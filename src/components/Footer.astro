---
import Logo from './Logo.astro';
import { WHATSAPP_BASE_URL } from '../data/whatsapp';

const whatsappLink = WHATSAPP_BASE_URL;
---

<footer class="site-footer">
  <div class="container-wide">
    <!-- 4-Column Footer Grid -->
    <div class="footer-grid-4">
      <!-- Column 1: Logo & Business Description -->
      <div class="footer-col footer-col-brand">
        <a href="/" class="footer-logo" aria-label="Solar Site Surveys Home">
          <Logo isDark={true} height={57} />
        </a>
        <p class="footer-brand-desc">
          Statewide solar site survey coordination platform connecting solar EPCs and installers with verified local surveyors across Texas. Delivering standardized field measurements and CAD-ready deliverables.
        </p>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="footer-col">
        <h4 class="footer-col-title">Navigation</h4>
        <ul class="footer-links-list">
          <li><a href="/">Home</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/service-areas">Service Areas</a></li>
          <li><a href="/join-us">Join Our Network</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <!-- Column 3: Core Disciplines -->
      <div class="footer-col">
        <h4 class="footer-col-title">Core Services</h4>
        <ul class="footer-links-list">
          <li><a href="/services/solar-site-surveys/">Precision Solar Site Surveys</a></li>
          <li><a href="/services/solar-cad-designs/">Permit-Ready CAD Designs</a></li>
          <li><a href="/services">Services Overview</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="/accessibility">Accessibility</a></li>
        </ul>
      </div>

      <!-- Column 4: Operations & Contact Desk -->
      <div class="footer-col footer-col-contact">
        <h4 class="footer-col-title">Operations Desk</h4>
        <div class="footer-contact-items">
          <div class="contact-item">
            <span class="contact-label">DIRECT PHONE</span>
            <a href="tel:+16823960543" class="contact-link phone-link">+1 (682) 396-0543</a>
          </div>
          <div class="contact-item">
            <span class="contact-label">WHATSAPP DISPATCH</span>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="contact-link whatsapp-link">
              <span>+1 (682) 396-0543</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
          <div class="contact-item">
            <span class="contact-label">OPERATING HOURS</span>
            <span class="contact-text">Mon–Sat: 6:00 AM – 7:00 PM CST</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Centered Credits -->
    <div class="footer-bottom">
      <p>© 2026 SolarSiteSurveyors.com | All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark);
    color: var(--text-light-muted);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--border-dark-subtle);
    margin-top: auto;
  }

  .footer-grid-4 {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 1.1fr 1.2fr;
    gap: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .footer-col-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .footer-brand-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #9FB3C8;
    max-width: 380px;
    margin: 0;
  }

  .footer-col-title {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
  }

  .footer-links-list a {
    color: #9FB3C8;
    font-family: var(--font-body);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links-list a:hover {
    color: var(--accent-gold);
  }

  .footer-contact-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contact-label {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-link {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color var(--transition-fast);
  }

  .contact-link:hover {
    color: var(--accent-gold);
  }

  .contact-text {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: #9FB3C8;
    line-height: 1.4;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: var(--space-8);
    text-align: center;
  }

  .footer-bottom p {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #9FB3C8;
    margin: 0;
    letter-spacing: 0.01em;
  }

  @media (max-width: 1024px) {
    .footer-grid-4 {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .footer-grid-4 {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
