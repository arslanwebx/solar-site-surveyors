---
import { getWhatsAppLink } from '../data/whatsapp';

interface Props {
  title?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  title = "Ready to Eliminate Survey Bottlenecks from Your Solar Pipeline?",
  subtitle = "Contact us today via WhatsApp to check real-time surveyor availability and coordinate your next Texas site survey.",
  primaryCtaText = "Schedule a Site Survey",
  primaryCtaLink = getWhatsAppLink('Hi, I would like to schedule a solar site survey in Texas.'),
  secondaryCtaText = "Partner With Us",
  secondaryCtaLink = "/join-us"
} = Astro.props;

const isExternal = primaryCtaLink.startsWith('http');
---

<section class="section section-dark cta-section">
  <div class="container">
    <div class="cta-inner-box">
      <div class="cta-header">
        <h2 class="cta-title">{title}</h2>
        <p class="cta-desc">{subtitle}</p>
      </div>

      <div class="cta-actions">
        <a 
          href={primaryCtaLink} 
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
          class="btn btn-primary btn-lg" 
          style="background-color: var(--primary); border-color: var(--primary);"
        >
          <span>{primaryCtaText}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={secondaryCtaLink} class="btn btn-outline-white btn-lg">
          <span>{secondaryCtaText}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    overflow: hidden;
    background-color: var(--primary);
  }

  .cta-inner-box {
    background-color: var(--primary-dark);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-10);
    text-align: center;
    position: relative;
    box-shadow: var(--shadow-xl);
  }

  .cta-header {
    max-width: 800px;
    margin: 0 auto var(--space-8);
  }

  .cta-title {
    color: #FFFFFF;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .cta-desc {
    color: #9FB3C8;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 0;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .cta-inner-box {
      padding: var(--space-10) var(--space-5);
    }
    .cta-actions {
      flex-direction: column;
    }
  }
</style>
