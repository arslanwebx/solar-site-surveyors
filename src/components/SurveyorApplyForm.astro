---
---

<div class="surveyor-form-card card-technical tech-grid-border" id="surveyor-apply-card">
  <div class="form-header">
    <h2 class="form-title">Join Our Field Surveyor Network</h2>
    <p class="form-desc">
      We coordinate consistent, localized site-survey work for independent solar field professionals, roof inspectors, and licensed drone pilots across Texas.
    </p>
  </div>

  <form id="surveyor-application-form" class="surveyor-form">
    <!-- Contact Info -->
    <div class="form-section-block">
      <h3 class="section-title"><span class="section-num font-mono">01</span> Personal & Contact Details</h3>
      
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label" for="surv-name">Full Legal Name <span class="required">*</span></label>
          <input type="text" id="surv-name" name="name" class="form-input" placeholder="e.g. Jason Ramirez" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="surv-email">Email Address <span class="required">*</span></label>
          <input type="email" id="surv-email" name="email" class="form-input" placeholder="e.g. jason@ramirezsurveys.com" required />
        </div>
      </div>

      <div class="grid-3">
        <div class="form-group">
          <label class="form-label" for="surv-phone">Mobile Phone Number <span class="required">*</span></label>
          <input type="tel" id="surv-phone" name="phone" class="form-input" placeholder="e.g. (555) 678-9012" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="surv-city">Base City <span class="required">*</span></label>
          <input type="text" id="surv-city" name="city" class="form-input" placeholder="e.g. Houston" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="surv-state">Base State <span class="required">*</span></label>
          <select id="surv-state" name="state" class="form-select" required>
            <option value="TX" selected>Texas</option>
            <option value="CA">California</option>
            <option value="FL">Florida</option>
            <option value="AZ">Arizona</option>
            <option value="CO">Colorado</option>
            <option value="NV">Nevada</option>
            <option value="OTHER">Other State</option>
          </select>
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label class="form-label" for="surv-zip">Base ZIP Code <span class="required">*</span></label>
          <input type="text" id="surv-zip" name="zip" class="form-input" placeholder="e.g. 77001" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="surv-radius">Maximum Service Radius <span class="required">*</span></label>
          <select id="surv-radius" name="radius" class="form-select" required>
            <option value="25 miles">Up to 25 miles</option>
            <option value="50 miles" selected>Up to 50 miles</option>
            <option value="75 miles">Up to 75 miles</option>
            <option value="100+ miles">100+ miles (Regional Travel)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Experience & Trade Background -->
    <div class="form-section-block">
      <h3 class="section-title"><span class="section-num font-mono">02</span> Solar & Field Experience</h3>
      
      <div class="grid-3">
        <div class="form-group">
          <label class="form-label" for="surv-solar-exp">Solar Experience <span class="required">*</span></label>
          <select id="surv-solar-exp" name="solarExperience" class="form-select" required>
            <option value="<1 year">&lt; 1 Year</option>
            <option value="1-2 years">1–2 Years</option>
            <option value="3-5 years" selected>3–5 Years</option>
            <option value="5+ years">5+ Years (Senior)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="surv-roof-exp">Roofing Experience <span class="required">*</span></label>
          <select id="surv-roof-exp" name="roofingExperience" class="form-select" required>
            <option value="Basic">Basic (Walkable Shingle only)</option>
            <option value="Experienced" selected>Experienced (Tile, Metal, Shingle)</option>
            <option value="Expert">Expert (Steep Pitch, Slate, Tile, Membrane)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="surv-elec-know">Electrical Knowledge <span class="required">*</span></label>
          <select id="surv-elec-know" name="electricalKnowledge" class="form-select" required>
            <option value="Fundamental">Fundamental (MSP Dead-Front & Breakers)</option>
            <option value="Advanced" selected>Advanced (120% Rule, Subpanels, Battery Gateways)</option>
            <option value="Journeyman / Licensed">Journeyman / Licensed Electrician</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Tools & Equipment Inventory -->
    <div class="form-section-block">
      <h3 class="section-title"><span class="section-num font-mono">03</span> Tools, Vehicle & Certifications</h3>
      
      <div class="form-group">
        <label class="form-label">Equipment Available in Your Vehicle</label>
        <div class="checkbox-grid">
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="28ft+ Extension Ladder" checked />
            <span>28ft+ Heavy Duty Extension Ladder</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="Safety Harness & Roof Anchor" checked />
            <span>OSHA Fall Protection Harness & Anchor Kit</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="Digital Angle Pitch Gauge" checked />
            <span>Digital Angle Pitch Gauge / Level</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="Digital Multimeter (CAT III/IV)" checked />
            <span>Digital Multimeter / Voltage Tester (CAT III/IV)</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="FAA Part 107 Commercial Drone" />
            <span>FAA Part 107 Commercial Drone (RGB / Thermal)</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="Laser Distance Meter" checked />
            <span>Laser Distance Measuring Tool</span>
          </label>
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label class="form-label" for="surv-vehicle">Reliable Work Vehicle <span class="required">*</span></label>
          <input type="text" id="surv-vehicle" name="vehicle" class="form-input" placeholder="e.g. Ford F-150 / Transit Cargo Van with Ladder Rack" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="surv-certs">Industry Certifications (if applicable)</label>
          <input type="text" id="surv-certs" name="certifications" class="form-input" placeholder="e.g. NABCEP PVA/PVSI, OSHA 10, OSHA 30, FAA 107" />
        </div>
      </div>
    </div>

    <!-- Availability & Rate Expectations -->
    <div class="form-section-block">
      <h3 class="section-title"><span class="section-num font-mono">04</span> Availability & Rate</h3>
      
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label" for="surv-rate">Target Rate Per Completed Residential Survey ($) <span class="required">*</span></label>
          <input type="text" id="surv-rate" name="targetRate" class="form-input" placeholder="e.g. $150–$200 per completed package" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="surv-days">Available Field Days <span class="required">*</span></label>
          <input type="text" id="surv-days" name="availableDays" class="form-input" placeholder="e.g. Monday through Saturday" required />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="surv-notes">Additional Background or Coverage Notes</label>
        <textarea id="surv-notes" name="notes" class="form-textarea" placeholder="Tell us about your background in solar, special roofing expertise, or specific Texas counties you prefer to cover..."></textarea>
      </div>
    </div>

    <!-- Terms and Submit -->
    <div class="form-submit-footer">
      <div class="disclaimer-note">
        <p><strong>Independent Contractor Network Notice:</strong> Submitting this application registers your profile for 1099 independent contractor field survey dispatches. All field surveyors must maintain active General Liability insurance and provide proof of OSHA compliance prior to first dispatch.</p>
      </div>

      <div class="submit-action-row">
        <button type="submit" class="btn btn-primary btn-lg" id="submit-surveyor-btn">
          <span>Apply to Join Field Network</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>
    </div>
  </form>

  <!-- Confirmation State -->
  <div class="surveyor-confirmation" id="surveyor-confirmation" style="display: none;">
    <div class="conf-icon-box">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
    </div>
    <h3 class="conf-title">Surveyor Profile Received</h3>
    <p class="conf-desc">
      Thank you for applying to the SolarSite field network. Our regional dispatch coordinator will review your tool inventory and service radius, and contact you promptly for onboarding.
    </p>
    <button type="button" class="btn btn-dark btn-md" id="reset-surveyor-form-btn">
      Back to Application
    </button>
  </div>
</div>

<script>
  const survForm = document.getElementById('surveyor-application-form') as HTMLFormElement;
  const survConf = document.getElementById('surveyor-confirmation');
  const survReset = document.getElementById('reset-surveyor-form-btn');

  if (survForm && survConf) {
    survForm.addEventListener('submit', (e) => {
      e.preventDefault();
      survForm.style.display = 'none';
      survConf.style.display = 'block';
      survConf.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    if (survReset) {
      survReset.addEventListener('click', () => {
        survForm.reset();
        survConf.style.display = 'none';
        survForm.style.display = 'block';
      });
    }
  }
</script>

<style>
  .surveyor-form-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: var(--space-10) var(--space-8);
  }

  .form-header {
    margin-bottom: var(--space-10);
    border-bottom: 1px solid var(--border-light);
    padding-bottom: var(--space-6);
  }

  .form-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .form-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 780px;
  }

  .form-section-block {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-light);
  }

  .section-title {
    font-size: 1.1875rem;
    color: var(--text-primary);
    margin-bottom: var(--space-5);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-num {
    color: var(--accent-amber);
    font-size: 0.9375rem;
    background-color: var(--accent-amber-bg);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .checkbox-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    cursor: pointer;
    background-color: var(--bg-subtle);
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
  }

  .checkbox-label:hover {
    border-color: var(--border-medium);
    color: var(--text-primary);
  }

  .checkbox-label input {
    accent-color: var(--accent-amber);
  }

  .disclaimer-note {
    background-color: var(--bg-subtle);
    border-left: 3px solid #D97706;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-sm);
  }

  .disclaimer-note p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  .submit-action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-4);
  }

  .surveyor-confirmation {
    text-align: center;
    padding: var(--space-12) var(--space-6);
  }

  .conf-icon-box {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--status-green-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
  }

  .conf-title {
    font-size: 1.875rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .conf-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0 auto var(--space-8);
  }

  @media (max-width: 768px) {
    .surveyor-form-card {
      padding: var(--space-6) var(--space-4);
    }
    .checkbox-grid {
      grid-template-columns: 1fr;
    }
    .submit-action-row button {
      width: 100%;
    }
  }
</style>
