---
interface Props {
  isDark?: boolean;
  height?: number;
  class?: string;
}

const { isDark = false, height = 38, class: className = '' } = Astro.props;
const textColor = isDark ? '#FFFFFF' : '#0A2540';
const roofColor = isDark ? '#FFFFFF' : '#0A2540';
const sunColor = '#FFAE00';
const pinColor = isDark ? '#FFFFFF' : '#0A2540';
const pinHole = isDark ? '#0F172A' : '#FFFFFF';
---

<div class={`logo-container ${className}`} style={`height: ${height}px; display: inline-flex; align-items: center;`}>
  <svg 
    viewBox="0 0 460 100" 
    height={height} 
    style="height: 100%; width: auto; max-width: 100%;" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg"
    aria-label="Solar Site Surveys Logo"
  >
    <!-- SUN -->
    <g class="logo-sun">
      <!-- Sun rays -->
      <line x1="52" y1="12" x2="52" y2="20" stroke={sunColor} stroke-width="4.5" stroke-linecap="round"/>
      <line x1="32" y1="20" x2="38" y2="26" stroke={sunColor} stroke-width="4.5" stroke-linecap="round"/>
      <line x1="24" y1="40" x2="32" y2="40" stroke={sunColor} stroke-width="4.5" stroke-linecap="round"/>
      <line x1="72" y1="20" x2="66" y2="26" stroke={sunColor} stroke-width="4.5" stroke-linecap="round"/>
      <line x1="32" y1="60" x2="38" y2="54" stroke={sunColor} stroke-width="4.5" stroke-linecap="round"/>
      <!-- Sun disc -->
      <circle cx="52" cy="40" r="17" fill={sunColor}/>
    </g>

    <!-- ROOF & SOLAR PANELS -->
    <g class="logo-roof">
      <!-- Solar Panels on Left Slope -->
      <!-- Panel 1 (Top) -->
      <polygon points="86,43 72,55 58,55 72,43" fill={roofColor}/>
      <!-- Panel 2 (Middle) -->
      <polygon points="70,57 56,69 42,69 56,57" fill={roofColor}/>
      <!-- Panel 3 (Bottom) -->
      <polygon points="54,71 40,83 26,83 40,71" fill={roofColor}/>

      <!-- Main Roof Ridge Gable Beams -->
      <!-- Left Ridge Trim -->
      <line x1="94" y1="41" x2="48" y2="83" stroke={roofColor} stroke-width="9" stroke-linecap="round"/>
      <!-- Right Ridge Slope -->
      <line x1="94" y1="41" x2="132" y2="78" stroke={roofColor} stroke-width="9" stroke-linecap="round"/>
    </g>

    <!-- LOCATION PIN & BASE OVAL -->
    <g class="logo-pin">
      <!-- Yellow Ground Base Oval -->
      <ellipse cx="94" cy="85" rx="16" ry="5.5" fill={sunColor}/>

      <!-- Dark Navy Location Pin -->
      <path 
        d="M94 51 C87.5 51 82.5 56 82.5 62.5 C82.5 70.5 94 81 94 81 C94 81 105.5 70.5 105.5 62.5 C105.5 56 100.5 51 94 51 Z" 
        fill={pinColor}
      />
      <!-- Center Pin Hole -->
      <circle cx="94" cy="62.5" r="3.75" fill={pinHole}/>
    </g>

    <!-- TEXT: Solar Site Surveys -->
    <!-- "Solar" (Bold) -->
    <text 
      x="142" 
      y="71" 
      fill={textColor} 
      font-family="'Plus Jakarta Sans', 'Space Grotesk', -apple-system, sans-serif" 
      font-size="44" 
      font-weight="800" 
      letter-spacing="-0.03em"
    >Solar</text>

    <!-- "Site Surveys" (Medium/Regular) -->
    <text 
      x="272" 
      y="71" 
      fill={textColor} 
      font-family="'Plus Jakarta Sans', 'Space Grotesk', -apple-system, sans-serif" 
      font-size="44" 
      font-weight="500" 
      letter-spacing="-0.02em"
    >Site Surveys</text>
  </svg>
</div>
