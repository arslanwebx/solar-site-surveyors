---
interface Props {
  isDark?: boolean;
  height?: number;
  class?: string;
}

const { isDark = false, height = 48, class: className = '' } = Astro.props;
const logoSrc = isDark ? '/images/logo-white.png' : '/images/logo.png';
---

<div class={`brand-logo-img-wrap ${className}`} style={`--logo-h: ${height}px;`}>
  <img 
    src={logoSrc} 
    alt="Solar Site Surveys" 
    height={height}
    class="brand-logo-img"
    loading="eager"
  />
</div>

<style>
  .brand-logo-img-wrap {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    user-select: none;
    line-height: 0;
    height: var(--logo-h, 48px);
  }

  .brand-logo-img {
    height: var(--logo-h, 48px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    image-rendering: -webkit-optimize-contrast;
  }

  @media (max-width: 640px) {
    .brand-logo-img-wrap {
      --logo-h: 40px;
    }
    .brand-logo-img {
      height: 40px;
    }
  }
</style>
