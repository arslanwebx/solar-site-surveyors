---
interface Props {
  isDark?: boolean;
  height?: number;
  class?: string;
}

const { isDark = false, height = 40, class: className = '' } = Astro.props;
const logoSrc = isDark ? '/images/logo-white.png' : '/images/logo.png';
---

<div class={`brand-logo-img-wrap ${className}`} style={`height: ${height}px; display: inline-flex; align-items: center; line-height: 0;`}>
  <img 
    src={logoSrc} 
    alt="Solar Site Surveys" 
    height={height}
    style={`height: ${height}px; width: auto; max-width: 100%; object-fit: contain; display: block;`}
    loading="eager"
  />
</div>

<style>
  .brand-logo-img-wrap {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    user-select: none;
  }
  .brand-logo-img-wrap img {
    height: 100%;
    width: auto;
  }
</style>
