---
const steps = [
  {
    stepNum: "01",
    label: "PROJECT INTAKE",
    title: "Submit Project & Requirements",
    description: "Provide the property address, prelim CAD/proposal, utility bill, and specific survey scope (roof planes, electrical panel, battery storage, attic access) via our fast intake portal."
  },
  {
    stepNum: "02",
    label: "DISPATCH & COORDINATION",
    title: "Surveyor Matched & Scheduled",
    description: "Our operations dispatch team assigns a vetted local site surveyor equipped with certified safety gear, digital pitch gauges, multimeters, and drones, and confirms site access directly."
  },
  {
    stepNum: "03",
    label: "FIELD EXECUTION",
    title: "Comprehensive Field Survey",
    description: "The surveyor performs an exhaustive on-site audit: 36-photo standard, MSP dead-front busbar verification, rafter dimensions, pitch measurements, obstruction coordinates, and battery clearances."
  },
  {
    stepNum: "04",
    label: "QA & DELIVERY",
    title: "CAD-Ready Package Delivered",
    description: "Every photo, measurement, and electrical reading undergoes internal triple-check QA before release. Your engineering and drafting team receives an organized, CAD-ready package."
  }
];
---

<div class="process-timeline-container">
  <div class="timeline-grid">
    {steps.map((step) => (
      <div class="timeline-step card-technical tech-grid-border">
        <div class="step-top-row">
          <span class="step-number">{step.stepNum}</span>
          <span class="step-label-mono">{step.label}</span>
        </div>
        <h3 class="step-title">{step.title}</h3>
        <p class="step-desc">{step.description}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .process-timeline-container {
    position: relative;
    margin-top: var(--space-8);
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    position: relative;
  }

  .timeline-step {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    padding: var(--space-8) var(--space-6);
    position: relative;
    transition: all var(--transition-fast);
  }

  .timeline-step:hover {
    border-color: var(--accent-amber);
    transform: translateY(-2px);
  }

  .step-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .step-number {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--accent-amber-dark);
    line-height: 1;
  }

  .step-label-mono {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .step-title {
    font-size: 1.1875rem;
    line-height: 1.3;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .step-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .timeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .timeline-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
