---
const steps = [
  {
    stepNum: "01",
    phase: "Project Intake",
    title: "Submit Project & Scope",
    description: "Provide the property address, proposal notes, utility bill, and specific survey scope (roof planes, electrical MSP, battery storage) via our streamlined intake."
  },
  {
    stepNum: "02",
    phase: "Local Dispatch",
    title: "Surveyor Matched & Scheduled",
    description: "Our operations team coordinates with a vetted local site surveyor equipped with certified safety gear, digital pitch gauges, and multimeters to confirm site access."
  },
  {
    stepNum: "03",
    phase: "Field Execution",
    title: "Comprehensive Field Survey",
    description: "The surveyor performs an exhaustive on-site audit: complete photo package, MSP dead-front busbar verification, rafter dimensions, pitch measurements, and battery clearances."
  },
  {
    stepNum: "04",
    phase: "QA & Release",
    title: "CAD-Ready Package Delivered",
    description: "Every photo, measurement, and electrical reading undergoes desk QA verification before release. Your engineering team receives an organized, CAD-ready package."
  }
];
---

<div class="process-timeline-container">
  <div class="timeline-grid">
    {steps.map((step) => (
      <div class="timeline-step card-technical">
        <div class="step-header">
          <div class="step-number-badge">
            <span class="badge-num font-mono">{step.stepNum}</span>
          </div>
          <span class="step-phase-tag">{step.phase}</span>
        </div>
        <h3 class="step-title">{step.title}</h3>
        <p class="step-desc">{step.description}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .process-timeline-container {
    position: relative;
    margin-top: var(--space-8);
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .timeline-step {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .timeline-step:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .step-number-badge {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .badge-num {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1;
  }

  .step-phase-tag {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .step-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--primary);
    margin-bottom: var(--space-3);
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 1100px) {
    .timeline-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .timeline-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
