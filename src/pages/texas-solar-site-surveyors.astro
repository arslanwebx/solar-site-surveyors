---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import { allTexasCities } from '../data/texasCities';
import { texasCityAuthorityPages } from '../data/texasCityAuthority';
import { getWhatsAppLink } from '../data/whatsapp';

// Breadcrumbs hierarchy: Home > Service Areas > Texas
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas' }
];

// 52 dedicated city authority pages.
const active52SlugsList = texasCityAuthorityPages.map((page) => page.slug);
const active52Set = new Set(active52SlugsList);
const authorityBySlug = new Map(texasCityAuthorityPages.map((page) => [page.slug, page]));

// Keep the full Texas directory, but replace generic summaries for the 52
// published city pages with their individually written local summaries.
const cityDirectory = allTexasCities.map((city) => ({
  ...city,
  keyCoverageNotes: authorityBySlug.get(city.slug)?.hubSummary ?? city.keyCoverageNotes
}));

// First 100 cities are pre-rendered statically for fast initial load and crawlability.
const initialCities = cityDirectory.slice(0, 100);
const remainingCities = cityDirectory.slice(100);
const defaultCustomSurveyWhatsApp = getWhatsAppLink('Hi, I would like to schedule a solar site survey in Texas.');
---

<BaseLayout 
  title="Texas Solar Site Surveyors | 52 City Service Pages"
  description="Solar site survey coordination for Texas EPCs and installers, with 52 dedicated city pages covering roof, electrical, structural, battery, and field documentation needs."
  activeNav="service-areas"
  canonical="/texas-solar-site-surveyors/"
>
  <!-- Page Hero with Dark Luxury Aesthetic -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <!-- Structured Breadcrumb Trail: Home > Service Areas > Texas -->
        <Breadcrumbs items={breadcrumbs} isDark={true} />

        <h1 class="page-title">Texas Solar Site Survey Coverage & City Directory</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 924px;">
          Texas solar projects do not share one utility, one permitting path, or one housing type. This directory connects EPCs and installers with 52 dedicated city pages built around the field conditions that matter locally, while the wider city list helps teams identify additional Texas coverage areas.
        </p>
      </div>
    </div>
  </section>

  <!-- Texas Statewide Cities Directory & Live Instant Search -->
  <section class="section section-warm" id="city-directory">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Statewide Directory</div>
        <h2>Active Texas City Dispatch Directory</h2>
        <p class="lead">
          Start with one of the 52 published city guides for detailed local survey context, or search the wider Texas directory to discuss coverage for another project address.
        </p>

        <!-- Live Instant Search Bar -->
        <div class="search-bar-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#66717D" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input 
            type="text" 
            id="city-search" 
            placeholder="Search Texas cities & towns (e.g. Houston, Plano, Lubbock, Tyler, Waco)..." 
            aria-label="Filter Texas cities"
          />
        </div>
      </div>

      <!-- Cities Grid (Initial 100 Pre-rendered) -->
      <div class="cities-grid" id="cities-grid">
        {initialCities.map((city) => {
          const hasPage = active52Set.has(city.slug);
          return (
            <div class={`city-card card-technical ${hasPage ? 'has-page' : 'is-unlinked'}`} id={city.slug} data-name={city.name.toLowerCase()}>
              <div class="city-card-content">
                <h3 class="city-name">
                  {hasPage ? (
                    <a href={`/texas/${city.slug}-solar-site-surveyors/`} class="city-title-link">{city.name}</a>
                  ) : (
                    <span class="city-title-static">{city.name}</span>
                  )}
                </h3>
                <p class="city-notes">{city.keyCoverageNotes}</p>
              </div>
              <div class="city-card-action">
                {hasPage ? (
                  <a 
                    href={`/texas/${city.slug}-solar-site-surveyors/`} 
                    class="btn btn-city-explore"
                    title={`Explore ${city.name}, TX solar site survey coverage`}
                  >
                    <span>Explore</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                ) : (
                  <button 
                    type="button" 
                    class="btn btn-city-explore btn-unlinked"
                    disabled
                    aria-disabled="true"
                    title="Coverage available across Texas. Dedicated landing page coming soon."
                  >
                    <span>Explore</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Load More Button -->
      <div class="load-more-wrap" id="load-more-wrap">
        <button type="button" class="btn btn-outline btn-lg" id="load-more-btn">
          <span>Load More Texas Cities</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>
      
      <!-- No Search Results Fallback -->
      <div id="no-cities-msg" class="no-results-box" style="display: none;">
        <p>No Texas cities matching your search. We coordinate surveys across all 254 counties statewide. <a href={defaultCustomSurveyWhatsApp} target="_blank" rel="noopener noreferrer" style="color: var(--primary); font-weight: 600; text-decoration: underline;">Schedule a Custom Survey via WhatsApp</a>.</p>
      </div>
    </div>
  </section>

  <!-- Texas Technical & Utility Interconnection Standards -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Engineering Specifications</div>
        <h2>Texas Field Data That Travels Well Across Different AHJs and Utilities</h2>
        <p class="lead">
          Texas project requirements vary by service address. The survey should establish accurate site facts first, then let your design, engineering, permitting, and interconnection teams apply the current requirements.
        </p>
      </div>

      <div class="specs-grid">
        <div class="spec-card card-technical">
          <div class="spec-header">
            <h4>Service Equipment Verification</h4>
            <span class="spec-tag">Address Specific</span>
          </div>
          <p>Readable meter identifiers, service equipment, panel ratings, grounding context, and wider electrical photos help the project team confirm the serving utility and design from the actual property configuration.</p>
        </div>

        <div class="spec-card card-technical">
          <div class="spec-header">
            <h4>Roof & Structural Evidence</h4>
            <span class="spec-tag">Engineering Input</span>
          </div>
          <p>Roof pitch, plane geometry, visible roof condition, attic framing, member dimensions, spacing, and decking can be documented for engineering review without turning the field survey into a structural certification.</p>
        </div>

        <div class="spec-card card-technical">
          <div class="spec-header">
            <h4>Jurisdiction & Utility Context</h4>
            <span class="spec-tag">Verify Current Rules</span>
          </div>
          <p>Texas cities can sit under municipal utilities, cooperatives, and different transmission or distribution territories. We capture field identifiers and site context while your project team verifies the current AHJ and interconnection requirements.</p>
        </div>

        <div class="spec-card card-technical">
          <div class="spec-header">
            <h4>Battery & Backup Locations</h4>
            <span class="spec-tag">Site Context</span>
          </div>
          <p>Wall dimensions, nearby doors and windows, gas or electrical equipment, service relationships, and potential routing can be captured so the design team can apply current code and manufacturer clearance requirements.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <CTASection 
    title="Ready to Dispatch a Solar Site Survey Anywhere in Texas?"
    subtitle="Connect with our operations desk to check surveyor availability, turnaround SLAs, and coordinate your upcoming pipeline."
    primaryCtaText="Schedule a Texas Survey"
    secondaryCtaText="Join Our Texas Network"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<!-- Client Script for Ultra-Fast Batch Loading and Full-Dataset Search -->
<script define:vars={{ remainingCities, initialCities, active52SlugsList }}>
  let currentLoadedCount = initialCities.length;
  const BATCH_SIZE = 100;
  const grid = document.getElementById('cities-grid');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreWrap = document.getElementById('load-more-wrap');
  const searchInput = document.getElementById('city-search');
  const noResults = document.getElementById('no-cities-msg');
  const active52Set = new Set(active52SlugsList);

  // Helper to create a city card DOM element
  function createCardElement(city) {
    const card = document.createElement('div');
    const hasPage = active52Set.has(city.slug);
    card.className = `city-card card-technical ${hasPage ? 'has-page' : 'is-unlinked'}`;
    card.id = city.slug;
    card.setAttribute('data-name', city.name.toLowerCase());
    const cityUrl = '/texas/' + city.slug + '-solar-site-surveyors/';
    
    card.innerHTML = `
      <div class="city-card-content">
        <h3 class="city-name">
          ${hasPage 
            ? `<a href="${cityUrl}" class="city-title-link">${city.name}</a>` 
            : `<span class="city-title-static">${city.name}</span>`}
        </h3>
        <p class="city-notes">${city.keyCoverageNotes}</p>
      </div>
      <div class="city-card-action">
        ${hasPage 
          ? `<a href="${cityUrl}" class="btn btn-city-explore" title="Explore ${city.name}, TX solar site survey coverage">
              <span>Explore</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>`
          : `<button type="button" class="btn btn-city-explore btn-unlinked" disabled aria-disabled="true" title="Coverage available across Texas. Dedicated landing page coming soon.">
              <span>Explore</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>`
        }
      </div>
    `;
    return card;
  }

  // Load More Handler (loads next batch)
  function loadNextBatch() {
    if (!grid || !remainingCities) return;
    const startIndex = currentLoadedCount - initialCities.length;
    const nextCities = remainingCities.slice(startIndex, startIndex + BATCH_SIZE);

    if (nextCities.length > 0) {
      const fragment = document.createDocumentFragment();
      nextCities.forEach(city => {
        fragment.appendChild(createCardElement(city));
      });
      grid.appendChild(fragment);
      currentLoadedCount += nextCities.length;
    }

    if (startIndex + BATCH_SIZE >= remainingCities.length && loadMoreWrap) {
      loadMoreWrap.style.display = 'none';
    }
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', loadNextBatch);
  }

  // Live Instant Search across whole dataset
  const allDataset = [...initialCities, ...remainingCities];

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();

      if (!q) {
        // Reset to currently loaded view
        if (grid) {
          const domCards = grid.querySelectorAll('.city-card');
          domCards.forEach((c) => {
            c.style.display = 'flex';
          });
        }
        if (loadMoreWrap) {
          const startIndex = currentLoadedCount - initialCities.length;
          loadMoreWrap.style.display = (startIndex < remainingCities.length) ? 'flex' : 'none';
        }
        if (noResults) noResults.style.display = 'none';
        return;
      }

      // If search query is active, hide load more button
      if (loadMoreWrap) loadMoreWrap.style.display = 'none';

      // Find matching cities from full dataset
      const matches = allDataset.filter(c => c.name.toLowerCase().includes(q));

      if (grid) {
        grid.innerHTML = '';
        if (matches.length > 0) {
          const fragment = document.createDocumentFragment();
          // Show up to 100 search results for instantaneous speed
          matches.slice(0, 100).forEach(city => {
            fragment.appendChild(createCardElement(city));
          });
          grid.appendChild(fragment);
          if (noResults) noResults.style.display = 'none';
        } else {
          if (noResults) noResults.style.display = 'block';
        }
      }
    });
  }
</script>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
    text-align: center;
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  /* Search Bar */
  .search-bar-wrap {
    position: relative;
    max-width: 594px;
    margin: var(--space-6) auto 0;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search-bar-wrap input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    background-color: #FFFFFF;
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .search-bar-wrap input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(16, 42, 67, 0.1);
  }

  /* Cities Grid & Clean Cards */
  .cities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  :global(.city-card) {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  :global(.city-card:hover) {
    border-color: var(--border-medium);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  :global(.city-card-content) {
    margin-bottom: var(--space-4);
  }

  :global(.city-name) {
    font-family: var(--font-heading) !important;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 0.4rem 0;
  }

  :global(.city-title-link) {
    color: var(--primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  :global(.city-title-link:hover) {
    color: var(--accent-gold);
  }

  :global(.city-title-static) {
    color: var(--primary);
  }

  :global(.city-notes) {
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  :global(.city-card-action) {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  :global(.btn-city-explore) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.6rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #FFFFFF;
    background-color: var(--primary);
    border: 1px solid var(--primary);
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  :global(.btn-city-explore:hover) {
    background-color: var(--primary-dark);
    color: #FFFFFF;
    border-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(16, 42, 67, 0.22);
  }

  :global(.btn-city-explore svg) {
    transition: transform var(--transition-fast);
  }

  :global(.btn-city-explore:hover svg) {
    transform: translateX(3px);
  }

  :global(.btn-city-explore.btn-unlinked) {
    cursor: default;
    opacity: 0.6;
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px dashed var(--border-medium, #cbd2d9);
    pointer-events: none;
  }

  :global(.btn-city-explore.btn-unlinked:hover) {
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    border-color: var(--border-medium, #cbd2d9);
    transform: none;
  }

  :global(.btn-city-explore.btn-unlinked svg) {
    opacity: 0.5;
  }

  :global(.btn-city-explore.btn-unlinked:hover svg) {
    transform: none;
  }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  .no-results-box {
    text-align: center;
    padding: var(--space-10);
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    margin-top: var(--space-6);
  }

  /* Specs Grid */
  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .spec-card {
    padding: var(--space-6);
    background-color: #FFFFFF;
  }

  .spec-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .spec-header h4 {
    color: var(--primary);
    margin: 0;
  }

  .spec-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
    background-color: var(--bg-secondary);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
  }

  .spec-card p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .cities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .cities-grid {
      grid-template-columns: 1fr;
    }
    .specs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
