---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Accessibility Statement | SolarSite Texas"
  description="Accessibility statement for SolarSite Texas website and digital dispatch portal."
>
  <section class="section section-dark page-hero">
    <div class="container-narrow">
      <h1 class="page-title">Accessibility Statement</h1>
      <p class="lead" style="color: #94A3B8;">Committed to accessible solar operations technology.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <div class="legal-content card-technical" style="padding: var(--space-8); line-height: 1.7;">
        <h3>Commitment to Accessibility</h3>
        <p>SolarSite Texas is dedicated to ensuring digital accessibility for all users, including solar operations personnel, field surveyors, and engineering partners with disabilities. We continually improve the user experience and apply relevant accessibility standards (WCAG 2.1 Level AA).</p>

        <h3 style="margin-top: 1.5rem;">Feedback & Assistance</h3>
        <p>If you experience difficulty accessing any part of our website or dispatch portal, please contact our accessibility coordinator at <a href="mailto:support@solarsitesurveyors.com" style="color: var(--accent-amber-dark); text-decoration: underline;">support@solarsitesurveyors.com</a> or call (800) 555-7878.</p>
      </div>
    </div>
  </section>
</BaseLayout>
