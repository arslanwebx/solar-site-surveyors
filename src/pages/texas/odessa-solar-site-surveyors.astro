---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Odessa, TX | Permian Basin Surveys';
const pageDescription = 'Solar site surveys in Odessa, TX. Standardizing Oncor electrical service data, low-pitch roof planes, and attic framing across Ector County.';
const canonicalPath = '/texas/odessa-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Odessa' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Odessa, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Odessa, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Odessa, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Main Electrical Panel Inspection',
    'Low-Pitch Roof Plane Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do older electrical service panels impact solar projects in Odessa?',
    answer: 'A significant portion of Odessa housing stock built from the 1950s through 1980s features 100-amp or 125-amp service equipment, sometimes with split-bus configurations or limited open breaker slots. Our surveyors photograph panel data labels, main breakers, and busbars so your electrical engineers can determine if a panel upgrade or line-side tap is required.'
  },
  {
    question: 'Which electric utility handles solar interconnection in Odessa?',
    answer: 'Odessa is located within Oncor Electric Delivery service territory. We photograph the meter enclosure, digital display, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for Oncor distributed generation filings.'
  },
  {
    question: 'How do low-slope roofs and attached carports affect solar surveys in Odessa?',
    answer: 'Homes in Odessa often feature low-pitch 3/12 or 4/12 roof planes alongside attached metal or wood-frame carports. The surveyor records pitch per plane, identifies roofing material condition, maps plumbing vents, and evaluates structural attachment framing to ensure code-compliant solar module layout.'
  },
  {
    question: 'What environmental challenges are documented during an Odessa site survey?',
    answer: 'Persistent dust from caliche roads and high wind conditions can weather exterior service disconnects and solar-facing roof planes. The surveyor documents equipment enclosure integrity and roof surface wear to help your engineering team design resilient installations.'
  },
  {
    question: 'Do your surveyors cover surrounding Ector County communities?',
    answer: 'Yes. Survey dispatches regularly connect Odessa with West Odessa, Goldsmith, Gardendale, Crane, and Monahans.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Odessa, TX</h1>
        <p class="lead">
          Field site documentation across Ector County and the western Permian Basin. Standardizing legacy electrical panel verification, low-pitch roof plane geometry, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Odessa Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Ector County Focus -->
  <section class="section">
    <div class="container">
      <div class="ode-split">
        <div class="ode-text">
          <div class="kicker">Operational Focus</div>
          <h2>Ector County Residential Core: Managing Legacy Service Panels in Odessa</h2>
          <p>
            Odessa serves as the industrial and operational engine of the Permian Basin, supporting a substantial residential population across Ector County. Characterized by post-war single-family homes, classic 1970s brick ranches, and expansive lot footprints in West Odessa, the city presents a distinct set of field survey priorities.
          </p>
          <p>
            Many established properties retain original 100-amp or 125-amp electrical service panels, frequently mounted outdoors where West Texas dust and high sun exposure have weathered manufacturer labels. If remote CAD engineers cannot verify the busbar rating or determine whether physical space exists for an interconnection breaker, project timelines stall during permit review.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Odessa project. We clean and record legible electrical data plates, verify main breaker capacities, inspect accessible attic framing, and map low-pitch roof planes so your engineering team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="ode-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Odessa Operating Overview</h3>
          <ul class="ode-spec-list">
            <li>
              <strong>County:</strong>
              <span>Ector County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Odessa Building Inspection</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Mid-century brick ranches, low-pitch single-family homes</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>100A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Odessa Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="ode-grid">
        <div class="ode-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="ode-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="ode-card card-technical">
          <h3>Low-Pitch Roof Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="ode-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="ode-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="ode-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Permian Basin Operations</div>
        <h2>Connected Survey Coverage Across Surrounding West Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="ode-links">
        <a href="/texas/midland-solar-site-surveyors/" class="ode-link-card">
          <h4>Midland Solar Site Surveyors</h4>
          <p>Permian Basin energy hub survey operations and Oncor service data directly east.</p>
        </a>
        <a href="/texas/lubbock-solar-site-surveyors/" class="ode-link-card">
          <h4>Lubbock Solar Site Surveyors</h4>
          <p>LP&L retail choice market transition and South Plains residential survey coordination directly north.</p>
        </a>
        <a href="/texas/san-angelo-solar-site-surveyors/" class="ode-link-card">
          <h4>San Angelo Solar Site Surveyors</h4>
          <p>Concho Valley residential survey coordination and AEP Texas North documentation directly southeast.</p>
        </a>
        <a href="/texas/abilene-solar-site-surveyors/" class="ode-link-card">
          <h4>Abilene Solar Site Surveyors</h4>
          <p>AEP Texas North territory and Big Country residential framing documentation directly east.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Odessa Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="ode-faq-list">
        {faqs.map(faq => (
          <div class="ode-faq-item card-technical">
            <h3 class="ode-faq-q">{faq.question}</h3>
            <p class="ode-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Odessa, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Odessa"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .ode-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .ode-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .ode-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .ode-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .ode-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .ode-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ode-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .ode-spec-list li:last-child {
    border-bottom: none;
  }

  .ode-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .ode-spec-list span {
    color: var(--text-secondary);
  }

  .ode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .ode-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .ode-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .ode-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .ode-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .ode-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .ode-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .ode-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .ode-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .ode-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ode-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .ode-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .ode-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .ode-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
