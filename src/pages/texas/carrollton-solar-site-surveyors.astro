---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Carrollton, TX | Tri-County Area';
const pageDescription = 'Solar site survey coordination in Carrollton, TX. Bridging Dallas, Denton, and Collin counties with standardized electrical and structural field packages.';
const canonicalPath = '/texas/carrollton-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Carrollton' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Carrollton, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Carrollton, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Carrollton, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Tri-County Jurisdictional Survey',
    'Main Panel Bus Rating Verification'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do tri-county boundaries affect Carrollton solar permitting?',
    answer: 'Carrollton spans Dallas, Denton, and Collin counties. While the City of Carrollton Building Inspection Department processes municipal building permits, county recordings and tax parcel information differ depending on property location. Our survey captures exact property details, street addresses, and utility meter records to ensure permit submittals match municipal records without administrative delays.'
  },
  {
    question: 'Which utility company serves Carrollton solar installations?',
    answer: 'Carrollton properties are primarily located in Oncor Electric Delivery territory. We photograph the meter enclosure, meter badge number, digital display, overhead or underground service entrance, and main disconnect to provide complete documentation for Oncor distributed generation interconnection filings.'
  },
  {
    question: 'What structural framing details are collected during a Carrollton survey?',
    answer: 'We measure framing member sizes, center-to-center spacing, purlin bracing, collar ties, and roof decking thickness with clear measurement photographs. Whether the home features conventional rafter framing or engineered roof trusses, our data supports structural engineering review.'
  },
  {
    question: 'What electrical service panel information is documented?',
    answer: 'The surveyor captures macro photographs of the panel data plate, busbar rating, main breaker capacity, circuit directory, and grounding conductors, confirming whether a solar backfeed breaker can be installed or if an alternative connection method is needed.'
  },
  {
    question: 'Do you provide survey dispatches across neighboring North DFW cities?',
    answer: 'Yes. Survey dispatches regularly connect Carrollton with Farmers Branch, Addison, Plano, Lewisville, and Irving.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Carrollton, TX</h1>
        <p class="lead">
          Field site documentation navigating the tri-county intersection of Dallas, Denton, and Collin counties. Standardizing electrical panel verification, roof geometry, and attic framing for solar EPC engineering teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Carrollton</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tri-County Boundary Section -->
  <section class="section">
    <div class="container">
      <div class="carr-split">
        <div class="carr-text">
          <div class="kicker">Operational Focus</div>
          <h2>Operating Across Tri-County Municipal Boundaries</h2>
          <p>
            Carrollton is one of the few Texas cities that sprawls across three distinct counties: Dallas, Denton, and Collin. For solar operations managers, coordinating surveys in Carrollton means handling projects where county tax records, parcel maps, and utility feeds intersect across neighborhood lines.
          </p>
          <p>
            While building permits are processed centrally by the City of Carrollton Building Inspection Department, county recording details and Oncor service boundaries must be accurately documented. When field surveyors provide incomplete property notes, remote CAD departments can easily misidentify jurisdictional requirements, causing administrative delays during permit intake.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Carrollton project. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your design team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="carr-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Carrollton Operating Overview</h3>
          <ul class="carr-spec-list">
            <li>
              <strong>Counties:</strong>
              <span>Dallas County, Denton County, Collin County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Carrollton Building Inspection</span>
            </li>
            <li>
              <strong>Housing Diversity:</strong>
              <span>1970s to 1990s residential tracts, custom infill</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>150A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Inspection Scope</div>
        <h2>What Our Carrollton Survey Packages Capture</h2>
        <p class="lead">
          Comprehensive field measurements designed for remote CAD engineers and structural calculations.
        </p>
      </div>

      <div class="carr-grid">
        <div class="carr-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="carr-card card-technical">
          <h3>Oncor Meter & Service Disconnect</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="carr-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="carr-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="carr-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="carr-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">North DFW Operations</div>
        <h2>Connected Survey Coverage Across Surrounding DFW Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="carr-links">
        <a href="/texas/lewisville-solar-site-surveyors/" class="carr-link-card">
          <h4>Lewisville Solar Site Surveyors</h4>
          <p>Lake-adjacent residential site data and utility coordination across southern Denton County directly west.</p>
        </a>
        <a href="/texas/plano-solar-site-surveyors/" class="carr-link-card">
          <h4>Plano Solar Site Surveyors</h4>
          <p>High-density North DFW residential survey coordination and engineering handoffs directly east.</p>
        </a>
        <a href="/texas/irving-solar-site-surveyors/" class="carr-link-card">
          <h4>Irving Solar Site Surveyors</h4>
          <p>Las Colinas, Valley Ranch, and central Irving municipal field documentation directly south.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="carr-link-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Dallas metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Carrollton Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="carr-faq-list">
        {faqs.map(faq => (
          <div class="carr-faq-item card-technical">
            <h3 class="carr-faq-q">{faq.question}</h3>
            <p class="carr-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Carrollton, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Carrollton"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .carr-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .carr-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .carr-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .carr-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .carr-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .carr-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .carr-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .carr-spec-list li:last-child {
    border-bottom: none;
  }

  .carr-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .carr-spec-list span {
    color: var(--text-secondary);
  }

  .carr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .carr-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .carr-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .carr-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .carr-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .carr-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .carr-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .carr-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .carr-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .carr-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .carr-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .carr-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .carr-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .carr-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
