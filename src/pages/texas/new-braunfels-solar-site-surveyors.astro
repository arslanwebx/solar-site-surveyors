---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in New Braunfels, TX | NBU Area';
const pageDescription = 'Solar site surveys in New Braunfels, TX. Aligning with New Braunfels Utilities (NBU) standards, Hill Country roof framing, and service equipment.';
const canonicalPath = '/texas/new-braunfels-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'New Braunfels' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in New Braunfels, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: New Braunfels, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'New Braunfels, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Municipal Utility Solar Surveys',
    'Residential Solar Site Survey',
    'Hill Country Roof Framing Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do New Braunfels Utilities standards impact solar projects?',
    answer: 'New Braunfels Utilities (NBU) is a municipal utility operating with its own customer distributed generation policies. NBU enforces specific meter socket configurations, dedicated exterior AC disconnect switches, and independent interconnection review processes. Our surveyors record high-resolution photos of the NBU meter, utility tags, and disconnect hardware to support accurate utility submittals.'
  },
  {
    question: 'Are all New Braunfels properties served by New Braunfels Utilities?',
    answer: 'Most properties within the city limits are in NBU territory, but outlying sections of Comal and Guadalupe counties connect to Guadalupe Valley Electric Cooperative (GVEC) or CenterPoint Energy. We verify the meter enclosure and utility labels on site so your team files with the proper provider.'
  },
  {
    question: 'What roof and framing conditions are typical in Hill Country homes?',
    answer: 'New Braunfels properties showcase a diverse architectural range, from historic German-heritage homes downtown with heavy timber rafters to contemporary Hill Country custom estates with complex multi-pitch roofs. We record member dimensions, spans, and decking materials with physical measurement photos.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do you cover projects across the Austin-San Antonio corridor?',
    answer: 'Yes. Survey dispatches regularly connect New Braunfels with San Marcos, Seguin, Canyon Lake, Schertz, and Cibolo.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in New Braunfels, TX</h1>
        <p class="lead">
          Accurate field data collection aligned with New Braunfels Utilities (NBU) municipal standards. Documenting electrical service equipment, Hill Country roof geometry, and attic structural framing across Comal and Guadalupe counties.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate New Braunfels Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- NBU Municipal Utility Alert -->
  <section class="section">
    <div class="container">
      <div class="nbu-banner card-technical">
        <div class="nbu-header">
          <div class="nbu-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <div class="kicker">Municipal Electric Market</div>
            <h2>New Braunfels Utilities (NBU) Interconnection Standards Require Local Data</h2>
          </div>
        </div>
        <p>
          Positioned between Austin and San Antonio, New Braunfels does not operate under generic transmission utility procedures. The city owns and operates New Braunfels Utilities (NBU), an independent municipal electric provider with strict customer generation rules and unique meter disconnect standards.
        </p>
        <p>
          Contractors submitting plan sets based on CPS Energy or Oncor assumptions face permit and interconnection rejections. Our survey coordination records the specific electrical parameters NBU requires: meter socket ratings, service entrance mast dimensions, exterior disconnect switch clearances, and grounding electrode paths. In border neighborhoods where NBU boundaries meet GVEC or CPS Energy, our on-site inspection verifies the exact utility tags so your team never files interconnection paperwork with the wrong provider.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Inspection Scope</div>
        <h2>New Braunfels Site Survey Package Deliverables</h2>
        <p class="lead">
          Comprehensive physical data prepared to support engineering review and City of New Braunfels building permits.
        </p>
      </div>

      <div class="nbu-grid">
        <div class="nbu-card card-technical">
          <h3>NBU Electric Meter Equipment</h3>
          <p>
            We photograph the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete NBU interconnection filing.
          </p>
        </div>

        <div class="nbu-card card-technical">
          <h3>Main Electrical Service Panels</h3>
          <p>
            The survey records busbar ratings, main breaker capacity, manufacturer data plates, and circuit breaker directories, confirming whether the electrical panel can accept a solar backfeed breaker.
          </p>
        </div>

        <div class="nbu-card card-technical">
          <h3>Hill Country Roof Framing & Decking</h3>
          <p>
            From historic German-heritage residences with dimensional timber rafters to contemporary estates with complex trusses, we document framing member sizes, spans, and decking materials.
          </p>
        </div>

        <div class="nbu-card card-technical">
          <h3>Roof Planes & Penetrations</h3>
          <p>
            We measure pitch angles, record roof plane azimuth, and map plumbing vents, attic fans, exhaust flues, and skylights to verify usable array boundaries within local fire code setbacks.
          </p>
        </div>

        <div class="nbu-card card-technical">
          <h3>Battery Backup & Inverter Clearances</h3>
          <p>
            For ESS projects, we record available wall space in attached garages or exterior side yards, verifying clearances from windows, doors, and gas meters to support code-compliant battery placement.
          </p>
        </div>

        <div class="nbu-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Full elevation photos document site access, fence gates, air conditioning equipment, and ladder setup areas to assist installation managers with build-day staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Corridor Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Hill Country Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="nbu-links">
        <a href="/texas/san-antonio-solar-site-surveyors/" class="nbu-link-card">
          <h4>San Antonio Solar Site Surveyors</h4>
          <p>CPS Energy municipal utility standards and broad Bexar County coverage directly south.</p>
        </a>
        <a href="/texas/austin-solar-site-surveyors/" class="nbu-link-card">
          <h4>Austin Solar Site Surveyors</h4>
          <p>Austin Energy municipal territory and Central Texas metroplex coverage directly northeast.</p>
        </a>
        <a href="/texas/round-rock-solar-site-surveyors/" class="nbu-link-card">
          <h4>Round Rock Solar Site Surveyors</h4>
          <p>High-density Williamson County tech corridor survey coordination further north along I-35.</p>
        </a>
        <a href="/texas/corpus-christi-solar-site-surveyors/" class="nbu-link-card">
          <h4>Corpus Christi Solar Site Surveyors</h4>
          <p>Coastal Bend windstorm documentation and AEP Texas utility coordination across South Texas.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>New Braunfels Solar Survey Operations</h2>
        <p class="lead">Essential details for solar contractors and project coordinators.</p>
      </div>

      <div class="nbu-faq-list">
        {faqs.map(faq => (
          <div class="nbu-faq-item card-technical">
            <h3 class="nbu-faq-q">{faq.question}</h3>
            <p class="nbu-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in New Braunfels, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and ensure your field package meets New Braunfels Utilities standards."
    primaryCtaText="Schedule Survey in New Braunfels"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .nbu-banner {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 6px solid var(--accent-gold);
    max-width: 1000px;
    margin: 0 auto;
  }

  .nbu-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .nbu-icon {
    color: var(--accent-gold);
    margin-top: 0.25rem;
  }

  .nbu-banner h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .nbu-banner p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .nbu-banner p:last-child {
    margin-bottom: 0;
  }

  .nbu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .nbu-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .nbu-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .nbu-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .nbu-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .nbu-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nbu-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .nbu-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .nbu-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .nbu-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .nbu-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .nbu-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .nbu-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
