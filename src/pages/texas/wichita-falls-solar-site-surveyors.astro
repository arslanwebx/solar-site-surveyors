---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Wichita Falls, TX | Red River Area';
const pageDescription = 'Solar site surveys in Wichita Falls, TX. Managing severe hail history, Oncor service panels, and roof framing across Wichita County and North Texas.';
const canonicalPath = '/texas/wichita-falls-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Wichita Falls' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Wichita Falls, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Wichita Falls, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Wichita Falls, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Hail Damage Roof Assessment',
    'Main Electrical Panel Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How does severe hail history affect solar roof surveys in Wichita Falls?',
    answer: 'Wichita Falls sits in a high-risk severe hail corridor along the Red River. Surveyors examine shingle layers, granule wear, and prior insurance repair patches. We photograph decking condition from accessible attic spaces and inspect rafter attachment zones to ensure the roof can support solar modules without hidden structural deficiencies.'
  },
  {
    question: 'Which utility company serves Wichita Falls solar installations?',
    answer: 'Wichita Falls is located within Oncor Electric Delivery service territory. We photograph the digital meter display, meter enclosure, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for Oncor distributed generation filings.'
  },
  {
    question: 'What electrical panel configurations are common in Wichita Falls homes?',
    answer: 'Homes constructed between the 1950s and 1980s across central Wichita Falls often feature 100-amp, 125-amp, or 150-amp main service panels. The surveyor records busbar ratings, main breaker capacities, and available breaker slots to verify whether a solar backfeed breaker can be installed or if a panel upgrade is needed.'
  },
  {
    question: 'How do detached garages and workshops affect conduit routing?',
    answer: 'Properties with detached outbuildings are common across Wichita County. We map proposed underground or exterior conduit pathways, measure physical distances to the main electrical service, and evaluate wire run logistics to assist engineering teams with accurate line diagrams.'
  },
  {
    question: 'Do your surveyors cover surrounding Red River border communities?',
    answer: 'Yes. Survey dispatches regularly connect Wichita Falls with Burkburnett, Iowa Park, Sheppard AFB, Henrietta, and Holliday.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Wichita Falls, TX</h1>
        <p class="lead">
          Field site documentation across the Red River border region. Managing severe hail history, Oncor electric service equipment, and attic structural framing across Wichita County.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Wichita Falls Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Red River Weather Focus -->
  <section class="section">
    <div class="container">
      <div class="wf-split">
        <div class="wf-text">
          <div class="kicker">Operational Focus</div>
          <h2>Red River Border Operations: Managing Severe Weather and Hail History</h2>
          <p>
            Wichita Falls sits at the northern edge of Texas, directly south of the Red River and the Oklahoma state line. Known for severe continental weather extremes, including frequent springtime hailstorms and intense summer heat, properties in Wichita County demand rigorous physical inspection before solar design work begins.
          </p>
          <p>
            Due to the region's weather history, roofs frequently feature recent shingle replacements, multiple underlayment layers, or hidden decking damage from past storms. Furthermore, established neighborhoods feature brick ranch homes with original 100-amp or 125-amp service equipment and detached garages. If remote CAD engineers receive vague field notes, they are forced to make assumptions that can lead to structural plan comments or installation-day rework.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Wichita Falls project. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your design team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="wf-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Wichita Falls Operating Overview</h3>
          <ul class="wf-spec-list">
            <li>
              <strong>County:</strong>
              <span>Wichita County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Wichita Falls Building Inspection</span>
            </li>
            <li>
              <strong>Environmental Context:</strong>
              <span>Severe hail risk, high wind gusts, wide temperature swings</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>100A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Wichita Falls Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="wf-grid">
        <div class="wf-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="wf-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="wf-card card-technical">
          <h3>Hail History & Roof Condition</h3>
          <p>
            We inspect shingle condition, measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers.
          </p>
        </div>

        <div class="wf-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="wf-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="wf-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">North Texas Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Regional Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="wf-links">
        <a href="/texas/denton-solar-site-surveyors/" class="wf-link-card">
          <h4>Denton Solar Site Surveyors</h4>
          <p>Denton Municipal Electric service data and northern DFW survey coordination directly southeast.</p>
        </a>
        <a href="/texas/abilene-solar-site-surveyors/" class="wf-link-card">
          <h4>Abilene Solar Site Surveyors</h4>
          <p>AEP Texas North territory and Big Country residential framing documentation directly southwest.</p>
        </a>
        <a href="/texas/amarillo-solar-site-surveyors/" class="wf-link-card">
          <h4>Amarillo Solar Site Surveyors</h4>
          <p>Texas Panhandle survey operations and Xcel Energy utility documentation directly northwest.</p>
        </a>
        <a href="/texas/fort-worth-solar-site-surveyors/" class="wf-link-card">
          <h4>Fort Worth Solar Site Surveyors</h4>
          <p>Comprehensive field survey support across western DFW and Tarrant County growth areas.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Wichita Falls Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="wf-faq-list">
        {faqs.map(faq => (
          <div class="wf-faq-item card-technical">
            <h3 class="wf-faq-q">{faq.question}</h3>
            <p class="wf-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Wichita Falls, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Wichita Falls"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .wf-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .wf-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .wf-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .wf-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .wf-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .wf-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .wf-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .wf-spec-list li:last-child {
    border-bottom: none;
  }

  .wf-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .wf-spec-list span {
    color: var(--text-secondary);
  }

  .wf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .wf-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .wf-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .wf-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .wf-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .wf-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .wf-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .wf-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .wf-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .wf-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .wf-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .wf-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .wf-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .wf-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
