---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Corpus Christi, TX';
const pageDescription = 'Solar site surveys in Corpus Christi and the Coastal Bend. TDI wind-load documentation, salt-air corrosion context, and structured field data for EPCs operating in Texas wind zones.';
const canonicalPath = '/texas/corpus-christi-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Corpus Christi' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Corpus Christi, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors — Corpus Christi, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Corpus Christi, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': ['Solar Site Surveys', 'Residential Solar Site Survey', 'Commercial Solar Site Survey'],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'Why do Corpus Christi solar surveys need wind-load documentation?',
    answer: 'Corpus Christi falls within designated TDI wind zones along the Texas coast. The Texas Department of Insurance requires specific structural documentation for building modifications in these zones, including solar installations. Our surveys capture framing data, roof attachment details, and structural condition information that your engineering team needs for wind-load calculations and TDI compliance.'
  },
  {
    question: 'How does salt-air exposure affect solar installations?',
    answer: 'Coastal proximity accelerates corrosion of exposed metal components — racking hardware, conduit, junction boxes, and electrical enclosures. Our surveys document the property distance from the coast, prevailing wind direction, existing corrosion on outdoor equipment, and environmental conditions that affect material selection for the system design.'
  },
  {
    question: 'What areas of the Coastal Bend do you cover?',
    answer: 'Our coverage spans Corpus Christi, Portland, Rockport, Aransas Pass, Port Aransas, Robstown, and surrounding Nueces and San Patricio County areas. Submit the project address for specific confirmation.'
  },
  {
    question: 'Do you document hurricane-related structural considerations?',
    answer: 'Our surveyors document visible roof condition, framing type and spacing, decking attachment, and any evidence of prior storm repair. This information helps your structural engineer assess whether the roof system can support solar array loads under the wind-speed ratings required by the local building code.'
  },
  {
    question: 'How do I submit a project for a Corpus Christi survey?',
    answer: 'Contact our operations desk via WhatsApp with the property address, project scope, and any custom requirements. We confirm surveyor availability and schedule the field visit.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <!-- Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Corpus Christi, TX</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 900px;">
          Solar installations along the Texas coast face conditions that inland projects do not — TDI wind-load requirements, salt-air corrosion, and hurricane-zone structural considerations. Our Corpus Christi surveys are structured to capture the environmental and structural data that coastal solar projects demand.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="cc-schedule-btn">
            <span>Schedule a Corpus Christi Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Coastal Wind Zones Editorial -->
  <section class="section">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Wind Zone Context</div>
        <h2>Coastal Solar: Wind Zones and What They Mean for Your Survey</h2>
      </div>
      <div class="editorial-prose">
        <p>
          The Texas Department of Insurance designates wind zones along the Gulf Coast that impose specific structural documentation requirements for building modifications — including solar panel installations. Corpus Christi and the surrounding Coastal Bend fall within these designated zones, which means the permitting process requires evidence that the existing roof structure can support additional loads under the area's design wind speeds.
        </p>
        <p>
          For solar EPCs, this translates to a more detailed survey scope than a typical inland project. Your structural engineer needs precise framing data — rafter or truss dimensions, spacing, span, decking thickness, and attachment details — not just general photos. Our surveyors document this information during the field visit so the engineering review can proceed without requesting supplemental data or a return trip.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: TDI Wind-Load Feature -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header center">
        <div class="kicker" style="color: var(--accent-gold);">Compliance</div>
        <h2 style="color: #FFFFFF;">TDI Wind-Load Framing Documentation</h2>
        <p class="lead" style="color: #9FB3C8;">Structural field data aligned with Texas coastal building requirements.</p>
      </div>

      <div class="tdi-grid">
        <div class="tdi-item">
          <div class="tdi-label">Rafter / Truss Sizing</div>
          <p>Depth, width, and member type documented with measurement tools and labeled photos</p>
        </div>
        <div class="tdi-item">
          <div class="tdi-label">Spacing & Span</div>
          <p>On-center spacing and clear span between supports — data points for wind-uplift calculations</p>
        </div>
        <div class="tdi-item">
          <div class="tdi-label">Decking Attachment</div>
          <p>Decking material, thickness, fastener type where visible, and general attachment condition</p>
        </div>
        <div class="tdi-item">
          <div class="tdi-label">Roof-to-Wall Connection</div>
          <p>Hurricane strap or clip presence, toe-nail connections, and visible connection quality</p>
        </div>
        <div class="tdi-item">
          <div class="tdi-label">Roof Material & Pitch</div>
          <p>Material identification, pitch readings per plane, and overall roof condition assessment</p>
        </div>
        <div class="tdi-item">
          <div class="tdi-label">Prior Storm Repair</div>
          <p>Visible evidence of repair or replacement — different materials, patches, or inconsistent framing</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Survey Scope (4-card grid) -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Complete Scope</div>
        <h2>Beyond Wind-Load: Full Survey Documentation</h2>
        <p class="lead">Every Corpus Christi survey also captures standard solar field data.</p>
      </div>

      <div class="scope-grid">
        <div class="scope-card card-technical">
          <h3>Electrical Service</h3>
          <p>Main panel, bus rating, main breaker, available breaker slots, grounding, and meter socket configuration documented for design and interconnection applications.</p>
        </div>
        <div class="scope-card card-technical">
          <h3>Battery & ESS Areas</h3>
          <p>Proposed equipment wall, NFPA 855 clearance measurements, pathway to main panel, and environmental notes — including salt-air exposure considerations.</p>
        </div>
        <div class="scope-card card-technical">
          <h3>Property & Exterior</h3>
          <p>Elevation photos, equipment locations, conduit routing options, coastal distance context, and access notes for the design and engineering team.</p>
        </div>
        <div class="scope-card card-technical">
          <h3>Photo Documentation</h3>
          <p>Categorized HD photo package labeled by scope area. Coastal surveys include additional environmental context photos showing exposure direction and proximity to salt water.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Salt Air & Corrosion -->
  <section class="section">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Environmental Factor</div>
        <h2>Salt Air, Corrosion, and Equipment Placement</h2>
      </div>
      <div class="editorial-prose">
        <p>
          Properties within a few miles of the Gulf Coast are exposed to salt-laden air that accelerates corrosion of metal components. For solar installations, this affects racking hardware, conduit, junction boxes, disconnects, and any exposed electrical enclosures. Design teams working on Coastal Bend projects need to know the property's coastal proximity and prevailing wind exposure to specify appropriate materials.
        </p>
        <p>
          Our surveys document the distance from the shoreline, wind direction indicators, existing corrosion on outdoor equipment (HVAC units, electrical panels, metal fencing), and the environmental conditions of proposed equipment locations. This information helps your engineering team make informed material specifications without requiring a separate site evaluation.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Specs -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Operations</div>
        <h2>Corpus Christi Survey Specifications</h2>
      </div>
      <div class="table-wrap card-technical">
        <table class="specs-table">
          <tbody>
            <tr>
              <td><strong>Coverage Area</strong></td>
              <td>Corpus Christi, Portland, Rockport, Aransas Pass, Port Aransas, Robstown, and Nueces / San Patricio Counties</td>
            </tr>
            <tr>
              <td><strong>Wind Zone</strong></td>
              <td>TDI-designated coastal wind zone — enhanced structural documentation included</td>
            </tr>
            <tr>
              <td><strong>Environmental</strong></td>
              <td>Gulf Coast salt-air exposure — corrosion context and coastal proximity documented</td>
            </tr>
            <tr>
              <td><strong>Deliverables</strong></td>
              <td>CAD-ready photo set, structural framing data, measurement log, categorized documentation</td>
            </tr>
            <tr>
              <td><strong>Compliance Reference</strong></td>
              <td>NEC 2020/2023, NFPA 855, TDI wind-load framing requirements, local building codes</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">FAQ</div>
        <h2>Corpus Christi Survey Questions</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTASection
    title="Need a Coastal Survey in Corpus Christi?"
    subtitle="Contact our operations desk to coordinate surveyor availability along the Texas Gulf Coast and Coastal Bend."
    primaryCtaText="Schedule in Corpus Christi"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Hub"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: var(--space-4);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  .narrow-content { max-width: 860px; }

  .editorial-prose p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .editorial-prose p:last-child { margin-bottom: 0; }

  /* TDI Grid (dark section) */
  .tdi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    max-width: 1056px;
    margin: 0 auto;
  }

  .tdi-item {
    padding: var(--space-5);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
  }

  .tdi-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  .tdi-item p {
    font-size: 0.8375rem;
    line-height: 1.55;
    color: #9FB3C8;
  }

  /* Scope Grid (4-card) */
  .scope-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    max-width: 990px;
    margin: 0 auto;
  }

  .scope-card {
    padding: var(--space-6);
  }

  .scope-card h3 {
    font-size: 1.0625rem;
    color: var(--primary);
    margin-bottom: var(--space-2);
  }

  .scope-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Specs Table */
  .table-wrap {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 990px;
    margin: 0 auto;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] { border-color: var(--accent-gold); }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .faq-item[open] .faq-question::after { content: '−'; }

  .faq-answer { padding: 0 var(--space-6) var(--space-5); }

  .faq-answer p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .tdi-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .tdi-grid { grid-template-columns: 1fr; }
    .scope-grid { grid-template-columns: 1fr; }
  }
</style>
