---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Baytown, TX | Field Surveys';
const pageDescription = 'Solar site surveys in Baytown, TX. Documenting exterior service equipment, coastal bay environment conditions, and roof framing across East Harris County.';
const canonicalPath = '/texas/baytown-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Baytown' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Baytown, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Baytown, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Baytown, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Coastal Bay Environmental Survey',
    'Main Electrical Service Panel Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do coastal bay conditions affect Baytown solar site surveys?',
    answer: 'Sited on Galveston Bay and the Houston Ship Channel, Baytown experiences elevated humidity and marine atmosphere. Our surveyors examine exterior electrical enclosures, conduit disconnects, and meter bases for signs of corrosion or environmental wear. We photograph equipment data plates and structural framing members to assist engineers in selecting appropriate corrosion-resistant hardware.'
  },
  {
    question: 'Which utility company serves Baytown solar installations?',
    answer: 'Baytown is served by CenterPoint Energy. We photograph the digital meter display, meter enclosure, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for CenterPoint distributed generation filings.'
  },
  {
    question: 'How do county boundaries affect Baytown solar permitting?',
    answer: 'Baytown spans Harris and Chambers counties. While the City of Baytown Building Services Division processes municipal permits, county tax parcel records differ depending on property location. Our survey captures exact property boundaries and utility meter details to ensure permit submittals match municipal records without administrative delays.'
  },
  {
    question: 'What roof and structural data is collected in Baytown neighborhoods?',
    answer: 'We measure pitch angles per roof plane, identify roofing material condition, map all vents and flashings, and record attic rafter or truss spacing with measurement photos to support structural review.'
  },
  {
    question: 'Do your surveyors cover surrounding East Harris and Chambers County markets?',
    answer: 'Yes. Survey dispatches regularly connect Baytown with Mont Belvieu, La Porte, Highlands, Crosby, and Pasadena.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Baytown, TX</h1>
        <p class="lead">
          Field site documentation across East Harris and Chambers counties. Documenting coastal bay environmental factors, CenterPoint service equipment, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Baytown</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Coastal Bay Focus Section -->
  <section class="section">
    <div class="container">
      <div class="bay-split">
        <div class="bay-text">
          <div class="kicker">Operational Focus</div>
          <h2>East Harris and Chambers County: Industrial and Coastal Environment Realities</h2>
          <p>
            Baytown occupies an important position along the eastern curve of Galveston Bay and the Houston Ship Channel. Combining industrial employment centers with residential subdivisions across Harris and Chambers counties, Baytown presents specific environmental and logistical considerations for solar operations managers.
          </p>
          <p>
            The coastal bay environment exposes exterior electrical equipment to persistent humidity and salt mist. Outside main panels, disconnect switches, and service entrance masts frequently show signs of oxidation or weathered labels. If a field surveyor provides poor-quality photos, remote CAD engineers cannot determine whether existing equipment can safely accept a solar interconnection or if a panel upgrade is warranted.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Baytown project. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your engineering team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="bay-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Baytown Operating Overview</h3>
          <ul class="bay-spec-list">
            <li>
              <strong>Counties:</strong>
              <span>Harris County, Chambers County overlap</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>CenterPoint Energy</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Baytown Building Services</span>
            </li>
            <li>
              <strong>Housing Diversity:</strong>
              <span>Established brick ranch homes, modern subdivisions</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>125A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Baytown Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="bay-grid">
        <div class="bay-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="bay-card card-technical">
          <h3>CenterPoint Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete CenterPoint interconnection filing.
          </p>
        </div>

        <div class="bay-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="bay-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="bay-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="bay-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">East Houston Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Greater Houston Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="bay-links">
        <a href="/texas/pasadena-solar-site-surveyors/" class="bay-link-card">
          <h4>Pasadena Solar Site Surveyors</h4>
          <p>Southeast Houston residential and industrial corridor survey coordination directly west.</p>
        </a>
        <a href="/texas/league-city-solar-site-surveyors/" class="bay-link-card">
          <h4>League City Solar Site Surveyors</h4>
          <p>Clear Lake and coastal transition area survey operations directly southwest.</p>
        </a>
        <a href="/texas/pearland-solar-site-surveyors/" class="bay-link-card">
          <h4>Pearland Solar Site Surveyors</h4>
          <p>Multi-county suburban survey coordination and dual CenterPoint versus TNMP utility data.</p>
        </a>
        <a href="/texas/houston-solar-site-surveyors/" class="bay-link-card">
          <h4>Houston Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Greater Houston metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Baytown Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="bay-faq-list">
        {faqs.map(faq => (
          <div class="bay-faq-item card-technical">
            <h3 class="bay-faq-q">{faq.question}</h3>
            <p class="bay-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Baytown, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Baytown"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .bay-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .bay-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .bay-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .bay-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .bay-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .bay-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bay-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .bay-spec-list li:last-child {
    border-bottom: none;
  }

  .bay-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .bay-spec-list span {
    color: var(--text-secondary);
  }

  .bay-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .bay-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .bay-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .bay-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .bay-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .bay-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .bay-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .bay-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .bay-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .bay-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bay-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .bay-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .bay-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .bay-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
