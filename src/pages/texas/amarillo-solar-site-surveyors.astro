---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Amarillo, TX | Panhandle Surveys';
const pageDescription = 'Solar site surveys in Amarillo, TX. Operating under Xcel Energy (SPS) standards, high-wind Panhandle roof planes, and Potter-Randall county lines.';
const canonicalPath = '/texas/amarillo-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Amarillo' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Amarillo, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Amarillo, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Amarillo, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Non-ERCOT Xcel Utility Solar Surveys',
    'Residential Solar Site Survey',
    'Panhandle Wind & Snow Roof Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How does Xcel Energy (SPS) affect solar interconnection in Amarillo?',
    answer: 'Amarillo does not operate in the ERCOT market. Electric service is provided by Southwestern Public Service (SPS), an operating company of Xcel Energy under the Southwest Power Pool (SPP) regional reliability grid. Xcel Energy maintains its own distributed generation interconnection manual, specific bi-directional meter base rules, and technical review timelines. Our surveyors record the exact Xcel meter tags and exterior disconnect specifications to support accurate submittals.'
  },
  {
    question: 'How do Panhandle wind and winter snow loads impact structural surveys?',
    answer: 'Amarillo experiences severe wind speeds and measurable winter snow loads. Survey packages document roof decking thickness, rafter member sizes, truss spacing, and existing bracing with physical measurement photos. This provides structural engineering teams with verified physical data to calculate proper attachment spacing.'
  },
  {
    question: 'How do county boundaries operate across Amarillo?',
    answer: 'Amarillo spans Potter and Randall counties. While the City of Amarillo Building Safety Department processes municipal building permits, county recordings and tax parcel data differ depending on location. Our survey captures exact property boundaries and utility meter details to ensure permit submittals match municipal records without administrative delays.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do your surveyors cover surrounding Texas Panhandle communities?',
    answer: 'Yes. Survey dispatches regularly connect Amarillo with Canyon, Bushland, Borger, Dumas, and Hereford.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Amarillo, TX</h1>
        <p class="lead">
          Field site documentation across the Texas Panhandle. Operating under Xcel Energy (SPS) standards, documenting high-wind roof plane geometry, and inspecting attic structural framing across Potter and Randall counties.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Amarillo Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Xcel Energy Non-ERCOT Alert -->
  <section class="section">
    <div class="container">
      <div class="xcel-banner card-technical">
        <div class="xcel-header">
          <div class="xcel-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <div class="kicker">Critical Utility Distinction</div>
            <h2>Non-ERCOT Grid: Operating Under Xcel Energy (SPS) Interconnection Rules</h2>
          </div>
        </div>
        <p>
          Amarillo does not operate in the ERCOT electric grid. Electric service across Potter and Randall counties is provided by Southwestern Public Service (SPS), a regulated operating company of Xcel Energy connected to the Southwest Power Pool (SPP) regional grid.
        </p>
        <p>
          Contractors submitting solar plan sets based on Oncor or CenterPoint standards face immediate interconnection delays. Xcel Energy enforces specific distributed generation applications, distinct bi-directional meter base requirements, and external manual disconnect rules. Our survey packages focus heavily on collecting clear photographs of the Xcel meter base, service entrance mast, utility tags, and existing disconnect equipment. This verification ensures your interconnection team files the appropriate paperwork without back-and-forth utility inquiries.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Inspection Scope</div>
        <h2>Amarillo Site Survey Package Deliverables</h2>
        <p class="lead">
          Comprehensive physical data prepared to support engineering review and City of Amarillo building permits.
        </p>
      </div>

      <div class="xcel-grid">
        <div class="xcel-card card-technical">
          <h3>Xcel Energy Electric Meter Equipment</h3>
          <p>
            We photograph the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Xcel Energy interconnection filing.
          </p>
        </div>

        <div class="xcel-card card-technical">
          <h3>Main Electrical Service Panels</h3>
          <p>
            The survey records busbar ratings, main breaker capacity, manufacturer data plates, and circuit breaker directories, confirming whether the electrical panel can accept a solar backfeed breaker.
          </p>
        </div>

        <div class="xcel-card card-technical">
          <h3>High-Wind & Snow Load Framing</h3>
          <p>
            We document rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs to support structural engineering review.
          </p>
        </div>

        <div class="xcel-card card-technical">
          <h3>Roof Planes & Penetrations</h3>
          <p>
            We measure pitch angles, record roof plane azimuth, and map plumbing vents, attic fans, exhaust flues, and skylights to verify usable array boundaries within local fire code setbacks.
          </p>
        </div>

        <div class="xcel-card card-technical">
          <h3>Battery Backup & Inverter Clearances</h3>
          <p>
            For ESS projects, we record available wall space in attached garages or exterior side yards, verifying clearances from windows, doors, and gas meters to support code-compliant battery placement.
          </p>
        </div>

        <div class="xcel-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Full elevation photos document site access, fence gates, air conditioning equipment, and ladder setup areas to assist installation managers with build-day staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Panhandle Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Panhandle Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="xcel-links">
        <a href="/texas/lubbock-solar-site-surveyors/" class="xcel-link-card">
          <h4>Lubbock Solar Site Surveyors</h4>
          <p>LP&L retail choice market transition and South Plains residential survey coordination directly south.</p>
        </a>
        <a href="/texas/wichita-falls-solar-site-surveyors/" class="xcel-link-card">
          <h4>Wichita Falls Solar Site Surveyors</h4>
          <p>Red River border residential survey coordination and severe hail history documentation directly southeast.</p>
        </a>
        <a href="/texas/midland-solar-site-surveyors/" class="xcel-link-card">
          <h4>Midland Solar Site Surveyors</h4>
          <p>Permian Basin energy hub survey operations and Oncor service data further south.</p>
        </a>
        <a href="/texas/abilene-solar-site-surveyors/" class="xcel-link-card">
          <h4>Abilene Solar Site Surveyors</h4>
          <p>AEP Texas North territory and Big Country residential framing documentation directly south.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Amarillo Solar Survey Operations</h2>
        <p class="lead">Essential details for solar contractors and project coordinators.</p>
      </div>

      <div class="xcel-faq-list">
        {faqs.map(faq => (
          <div class="xcel-faq-item card-technical">
            <h3 class="xcel-faq-q">{faq.question}</h3>
            <p class="xcel-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in Amarillo, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and ensure your field package meets Xcel Energy requirements."
    primaryCtaText="Schedule Survey in Amarillo"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .xcel-banner {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 6px solid var(--accent-gold);
    max-width: 1000px;
    margin: 0 auto;
  }

  .xcel-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .xcel-icon {
    color: var(--accent-gold);
    margin-top: 0.25rem;
  }

  .xcel-banner h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .xcel-banner p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .xcel-banner p:last-child {
    margin-bottom: 0;
  }

  .xcel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .xcel-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .xcel-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .xcel-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .xcel-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .xcel-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .xcel-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .xcel-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .xcel-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .xcel-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .xcel-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .xcel-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .xcel-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
