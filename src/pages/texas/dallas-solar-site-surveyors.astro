---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Dallas, TX';
const pageDescription = 'Solar site surveys across the Dallas metro and DFW Metroplex. Multi-jurisdiction field documentation for EPCs, solar installers, and design teams operating in Oncor territory.';
const canonicalPath = '/texas/dallas-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Dallas' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in the Dallas area.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors — Dallas, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Dallas, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': ['Solar Site Surveys', 'Residential Solar Site Survey', 'Commercial Solar Site Survey'],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'Why does multi-jurisdiction permitting matter for Dallas solar surveys?',
    answer: 'The DFW Metroplex includes dozens of incorporated cities — each with its own building department and permit requirements. A survey in Plano may need different documentation detail than one in Mesquite or Richardson. We capture comprehensive field data that covers the common requirements across these jurisdictions.'
  },
  {
    question: 'What Oncor-related documentation do you capture?',
    answer: 'Our surveys document meter socket type, service entrance configuration, utility disconnect location, and metering panel details. This information is used during the Oncor interconnection application process that most DFW solar projects require.'
  },
  {
    question: 'Do you survey in suburbs like Frisco, McKinney, or Allen?',
    answer: 'Yes. Our surveyor coordination covers the full DFW Metroplex footprint including Collin County suburbs (Frisco, McKinney, Allen, Prosper), southern Dallas County, and eastern Tarrant County overlap areas.'
  },
  {
    question: 'How do I submit a survey for a Dallas-area project?',
    answer: 'Send the property address, project scope, and any custom checklist requirements to our operations desk via WhatsApp. We confirm coverage and schedule the field visit based on surveyor availability.'
  },
  {
    question: 'What does a typical DFW site survey include?',
    answer: 'Roof geometry and condition, accessible attic framing documentation, main electrical service details, battery/ESS area measurements, property exterior photos, and a categorized photo package organized for your design workflow.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer }
  }))
};

// Jurisdictions list for content
const jurisdictions = [
  'City of Dallas', 'Plano', 'Richardson', 'Garland', 'Mesquite',
  'Carrollton', 'Farmers Branch', 'Irving', 'Grand Prairie',
  'Frisco', 'McKinney', 'Allen', 'Prosper', 'Rockwall'
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <!-- Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Dallas, TX</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 900px;">
          The DFW Metroplex spans 13 counties, 200+ municipalities, and dozens of permitting jurisdictions — each with its own building department, review timelines, and documentation expectations. Our survey coordination produces consistent field packages that work across the Metroplex's fragmented AHJ landscape.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="dallas-schedule-btn">
            <span>Schedule a Dallas Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Multi-Jurisdiction Context -->
  <section class="section">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">AHJ Complexity</div>
        <h2>Navigating Multi-Jurisdiction Permitting in DFW</h2>
      </div>
      <div class="editorial-prose">
        <p>
          A solar company operating in Dallas rarely works in just one jurisdiction. Monday's project could be in Richardson (Dallas County), Tuesday's in McKinney (Collin County), and Wednesday's in Grand Prairie (shared between Dallas and Tarrant counties). Each city has its own building official, its own permit application portal, and its own expectations for what supporting documentation should accompany the application.
        </p>
        <p>
          This means the field data captured at the property needs to be thorough enough to satisfy the strictest reviewer in the Metroplex. A survey that passes muster in one city but lacks a detail required by another creates a costly revision cycle. Our survey scope is designed around comprehensive capture: if the information could be needed by any DFW-area building department, we collect it on the first visit.
        </p>
      </div>

      <div class="jurisdiction-strip">
        <span class="juris-label">Common DFW Permitting Jurisdictions:</span>
        <div class="juris-tags">
          {jurisdictions.map(j => (
            <span class="juris-tag">{j}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Section: 6-Card Technical Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Documentation Scope</div>
        <h2>Comprehensive Field Capture for DFW Solar Projects</h2>
        <p class="lead">Six categories of field data in every survey package.</p>
      </div>

      <div class="tech-grid">
        <div class="tech-card card-technical">
          <div class="tc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Roof Planes & Geometry</h3>
          <p>Pitch readings, plane dimensions, ridge and eave lengths, material identification, condition notes, and available mounting surface for array design.</p>
        </div>
        <div class="tech-card card-technical">
          <div class="tc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <h3>Attic Framing Access</h3>
          <p>Rafter or truss sizing, spacing, span, direction, decking observations — documented where safe attic access is available.</p>
        </div>
        <div class="tech-card card-technical">
          <div class="tc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Main Electrical Panel</h3>
          <p>Panel manufacturer, bus rating, main breaker, available breaker slots, grounding electrode, and interior labeling when safely accessible.</p>
        </div>
        <div class="tech-card card-technical">
          <div class="tc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
          </div>
          <h3>Meter & Utility Interface</h3>
          <p>Meter socket type, service entrance configuration, utility disconnect, and Oncor meter details for interconnection documentation.</p>
        </div>
        <div class="tech-card card-technical">
          <div class="tc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3>Battery & ESS Layout</h3>
          <p>Proposed wall location, clearance from doors, windows, gas equipment, pathway to main panel, and environmental suitability notes.</p>
        </div>
        <div class="tech-card card-technical">
          <div class="tc-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </div>
          <h3>Organized Photo Package</h3>
          <p>Categorized HD photos labeled by scope area: roof, attic, electrical, exterior, obstructions — ready for CAD reference and permit applications.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Oncor Interconnection -->
  <section class="section section-dark">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker" style="color: var(--accent-gold);">Utility Documentation</div>
        <h2 style="color: #FFFFFF;">Oncor Interconnection and Meter Documentation</h2>
      </div>
      <div class="editorial-prose" style="color: #9FB3C8;">
        <p>
          Most DFW solar projects interconnect through Oncor — the transmission and distribution utility serving the Metroplex. Oncor's distributed generation application requires specific service entrance and metering information that your engineering team needs from the field visit.
        </p>
        <p>
          Our surveys capture meter socket configuration, service entrance ratings, utility disconnect presence and location, and any existing generation equipment — the data points that Oncor's interconnection review team evaluates. Having this information documented accurately during the initial site visit prevents application delays and return trips.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: How It Works (5-step) -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Workflow</div>
        <h2>Dallas Survey Process: Five Steps</h2>
      </div>

      <div class="workflow-steps">
        <div class="wf-step">
          <div class="wf-num">01</div>
          <div class="wf-body">
            <h3>Project Intake</h3>
            <p>You send the property address, scope, and any custom survey form or checklist requirements.</p>
          </div>
        </div>
        <div class="wf-step">
          <div class="wf-num">02</div>
          <div class="wf-body">
            <h3>Surveyor Assignment</h3>
            <p>A local DFW-area surveyor is assigned based on location, scope, and scheduling availability.</p>
          </div>
        </div>
        <div class="wf-step">
          <div class="wf-num">03</div>
          <div class="wf-body">
            <h3>On-Site Documentation</h3>
            <p>All measurements, photos, and field notes are captured following the agreed survey scope.</p>
          </div>
        </div>
        <div class="wf-step">
          <div class="wf-num">04</div>
          <div class="wf-body">
            <h3>Desk QA Review</h3>
            <p>The field package is reviewed for completeness and consistency before release to your team.</p>
          </div>
        </div>
        <div class="wf-step">
          <div class="wf-num">05</div>
          <div class="wf-body">
            <h3>Package Delivery</h3>
            <p>Organized, verified deliverables are sent to your design team — ready for CAD and permitting.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-warm">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Common Questions</div>
        <h2>Dallas–Fort Worth Survey FAQ</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTASection
    title="Ready to Schedule a Dallas-Area Survey?"
    subtitle="Contact our operations desk to confirm surveyor availability across the DFW Metroplex and coordinate your next field documentation project."
    primaryCtaText="Schedule in Dallas"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Hub"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
    text-align: center;
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: var(--space-4);
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  .narrow-content { max-width: 860px; }

  .editorial-prose p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .editorial-prose p:last-child { margin-bottom: 0; }

  /* Jurisdiction Strip */
  .jurisdiction-strip {
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-6);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
  }

  .juris-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--primary);
    display: block;
    margin-bottom: var(--space-3);
  }

  .juris-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .juris-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--primary);
    background: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
  }

  /* 6-card tech grid */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .tech-card {
    padding: var(--space-6);
  }

  .tc-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--accent-gold-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
  }

  .tech-card h3 {
    font-size: 1rem;
    color: var(--primary);
    margin-bottom: var(--space-2);
  }

  .tech-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Workflow Steps (numbered list) */
  .workflow-steps {
    max-width: 770px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .wf-step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }

  .wf-num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.75rem;
    color: var(--accent-gold);
    line-height: 1;
    flex-shrink: 0;
    min-width: 40px;
  }

  .wf-body h3 {
    font-size: 1rem;
    color: var(--primary);
    margin-bottom: var(--space-1);
  }

  .wf-body p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] { border-color: var(--accent-gold); }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .faq-item[open] .faq-question::after { content: '−'; }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-5);
  }

  .faq-answer p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .tech-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .tech-grid { grid-template-columns: 1fr; }
  }
</style>
