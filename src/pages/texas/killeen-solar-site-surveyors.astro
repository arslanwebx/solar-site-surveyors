---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Killeen, TX | Central Texas';
const pageDescription = 'Solar site surveys in Killeen, TX. Documenting Oncor service panels, attic framing, and roof plane geometry across Bell County and the Fort Cavazos corridor.';
const canonicalPath = '/texas/killeen-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Killeen' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Killeen, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Killeen, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Killeen, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Main Electrical Service Inspection',
    'Roof Plane Measurement'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do City of Killeen building inspections impact solar permits?',
    answer: 'The City of Killeen Building Inspections department requires code-compliant single-line electrical diagrams, manufacturer equipment spec sheets, and clear structural mounting details. Our survey packages record clear electrical data plate photos and physical framing measurements to help your design team pass permit review promptly.'
  },
  {
    question: 'Which electric utility serves Killeen solar installations?',
    answer: 'Killeen is located within Oncor Electric Delivery service territory. We photograph the meter enclosure, digital display, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for Oncor distributed generation filings.'
  },
  {
    question: 'What electrical panel configurations are common in Killeen homes?',
    answer: 'Housing stock across Killeen built between the 1970s and 2000s frequently features 150-amp or 200-amp main service equipment. Our surveyors photograph panel labels, bus ratings, main breaker capacities, and open breaker slots to confirm whether a solar backfeed breaker can be installed.'
  },
  {
    question: 'What roof types and framing conditions are typical in Killeen?',
    answer: 'Most single-family homes feature composition shingle roofs on low-to-medium pitch gable and hip planes. We document rafter or truss dimensions, center-to-center spacing, purlin bracing, and roof decking thickness with measurement photos to support structural review.'
  },
  {
    question: 'Do you cover projects across the greater Bell County and Fort Cavazos corridor?',
    answer: 'Yes. Survey dispatches regularly connect Killeen with Harker Heights, Copperas Cove, Nolanville, Belton, and Temple.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Killeen, TX</h1>
        <p class="lead">
          Field site documentation across Killeen and the Fort Cavazos corridor. Standardizing electrical panel verification, roof geometry, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Killeen</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Central Texas Corridor Focus -->
  <section class="section">
    <div class="container">
      <div class="kil-split">
        <div class="kil-text">
          <div class="kicker">Operational Focus</div>
          <h2>Bell County Growth: High-Turnover Residential Solar Deployment</h2>
          <p>
            Killeen anchors western Bell County, serving as a primary residential center for personnel and families connected to Fort Cavazos. For solar installation companies, Killeen represents an active single-family residential market with extensive subdivision development built from the late 1970s through the 2010s.
          </p>
          <p>
            Due to the suburban expansion patterns of the region, housing styles range from compact single-story ranch homes to expansive two-story residences. While service equipment is generally standardized under Oncor Electric Delivery, variations in panel bus ratings and crowded breaker schedules require precise photographic documentation. If remote CAD engineers work from incomplete field notes, permit packages may misrepresent electrical capacity, leading to plan review delays.
          </p>
          <p>
            Our survey coordination provides verified physical data for every Killeen project. We document electrical bus ratings, record attic rafter dimensions, map roof plane boundaries, and verify Oncor meter equipment, ensuring your design department has the information needed to draft permit-ready solar plan sets.
          </p>
        </div>
        <div class="kil-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Killeen Operating Overview</h3>
          <ul class="kil-spec-list">
            <li>
              <strong>County:</strong>
              <span>Bell County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Killeen Building Inspections</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Single-story suburban tracts, two-story production homes</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>150A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Killeen Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="kil-grid">
        <div class="kil-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="kil-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="kil-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="kil-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="kil-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="kil-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Central Texas Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Central Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="kil-links">
        <a href="/texas/temple-solar-site-surveyors/" class="kil-link-card">
          <h4>Temple Solar Site Surveyors</h4>
          <p>Eastern Bell County medical corridor survey coordination and framing documentation directly east.</p>
        </a>
        <a href="/texas/waco-solar-site-surveyors/" class="kil-link-card">
          <h4>Waco Solar Site Surveyors</h4>
          <p>Historic university-area housing and suburban roof plane documentation directly northeast.</p>
        </a>
        <a href="/texas/round-rock-solar-site-surveyors/" class="kil-link-card">
          <h4>Round Rock Solar Site Surveyors</h4>
          <p>High-density Williamson County tech corridor survey coordination directly south.</p>
        </a>
        <a href="/texas/austin-solar-site-surveyors/" class="kil-link-card">
          <h4>Austin Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Austin-Round Rock metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Killeen Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="kil-faq-list">
        {faqs.map(faq => (
          <div class="kil-faq-item card-technical">
            <h3 class="kil-faq-q">{faq.question}</h3>
            <p class="kil-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Killeen, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Killeen"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .kil-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .kil-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .kil-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .kil-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .kil-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .kil-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .kil-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .kil-spec-list li:last-child {
    border-bottom: none;
  }

  .kil-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .kil-spec-list span {
    color: var(--text-secondary);
  }

  .kil-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .kil-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .kil-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .kil-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .kil-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .kil-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .kil-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .kil-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .kil-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .kil-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .kil-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .kil-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .kil-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .kil-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
