---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Grand Prairie, TX | Mid-Cities';
const pageDescription = 'Solar site surveys in Grand Prairie, TX. Bridging Dallas and Tarrant counties with property-specific electrical service, roof plane, and attic documentation.';
const canonicalPath = '/texas/grand-prairie-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Grand Prairie' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Grand Prairie, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Grand Prairie, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Grand Prairie, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Main Panel Bus Rating Verification',
    'Attic Rafter Measurement'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do county boundaries affect Grand Prairie solar permits?',
    answer: 'Grand Prairie spans Dallas, Tarrant, and Ellis counties. While the City of Grand Prairie Building Inspections department handles municipal building and electrical permits, county recording records and tax parcels may differ. Our survey captures the exact street address, parcel coordinates, and utility meter details to ensure permit applications match municipal records.'
  },
  {
    question: 'Which utility company serves Grand Prairie solar projects?',
    answer: 'Grand Prairie is primarily served by Oncor Electric Delivery. We photograph the meter enclosure, digital display, meter number, and main service disconnect to provide complete documentation for your Oncor distributed generation interconnection application.'
  },
  {
    question: 'What roof and structural data is collected in Grand Prairie?',
    answer: 'We measure pitch per roof plane, identify roofing material condition, map all vents and flashings, and record attic rafter or truss spacing with measurement photos to support structural review.'
  },
  {
    question: 'Can you survey battery backup locations in attached garages?',
    answer: 'Yes. The surveyor records available wall dimensions, notes clearances to garage entry doors, windows, and water heaters, and evaluates conduit routing to the main electrical panel.'
  },
  {
    question: 'Do you provide survey dispatches across the broader Mid-Cities area?',
    answer: 'Yes. Survey dispatches regularly connect Grand Prairie with Arlington, Irving, Mansfield, and western Dallas.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Grand Prairie, TX</h1>
        <p class="lead">
          Coordinated site surveys across the heart of the DFW Mid-Cities. Bridging Dallas and Tarrant County jurisdictions with standardized electrical, roof, and structural field data.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Grand Prairie</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mid-Cities Positioning Section -->
  <section class="section">
    <div class="container">
      <div class="gp-container">
        <div class="kicker">Operational Geometry</div>
        <h2>Bridging the Dallas and Fort Worth Operations Gap</h2>
        <p>
          Grand Prairie occupies a strategic position directly between Dallas and Fort Worth along the I-20, I-30, and SH-360 corridors. For solar contractors operating across the metroplex, Grand Prairie represents a high-volume installation corridor where properties span across Dallas, Tarrant, and Ellis county lines.
        </p>
        <p>
          Because Grand Prairie sits between two major metropolitan centers, installation companies frequently dispatch crews from opposite sides of the metroplex. When field survey packages lack consistency, project coordinators face confusion over municipal permit submittals and utility meter placement.
        </p>
        <p>
          Our surveyor coordination provides a reliable field presence. We collect standardized high-resolution photo packages, verify electrical service bus ratings, record attic rafter dimensions, and measure battery storage clearances, ensuring your engineering team receives the data needed to produce permit-ready plan sets.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Inspection Deliverables</div>
        <h2>Field Data That Keeps Mid-Cities Solar Projects Moving</h2>
        <p class="lead">
          Structured documentation designed for solar CAD drafting and Oncor interconnection filing.
        </p>
      </div>

      <div class="gp-grid">
        <div class="gp-card card-technical">
          <h3>Main Electrical Service Verification</h3>
          <p>
            We capture detailed macro photos of the main service panel, manufacturer label, busbar rating, main breaker capacity, and circuit breaker directory, verifying open spaces for solar backfeed.
          </p>
        </div>

        <div class="gp-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the Oncor meter enclosure, digital display, meter badge number, service drop or underground lateral, and existing exterior disconnect equipment.
          </p>
        </div>

        <div class="gp-card card-technical">
          <h3>Roof Pitch & Usable Plane Geometry</h3>
          <p>
            We measure pitch angles on each roof plane, identify roofing material condition, and map all vents, skylights, and flashings to ensure modules are placed within code-compliant setbacks.
          </p>
        </div>

        <div class="gp-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records framing member dimensions, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="gp-card card-technical">
          <h3>Battery & ESS Wall Clearances</h3>
          <p>
            We record available wall dimensions in attached garages or exterior side yards, verifying clearances from windows, doors, and gas meters to support code-compliant battery placement.
          </p>
        </div>

        <div class="gp-card card-technical">
          <h3>Exterior Pathways & Elevations</h3>
          <p>
            Four-corner property elevation photos establish site access, fence gates, air conditioning units, and ladder staging areas to support safe installation logistics.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Mid-Cities Operations</div>
        <h2>Connected Survey Coverage Across Surrounding DFW Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with the same reliable documentation standards.
        </p>
      </div>

      <div class="gp-links">
        <a href="/texas/arlington-solar-site-surveyors/" class="gp-link-card">
          <h4>Arlington Solar Site Surveyors</h4>
          <p>Central DFW hub coverage directly west, supporting mature residential and commercial solar projects.</p>
        </a>
        <a href="/texas/irving-solar-site-surveyors/" class="gp-link-card">
          <h4>Irving Solar Site Surveyors</h4>
          <p>Las Colinas, Valley Ranch, and central Irving municipal field documentation directly north.</p>
        </a>
        <a href="/texas/mansfield-solar-site-surveyors/" class="gp-link-card">
          <h4>Mansfield Solar Site Surveyors</h4>
          <p>South DFW expansion coverage across southern Tarrant and Johnson counties.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="gp-link-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Dallas metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Grand Prairie Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="gp-faq-list">
        {faqs.map(faq => (
          <div class="gp-faq-item card-technical">
            <h3 class="gp-faq-q">{faq.question}</h3>
            <p class="gp-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in Grand Prairie, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Grand Prairie"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .gp-container {
    max-width: 990px;
    margin: 0 auto;
  }

  .gp-container h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .gp-container p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .gp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .gp-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .gp-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .gp-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .gp-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .gp-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .gp-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .gp-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .gp-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .gp-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .gp-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .gp-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .gp-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
