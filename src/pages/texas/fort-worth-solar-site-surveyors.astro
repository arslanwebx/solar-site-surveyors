---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Fort Worth, TX';
const pageDescription = 'Solar site surveys in Fort Worth and Western DFW for EPCs, installers, and engineering teams. Field documentation across new-construction suburbs and established neighborhoods in Tarrant County.';
const canonicalPath = '/texas/fort-worth-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Fort Worth' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in the Fort Worth area.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors — Fort Worth, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Fort Worth, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': ['Solar Site Surveys', 'Residential Solar Site Survey', 'Commercial Solar Site Survey'],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'What makes Fort Worth surveys different from Dallas surveys?',
    answer: 'Fort Worth has its own building department, separate permit application process, and a different mix of housing stock — particularly in the rapidly growing western suburbs like Aledo, Weatherford, and Hudson Oaks. The survey scope accounts for these local differences while maintaining consistent deliverable quality.'
  },
  {
    question: 'Do you cover the new-construction neighborhoods west of Fort Worth?',
    answer: 'Yes. Western expansion areas including Walsh Ranch, Aledo, Willow Park, Hudson Oaks, and Weatherford are within our surveyor coordination coverage. New-construction properties have their own survey considerations, which we document during the visit.'
  },
  {
    question: 'What roof types are common in Fort Worth?',
    answer: 'Fort Worth housing stock ranges from older pier-and-beam homes in neighborhoods like Fairmount and Southside to modern slab-on-grade new construction in master-planned communities. Roof materials include composition shingle, tile, and stone-coated steel. Our surveyors document roof material, pitch, and condition regardless of type.'
  },
  {
    question: 'How do you handle properties in Tarrant County ETJ areas?',
    answer: 'Properties in Tarrant County extraterritorial jurisdictions may have different permit requirements than incorporated Fort Worth. Our surveys capture comprehensive field data that covers the documentation needs for both City of Fort Worth permits and county-level applications.'
  },
  {
    question: 'Can I use my own survey form or checklist?',
    answer: 'Yes. If your EPC or engineering team has a custom survey checklist, photo naming convention, or required measurement set, provide it at project intake and we align the field scope to your workflow.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <!-- Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Fort Worth, TX</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 900px;">
          Fort Worth is one of the fastest-growing large cities in the U.S., with new-construction neighborhoods stretching west toward Weatherford and north toward Haslet. Our survey coordination covers the full range of Fort Worth housing stock — from established Southside bungalows to brand-new master-planned communities — delivering field data your design team can work with immediately.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="fw-schedule-btn">
            <span>Schedule a Fort Worth Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: New-Build Suburbs Editorial -->
  <section class="section">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Growth Corridor</div>
        <h2>New-Build Suburbs and the Survey Challenges They Create</h2>
      </div>
      <div class="editorial-prose">
        <p>
          Fort Worth's western expansion has produced thousands of new homes in communities like Walsh Ranch, Aledo, and Sendera Ranch — but new construction does not mean a simpler survey. These properties often have complex hip-and-valley roof configurations, tile or stone-coated steel roofing materials, and compact lot setbacks that affect array placement options.
        </p>
        <p>
          Additionally, many new-build neighborhoods are governed by HOAs with architectural review requirements that can restrict panel visibility, equipment placement, or conduit routing. Our surveyors document the physical property conditions and note any visible HOA signage or architectural standards that your design team should be aware of before starting the plan set.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Two-Column Feature Blocks (alternating) -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Survey Scope</div>
        <h2>What We Document at Every Fort Worth Property</h2>
      </div>

      <div class="feature-blocks">
        <div class="feature-row">
          <div class="feature-content">
            <h3>Roof Geometry & Structural Access</h3>
            <p>Pitch, planes, ridges, valleys, material type, and condition. Where attic access is available, the surveyor captures rafter or truss dimensions, spacing, span, decking type, and framing direction — the structural data your engineer needs for attachment calculations.</p>
          </div>
          <div class="feature-content">
            <h3>Electrical Service & Metering</h3>
            <p>Main panel make and model, bus rating, main breaker ampacity, available breaker slots, grounding electrode, meter socket type, and utility disconnect location. Documented in the format solar designers and Oncor interconnection applications require.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-content">
            <h3>Battery & ESS Candidate Areas</h3>
            <p>Proposed equipment wall, NFPA 855 clearance measurements from doors, windows, and gas equipment, pathway distance to the main panel, and indoor/outdoor environmental suitability notes for whole-home backup or partial backup configurations.</p>
          </div>
          <div class="feature-content">
            <h3>Property Exterior & Photo Package</h3>
            <p>Elevation photos from all accessible sides, equipment location context, possible conduit routes, and a categorized HD photo set organized by scope area — not a folder of unnamed phone images.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Fort Worth Western Expansion -->
  <section class="section section-dark">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker" style="color: var(--accent-gold);">Market Context</div>
        <h2 style="color: #FFFFFF;">Fort Worth's Western Expansion and Solar Adoption</h2>
      </div>
      <div class="editorial-prose" style="color: #9FB3C8;">
        <p>
          The I-30 corridor west of Fort Worth has seen some of the fastest residential growth in Texas over the past decade. Communities in Parker County, including Willow Park and Hudson Oaks, are attracting homeowners who are building larger homes with higher energy consumption — properties that are strong candidates for solar installations.
        </p>
        <p>
          These areas are served by Oncor for transmission and distribution, and many fall under Parker County's jurisdiction rather than the City of Fort Worth's building department. Our survey documentation is structured to be usable regardless of which local authority reviews the permit application, ensuring your operations team does not have to request supplemental field data after the fact.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Operations Specs -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Operations</div>
        <h2>Fort Worth Survey Service Specifications</h2>
      </div>
      <div class="table-wrap card-technical">
        <table class="specs-table">
          <tbody>
            <tr>
              <td><strong>Coverage Area</strong></td>
              <td>Fort Worth, Western Tarrant County, and adjacent communities — Aledo, Weatherford, Benbrook, Burleson, Haslet, Keller, Southlake</td>
            </tr>
            <tr>
              <td><strong>Housing Stock</strong></td>
              <td>New-construction master-planned communities, established mid-century neighborhoods, and older historic districts</td>
            </tr>
            <tr>
              <td><strong>Deliverables</strong></td>
              <td>CAD-ready photo set, digital measurement log, categorized field documentation aligned with your team's checklist</td>
            </tr>
            <tr>
              <td><strong>Compliance Reference</strong></td>
              <td>NEC 2020/2023, NFPA 855, City of Fort Worth / Parker County building permit requirements</td>
            </tr>
            <tr>
              <td><strong>Target Audience</strong></td>
              <td>Solar EPCs, regional installers, design engineering teams, and operations coordinators</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-warm">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Questions</div>
        <h2>Fort Worth Survey FAQ</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTASection
    title="Need a Site Survey in Fort Worth?"
    subtitle="Contact our operations desk to check surveyor availability across Fort Worth and Western DFW."
    primaryCtaText="Schedule in Fort Worth"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Hub"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: var(--space-4);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  .narrow-content { max-width: 860px; }

  .editorial-prose p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .editorial-prose p:last-child { margin-bottom: 0; }

  /* Feature Blocks (alternating 2-col) */
  .feature-blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .feature-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .feature-content {
    padding: var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .feature-content h3 {
    font-size: 1.0625rem;
    color: var(--primary);
    margin-bottom: var(--space-2);
  }

  .feature-content p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Specs Table */
  .table-wrap {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 990px;
    margin: 0 auto;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] { border-color: var(--accent-gold); }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .faq-item[open] .faq-question::after { content: '−'; }

  .faq-answer { padding: 0 var(--space-6) var(--space-5); }

  .faq-answer p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .feature-row { grid-template-columns: 1fr; }
  }
</style>
