---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Leander, TX | PEC Territory';
const pageDescription = 'Solar site surveys in Leander, TX. Aligning with Pedernales Electric Cooperative (PEC) standards, Hill Country roof framing, and electrical services.';
const canonicalPath = '/texas/leander-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Leander' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Leander, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Leander, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Leander, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Electric Cooperative Solar Surveys',
    'Residential Solar Site Survey',
    'Hill Country Roof Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do Pedernales Electric Cooperative (PEC) standards affect solar surveys in Leander?',
    answer: 'Leander is predominantly served by Pedernales Electric Cooperative (PEC), the largest electric cooperative in the United States. PEC enforces distinct distributed generation interconnection procedures, specific bi-directional meter base requirements, and external AC disconnect rules. Our surveyors record the exact meter model, enclosure ratings, and exterior disconnect locations to support your PEC submittal.'
  },
  {
    question: 'Are all Leander properties served by Pedernales Electric Cooperative?',
    answer: 'While most of Leander falls within PEC territory, certain border neighborhoods in eastern Leander connect to Oncor Electric Delivery. We verify the electric meter badge and utility markings on site so your team files with the correct provider.'
  },
  {
    question: 'What roof framing conditions are typical across Leander Hill Country homes?',
    answer: 'Master-planned communities such as Crystal Falls and Travisso feature complex multi-pitch hip and gable roofs with steep slopes and engineered truss systems. The survey measures pitch per plane, records azimuth, maps plumbing vents, and documents truss spacing with physical measurement photos.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do you provide survey dispatches across the Northwest Austin corridor?',
    answer: 'Yes. Survey dispatches regularly connect Leander with Cedar Park, Liberty Hill, Georgetown, Lago Vista, and Jonestown.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Leander, TX</h1>
        <p class="lead">
          Field site documentation across the Texas Hill Country gateway. Aligning with Pedernales Electric Cooperative (PEC) standards, steep roof geometry, and 200A to 400A electrical services for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Leander Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PEC Electric Cooperative Alert -->
  <section class="section">
    <div class="container">
      <div class="pec-banner card-technical">
        <div class="pec-header">
          <div class="pec-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <div class="kicker">Electric Cooperative Notice</div>
            <h2>Pedernales Electric Cooperative (PEC) Territory Dictates Field Data Standards</h2>
          </div>
        </div>
        <p>
          Leander is not served by generic transmission utilities. As one of the core service territories of Pedernales Electric Cooperative (PEC), solar installations must comply with cooperative interconnection procedures, specific meter base configurations, and strict manual disconnect requirements.
        </p>
        <p>
          Contractors submitting plan sets based on Oncor or Austin Energy guidelines face immediate utility holds. Our survey coordination records the specific electrical parameters PEC requires: meter socket ratings, service entrance mast dimensions, exterior disconnect switch clearances, and grounding electrode paths. In border neighborhoods where PEC boundaries meet Oncor, our on-site inspection verifies the exact utility tags so your team never files interconnection paperwork with the wrong provider.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Inspection Scope</div>
        <h2>Leander Site Survey Package Deliverables</h2>
        <p class="lead">
          Comprehensive physical data prepared to support engineering review and City of Leander building permits.
        </p>
      </div>

      <div class="pec-grid">
        <div class="pec-card card-technical">
          <h3>PEC Electric Meter Equipment</h3>
          <p>
            We photograph the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete PEC interconnection filing.
          </p>
        </div>

        <div class="pec-card card-technical">
          <h3>Main Electrical Service Panels</h3>
          <p>
            The survey records busbar ratings, main breaker capacity, manufacturer data plates, and circuit breaker directories, confirming whether the electrical panel can accept a solar backfeed breaker.
          </p>
        </div>

        <div class="pec-card card-technical">
          <h3>Hill Country Roof Framing & Slopes</h3>
          <p>
            From master-planned communities in Crystal Falls and Travisso with steep multi-plane roofs to custom Hill Country estates, we document framing member sizes, spans, and decking materials.
          </p>
        </div>

        <div class="pec-card card-technical">
          <h3>Roof Planes & Penetrations</h3>
          <p>
            We measure pitch angles, record roof plane azimuth, and map plumbing vents, attic fans, exhaust flues, and skylights to verify usable array boundaries within local fire code setbacks.
          </p>
        </div>

        <div class="pec-card card-technical">
          <h3>Battery Backup & Inverter Clearances</h3>
          <p>
            For ESS projects, we record available wall space in attached garages or exterior side yards, verifying clearances from windows, doors, and gas meters to support code-compliant battery placement.
          </p>
        </div>

        <div class="pec-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Full elevation photos document site access, fence gates, air conditioning equipment, and ladder setup areas to assist installation managers with build-day staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Hill Country Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Central Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="pec-links">
        <a href="/texas/georgetown-solar-site-surveyors/" class="pec-link-card">
          <h4>Georgetown Solar Site Surveyors</h4>
          <p>Georgetown Utility Systems municipal standards and Sun City roof plane documentation directly northeast.</p>
        </a>
        <a href="/texas/round-rock-solar-site-surveyors/" class="pec-link-card">
          <h4>Round Rock Solar Site Surveyors</h4>
          <p>High-density Williamson County tech corridor survey coordination directly southeast.</p>
        </a>
        <a href="/texas/austin-solar-site-surveyors/" class="pec-link-card">
          <h4>Austin Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Austin metropolitan area directly south.</p>
        </a>
        <a href="/texas/killeen-solar-site-surveyors/" class="pec-link-card">
          <h4>Killeen Solar Site Surveyors</h4>
          <p>Fort Cavazos corridor residential survey coordination further north along US-183.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Leander Solar Survey Operations</h2>
        <p class="lead">Essential details for solar contractors and project coordinators.</p>
      </div>

      <div class="pec-faq-list">
        {faqs.map(faq => (
          <div class="pec-faq-item card-technical">
            <h3 class="pec-faq-q">{faq.question}</h3>
            <p class="pec-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in Leander, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and ensure your field package meets Pedernales Electric Cooperative standards."
    primaryCtaText="Schedule Survey in Leander"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .pec-banner {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 6px solid var(--accent-gold);
    max-width: 1000px;
    margin: 0 auto;
  }

  .pec-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .pec-icon {
    color: var(--accent-gold);
    margin-top: 0.25rem;
  }

  .pec-banner h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .pec-banner p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .pec-banner p:last-child {
    margin-bottom: 0;
  }

  .pec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .pec-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .pec-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .pec-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .pec-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .pec-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pec-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .pec-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .pec-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pec-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pec-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .pec-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .pec-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
