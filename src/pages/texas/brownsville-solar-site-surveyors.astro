---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Brownsville, TX | BPUB Area';
const pageDescription = 'Solar site surveys in Brownsville, TX. Aligning with Brownsville Public Utilities Board (BPUB) standards, coastal windstorm framing, and electrical panels.';
const canonicalPath = '/texas/brownsville-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Brownsville' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Brownsville, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Brownsville, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Brownsville, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Municipal Utility Solar Surveys',
    'Residential Solar Site Survey',
    'BPUB Meter Verification'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do Brownsville Public Utilities Board (BPUB) standards affect solar surveys?',
    answer: 'The Brownsville Public Utilities Board (BPUB) is a municipal electric utility operating independently with its own distributed generation policies. BPUB requires dedicated interconnection applications, specific meter socket standards, and accessible exterior AC disconnect switches. Our survey packages capture clear photographs of the BPUB meter base, label numbers, and service entrance disconnects to verify compliance before plan submittal.'
  },
  {
    question: 'Are all Brownsville addresses served by BPUB?',
    answer: 'Most properties within the city limits are in BPUB territory, but certain outer sections and extraterritorial areas in Cameron County connect to AEP Texas Central or Magic Valley Electric Cooperative (MVEC). We verify the meter enclosure and utility labels on site so your team files with the proper provider.'
  },
  {
    question: 'How do coastal windstorm and humidity factors impact Brownsville surveys?',
    answer: 'Located near the Gulf of Mexico, Brownsville experiences high ambient humidity and hurricane-force wind considerations. Survey packages record roof decking thickness, rafter or truss spacing, attachment points, and existing structural bracing with physical measurement photos, giving your structural engineer verified data for wind calculations.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do you cover projects across the Lower Rio Grande Valley?',
    answer: 'Yes. Survey dispatches regularly connect Brownsville with Harlingen, San Benito, Los Fresnos, Port Isabel, and South Padre Island.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Brownsville, TX</h1>
        <p class="lead">
          Accurate field data collection aligned with Brownsville Public Utilities Board (BPUB) municipal standards. Documenting coastal windstorm framing, salt-air exposure, and electrical equipment across Cameron County.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Brownsville Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- BPUB Municipal Utility Alert -->
  <section class="section">
    <div class="container">
      <div class="bpub-banner card-technical">
        <div class="bpub-header">
          <div class="bpub-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <div class="kicker">Municipal Utility Notice</div>
            <h2>Brownsville Public Utilities Board (BPUB) Demands Independent Field Data</h2>
          </div>
        </div>
        <p>
          Brownsville does not operate under standard AEP Texas transmission rules. The city is served by the Brownsville Public Utilities Board (BPUB), a municipal provider with its own distributed generation interconnection manual, specific bi-directional meter base requirements, and unique exterior AC disconnect rules.
        </p>
        <p>
          Contractors who submit plan sets assuming generic transmission utility procedures experience immediate interconnection holds. Our survey coordination records the specific electrical parameters BPUB requires: meter socket ratings, service entrance mast dimensions, exterior disconnect switch clearances, and grounding electrode paths. In border neighborhoods where BPUB boundaries meet AEP Texas or MVEC, our on-site inspection verifies the exact utility tags so your team never files interconnection paperwork with the wrong provider.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Inspection Scope</div>
        <h2>Brownsville Site Survey Package Deliverables</h2>
        <p class="lead">
          Comprehensive physical data prepared to support engineering review and City of Brownsville building permits.
        </p>
      </div>

      <div class="bpub-grid">
        <div class="bpub-card card-technical">
          <h3>BPUB Electric Meter Equipment</h3>
          <p>
            We photograph the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete BPUB interconnection filing.
          </p>
        </div>

        <div class="bpub-card card-technical">
          <h3>Main Electrical Service Panels</h3>
          <p>
            The survey records busbar ratings, main breaker capacity, manufacturer data plates, and circuit breaker directories, confirming whether the electrical panel can accept a solar backfeed breaker.
          </p>
        </div>

        <div class="bpub-card card-technical">
          <h3>Coastal Windstorm Roof Framing</h3>
          <p>
            We document rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs to support structural engineering review.
          </p>
        </div>

        <div class="bpub-card card-technical">
          <h3>Roof Planes & Penetrations</h3>
          <p>
            We measure pitch angles, record roof plane azimuth, and map plumbing vents, attic fans, exhaust flues, and skylights to verify usable array boundaries within local fire code setbacks.
          </p>
        </div>

        <div class="bpub-card card-technical">
          <h3>Battery Backup & Inverter Clearances</h3>
          <p>
            For ESS projects, we record available wall space in attached garages or exterior side yards, verifying clearances from windows, doors, and gas meters to support code-compliant battery placement.
          </p>
        </div>

        <div class="bpub-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Full elevation photos document site access, fence gates, air conditioning equipment, and ladder setup areas to assist installation managers with build-day staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Lower Valley Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Coastal Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="bpub-links">
        <a href="/texas/mcallen-solar-site-surveyors/" class="bpub-link-card">
          <h4>McAllen Solar Site Surveyors</h4>
          <p>Rio Grande Valley commercial hub survey coordination and AEP Texas Central documentation directly northwest.</p>
        </a>
        <a href="/texas/pharr-solar-site-surveyors/" class="bpub-link-card">
          <h4>Pharr Solar Site Surveyors</h4>
          <p>Hidalgo County residential survey coordination and AEP Texas Central documentation directly northwest.</p>
        </a>
        <a href="/texas/corpus-christi-solar-site-surveyors/" class="bpub-link-card">
          <h4>Corpus Christi Solar Site Surveyors</h4>
          <p>Coastal Bend windstorm documentation and AEP Texas utility coordination directly north.</p>
        </a>
        <a href="/texas/laredo-solar-site-surveyors/" class="bpub-link-card">
          <h4>Laredo Solar Site Surveyors</h4>
          <p>Webb County border logistics hub survey operations and flat parapet roof documentation directly northwest.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Brownsville Solar Survey Operations</h2>
        <p class="lead">Essential details for solar contractors and project coordinators.</p>
      </div>

      <div class="bpub-faq-list">
        {faqs.map(faq => (
          <div class="bpub-faq-item card-technical">
            <h3 class="bpub-faq-q">{faq.question}</h3>
            <p class="bpub-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in Brownsville, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and ensure your field package meets BPUB standards."
    primaryCtaText="Schedule Survey in Brownsville"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .bpub-banner {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 6px solid var(--accent-gold);
    max-width: 1000px;
    margin: 0 auto;
  }

  .bpub-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .bpub-icon {
    color: var(--accent-gold);
    margin-top: 0.25rem;
  }

  .bpub-banner h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .bpub-banner p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .bpub-banner p:last-child {
    margin-bottom: 0;
  }

  .bpub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .bpub-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .bpub-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .bpub-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .bpub-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .bpub-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .bpub-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .bpub-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .bpub-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .bpub-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bpub-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .bpub-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .bpub-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
