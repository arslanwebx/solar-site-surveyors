---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Tyler, TX | East Texas Surveys';
const pageDescription = 'Solar site surveys in Tyler, TX. Managing East Texas pine tree shading, Oncor service panels, and roof framing across Smith County.';
const canonicalPath = '/texas/tyler-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Tyler' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Tyler, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Tyler, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Tyler, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Pine Canopy Shade Analysis',
    'Main Electrical Service Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How does the dense East Texas pine canopy affect solar surveys in Tyler?',
    answer: 'Tyler features extensive loblolly pine and hardwood tree cover that creates complex shading. Our surveyors capture high-resolution 360-degree tree line photos from multiple roof vantage points, documenting obstruction angles and overhangs so your CAD designers can accurately model solar irradiance.'
  },
  {
    question: 'Which utility company serves Tyler solar installations?',
    answer: 'Tyler is located within Oncor Electric Delivery service territory (East Texas region). We photograph the digital meter display, meter enclosure, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for Oncor distributed generation filings.'
  },
  {
    question: 'What electrical panel configurations are common in Tyler homes?',
    answer: 'Homes constructed between the 1960s and 1980s across central Tyler often feature 100-amp, 125-amp, or 150-amp main service panels, while newer custom homes near Lake Tyler feature 200-amp or 400-amp split services. The surveyor records busbar ratings, main breaker capacities, and available breaker slots to verify whether a solar backfeed breaker can be installed.'
  },
  {
    question: 'What framing conditions are common in Tyler historic neighborhoods?',
    answer: 'Properties in the historic Azalea District often feature steep conventional rafter framing with 1x8 tongue-and-groove or shiplap decking, while modern master-planned subdivisions utilize engineered roof trusses. We record member dimensions, spans, and decking materials with physical measurement photos.'
  },
  {
    question: 'Do your surveyors cover surrounding East Texas communities?',
    answer: 'Yes. Survey dispatches regularly connect Tyler with Whitehouse, Lindale, Bullard, Flint, Jacksonville, and Mineola.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Tyler, TX</h1>
        <p class="lead">
          Field site documentation across Smith County and the Piney Woods. Managing dense pine canopy shading, Oncor electric service equipment, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Tyler Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- East Texas Pine Canopy Focus -->
  <section class="section">
    <div class="container">
      <div class="tyl-split">
        <div class="tyl-text">
          <div class="kicker">Operational Focus</div>
          <h2>East Texas Pine Canopy: Tree Shading and Structural Roof Documentation</h2>
          <p>
            Tyler serves as the principal economic, medical, and cultural anchor of East Texas, known as the Rose Capital of America. Nestled within the Piney Woods, residential neighborhoods in Tyler feature majestic loblolly pine canopies, mature oak trees, and rolling terrain that create distinctive field survey requirements.
          </p>
          <p>
            Dense pine cover demands accurate shading documentation. Our surveyors record detailed horizon and tree line photos from roof eaves and ridges, allowing CAD designers to evaluate obstruction profiles accurately. In addition, established housing in the Azalea District features steep conventional rafter systems with shiplap decking, while suburban communities south along HWY 69 feature modern engineered trusses.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Tyler project. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your design team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="tyl-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Tyler Operating Overview</h3>
          <ul class="tyl-spec-list">
            <li>
              <strong>County:</strong>
              <span>Smith County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery (East Texas Region)</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Tyler Building Inspection</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Historic Azalea District homes, modern master-planned communities</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>125A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Tyler Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="tyl-grid">
        <div class="tyl-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="tyl-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="tyl-card card-technical">
          <h3>Pine Canopy Shading & Roof Geometry</h3>
          <p>
            We measure pitch angles, record azimuth, map roof planes, and photograph mature pine tree obstructions across multiple vantage points to define viable solar array layouts.
          </p>
        </div>

        <div class="tyl-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="tyl-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="tyl-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">East Texas Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Regional Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="tyl-links">
        <a href="/texas/longview-solar-site-surveyors/" class="tyl-link-card">
          <h4>Longview Solar Site Surveyors</h4>
          <p>SWEPCO non-ERCOT utility standards and Gregg County residential survey coordination directly east.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="tyl-link-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>North Texas metropolitan survey operations and Oncor utility documentation west.</p>
        </a>
        <a href="/texas/beaumont-solar-site-surveyors/" class="tyl-link-card">
          <h4>Beaumont Solar Site Surveyors</h4>
          <p>Entergy Texas territory and coastal hurricane corridor survey coordination southeast.</p>
        </a>
        <a href="/texas/waco-solar-site-surveyors/" class="tyl-link-card">
          <h4>Waco Solar Site Surveyors</h4>
          <p>McLennan County residential survey coordination and I-35 corridor framing documentation southwest.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Tyler Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="tyl-faq-list">
        {faqs.map(faq => (
          <div class="tyl-faq-item card-technical">
            <h3 class="tyl-faq-q">{faq.question}</h3>
            <p class="tyl-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Tyler, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Tyler"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .tyl-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .tyl-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .tyl-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .tyl-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .tyl-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .tyl-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tyl-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .tyl-spec-list li:last-child {
    border-bottom: none;
  }

  .tyl-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .tyl-spec-list span {
    color: var(--text-secondary);
  }

  .tyl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .tyl-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .tyl-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .tyl-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .tyl-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .tyl-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tyl-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .tyl-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .tyl-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .tyl-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tyl-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .tyl-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .tyl-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .tyl-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
