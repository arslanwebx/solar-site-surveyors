---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { allTexasCities, featuredTexasCities } from '../../data/texasCities';
import { getWhatsAppLink } from '../../data/whatsapp';

// Breadcrumbs hierarchy: Home > Service Areas > Texas
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas' }
];

// First 100 cities are pre-rendered statically for ultra-fast initial load & SEO indexing
const initialCities = allTexasCities.slice(0, 100);
const remainingCities = allTexasCities.slice(100);
const defaultCustomSurveyWhatsApp = getWhatsAppLink('Hi, I would like to schedule a solar site survey in Texas.');
---

<BaseLayout 
  title="Solar Site Surveyors in Texas | Statewide Coverage"
  description="Professional solar site surveys throughout Texas for installers, EPCs, solar companies, and contractors. Fast-track surveyor coordination and CAD-ready photo packages across all 254 counties."
  activeNav="service-areas"
  canonical="/texas/"
>
  <!-- Page Hero with Dark Luxury Aesthetic -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <!-- Structured Breadcrumb Trail: Home > Service Areas > Texas -->
        <Breadcrumbs items={breadcrumbs} isDark={true} />

        <h1 class="page-title">Texas Solar Site Survey Coverage & City Directory</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 840px;">
          Professional solar site surveys throughout Texas for installers, EPCs, solar companies, and contractors. From the Rio Grande Valley to the Panhandle, Solar Site Surveys coordinates vetted local site surveyors across all 254 Texas counties—delivering CAD-ready photo packages for your engineering and permitting teams.
        </p>
      </div>
    </div>
  </section>

  <!-- Major Texas Metro Dispatch Hubs (Pinned on Top) -->
  <section class="section section-tight featured-metros-section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Primary Markets</div>
        <h2>Major Texas Metro Dispatch Hubs</h2>
        <p class="lead">
          Dedicated, jurisdiction-specific field survey operations and custom engineering coverage across Texas's eight primary metropolitan centers.
        </p>
      </div>

      <div class="metro-grid">
        {featuredTexasCities.map((city) => (
          <div class="metro-card card-technical">
            <div class="metro-card-top">
              <div class="metro-header-row">
                <span class="metro-badge">Primary Hub</span>
                <span class="metro-status"><span class="status-dot"></span> Active</span>
              </div>
              <h3 class="metro-name">
                <a href={`/texas/${city.slug}-solar-site-surveyors/`} class="metro-title-link">
                  {city.name}
                </a>
              </h3>
              <p class="metro-notes">{city.keyCoverageNotes}</p>
            </div>
            <div class="metro-card-bottom">
              <a 
                href={`/texas/${city.slug}-solar-site-surveyors/`} 
                class="btn btn-primary btn-sm metro-btn"
                title={`Explore ${city.name}, TX Solar Site Survey Coverage`}
              >
                <span>Explore {city.name}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Texas Statewide Cities Directory & Live Instant Search -->
  <section class="section section-warm" id="city-directory">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Statewide Directory</div>
        <h2>Active Texas City Dispatch Directory</h2>
        <p class="lead">
          Our distributed field surveyor network covers municipal jurisdictions and rural co-op territories across the entire state.
        </p>

        <!-- Live Instant Search Bar -->
        <div class="search-bar-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#66717D" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input 
            type="text" 
            id="city-search" 
            placeholder="Search Texas cities & towns (e.g. Houston, Plano, Lubbock, Tyler, Waco)..." 
            aria-label="Filter Texas cities"
          />
        </div>
      </div>

      <!-- Cities Grid (Initial 100 Pre-rendered) -->
      <div class="cities-grid" id="cities-grid">
        {initialCities.map((city) => (
          <div class="city-card card-technical" id={city.slug} data-name={city.name.toLowerCase()}>
            <div class="city-card-content">
              <h3 class="city-name">
                <a href={`/texas/${city.slug}-solar-site-surveyors/`} class="city-title-link">{city.name}</a>
              </h3>
              <p class="city-notes">{city.keyCoverageNotes}</p>
            </div>
            <div class="city-card-action">
              <a 
                href={`/texas/${city.slug}-solar-site-surveyors/`} 
                class="btn btn-city-explore"
                title={`Explore ${city.name}, TX solar site survey coverage`}
              >
                <span>Explore</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Load More Button -->
      <div class="load-more-wrap" id="load-more-wrap">
        <button type="button" class="btn btn-outline btn-lg" id="load-more-btn">
          <span>Load More Texas Cities</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>
      
      <!-- No Search Results Fallback -->
      <div id="no-cities-msg" class="no-results-box" style="display: none;">
        <p>No Texas cities matching your search. We coordinate surveys across all 254 counties statewide—<a href={defaultCustomSurveyWhatsApp} target="_blank" rel="noopener noreferrer" style="color: var(--primary); font-weight: 600; text-decoration: underline;">Schedule a Custom Survey via WhatsApp</a>.</p>
      </div>
    </div>
  </section>

  <!-- Texas Technical & Utility Interconnection Standards -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Engineering Specifications</div>
        <h2>Texas AHJ & Utility Compliance Matrix</h2>
        <p class="lead">
          Our surveys are purpose-built to comply with ERCOT transmission entities, municipal electric authorities, and regional building departments.
        </p>
      </div>

      <div class="specs-grid">
        <div class="spec-card card-technical">
          <div class="spec-header">
            <h4>Major Electric Utilities</h4>
            <span class="spec-tag">Statewide</span>
          </div>
          <p>Standardized measurement protocols aligned with Oncor Electric Delivery, CenterPoint Energy, AEP Texas, Texas-New Mexico Power (TNMP), Austin Energy, CPS Energy, and rural electric co-ops (Pedernales, Bluebonnet, CoServ, Tri-County).</p>
        </div>

        <div class="spec-card card-technical">
          <div class="spec-header">
            <h4>Gulf Coast High Wind Loads</h4>
            <span class="spec-tag">Coastal Zone</span>
          </div>
          <p>Rigorous structural rafter assessments, truss spacing measurements, and decking condition logs complying with Texas Department of Insurance (TDI) windstorm guidelines and 115–150+ mph wind speed engineering thresholds.</p>
        </div>

        <div class="spec-card card-technical">
          <div class="spec-header">
            <h4>ERCOT Market & Tariff Nuances</h4>
            <span class="spec-tag">Deregulated</span>
          </div>
          <p>Documentation of dual-meter sockets, solar net-billing meters, smart meter serial numbers, and line-side tap clearances required for seamless retail electric provider (REP) buyback enrollment.</p>
        </div>

        <div class="spec-card card-technical">
          <div class="spec-header">
            <h4>Battery & Backup Clearances</h4>
            <span class="spec-tag">ESS / NFPA 855</span>
          </div>
          <p>Precise clearance measurements around garage walls, outdoor siding, gas meters, windows, and doors to ensure compliance with NFPA 855 and local municipal fire marshal setback codes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <CTASection 
    title="Ready to Dispatch a Solar Site Survey Anywhere in Texas?"
    subtitle="Connect with our operations desk to check surveyor availability, turnaround SLAs, and coordinate your upcoming pipeline."
    primaryCtaText="Schedule a Texas Survey"
    secondaryCtaText="Join Our Texas Network"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<!-- Client Script for Ultra-Fast Batch Loading and Full-Dataset Search -->
<script define:vars={{ remainingCities, initialCities }}>
  let currentLoadedCount = initialCities.length;
  const BATCH_SIZE = 100;
  const grid = document.getElementById('cities-grid');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreWrap = document.getElementById('load-more-wrap');
  const searchInput = document.getElementById('city-search');
  const noResults = document.getElementById('no-cities-msg');

  // Helper to create a city card DOM element
  function createCardElement(city) {
    const card = document.createElement('div');
    card.className = 'city-card card-technical';
    card.id = city.slug;
    card.setAttribute('data-name', city.name.toLowerCase());
    const cityUrl = '/texas/' + city.slug + '-solar-site-surveyors/';
    
    card.innerHTML = `
      <div class="city-card-content">
        <h3 class="city-name">
          <a href="${cityUrl}" class="city-title-link">${city.name}</a>
        </h3>
        <p class="city-notes">${city.keyCoverageNotes}</p>
      </div>
      <div class="city-card-action">
        <a href="${cityUrl}" class="btn btn-city-explore" title="Explore ${city.name}, TX solar site survey coverage">
          <span>Explore</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    `;
    return card;
  }

  // Load More Handler (loads next batch)
  function loadNextBatch() {
    if (!grid || !remainingCities) return;
    const startIndex = currentLoadedCount - initialCities.length;
    const nextCities = remainingCities.slice(startIndex, startIndex + BATCH_SIZE);

    if (nextCities.length > 0) {
      const fragment = document.createDocumentFragment();
      nextCities.forEach(city => {
        fragment.appendChild(createCardElement(city));
      });
      grid.appendChild(fragment);
      currentLoadedCount += nextCities.length;
    }

    if (startIndex + BATCH_SIZE >= remainingCities.length && loadMoreWrap) {
      loadMoreWrap.style.display = 'none';
    }
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', loadNextBatch);
  }

  // Live Instant Search across whole dataset
  const allDataset = [...initialCities, ...remainingCities];

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();

      if (!q) {
        // Reset to currently loaded view
        if (grid) {
          const domCards = grid.querySelectorAll('.city-card');
          domCards.forEach((c) => {
            c.style.display = 'flex';
          });
        }
        if (loadMoreWrap) {
          const startIndex = currentLoadedCount - initialCities.length;
          loadMoreWrap.style.display = (startIndex < remainingCities.length) ? 'flex' : 'none';
        }
        if (noResults) noResults.style.display = 'none';
        return;
      }

      // If search query is active, hide load more button
      if (loadMoreWrap) loadMoreWrap.style.display = 'none';

      // Find matching cities from full dataset
      const matches = allDataset.filter(c => c.name.toLowerCase().includes(q));

      if (grid) {
        grid.innerHTML = '';
        if (matches.length > 0) {
          const fragment = document.createDocumentFragment();
          // Show up to 100 search results for instantaneous speed
          matches.slice(0, 100).forEach(city => {
            fragment.appendChild(createCardElement(city));
          });
          grid.appendChild(fragment);
          if (noResults) noResults.style.display = 'none';
        } else {
          if (noResults) noResults.style.display = 'block';
        }
      }
    });
  }
</script>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  /* Search Bar */
  .search-bar-wrap {
    position: relative;
    max-width: 540px;
    margin: var(--space-6) auto 0;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search-bar-wrap input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    background-color: #FFFFFF;
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .search-bar-wrap input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(16, 42, 67, 0.1);
  }

  /* Featured Metro Hubs (Top Section) */
  .featured-metros-section {
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--border-light);
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .metro-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .metro-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .metro-card:hover {
    border-color: var(--accent-gold);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .metro-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .metro-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
    background-color: var(--accent-gold-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(244, 185, 66, 0.3);
  }

  .metro-status {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--status-green);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }

  .metro-name {
    font-family: var(--font-heading) !important;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 var(--space-2) 0;
    letter-spacing: -0.02em;
  }

  .metro-title-link {
    color: var(--primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .metro-title-link:hover {
    color: var(--accent-gold);
  }

  .metro-notes {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  .metro-card-bottom {
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-light);
  }

  .metro-btn {
    width: 100%;
    justify-content: center;
    font-weight: 600;
  }

  /* Cities Grid & Clean Cards */
  .cities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  :global(.city-card) {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  :global(.city-card:hover) {
    border-color: var(--border-medium);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  :global(.city-card-content) {
    margin-bottom: var(--space-4);
  }

  :global(.city-name) {
    font-family: var(--font-heading) !important;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 0.4rem 0;
  }

  :global(.city-title-link) {
    color: var(--primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  :global(.city-title-link:hover) {
    color: var(--accent-gold);
  }

  :global(.city-notes) {
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  :global(.city-card-action) {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  :global(.btn-city-explore) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.55rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  :global(.btn-city-explore:hover) {
    background-color: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
  }

  :global(.btn-city-explore svg) {
    transition: transform var(--transition-fast);
  }

  :global(.btn-city-explore:hover svg) {
    transform: translateX(3px);
  }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  .no-results-box {
    text-align: center;
    padding: var(--space-10);
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    margin-top: var(--space-6);
  }

  /* Specs Grid */
  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .spec-card {
    padding: var(--space-6);
    background-color: #FFFFFF;
  }

  .spec-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .spec-header h4 {
    color: var(--primary);
    margin: 0;
  }

  .spec-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
    background-color: var(--bg-secondary);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
  }

  .spec-card p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .metro-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .metro-grid {
      grid-template-columns: 1fr;
    }
    .cities-grid {
      grid-template-columns: 1fr;
    }
    .specs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
