---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Mesquite, TX | East DFW Surveys';
const pageDescription = 'Solar site surveys in Mesquite, TX. Documenting 100A and 125A electrical service panels, low-pitch roof planes, and attic framing across East Dallas County.';
const canonicalPath = '/texas/mesquite-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Mesquite' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Mesquite, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Mesquite, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Mesquite, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Main Panel Bus Rating Inspection',
    'Attic Rafter Documentation'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do older electrical panels in Mesquite impact solar design?',
    answer: 'A significant portion of Mesquite housing stock built in the 1960s, 1970s, and 1980s features 100-amp or 125-amp service equipment. These panels frequently have limited physical space or low busbar ratings that restrict solar backfeed under the 120 percent rule. Our surveyors take macro photographs of the panel data label, main breaker, and busbars so your electrical engineers can determine if a panel upgrade or line-side tap is required.'
  },
  {
    question: 'Which utility company serves Mesquite solar projects?',
    answer: 'Mesquite is located within Oncor Electric Delivery service territory. We photograph the meter enclosure, meter number badge, overhead service drop or underground lateral, and main utility disconnect to provide complete documentation for Oncor distributed generation interconnection filings.'
  },
  {
    question: 'How do City of Mesquite building inspections handle solar permits?',
    answer: 'The City of Mesquite Building Inspection Division requires code-compliant electrical single-line diagrams, manufacturer specification sheets, and clear structural mounting attachments. Our complete photo logs and measurement reports ensure your design team can produce accurate permit packages.'
  },
  {
    question: 'What roof conditions are commonly documented in Mesquite neighborhoods?',
    answer: 'Established Mesquite neighborhoods often feature low-pitch 3/12 or 4/12 roof slopes with conventional 2x4 or 2x6 rafter construction. The surveyor records pitch, shingle wear, decking thickness, and all roof penetrations to define buildable array boundaries.'
  },
  {
    question: 'Do you cover projects across the East Dallas corridor?',
    answer: 'Yes. Survey dispatches regularly connect Mesquite projects with surrounding properties in Garland, Balch Springs, Sunnyvale, Rowlett, and eastern Dallas.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Mesquite, TX</h1>
        <p class="lead">
          Field site documentation across established East DFW neighborhoods. Specializing in legacy electrical service panel verification, low-slope roof planes, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Mesquite</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Section: Legacy Electrical Focus -->
  <section class="section">
    <div class="container">
      <div class="mesquite-split">
        <div class="mesquite-text">
          <div class="kicker">Operational Focus</div>
          <h2>East DFW Housing Stock: Documenting Legacy Electrical Panels</h2>
          <p>
            Mesquite represents an established East DFW residential corridor where the primary operational challenge is electrical service equipment. While northern suburbs like Frisco or McKinney feature modern 200-amp panels with open breaker slots, homes across Mesquite often retain their original 100-amp or 125-amp service equipment from the 1960s through 1980s.
          </p>
          <p>
            For a remote solar engineering desk, an illegible panel photo can halt a project completely. If an engineer cannot confirm the busbar rating or determine whether the main breaker is 100A or 125A, they cannot perform a reliable NEC 705.12 calculation. Guessing wrong leads to failed municipal inspections or expensive build-day change orders.
          </p>
          <p>
            Our surveyors prioritize high-resolution macro photography of panel data plates, main breaker markings, busbar configurations, and grounding conductors. We record all existing breaker amperages and verify whether physical space exists for a solar backfeed breaker or if a main panel upgrade must be factored into the project scope.
          </p>
        </div>
        <div class="mesquite-card-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Mesquite Operating Overview</h3>
          <ul class="mesquite-spec-list">
            <li>
              <strong>County:</strong>
              <span>Dallas County, Kaufman County overlap</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Mesquite Building Inspection</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Mid-century brick ranches, 1980s single-family homes</span>
            </li>
            <li>
              <strong>Common Electrical:</strong>
              <span>100A to 150A main panels, split-bus hardware</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Support</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Inspection Scope -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Verification Scope</div>
        <h2>Detailed Deliverables for Mesquite Solar Projects</h2>
        <p class="lead">
          Field data organized to support solar engineering review and City of Mesquite permit applications.
        </p>
      </div>

      <div class="mesquite-grid">
        <div class="mesquite-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, allowing your design team to assess backfeed capacity or upgrade needs.
          </p>
        </div>

        <div class="mesquite-card card-technical">
          <h3>Oncor Meter & Service Disconnect</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="mesquite-card card-technical">
          <h3>Low-Slope Roof Plane Geometry</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="mesquite-card card-technical">
          <h3>Attic Rafter & Framing Health</h3>
          <p>
            In homes with conventional rafter construction, we record member dimensions, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="mesquite-card card-technical">
          <h3>Battery Backup Wall Clearances</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="mesquite-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">East DFW Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Municipalities</h2>
        <p class="lead">
          Coordinate field surveys across neighboring East DFW markets with consistent documentation standards.
        </p>
      </div>

      <div class="mesquite-links">
        <a href="/texas/garland-solar-site-surveyors/" class="mesquite-link-card">
          <h4>Garland Solar Site Surveyors</h4>
          <p>Municipal utility verification and GP&L distributed generation survey standards directly north.</p>
        </a>
        <a href="/texas/richardson-solar-site-surveyors/" class="mesquite-link-card">
          <h4>Richardson Solar Site Surveyors</h4>
          <p>Telecom corridor housing stock, mature tree shading analysis, and legacy panel documentation.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="mesquite-link-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Dallas metropolitan area.</p>
        </a>
        <a href="/texas/plano-solar-site-surveyors/" class="mesquite-link-card">
          <h4>Plano Solar Site Surveyors</h4>
          <p>High-density North DFW residential survey coordination and engineering handoffs.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Mesquite Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="mesquite-faq-list">
        {faqs.map(faq => (
          <div class="mesquite-faq-item card-technical">
            <h3 class="mesquite-faq-q">{faq.question}</h3>
            <p class="mesquite-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Mesquite, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Mesquite"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .mesquite-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .mesquite-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .mesquite-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .mesquite-card-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .mesquite-card-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .mesquite-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mesquite-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .mesquite-spec-list li:last-child {
    border-bottom: none;
  }

  .mesquite-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .mesquite-spec-list span {
    color: var(--text-secondary);
  }

  .mesquite-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .mesquite-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .mesquite-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .mesquite-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .mesquite-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .mesquite-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mesquite-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .mesquite-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .mesquite-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .mesquite-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mesquite-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .mesquite-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .mesquite-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .mesquite-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
