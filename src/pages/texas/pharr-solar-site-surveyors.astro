---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Pharr, TX | Hidalgo County';
const pageDescription = 'Solar site surveys in Pharr, TX. Documenting AEP Texas Central service panels, high-insolation roof geometry, and attic framing across Hidalgo County.';
const canonicalPath = '/texas/pharr-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Pharr' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Pharr, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Pharr, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Pharr, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Main Electrical Service Inspection',
    'High-Insolation Roof Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do AEP Texas Central rules impact solar surveys in Pharr?',
    answer: 'Pharr is located within AEP Texas Central service territory. Distributed generation interconnection requires specific application forms, dedicated bi-directional meter base standards, and manual exterior AC disconnect switches. Our surveyors photograph the digital AEP meter badge, enclosure tags, and service disconnect to verify compliance before plan submittal.'
  },
  {
    question: 'How does the City of Pharr review residential solar permits?',
    answer: 'The City of Pharr Development Services Department requires code-compliant single-line electrical diagrams, manufacturer equipment cut sheets, and clear structural mounting attachments. Our survey photo logs and physical measurements provide remote CAD teams with verified data to pass plan review on the initial submission.'
  },
  {
    question: 'What roof types and framing conditions are typical across Pharr?',
    answer: 'Pharr features single-story ranch homes and newer master-planned communities with composition shingles and concrete tile accents on conventional rafter or engineered truss systems. The survey measures pitch per plane, records azimuth, maps plumbing vents, and documents rafter spacing with measurement photos.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do you cover projects across central Hidalgo County?',
    answer: 'Yes. Survey dispatches regularly connect Pharr with McAllen, San Juan, Alamo, Edinburg, and Hidalgo.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Pharr, TX</h1>
        <p class="lead">
          Field site documentation across central Hidalgo County and the international trade corridor. Standardizing AEP Texas Central electrical service data, roof plane geometry, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Pharr Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- International Trade Corridor Focus -->
  <section class="section">
    <div class="container">
      <div class="pha-split">
        <div class="pha-text">
          <div class="kicker">Operational Focus</div>
          <h2>International Trade Corridor: High-Density Residential Solar Coordination</h2>
          <p>
            Pharr serves as a crucial trade and logistics nexus for the Rio Grande Valley, anchored by the Pharr-Reynosa International Bridge. Surrounded by rapidly growing residential developments, commercial logistics hubs, and mature established neighborhoods, Pharr combines dense residential rooftops with high solar irradiance and significant residential cooling loads.
          </p>
          <p>
            Operating in Pharr requires precision in documenting electrical service equipment under AEP Texas Central guidelines. Established neighborhoods feature classic single-story brick ranches with 125-amp or 150-amp panels, while newer master-planned communities along I-69C feature modern 200-amp service equipment and complex multi-plane roof systems. If remote CAD engineers work from incomplete site photos, they cannot verify busbar ratings or determine whether physical space exists for an interconnection breaker, stalling project timelines.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Pharr project. We clean and record legible electrical data plates, verify main breaker capacities, inspect accessible attic framing, and map roof plane geometry so your engineering team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="pha-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Pharr Operating Overview</h3>
          <ul class="pha-spec-list">
            <li>
              <strong>County:</strong>
              <span>Hidalgo County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>AEP Texas Central</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Pharr Development Services</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Mid-century brick ranches, contemporary suburban subdivisions</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>125A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Pharr Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="pha-grid">
        <div class="pha-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="pha-card card-technical">
          <h3>AEP Texas Central Meter Tagging</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete AEP interconnection filing.
          </p>
        </div>

        <div class="pha-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="pha-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="pha-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="pha-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Mid-Valley Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Hidalgo County Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="pha-links">
        <a href="/texas/mcallen-solar-site-surveyors/" class="pha-link-card">
          <h4>McAllen Solar Site Surveyors</h4>
          <p>Rio Grande Valley commercial hub survey coordination directly west.</p>
        </a>
        <a href="/texas/edinburg-solar-site-surveyors/" class="pha-link-card">
          <h4>Edinburg Solar Site Surveyors</h4>
          <p>Hidalgo County seat survey coordination and university corridor framing documentation directly northwest.</p>
        </a>
        <a href="/texas/mission-solar-site-surveyors/" class="pha-link-card">
          <h4>Mission Solar Site Surveyors</h4>
          <p>Western Valley citrus corridor residential survey coordination directly west.</p>
        </a>
        <a href="/texas/brownsville-solar-site-surveyors/" class="pha-link-card">
          <h4>Brownsville Solar Site Surveyors</h4>
          <p>BPUB municipal electric standards and coastal border survey operations southeast.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Pharr Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="pha-faq-list">
        {faqs.map(faq => (
          <div class="pha-faq-item card-technical">
            <h3 class="pha-faq-q">{faq.question}</h3>
            <p class="pha-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Pharr, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Pharr"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .pha-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .pha-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .pha-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .pha-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .pha-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .pha-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pha-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .pha-spec-list li:last-child {
    border-bottom: none;
  }

  .pha-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .pha-spec-list span {
    color: var(--text-secondary);
  }

  .pha-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .pha-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .pha-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .pha-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .pha-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .pha-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pha-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .pha-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .pha-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pha-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pha-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .pha-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .pha-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .pha-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
