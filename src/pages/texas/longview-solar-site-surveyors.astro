---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Longview, TX | SWEPCO Territory';
const pageDescription = 'Solar site surveys in Longview, TX. Operating under SWEPCO non-ERCOT standards, East Texas pine shading, and electrical service verification.';
const canonicalPath = '/texas/longview-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Longview' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Longview, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Longview, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Longview, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'SWEPCO Non-ERCOT Utility Solar Surveys',
    'Residential Solar Site Survey',
    'Pine Canopy Shade Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How does SWEPCO operate outside the ERCOT market in Longview?',
    answer: 'Longview is served by Southwestern Electric Power Company (SWEPCO), an operating company of American Electric Power (AEP) operating under the Southwest Power Pool (SPP) regional reliability council rather than ERCOT. SWEPCO maintains distinct distributed generation policies, net billing tariffs, specific meter socket standards, and manual exterior AC disconnect rules. Our surveyors photograph the digital SWEPCO meter badge, enclosure tags, and service disconnect to verify compliance before plan submittal.'
  },
  {
    question: 'How does heavy pine tree cover impact roof solar surveys in Gregg County?',
    answer: 'Longview is heavily forested with mature loblolly pines and sweetgums. Our surveyors take 360-degree tree line photos from multiple roof vantage points, measuring obstruction angles and overhangs so your CAD designers can accurately model solar irradiance.'
  },
  {
    question: 'What electrical panel configurations are common in Longview homes?',
    answer: 'Properties in Longview feature a mix of 100-amp and 150-amp main service panels in established neighborhoods, with newer builds equipped with 200-amp service equipment. We photograph panel labels, bus ratings, and open breaker slots to verify backfeed feasibility.'
  },
  {
    question: 'What framing conditions are documented across Longview residential properties?',
    answer: 'Established homes feature conventional 2x4 and 2x6 rafter construction with tongue-and-groove or plywood decking, while newer subdivisions feature engineered gang-nail trusses. We document framing member dimensions, spans, and decking materials with physical measurement photos.'
  },
  {
    question: 'Do your surveyors cover surrounding East Texas communities?',
    answer: 'Yes. Survey dispatches regularly connect Longview with Kilgore, Gladewater, Hallsville, Marshall, and Henderson.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Longview, TX</h1>
        <p class="lead">
          Field site documentation across Gregg and Harrison counties. Operating under SWEPCO non-ERCOT utility standards, managing East Texas pine canopy shading, and inspecting attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Longview Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SWEPCO Non-ERCOT Alert -->
  <section class="section">
    <div class="container">
      <div class="swepco-banner card-technical">
        <div class="swepco-header">
          <div class="swepco-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <div class="kicker">Critical Utility Distinction</div>
            <h2>Non-ERCOT Territory: Operating Under SWEPCO Interconnection Standards</h2>
          </div>
        </div>
        <p>
          Longview does not operate within the ERCOT electric market. Electric service is provided by Southwestern Electric Power Company (SWEPCO), an operating company of American Electric Power connected to the Southwest Power Pool (SPP) regional grid.
        </p>
        <p>
          Contractors submitting solar plan sets based on Oncor or CenterPoint standards face immediate interconnection delays. SWEPCO enforces specific distributed generation applications, distinct bi-directional meter base requirements, and external manual disconnect rules. Our survey packages focus heavily on collecting clear photographs of the SWEPCO meter base, service entrance mast, utility tags, and existing disconnect equipment. This verification ensures your interconnection team files the appropriate paperwork without back-and-forth utility inquiries.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Inspection Scope</div>
        <h2>Longview Site Survey Package Deliverables</h2>
        <p class="lead">
          Comprehensive physical data prepared to support engineering review and City of Longview building permits.
        </p>
      </div>

      <div class="swepco-grid">
        <div class="swepco-card card-technical">
          <h3>SWEPCO Electric Meter Equipment</h3>
          <p>
            We photograph the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete SWEPCO interconnection filing.
          </p>
        </div>

        <div class="swepco-card card-technical">
          <h3>Main Electrical Service Panels</h3>
          <p>
            The survey records busbar ratings, main breaker capacity, manufacturer data plates, and circuit breaker directories, confirming whether the electrical panel can accept a solar backfeed breaker.
          </p>
        </div>

        <div class="swepco-card card-technical">
          <h3>Pine Canopy Shading & Roof Geometry</h3>
          <p>
            We measure pitch angles, record azimuth, map roof planes, and photograph mature pine tree obstructions across multiple vantage points to define viable solar array layouts.
          </p>
        </div>

        <div class="swepco-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="swepco-card card-technical">
          <h3>Battery Backup & Inverter Clearances</h3>
          <p>
            For ESS projects, we record available wall space in attached garages or exterior side yards, verifying clearances from windows, doors, and gas meters to support code-compliant battery placement.
          </p>
        </div>

        <div class="swepco-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Full elevation photos document site access, fence gates, air conditioning equipment, and ladder setup areas to assist installation managers with build-day staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Piney Woods Operations</div>
        <h2>Connected Survey Coverage Across Surrounding East Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="swepco-links">
        <a href="/texas/tyler-solar-site-surveyors/" class="swepco-link-card">
          <h4>Tyler Solar Site Surveyors</h4>
          <p>Smith County commercial hub survey coordination and Oncor East utility documentation directly west.</p>
        </a>
        <a href="/texas/beaumont-solar-site-surveyors/" class="swepco-link-card">
          <h4>Beaumont Solar Site Surveyors</h4>
          <p>Entergy Texas territory and coastal hurricane corridor survey coordination directly south.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="swepco-link-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>North Texas metropolitan survey operations and Oncor utility documentation west.</p>
        </a>
        <a href="/texas/houston-solar-site-surveyors/" class="swepco-link-card">
          <h4>Houston Solar Site Surveyors</h4>
          <p>CenterPoint Houston territory and metropolitan survey operations southwest.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Longview Solar Survey Operations</h2>
        <p class="lead">Essential details for solar contractors and project coordinators.</p>
      </div>

      <div class="swepco-faq-list">
        {faqs.map(faq => (
          <div class="swepco-faq-item card-technical">
            <h3 class="swepco-faq-q">{faq.question}</h3>
            <p class="swepco-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in Longview, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and ensure your field package meets SWEPCO requirements."
    primaryCtaText="Schedule Survey in Longview"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .swepco-banner {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 6px solid var(--accent-gold);
    max-width: 1000px;
    margin: 0 auto;
  }

  .swepco-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .swepco-icon {
    color: var(--accent-gold);
    margin-top: 0.25rem;
  }

  .swepco-banner h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .swepco-banner p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .swepco-banner p:last-child {
    margin-bottom: 0;
  }

  .swepco-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .swepco-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .swepco-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .swepco-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .swepco-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .swepco-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .swepco-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .swepco-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .swepco-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .swepco-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .swepco-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .swepco-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .swepco-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
