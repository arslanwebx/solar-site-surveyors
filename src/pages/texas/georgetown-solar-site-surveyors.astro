---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Georgetown, TX | GUS Utility';
const pageDescription = 'Solar site surveys in Georgetown, TX. Aligning with Georgetown Utility Systems (GUS) standards, roof plane geometry, and framing across Williamson County.';
const canonicalPath = '/texas/georgetown-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Georgetown' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Georgetown, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Georgetown, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Georgetown, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Municipal Utility Solar Surveys',
    'Residential Solar Site Survey',
    'GUS Meter Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do Georgetown Utility Systems (GUS) standards affect solar surveys?',
    answer: 'Georgetown Utility Systems (GUS) is a municipal electric utility with specific distributed generation interconnection rules. GUS requires dedicated customer generation applications, specific meter socket standards, and accessible exterior AC disconnect switches. Our survey packages capture high-resolution photos of the GUS meter base, label numbers, and service entrance disconnects to verify compliance before plan submittal.'
  },
  {
    question: 'Are all Georgetown addresses served by Georgetown Utility Systems?',
    answer: 'While the majority of properties inside the city limits are in GUS territory, certain outer neighborhoods and extraterritorial areas in Williamson County connect to Oncor Electric Delivery or Pedernales Electric Cooperative (PEC). We verify the meter enclosure and utility labels on site so your team files with the proper provider.'
  },
  {
    question: 'What roof and framing conditions are typical across Sun City and Wolf Ranch?',
    answer: 'Sun City properties predominantly feature single-story homes with low-to-medium pitch hip roofs, while newer communities like Wolf Ranch feature complex multi-story construction with steep roof profiles. We measure pitch per plane, record azimuth, map plumbing vents, and record truss spacing with physical measurement photos.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do you cover projects across northern Williamson County?',
    answer: 'Yes. Survey dispatches regularly connect Georgetown with Round Rock, Leander, Liberty Hill, Jarrell, and Salado.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Georgetown, TX</h1>
        <p class="lead">
          Accurate field data collection aligned with Georgetown Utility Systems (GUS) municipal standards. Documenting electrical equipment, roof plane geometry, and attic framing across Williamson County.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Georgetown Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- GUS Municipal Utility Alert -->
  <section class="section">
    <div class="container">
      <div class="gus-banner card-technical">
        <div class="gus-header">
          <div class="gus-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <div class="kicker">Municipal Utility Notice</div>
            <h2>Georgetown Utility Systems (GUS) Interconnection Requires Property-Specific Data</h2>
          </div>
        </div>
        <p>
          Georgetown does not operate under generic transmission utility rules. Electric service is managed by Georgetown Utility Systems (GUS), a municipal utility that maintains independent distributed generation rules, distinct net billing policies, and specific meter disconnect standards.
        </p>
        <p>
          Contractors who submit interconnection applications assuming Oncor procedures experience permit holds and utility rejections. Our survey packages focus heavily on collecting clear photographs of the GUS meter base, service entrance mast, utility tags, and existing disconnect equipment. This verification ensures your interconnection team files the appropriate paperwork without back-and-forth utility inquiries.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Inspection Scope</div>
        <h2>Georgetown Site Survey Package Deliverables</h2>
        <p class="lead">
          Comprehensive physical data prepared to support engineering review and City of Georgetown building permits.
        </p>
      </div>

      <div class="gus-grid">
        <div class="gus-card card-technical">
          <h3>GUS Electric Meter Equipment</h3>
          <p>
            We photograph the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete GUS interconnection filing.
          </p>
        </div>

        <div class="gus-card card-technical">
          <h3>Main Electrical Service Panels</h3>
          <p>
            The survey records busbar ratings, main breaker capacity, manufacturer data plates, and circuit breaker directories, confirming whether the electrical panel can accept a solar backfeed breaker.
          </p>
        </div>

        <div class="gus-card card-technical">
          <h3>Sun City & Wolf Ranch Roof Geometry</h3>
          <p>
            From single-story active adult residences in Sun City to multi-story production homes in Wolf Ranch, we record pitch angles, azimuth, and all roof penetrations to define usable array boundaries.
          </p>
        </div>

        <div class="gus-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="gus-card card-technical">
          <h3>Battery Backup & Inverter Clearances</h3>
          <p>
            For ESS projects, we record available wall space in attached garages or exterior side yards, verifying clearances from windows, doors, and gas meters to support code-compliant battery placement.
          </p>
        </div>

        <div class="gus-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Full elevation photos document site access, fence gates, air conditioning equipment, and ladder setup areas to assist installation managers with build-day staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Williamson County Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Central Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="gus-links">
        <a href="/texas/round-rock-solar-site-surveyors/" class="gus-link-card">
          <h4>Round Rock Solar Site Surveyors</h4>
          <p>High-density Williamson County tech corridor survey coordination directly south.</p>
        </a>
        <a href="/texas/leander-solar-site-surveyors/" class="gus-link-card">
          <h4>Leander Solar Site Surveyors</h4>
          <p>Pedernales Electric Cooperative service data and Hill Country framing directly southwest.</p>
        </a>
        <a href="/texas/temple-solar-site-surveyors/" class="gus-link-card">
          <h4>Temple Solar Site Surveyors</h4>
          <p>Bell County medical corridor survey coordination and framing documentation directly north.</p>
        </a>
        <a href="/texas/austin-solar-site-surveyors/" class="gus-link-card">
          <h4>Austin Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Austin-Round Rock metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Georgetown Solar Survey Operations</h2>
        <p class="lead">Essential details for solar contractors and project coordinators.</p>
      </div>

      <div class="gus-faq-list">
        {faqs.map(faq => (
          <div class="gus-faq-item card-technical">
            <h3 class="gus-faq-q">{faq.question}</h3>
            <p class="gus-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in Georgetown, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and ensure your field package meets Georgetown Utility Systems standards."
    primaryCtaText="Schedule Survey in Georgetown"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .gus-banner {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 6px solid var(--accent-gold);
    max-width: 1000px;
    margin: 0 auto;
  }

  .gus-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .gus-icon {
    color: var(--accent-gold);
    margin-top: 0.25rem;
  }

  .gus-banner h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .gus-banner p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .gus-banner p:last-child {
    margin-bottom: 0;
  }

  .gus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .gus-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .gus-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .gus-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .gus-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .gus-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .gus-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .gus-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .gus-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .gus-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .gus-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .gus-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .gus-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
