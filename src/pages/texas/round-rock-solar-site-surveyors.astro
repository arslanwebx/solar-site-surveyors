---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Round Rock, TX | Tech Corridor';
const pageDescription = 'Solar site surveys in Round Rock, TX. Documenting Oncor service panels, complex roof plane geometry, and attic framing across Williamson County.';
const canonicalPath = '/texas/round-rock-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Round Rock' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Round Rock, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Round Rock, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Round Rock, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Main Electrical Service Inspection',
    'Attic Framing Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do City of Round Rock building inspections handle solar permits?',
    answer: 'The City of Round Rock Building Inspection Division enforces current residential building and electrical codes. Plan reviewers examine structural mounting attachments, single-line diagrams, and equipment specification sheets. Our field survey packages capture readable data plate photos and physical framing measurements to help your team pass permit review on the initial submittal.'
  },
  {
    question: 'Which electric utility serves Round Rock solar installations?',
    answer: 'Round Rock is primarily located within Oncor Electric Delivery territory. We photograph the meter enclosure, digital display, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for Oncor distributed generation filings.'
  },
  {
    question: 'What electrical panel configurations are common in Round Rock homes?',
    answer: 'Modern master-planned subdivisions across Round Rock frequently feature 200-amp main service panels, with larger custom homes equipped with 400-amp split services. The surveyor records busbar ratings, main breaker capacities, and available breaker slots to verify backfeed feasibility.'
  },
  {
    question: 'How do you document complex hip roofs in Round Rock master-planned communities?',
    answer: 'Properties in Round Rock often showcase multi-plane hip roofs with steep pitches, dormers, and multiple valleys. We measure pitch angles per plane, record azimuth, map plumbing vents, and calculate usable array areas within local fire code setbacks.'
  },
  {
    question: 'Do you cover projects across the North Austin and Williamson County corridor?',
    answer: 'Yes. Survey dispatches regularly connect Round Rock with Pflugerville, Hutto, Georgetown, Cedar Park, and North Austin.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Round Rock, TX</h1>
        <p class="lead">
          Field site documentation across the North Austin technology corridor. Delivering verified electrical service records, attic structural framing data, and multi-plane roof geometry for solar EPC design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Round Rock</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Williamson County Tech Hub Focus -->
  <section class="section">
    <div class="container">
      <div class="rr-split">
        <div class="rr-text">
          <div class="kicker">Operational Focus</div>
          <h2>North Austin Tech Corridor: High-Velocity Solar Engineering Handoffs</h2>
          <p>
            Round Rock is the economic powerhouse of Williamson County, situated directly north of Austin. Known as a major technology and corporate center, the city features extensive master-planned communities characterized by large two-story single-family homes, limestone exterior masonry, and multi-faceted roof architectures.
          </p>
          <p>
            For solar contractors managing high installation volumes in Round Rock, rapid project throughput relies on eliminating design ambiguities. When remote CAD engineers work from incomplete site photos, they frequently make assumptions regarding panel busbar ratings or attic truss spacing. If an assumption fails to match the physical property, plan reviewers issue comments, and field crews encounter unexpected site conditions on installation day.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Round Rock address. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your design team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="rr-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Round Rock Operating Overview</h3>
          <ul class="rr-spec-list">
            <li>
              <strong>County:</strong>
              <span>Williamson County, Travis County overlap</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Round Rock Building Inspection</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Modern master plans, two-story stone and brick homes</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>200A to 400A split residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Round Rock Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="rr-grid">
        <div class="rr-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="rr-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="rr-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="rr-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="rr-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="rr-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Williamson County Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Central Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="rr-links">
        <a href="/texas/georgetown-solar-site-surveyors/" class="rr-link-card">
          <h4>Georgetown Solar Site Surveyors</h4>
          <p>Georgetown Utility Systems municipal standards and Sun City roof plane documentation directly north.</p>
        </a>
        <a href="/texas/leander-solar-site-surveyors/" class="rr-link-card">
          <h4>Leander Solar Site Surveyors</h4>
          <p>Pedernales Electric Cooperative service data and Hill Country framing directly northwest.</p>
        </a>
        <a href="/texas/austin-solar-site-surveyors/" class="rr-link-card">
          <h4>Austin Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Austin metropolitan area.</p>
        </a>
        <a href="/texas/killeen-solar-site-surveyors/" class="rr-link-card">
          <h4>Killeen Solar Site Surveyors</h4>
          <p>Fort Cavazos corridor high-density residential survey coordination further north.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Round Rock Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="rr-faq-list">
        {faqs.map(faq => (
          <div class="rr-faq-item card-technical">
            <h3 class="rr-faq-q">{faq.question}</h3>
            <p class="rr-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Round Rock, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Round Rock"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .rr-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .rr-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .rr-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .rr-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .rr-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .rr-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rr-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .rr-spec-list li:last-child {
    border-bottom: none;
  }

  .rr-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .rr-spec-list span {
    color: var(--text-secondary);
  }

  .rr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .rr-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .rr-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .rr-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .rr-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .rr-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .rr-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .rr-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .rr-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .rr-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rr-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .rr-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .rr-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .rr-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
