---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Allen, TX | CAD-Ready Field Data';
const pageDescription = 'Solar site surveys in Allen, TX for solar EPCs. Standardized roof geometry, 200-amp electrical panels, and battery clearances across central Collin County.';
const canonicalPath = '/texas/allen-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Allen' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Allen, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Allen, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Allen, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Electrical Panel Verification',
    'Battery Storage Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do City of Allen building permits impact solar design requirements?',
    answer: 'The City of Allen Community Development Department requires detailed structural calculations and single-line electrical diagrams that accurately reflect property equipment. Ambiguous rafter spans or missing panel labels frequently trigger review comments. Our field package documents truss spacing, member sizing, bus ratings, and disconnect hardware to support prompt plan approvals.'
  },
  {
    question: 'Which electric utilities serve Allen solar installations?',
    answer: 'Allen is primarily served by Oncor Electric Delivery, with portions of western Allen falling under CoServ Electric territory. We verify the meter enclosure, badge number, and disconnect hardware on site to ensure your interconnection paperwork is filed with the proper utility.'
  },
  {
    question: 'What roof conditions are documented across Allen subdivisions?',
    answer: 'Allen features predominantly modern two-story single-family homes with multi-plane composition shingle roofs. The survey records pitch angles per plane, shingle condition, ridge vents, plumbing pipe penetrations, and dormers to define usable array boundaries.'
  },
  {
    question: 'Can you survey battery backup locations in attached garages?',
    answer: 'Yes. The surveyor records available wall dimensions, notes clearances to garage doors, windows, and water heaters, and evaluates conduit routing back to the main electrical service panel.'
  },
  {
    question: 'Do you provide survey coverage across neighboring Collin County cities?',
    answer: 'Yes. Survey dispatches regularly connect Allen projects with contiguous properties in Plano, McKinney, Frisco, and Fairview.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Allen, TX</h1>
        <p class="lead">
          High-precision field site surveys across central Collin County. Delivering standardized roof geometry, electrical service records, and battery clearance measurements for solar EPC design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Allen</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Central Collin County Context -->
  <section class="section">
    <div class="container">
      <div class="allen-split">
        <div class="allen-text">
          <div class="kicker">Operational Focus</div>
          <h2>High-Density Suburban Coordination Across Central Collin County</h2>
          <p>
            Allen represents a prime North DFW residential market characterized by master-planned neighborhoods, active homeowners associations, and modern two-story construction. Solar EPCs managing installations in Allen require rapid, accurate design handoffs to keep installation queues moving without permitting friction.
          </p>
          <p>
            Because properties in Allen frequently feature steep multi-plane roofs and high-ampacity electrical service panels, remote design departments cannot rely on satellite approximations. If roof pitch is miscalculated or attic truss spacing is assumed, structural engineering calculations must be revised, adding days to project timelines.
          </p>
          <p>
            Our surveyor coordination delivers structured, comprehensive site packages for every Allen address. We collect physical measurements, macro photographs of electrical data plates, and verified attic framing details so your engineering team can draft accurate, permit-ready plans immediately.
          </p>
        </div>
        <div class="allen-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Allen Operating Overview</h3>
          <ul class="allen-spec-list">
            <li>
              <strong>County:</strong>
              <span>Collin County</span>
            </li>
            <li>
              <strong>Electric Utilities:</strong>
              <span>Oncor Electric Delivery and CoServ Electric</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Allen Community Development</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Modern master-planned subdivisions, two-story brick homes</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>200A main service panels, 400A split services</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Allen Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="allen-grid">
        <div class="allen-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="allen-card card-technical">
          <h3>Utility Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor or CoServ interconnection filing.
          </p>
        </div>

        <div class="allen-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="allen-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="allen-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="allen-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Collin County Operations</div>
        <h2>Connected Survey Coverage Across Surrounding DFW Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="allen-links">
        <a href="/texas/plano-solar-site-surveyors/" class="allen-link-card">
          <h4>Plano Solar Site Surveyors</h4>
          <p>High-density North DFW residential survey coordination and engineering handoffs directly south.</p>
        </a>
        <a href="/texas/mckinney-solar-site-surveyors/" class="allen-link-card">
          <h4>McKinney Solar Site Surveyors</h4>
          <p>Framing documentation from historic downtown to modern production builds directly north.</p>
        </a>
        <a href="/texas/frisco-solar-site-surveyors/" class="allen-link-card">
          <h4>Frisco Solar Site Surveyors</h4>
          <p>Steep roof plane geometry, dual-utility boundaries, and high-velocity residential design coordination.</p>
        </a>
        <a href="/texas/richardson-solar-site-surveyors/" class="allen-link-card">
          <h4>Richardson Solar Site Surveyors</h4>
          <p>Telecom corridor housing stock, tree shading analysis, and legacy panel documentation.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Allen Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="allen-faq-list">
        {faqs.map(faq => (
          <div class="allen-faq-item card-technical">
            <h3 class="allen-faq-q">{faq.question}</h3>
            <p class="allen-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Allen, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Allen"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .allen-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .allen-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .allen-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .allen-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .allen-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .allen-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .allen-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .allen-spec-list li:last-child {
    border-bottom: none;
  }

  .allen-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .allen-spec-list span {
    color: var(--text-secondary);
  }

  .allen-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .allen-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .allen-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .allen-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .allen-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .allen-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .allen-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .allen-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .allen-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .allen-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .allen-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .allen-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .allen-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .allen-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
