---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Midland, TX | Permian Basin Surveys';
const pageDescription = 'Solar site surveys in Midland, TX. Documenting Oncor service panels, high-insolation Permian Basin roof planes, and caliche dust exposure.';
const canonicalPath = '/texas/midland-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Midland' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Midland, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Midland, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Midland, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Electrical Panel Verification',
    'Permian Basin High-Sun Solar Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do high summer temperatures and dust impact solar surveys in Midland?',
    answer: 'Midland experiences extreme summer heat and frequent caliche dust exposure from surrounding oilfield operations. Our surveyors clear nameplates on exterior electrical equipment to capture legible catalog numbers and busbar ratings. We also record roof surface temperature conditions and inspect shingle granule adhesion.'
  },
  {
    question: 'Which utility company serves Midland solar installations?',
    answer: 'Midland is served by Oncor Electric Delivery. We photograph the digital meter display, meter enclosure, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for Oncor distributed generation filings.'
  },
  {
    question: 'What electrical panel configurations are common in Midland homes?',
    answer: 'Properties in Midland feature a mix of 150-amp and 200-amp main service panels in established neighborhoods, with newer custom homes frequently equipped with 400-amp split services. We photograph panel labels, bus ratings, and open breaker slots to verify backfeed feasibility.'
  },
  {
    question: 'What roof types and framing conditions are typical across Midland?',
    answer: 'Midland features single-story ranch homes and two-story modern builds with composition shingle roofs on low-to-medium pitch gable and hip planes. We document rafter or truss dimensions, center-to-center spacing, purlin bracing, and roof decking thickness with measurement photos.'
  },
  {
    question: 'Do you cover projects across the Permian Basin region?',
    answer: 'Yes. Survey dispatches regularly connect Midland with Odessa, Greenwood, Stanton, Big Spring, and Andrews.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Midland, TX</h1>
        <p class="lead">
          Field site documentation across the Permian Basin energy hub. Standardizing electrical panel verification, high-insolation roof geometry, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Midland</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Permian Basin Focus -->
  <section class="section">
    <div class="container">
      <div class="mid-split">
        <div class="mid-text">
          <div class="kicker">Operational Focus</div>
          <h2>Permian Basin Energy Capital: High-Insolation Field Site Verification</h2>
          <p>
            Midland stands as the corporate and financial headquarters of the Permian Basin. With some of the highest solar irradiance levels in North America and heavy residential electric consumption driven by long, intense summer cooling seasons, Midland is a prime market for residential and commercial solar deployment.
          </p>
          <p>
            However, operating in the Permian Basin presents distinct environmental challenges. Exterior electrical equipment is routinely exposed to wind-blown caliche dust, intense ultraviolet degradation, and extreme temperature fluctuations. If a field surveyor provides blurry photos of weathered electrical labels, remote CAD engineers cannot verify busbar ratings, leading to permit plan rejections or costly installation-day delays.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Midland project. We clean and document electrical data plates, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your design team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="mid-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Midland Operating Overview</h3>
          <ul class="mid-spec-list">
            <li>
              <strong>County:</strong>
              <span>Midland County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Midland Code Administration</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Mid-century brick ranches, modern custom subdivisions</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>150A to 400A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Midland Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="mid-grid">
        <div class="mid-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="mid-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="mid-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="mid-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="mid-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="mid-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Permian Basin Operations</div>
        <h2>Connected Survey Coverage Across Surrounding West Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="mid-links">
        <a href="/texas/odessa-solar-site-surveyors/" class="mid-link-card">
          <h4>Odessa Solar Site Surveyors</h4>
          <p>Ector County residential survey coordination and low-slope roof plane mapping directly west.</p>
        </a>
        <a href="/texas/lubbock-solar-site-surveyors/" class="mid-link-card">
          <h4>Lubbock Solar Site Surveyors</h4>
          <p>LP&L retail choice market transition and South Plains residential survey coordination directly north.</p>
        </a>
        <a href="/texas/san-angelo-solar-site-surveyors/" class="mid-link-card">
          <h4>San Angelo Solar Site Surveyors</h4>
          <p>Concho Valley residential survey coordination and AEP Texas North documentation directly southeast.</p>
        </a>
        <a href="/texas/abilene-solar-site-surveyors/" class="mid-link-card">
          <h4>Abilene Solar Site Surveyors</h4>
          <p>AEP Texas North territory and Big Country residential framing documentation directly east.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Midland Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="mid-faq-list">
        {faqs.map(faq => (
          <div class="mid-faq-item card-technical">
            <h3 class="mid-faq-q">{faq.question}</h3>
            <p class="mid-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Midland, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Midland"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .mid-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .mid-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .mid-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .mid-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .mid-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .mid-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mid-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .mid-spec-list li:last-child {
    border-bottom: none;
  }

  .mid-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .mid-spec-list span {
    color: var(--text-secondary);
  }

  .mid-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .mid-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .mid-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .mid-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .mid-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .mid-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mid-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .mid-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .mid-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .mid-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mid-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .mid-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .mid-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .mid-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
