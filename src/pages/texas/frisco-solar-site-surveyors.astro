---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Frisco, TX | Roof & Electrical';
const pageDescription = 'Precision solar site surveys in Frisco, TX for solar installers and EPCs. Documenting steep roof planes, electrical panels, and dual-utility boundaries.';
const canonicalPath = '/texas/frisco-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Frisco' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Frisco, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Frisco, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Frisco, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Steep Roof Pitch Solar Survey',
    'Battery Backup Site Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do dual-utility boundaries affect Frisco solar projects?',
    answer: 'Frisco properties are divided between Oncor Electric Delivery and CoServ Electric. The two utilities have different interconnection forms, meter disconnect rules, and review timelines. Our surveyors record the exact meter number, enclosure tags, and service disconnect configuration so your interconnection team submits the application to the correct utility.'
  },
  {
    question: 'How do your surveyors handle steep multi-plane roofs in Frisco?',
    answer: 'Frisco residential architecture commonly features 8/12, 10/12, and 12/12 pitch roof profiles with numerous hips, valleys, and dormers. We document pitch angles, measure ridge lengths, map plumbing vent locations, and calculate usable plane areas to ensure your CAD designers place arrays strictly within buildable fire code boundaries.'
  },
  {
    question: 'Are modern Frisco homes typically equipped with 200-amp panels?',
    answer: 'Yes, most homes built within the past twenty years feature 200-amp or 400-amp split electrical services. However, many panels have full breaker slots or solar-ready busbars with specific tap limitations. We photograph all interior schedules, bus ratings, and main breakers to confirm backfeed feasibility.'
  },
  {
    question: 'What battery storage details are collected for Frisco properties?',
    answer: 'We evaluate interior garage wall space and exterior side yards for battery placement. We record distances to garage entry doors, windows, gas meters, and AC equipment, providing clear measurement notes to support code-compliant ESS plan drafting.'
  },
  {
    question: 'What is the scheduling turnaround for a Frisco site survey?',
    answer: 'Surveys are scheduled based on customer access availability and route coordination across Collin and Denton counties. Contact our operations desk via WhatsApp to verify current calendar openings.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Frisco, TX</h1>
        <p class="lead">
          Field site documentation tailored for fast-moving North DFW solar EPCs. Capturing complex roof plane geometry, attic truss framing, electrical bus ratings, and CoServ versus Oncor utility data.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Frisco</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Dual Utility & Operational Realities -->
  <section class="section">
    <div class="container">
      <div class="frisco-split">
        <div class="frisco-text">
          <div class="kicker">Operational Focus</div>
          <h2>Navigating Dual Utility Boundaries Across Frisco Projects</h2>
          <p>
            Frisco is one of the most active residential construction markets in the country. For solar operations managers, it presents a unique operational detail: service territory is split between Oncor Electric Delivery and CoServ Electric. A project on the west side of town may follow CoServ interconnection procedures, while an address just three miles east connects to the Oncor grid.
          </p>
          <p>
            In addition to utility boundaries, Frisco homes showcase complex roof architectures. Steep pitch profiles, nested hips, valley flashings, and multiple second-story dormers mean usable roof area cannot be estimated from satellite imagery alone. If a remote designer assumes a standard 4/12 slope, racking hardware specifications will be incorrect, and array layouts will encroach on mandatory fire setbacks.
          </p>
          <p>
            Our survey coordination resolves these uncertainties before design work begins. We capture physical pitch measurements, map obstruction coordinates, record electrical service parameters, and verify the serving utility on site.
          </p>
        </div>
        <div class="frisco-profile card-technical">
          <div class="profile-badge">Frisco Overview</div>
          <h3>Local Operating Realities</h3>
          <ul class="frisco-list">
            <li>
              <strong>Jurisdictions:</strong>
              <span>Collin County, Denton County overlap</span>
            </li>
            <li>
              <strong>Electric Providers:</strong>
              <span>CoServ Electric and Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Frisco Building Inspections</span>
            </li>
            <li>
              <strong>Roof Profiles:</strong>
              <span>High-slope composition shingle, tile accents, steep valleys</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>200A to 400A main service equipment</span>
            </li>
            <li>
              <strong>Design Support:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Permit-Ready CAD</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Module: Complex Roof & Attic Inspection -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Technical Scope</div>
        <h2>What Our Frisco Site Survey Packages Capture</h2>
        <p class="lead">
          Comprehensive field measurements designed for remote CAD engineers and structural review.
        </p>
      </div>

      <div class="frisco-grid">
        <div class="frisco-card card-technical">
          <h3>Complex Roof Plane Geometry</h3>
          <p>
            We measure pitch angles per roof face using digital level tools, photograph all plane transitions, and identify structural valleys, hips, and ridges. Usable plane dimensions are measured to ensure panel layouts honor City of Frisco fire setbacks.
          </p>
        </div>

        <div class="frisco-card card-technical">
          <h3>Roof Penetrations & Obstructions</h3>
          <p>
            Plumbing pipe vents, HVAC exhaust vents, attic fans, and skylights are photographed with reference dimensions. This prevents CAD designers from placing solar modules over physical penetrations that would require on-site rework.
          </p>
        </div>

        <div class="frisco-card card-technical">
          <h3>Attic Framing & Truss Spacing</h3>
          <p>
            Frisco homes predominantly feature engineered roof truss systems. The surveyor documents truss member sizes, web configurations, metal gusset plate stamps, and center-to-center spacing to support structural engineering calculations.
          </p>
        </div>

        <div class="frisco-card card-technical">
          <h3>Main Electrical Service Panel</h3>
          <p>
            We capture wide-angle and close-up photographs of the panel interior, busbar rating, main breaker capacity, and circuit breaker directory. We identify any solar-ready provisions or available slots for interconnection breakers.
          </p>
        </div>

        <div class="frisco-card card-technical">
          <h3>Utility Meter & Disconnect Hardware</h3>
          <p>
            We record utility meter tags, socket enclosures, overhead or underground entrance conduits, and existing AC disconnects. We document whether CoServ or Oncor rules dictate specific exterior disconnect placement.
          </p>
        </div>

        <div class="frisco-card card-technical">
          <h3>Battery & ESS Wall Setbacks</h3>
          <p>
            For whole-home energy storage projects, we verify garage and exterior wall clearances. We measure distances to doors, windows, gas meters, and vehicle pathways to ensure compliance with NFPA 855 standards.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Neighboring North DFW Markets -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Regional Pipeline</div>
        <h2>Coordinated Surveying Across Adjacent Collin & Denton Cities</h2>
        <p class="lead">
          Maintain consistent field data quality as your installation crews move between neighboring North DFW markets.
        </p>
      </div>

      <div class="market-links">
        <a href="/texas/plano-solar-site-surveyors/" class="market-item">
          <h4>Plano Solar Site Surveyors</h4>
          <p>High-density residential survey coordination and engineering handoffs south of Frisco.</p>
        </a>
        <a href="/texas/mckinney-solar-site-surveyors/" class="market-item">
          <h4>McKinney Solar Site Surveyors</h4>
          <p>Framing documentation from historic downtown to modern master-planned communities.</p>
        </a>
        <a href="/texas/allen-solar-site-surveyors/" class="market-item">
          <h4>Allen Solar Site Surveyors</h4>
          <p>Suburban roof plane documentation and rapid design coordination directly east.</p>
        </a>
        <a href="/texas/lewisville-solar-site-surveyors/" class="market-item">
          <h4>Lewisville Solar Site Surveyors</h4>
          <p>Lake-adjacent residential site data and utility coordination across Denton County.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Frisco Solar Survey Operations</h2>
        <p class="lead">Answers to key operational questions from solar project managers.</p>
      </div>

      <div class="faq-group">
        {faqs.map(faq => (
          <div class="faq-row card-technical">
            <h3 class="faq-q">{faq.question}</h3>
            <p class="faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Frisco, TX?"
    subtitle="Submit your project address to coordinate a prompt field visit and receive CAD-ready documentation for your design team."
    primaryCtaText="Schedule Survey in Frisco"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .frisco-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .frisco-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .frisco-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .frisco-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .frisco-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .frisco-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .frisco-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .frisco-list li:last-child {
    border-bottom: none;
  }

  .frisco-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .frisco-list span {
    color: var(--text-secondary);
  }

  .frisco-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .frisco-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .frisco-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .frisco-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .market-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .market-item {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .market-item:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .market-item h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .market-item p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .faq-group {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-row {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .frisco-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
