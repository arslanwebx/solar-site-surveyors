---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in San Antonio, TX';
const pageDescription = 'Solar site surveys in San Antonio and CPS Energy territory. Roof, attic, electrical, and battery field documentation for EPCs, installers, and engineering teams across Bexar County.';
const canonicalPath = '/texas/san-antonio-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'San Antonio' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in San Antonio, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors — San Antonio, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'San Antonio, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': ['Solar Site Surveys', 'Residential Solar Site Survey', 'Commercial Solar Site Survey'],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How does CPS Energy affect solar site survey requirements in San Antonio?',
    answer: 'CPS Energy is a municipally owned utility with specific interconnection and metering documentation requirements. Our surveys capture meter socket configuration, service entrance details, and panel information that align with what CPS Energy and local permitting offices typically request for solar applications.'
  },
  {
    question: 'Do you survey properties near military bases like JBSA?',
    answer: 'Yes. We coordinate surveys in neighborhoods adjacent to Joint Base San Antonio installations — Lackland, Randolph, and Fort Sam Houston areas. Base-adjacent properties often have specific height restrictions or HOA considerations that we document during the field visit.'
  },
  {
    question: 'What areas of San Antonio do you cover?',
    answer: 'Our coverage spans the San Antonio metro including Alamo Heights, Stone Oak, Helotes, Converse, Schertz, New Braunfels, and unincorporated Bexar County areas. Submit the project address for specific confirmation.'
  },
  {
    question: 'Can you document attic and structural framing in older San Antonio homes?',
    answer: 'Where attic access is available and safe, our surveyors document rafter or truss dimensions, spacing, span, decking type, and framing condition. Older homes in areas like Monte Vista or Dignowity Hill may have non-standard framing that requires additional measurement detail.'
  },
  {
    question: 'What is included in the photo documentation package?',
    answer: 'A categorized HD photo set covering roof surfaces, structural framing, electrical equipment, meter configuration, proposed equipment areas, obstructions, and property exterior. Photos are labeled by category — not delivered as an unorganized batch.'
  },
  {
    question: 'How do I submit a survey request?',
    answer: 'Contact our operations desk via WhatsApp with the property address, project scope, and any custom checklist requirements. We confirm surveyor availability and schedule the field visit from there.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <!-- Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in San Antonio, TX</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 900px;">
          San Antonio runs on CPS Energy — one of the nation's largest municipally owned utilities — and that creates a distinct interconnection and documentation environment for solar projects. Our field surveys are structured to capture what CPS Energy applications and Bexar County permitting offices expect.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="sa-schedule-btn">
            <span>Schedule a San Antonio Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: CPS Energy Context -->
  <section class="section section-warm">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Utility Territory</div>
        <h2>CPS Energy Territory and What It Means for Solar Site Surveys</h2>
      </div>
      <div class="editorial-prose">
        <p>
          Unlike most of Texas where investor-owned utilities like Oncor handle transmission and distribution, San Antonio's electric service is managed by CPS Energy — a city-owned utility serving over 900,000 electric customers across Bexar County and portions of surrounding counties. This means solar interconnection applications, meter documentation requirements, and net metering program details flow through a single municipal entity rather than the ERCOT retail market structure.
        </p>
        <p>
          For solar EPCs and design teams, this creates specific documentation expectations during the site survey phase. Meter socket type, service entrance rating, main breaker configuration, and utility-side equipment all need to be captured accurately because CPS Energy reviews this information during the interconnection application process. Our survey protocol accounts for these utility-specific requirements.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Survey Deliverables (3-column) -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Survey Scope</div>
        <h2>Field Documentation Deliverables</h2>
        <p class="lead">Organized data for your design, engineering, and permitting teams.</p>
      </div>

      <div class="deliverables-tri">
        <div class="del-card card-technical">
          <div class="del-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Roof & Structural</h3>
          <p>Roof geometry, pitch, material, obstruction mapping, and accessible attic framing — rafter dimensions, spacing, span, and decking condition.</p>
        </div>
        <div class="del-card card-technical">
          <div class="del-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Electrical & Utility Metering</h3>
          <p>Main panel, bus rating, breaker ampacity, available slots, meter socket configuration, grounding, and CPS Energy service entrance documentation.</p>
        </div>
        <div class="del-card card-technical">
          <div class="del-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3>Battery, ESS & Property</h3>
          <p>ESS candidate walls, NFPA 855 clearance measurements, exterior elevations, equipment locations, conduit routes, and categorized photo package.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Military Housing -->
  <section class="section section-dark">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker" style="color: var(--accent-gold);">Local Market</div>
        <h2 style="color: #FFFFFF;">Military Housing & Solar: Base-Adjacent Neighborhoods</h2>
      </div>
      <div class="editorial-prose" style="color: #9FB3C8;">
        <p>
          San Antonio is home to Joint Base San Antonio — the largest joint military installation in the Department of Defense — with Lackland, Randolph, and Fort Sam Houston forming the backbone of significant residential communities around the metro. Neighborhoods like Converse, Universal City, Live Oak, and Schertz have high concentrations of military families and veterans who own homes near these installations.
        </p>
        <p>
          Solar site surveys in these areas often involve properties with HOA deed restrictions, height limitations, and specific roof configurations common to 1990s–2010s military-area tract housing. Our surveyors document the property conditions that matter for solar design — including roof-facing orientations, setback constraints, and any visible covenants or signage that could affect panel placement.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Operations Specs -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Service Standards</div>
        <h2>San Antonio Survey Operations</h2>
      </div>
      <div class="table-wrap card-technical">
        <table class="specs-table">
          <tbody>
            <tr>
              <td><strong>Coverage Area</strong></td>
              <td>San Antonio, Bexar County, and adjacent communities — Alamo Heights, Stone Oak, Helotes, Converse, Schertz, New Braunfels</td>
            </tr>
            <tr>
              <td><strong>Utility Territory</strong></td>
              <td>CPS Energy (municipally owned electric utility)</td>
            </tr>
            <tr>
              <td><strong>Deliverables</strong></td>
              <td>CAD-ready photo set, digital field measurement log, categorized documentation organized by scope area</td>
            </tr>
            <tr>
              <td><strong>Compliance Reference</strong></td>
              <td>NEC 2020/2023, NFPA 855, City of San Antonio building and electrical permit requirements</td>
            </tr>
            <tr>
              <td><strong>Target Audience</strong></td>
              <td>Solar EPCs, installers, design engineering teams, and operations coordinators</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Common Questions</div>
        <h2>San Antonio Site Survey FAQ</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTASection
    title="Need a Solar Site Survey in San Antonio?"
    subtitle="Reach our operations desk via WhatsApp to coordinate surveyor availability across the San Antonio metro and CPS Energy territory."
    primaryCtaText="Schedule in San Antonio"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Hub"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
    text-align: center;
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: var(--space-4);
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  .narrow-content {
    max-width: 860px;
  }

  .editorial-prose p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .editorial-prose p:last-child {
    margin-bottom: 0;
  }

  /* 3-column deliverables */
  .deliverables-tri {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .del-card {
    padding: var(--space-6);
    text-align: center;
  }

  .del-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background-color: var(--accent-gold-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
  }

  .del-card h3 {
    font-size: 1.0625rem;
    color: var(--primary);
    margin-bottom: var(--space-2);
  }

  .del-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Specs Table */
  .table-wrap {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 990px;
    margin: 0 auto;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--accent-gold);
  }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .faq-item[open] .faq-question::after {
    content: '−';
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-5);
  }

  .faq-answer p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .deliverables-tri { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .deliverables-tri { grid-template-columns: 1fr; }
  }
</style>
