---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Austin, TX';
const pageDescription = 'Solar site surveys in Austin and Travis County. Field documentation for EPCs and installers operating in Austin Energy territory with its unique solar buyback program requirements.';
const canonicalPath = '/texas/austin-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Austin' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in the Austin metro area.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors — Austin, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Austin, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': ['Solar Site Surveys', 'Residential Solar Site Survey', 'Commercial Solar Site Survey'],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How does Austin Energy affect solar site survey requirements?',
    answer: 'Austin Energy is a municipally owned utility with a specific solar interconnection process and buyback program. Our surveys document the meter configuration, service entrance details, and electrical equipment information that Austin Energy applications require — alongside the standard structural and roof data your design team needs.'
  },
  {
    question: 'Do you cover areas outside Austin Energy territory?',
    answer: 'Yes. The Austin metro extends into Pedernales Electric Cooperative territory (Dripping Springs, Bee Cave, Lakeway) and Oncor territory (some eastern Travis County areas). We coordinate surveys across these utility boundaries based on the project address.'
  },
  {
    question: 'What Travis County AHJ differences should I know about?',
    answer: 'Travis County has multiple permitting jurisdictions — City of Austin, Cedar Park, Round Rock, Pflugerville, and unincorporated county areas — each with its own building department. Our surveys capture comprehensive documentation designed to satisfy the most thorough reviewer in the metro.'
  },
  {
    question: 'Can your surveyors access attic spaces in older Austin homes?',
    answer: 'Where attic access is available and safe, our surveyors document rafter or truss dimensions, spacing, span, decking type, and framing condition. Many older Austin homes in neighborhoods like Hyde Park, Bouldin Creek, and Zilker have unique framing that requires careful measurement.'
  },
  {
    question: 'How do I get started with a survey in Austin?',
    answer: 'Send the project address, scope, and any custom checklist requirements to our operations desk via WhatsApp. We confirm coverage, assign a local surveyor, and coordinate the visit based on property access and availability.'
  },
  {
    question: 'Do you document battery and ESS installation areas?',
    answer: 'Yes. We measure proposed equipment walls, clearance from doors, windows, and gas equipment, pathway to the main panel, and note environmental factors like sun exposure and ventilation — data your engineering team needs for battery layout and NFPA 855 review.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer }
  }))
};

const capabilities = [
  { title: 'Roof geometry & material identification', desc: 'Pitch, planes, ridges, valleys, material, condition, and obstruction mapping' },
  { title: 'Attic framing documentation', desc: 'Rafter/truss dimensions, spacing, span, decking — where safe access exists' },
  { title: 'Main electrical service capture', desc: 'Panel, bus rating, breaker, grounding, and meter socket details' },
  { title: 'Austin Energy meter documentation', desc: 'Service entrance type, meter configuration, and utility-side equipment photos' },
  { title: 'Battery & ESS area assessment', desc: 'Wall location, clearances, pathway to panel, and environmental suitability' },
  { title: 'Categorized photo documentation', desc: 'Labeled HD photos organized by scope area for CAD and permit reference' },
  { title: 'Property exterior & setbacks', desc: 'Elevation context, equipment locations, conduit routing options, and access notes' },
  { title: 'Custom checklist alignment', desc: 'Survey scope matched to your EPC or engineering team requirements' }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <!-- Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Austin, TX</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 900px;">
          Austin's solar market operates differently from the rest of Texas. Austin Energy — the city-owned utility — runs its own interconnection process and solar buyback program, creating documentation requirements that do not exist in deregulated markets. Our field surveys are structured to capture what Austin Energy and Travis County permitting offices expect.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="austin-schedule-btn">
            <span>Schedule an Austin Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Austin Energy Editorial -->
  <section class="section section-warm">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Utility Context</div>
        <h2>Austin Energy's Solar Buyback Program and Your Site Survey</h2>
      </div>
      <div class="editorial-prose">
        <p>
          Austin Energy is one of the few municipal utilities in Texas with an active Value of Solar tariff — a buyback rate that compensates solar customers based on the calculated value that distributed generation provides to the grid. For solar EPCs and design teams, this means the interconnection application process is handled directly through Austin Energy rather than through the ERCOT retail market structure that governs most of the state.
        </p>
        <p>
          The practical impact on site surveys is that metering documentation matters more than it does in some other Texas markets. Austin Energy's application process reviews meter configuration, service entrance ratings, and existing generation equipment as part of their interconnection approval workflow. Our surveyors capture these details during the initial field visit so your permitting coordinator has complete documentation without needing to request supplemental information.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Survey Capabilities (Icon List — NOT cards) -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Capabilities</div>
        <h2>What Our Austin Surveys Document</h2>
        <p class="lead">Structured data across eight scope categories.</p>
      </div>

      <div class="cap-list">
        {capabilities.map(cap => (
          <div class="cap-row">
            <div class="cap-check">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-gold)" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="cap-text">
              <strong>{cap.title}</strong>
              <span> — {cap.desc}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section: Travis County AHJs -->
  <section class="section section-dark">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker" style="color: var(--accent-gold);">Jurisdiction Coverage</div>
        <h2 style="color: #FFFFFF;">Permitting Across Travis County AHJs</h2>
      </div>
      <div class="editorial-prose" style="color: #9FB3C8;">
        <p>
          The Austin metro extends well beyond the City of Austin's jurisdiction. Solar projects in Round Rock (Williamson County), Cedar Park, Pflugerville, Bee Cave, and Dripping Springs each submit permits through different building departments — and the documentation expectations vary. Some jurisdictions require structural engineering review with specific framing data, while others focus more heavily on electrical documentation.
        </p>
        <p>
          Our survey protocol captures comprehensive field data that covers the broadest set of requirements across Travis, Williamson, and Hays county jurisdictions. This means your operations team does not need to adjust the survey scope based on which AHJ will review the permit application — the field package is thorough enough for any of them.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Process Timeline (Horizontal) -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Process</div>
        <h2>Austin Survey Timeline</h2>
      </div>

      <div class="timeline-row">
        <div class="tl-step">
          <div class="tl-dot"></div>
          <h3>Submit Project</h3>
          <p>Address, scope, and checklist requirements</p>
        </div>
        <div class="tl-connector"></div>
        <div class="tl-step">
          <div class="tl-dot"></div>
          <h3>Schedule Visit</h3>
          <p>Local surveyor assigned and coordinated</p>
        </div>
        <div class="tl-connector"></div>
        <div class="tl-step">
          <div class="tl-dot"></div>
          <h3>Field Capture</h3>
          <p>Measurements, photos, and field notes</p>
        </div>
        <div class="tl-connector"></div>
        <div class="tl-step">
          <div class="tl-dot"></div>
          <h3>QA & Deliver</h3>
          <p>Verified package sent to your team</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">FAQ</div>
        <h2>Austin Solar Site Survey Questions</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTASection
    title="Need a Solar Site Survey in Austin?"
    subtitle="Contact our operations desk to coordinate surveyor availability across the Austin metro, Travis County, and surrounding utility territories."
    primaryCtaText="Schedule in Austin"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Hub"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: var(--space-4);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  .narrow-content { max-width: 860px; }

  .editorial-prose p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .editorial-prose p:last-child { margin-bottom: 0; }

  /* Capabilities List */
  .cap-list {
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cap-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    transition: border-color var(--transition-fast);
  }

  .cap-row:hover {
    border-color: var(--accent-gold);
  }

  .cap-check {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cap-text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .cap-text strong {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--primary);
  }

  /* Timeline */
  .timeline-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    max-width: 990px;
    margin: 0 auto;
  }

  .tl-step {
    text-align: center;
    flex: 1;
    max-width: 200px;
    padding: 0 var(--space-3);
  }

  .tl-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-gold);
    margin: 0 auto var(--space-3);
    box-shadow: 0 0 0 4px rgba(244, 185, 66, 0.2);
  }

  .tl-connector {
    width: 40px;
    height: 2px;
    background: var(--border-light);
    margin-top: 7px;
    flex-shrink: 0;
  }

  .tl-step h3 {
    font-size: 0.9375rem;
    color: var(--primary);
    margin-bottom: var(--space-1);
  }

  .tl-step p {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] { border-color: var(--accent-gold); }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .faq-item[open] .faq-question::after { content: '−'; }

  .faq-answer { padding: 0 var(--space-6) var(--space-5); }

  .faq-answer p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .timeline-row {
      flex-direction: column;
      align-items: center;
    }
    .tl-connector {
      width: 2px;
      height: 24px;
      margin: 0;
    }
    .tl-step {
      max-width: 100%;
    }
  }
</style>
