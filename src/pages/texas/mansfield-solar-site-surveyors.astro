---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Mansfield, TX | South DFW Surveys';
const pageDescription = 'Solar site surveys in Mansfield, TX. Documenting Oncor and electric cooperative service lines, large-lot roof planes, and long conduit runs in South DFW.';
const canonicalPath = '/texas/mansfield-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Mansfield' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Mansfield, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Mansfield, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Mansfield, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Rural Electric Cooperative Survey',
    'Electrical Service Panel Verification'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do electric utility boundaries operate across Mansfield properties?',
    answer: 'Mansfield properties are divided between Oncor Electric Delivery and United Cooperative Services. In rural and semi-rural sections of southern Mansfield and Johnson County, electric cooperative interconnection rules apply. Our surveyors verify the meter enclosure, digital display, badge numbers, and disconnect hardware to ensure applications are submitted to the correct utility.'
  },
  {
    question: 'What challenges are common on large-lot residential properties in Mansfield?',
    answer: 'Mansfield features numerous properties with detached workshops, long underground conduit distances, and multi-level roof designs. We map exterior conduit pathways, measure physical distances between buildings, and document subpanel ratings to help engineering teams plan DC or AC wire runs.'
  },
  {
    question: 'How do City of Mansfield building inspections impact solar plan sets?',
    answer: 'The City of Mansfield Building Inspections department requires code-compliant single-line electrical diagrams, manufacturer equipment cut sheets, and clear structural mounting attachments. Our survey photo logs and physical measurements provide remote CAD teams with verified data to pass plan review on the first submission.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do your surveyors cover adjacent southern DFW communities?',
    answer: 'Yes. Survey routes frequently connect Mansfield with Arlington, Grand Prairie, Burleson, Midlothian, and Cedar Hill.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Mansfield, TX</h1>
        <p class="lead">
          Field site documentation across southern DFW. Managing Oncor and electric cooperative service boundaries, large-lot residential layouts, and structural roof framing across Tarrant and Johnson counties.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Mansfield</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- South DFW Expansion Focus -->
  <section class="section">
    <div class="container">
      <div class="mans-split">
        <div class="mans-text">
          <div class="kicker">Operational Focus</div>
          <h2>South DFW Expansion: Managing Oncor and Electric Cooperative Boundaries</h2>
          <p>
            Mansfield sits at the rapidly expanding southern edge of the DFW metroplex, spanning Tarrant, Johnson, and Ellis counties. The residential landscape ranges from dense suburban neighborhoods near Broad Street to expansive multi-acre custom properties along the southern perimeter.
          </p>
          <p>
            This geographic diversity creates distinct operational requirements. In newer suburban developments, homes connect to Oncor Electric Delivery with standard 200-amp service equipment. Further south, properties often fall within United Cooperative Services territory, where cooperative distributed generation standards and specific meter disconnect rules apply.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Mansfield project. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and map exterior conduit routes so your engineering team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="mans-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Mansfield Operating Overview</h3>
          <ul class="mans-spec-list">
            <li>
              <strong>Counties:</strong>
              <span>Tarrant County, Johnson County, Ellis County</span>
            </li>
            <li>
              <strong>Electric Utilities:</strong>
              <span>Oncor Electric Delivery and United Cooperative Services</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Mansfield Building Inspections</span>
            </li>
            <li>
              <strong>Housing Diversity:</strong>
              <span>Suburban master plans, multi-acre custom estates</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>200A to 400A main service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Mansfield Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="mans-grid">
        <div class="mans-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="mans-card card-technical">
          <h3>Utility Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor or United Cooperative filing.
          </p>
        </div>

        <div class="mans-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="mans-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="mans-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="mans-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">South DFW Operations</div>
        <h2>Connected Survey Coverage Across Surrounding DFW Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="mans-links">
        <a href="/texas/arlington-solar-site-surveyors/" class="mans-link-card">
          <h4>Arlington Solar Site Surveyors</h4>
          <p>Central DFW hub coverage directly north, supporting mature residential and commercial solar projects.</p>
        </a>
        <a href="/texas/grand-prairie-solar-site-surveyors/" class="mans-link-card">
          <h4>Grand Prairie Solar Site Surveyors</h4>
          <p>Mid-Cities survey coordination spanning the Dallas and Tarrant County municipal border.</p>
        </a>
        <a href="/texas/fort-worth-solar-site-surveyors/" class="mans-link-card">
          <h4>Fort Worth Solar Site Surveyors</h4>
          <p>Comprehensive field survey support across western DFW and Tarrant County growth areas.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="mans-link-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>Broad metroplex survey operations supporting solar EPC teams throughout Dallas County.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Mansfield Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="mans-faq-list">
        {faqs.map(faq => (
          <div class="mans-faq-item card-technical">
            <h3 class="mans-faq-q">{faq.question}</h3>
            <p class="mans-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Mansfield, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Mansfield"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .mans-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .mans-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .mans-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .mans-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .mans-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .mans-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mans-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .mans-spec-list li:last-child {
    border-bottom: none;
  }

  .mans-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .mans-spec-list span {
    color: var(--text-secondary);
  }

  .mans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .mans-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .mans-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .mans-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .mans-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .mans-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mans-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .mans-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .mans-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .mans-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mans-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .mans-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .mans-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .mans-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
