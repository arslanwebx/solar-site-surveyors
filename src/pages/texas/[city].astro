---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { allTexasCities, type TexasCity } from '../../data/texasCities';
import { getWhatsAppLink } from '../../data/whatsapp';

export function getStaticPaths() {
  return allTexasCities.map((city) => ({
    params: { city: `${city.slug}-solar-site-surveyors` },
    props: { city }
  }));
}

interface Props {
  city: TexasCity;
}

const { city } = Astro.props;

// Canonical URL & SEO metadata
const canonicalPath = `/texas/${city.slug}-solar-site-surveyors/`;
const pageTitle = `Solar Site Surveyors in ${city.name} TX | Solar Site Surveys`;
const seoHeading = `Solar Site Surveyors in ${city.name} TX`;
const pageDescription = `Professional solar site surveys in ${city.name}, TX for solar installers, EPCs, and contractors. Fast 48-hour turnaround, CAD-ready photo packages & local utility compliance.`;

// Breadcrumbs: Home > Service Areas > Texas > [City]
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: city.name }
];

const dispatchWhatsApp = getWhatsAppLink(`Hi, I would like to schedule a solar site survey in ${city.name}, Texas.`);

// Schema.org Local / Professional Service Schema
const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': `Solar Site Surveyors in ${city.name} TX`,
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': `${city.name}, Texas`,
    'containedInPlace': {
      '@type': 'State',
      'name': 'Texas'
    }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Commercial Solar Site Survey',
    'Electrical Main Service Panel Survey',
    'Battery Energy Storage Clearance Survey',
    'Drone Photogrammetry Roof Inspection'
  ],
  'priceRange': '$$'
};
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <!-- City Page Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <!-- Breadcrumbs: Home > Service Areas > Texas > [City] -->
        <Breadcrumbs items={breadcrumbs} isDark={true} />

        <h1 class="page-title">{seoHeading}</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 820px;">
          Professional solar site surveys in {city.name}, Texas for solar EPCs, installers, and engineering teams. Standardized field data, high-resolution photo documentation, and CAD-ready deliverables.
        </p>

        <!-- Action CTAs -->
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="city-schedule-survey-btn">
            <span>Schedule Survey in {city.name}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- City Coverage Overview -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="kicker">Field Coordination</div>
        <h2>Solar Site Survey Coordination in {city.name}, TX</h2>
        <p class="lead">
          {city.keyCoverageNotes}
        </p>
      </div>

      <!-- Deliverables Grid -->
      <div class="deliverables-grid">
        <div class="deliverable-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Attic & Roof Framing</h3>
          <p>
            Rafter sizing, truss spacing, span, roof pitch, framing health, and decking thickness recorded with clear measurement tools for structural engineering review in {city.name}.
          </p>
        </div>

        <div class="deliverable-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Electrical & Main Panel</h3>
          <p>
            Bus rating, main breaker ampacity, meter socket configuration, grounding electrode, available breaker slots, and conduit pathways aligned with regional Texas utility rules.
          </p>
        </div>

        <div class="deliverable-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3>Battery & ESS Clearances</h3>
          <p>
            NFPA 855 setback verification, wall backing condition, pathway to the main service panel, and indoor/outdoor environmental clearances for whole-home backup.
          </p>
        </div>

        <div class="deliverable-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </div>
          <h3>Aerial Photogrammetry</h3>
          <p>
            Drone roof surface capture, obstruction coordinates (vents, skylights, plumbing stacks), and high-resolution solar irradiance context for precision CAD layouts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- City Operations Table -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Service Standards</div>
        <h2>{city.name} Survey Operations & SLA Specifications</h2>
        <p class="lead">
          Everything your design and permitting teams need, delivered promptly without rework.
        </p>
      </div>

      <div class="table-wrap card-technical">
        <table class="specs-table">
          <tbody>
            <tr>
              <td><strong>Coverage Area</strong></td>
              <td>{city.name}, Texas and adjacent regional municipal jurisdictions</td>
            </tr>
            <tr>
              <td><strong>Turnaround SLA</strong></td>
              <td>48 Hours from site visit to QA photo package release</td>
            </tr>
            <tr>
              <td><strong>Deliverables Included</strong></td>
              <td>CAD-ready photo set (60–90+ high-res photos), digital field measurement log, drone roof capture</td>
            </tr>
            <tr>
              <td><strong>Codes & Compliance</strong></td>
              <td>NEC 2020 / NEC 2023, NFPA 855 ESS clearance, Texas Department of Insurance (TDI) wind load framing checks</td>
            </tr>
            <tr>
              <td><strong>Target Audience</strong></td>
              <td>Solar EPCs, regional installation companies, solar sales organizations, and design engineering teams</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="hub-return-wrap">
        <a href="/texas/" class="btn btn-outline btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Explore All Texas Cities Directory</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Final City Dispatch CTA -->
  <CTASection 
    title={`Need a Solar Site Survey in ${city.name}, TX?`}
    subtitle={`Contact our operations desk via WhatsApp to verify surveyor availability in ${city.name} and coordinate your upcoming site survey.`}
    primaryCtaText={`Schedule in ${city.name}`}
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Hub"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    margin-bottom: var(--space-4);
    letter-spacing: -0.025em;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  /* Deliverables Grid */
  .deliverables-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .deliverable-card {
    padding: var(--space-6);
    background-color: #FFFFFF;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--accent-gold-subtle);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .deliverable-card h3 {
    font-size: 1.125rem;
    color: var(--primary);
    margin-bottom: var(--space-2);
  }

  .deliverable-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* Specs Table */
  .table-wrap {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 900px;
    margin: 0 auto var(--space-10);
  }

  .hub-return-wrap {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .deliverables-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .deliverables-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
