---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Arlington, TX';
const pageDescription = 'Solar site surveys in Arlington and the DFW Mid-Cities corridor. Professional field documentation for EPCs and installers across one of the most densely populated residential zones in North Texas.';
const canonicalPath = '/texas/arlington-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Arlington' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Arlington, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors — Arlington, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Arlington, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': ['Solar Site Surveys', 'Residential Solar Site Survey', 'Commercial Solar Site Survey'],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'Why is Arlington a distinct survey market within DFW?',
    answer: 'Arlington is the largest U.S. city without a public transit system and sits directly between Dallas and Fort Worth. It has its own building department, permit application process, and a unique mix of housing from the 1960s through today. These factors create specific survey requirements that differ from both Dallas and Fort Worth jurisdictions.'
  },
  {
    question: 'What Mid-Cities areas do you cover beyond Arlington?',
    answer: 'Our surveyor coordination extends throughout the Mid-Cities corridor including Grand Prairie, Mansfield, Euless, Bedford, Hurst, Haltom City, and North Richland Hills. Submit the project address for specific confirmation.'
  },
  {
    question: 'What roof diversity should I expect in Arlington surveys?',
    answer: 'Arlington housing stock spans six decades of construction. Older neighborhoods near UTA have pier-and-beam homes with simpler gable roofs. Newer developments in southeast Arlington feature complex hip-and-valley configurations with composition shingle or tile. Our surveyors document all roof types with the same measurement detail.'
  },
  {
    question: 'Do you match our company survey form?',
    answer: 'Yes. If your EPC has a custom photo naming convention, measurement checklist, or required survey form, provide it at project intake. We align the field scope to your internal standards.'
  },
  {
    question: 'What electrical documentation is included?',
    answer: 'Main panel make/model, bus rating, main breaker ampacity, available breaker positions, grounding electrode, meter socket type, and conduit pathway options — captured in organized photos and measurement notes for your design team.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(faq => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': faq.answer }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <!-- Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Arlington, TX</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 900px;">
          Arlington sits at the geographic center of DFW — the largest city in the Metroplex that is not Dallas or Fort Worth. With nearly 400,000 residents and a dense concentration of 1970s–2000s residential housing, it is one of the highest-density solar survey markets in North Texas. Our field coordination covers Arlington and the surrounding Mid-Cities corridor with consistent, organized deliverables.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="arlington-schedule-btn">
            <span>Schedule an Arlington Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Mid-Cities Advantage Editorial -->
  <section class="section section-warm">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Strategic Location</div>
        <h2>The Mid-Cities Advantage: Central DFW Survey Coordination</h2>
      </div>
      <div class="editorial-prose">
        <p>
          The Mid-Cities corridor — Arlington, Grand Prairie, Mansfield, and the HEB communities — is where DFW's residential density peaks without the commercial high-rise landscape of downtown Dallas or the sprawl of Fort Worth's western suburbs. For solar companies, this means a high concentration of single-family rooftops within a compact geographic area.
        </p>
        <p>
          This density creates efficiency for field operations. A surveyor working the Mid-Cities can complete multiple site visits in a single day without the 45-minute drive times that outer-ring DFW suburbs require. Our coordination takes advantage of this density to schedule efficient survey routes across Arlington and adjacent cities.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Deliverables Grid (3-col) -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Survey Deliverables</div>
        <h2>What Your Arlington Survey Package Contains</h2>
        <p class="lead">Comprehensive field documentation organized for immediate use.</p>
      </div>

      <div class="del-grid">
        <div class="del-item card-technical">
          <span class="del-num">01</span>
          <h3>Roof Geometry</h3>
          <p>Pitch, plane dimensions, ridge and eave lengths, material type, condition notes, and obstruction coordinates for array layout.</p>
        </div>
        <div class="del-item card-technical">
          <span class="del-num">02</span>
          <h3>Structural Framing</h3>
          <p>Accessible attic documentation: rafter or truss sizing, spacing, span, decking type, and supporting photos for engineering review.</p>
        </div>
        <div class="del-item card-technical">
          <span class="del-num">03</span>
          <h3>Electrical Panel</h3>
          <p>Panel make/model, bus rating, main breaker, available breaker positions, grounding, and interior panel labeling.</p>
        </div>
        <div class="del-item card-technical">
          <span class="del-num">04</span>
          <h3>Meter & Utility</h3>
          <p>Meter socket configuration, service entrance rating, utility disconnect location, and Oncor interconnection documentation.</p>
        </div>
        <div class="del-item card-technical">
          <span class="del-num">05</span>
          <h3>Battery / ESS</h3>
          <p>Proposed equipment wall, NFPA 855 clearances, pathway to main panel, and environmental suitability assessment.</p>
        </div>
        <div class="del-item card-technical">
          <span class="del-num">06</span>
          <h3>Photo Package</h3>
          <p>Categorized HD photos labeled by scope area — roof, attic, electrical, exterior, obstructions — for CAD and permit use.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Residential Density & Roof Diversity -->
  <section class="section section-dark">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker" style="color: var(--accent-gold);">Housing Stock</div>
        <h2 style="color: #FFFFFF;">Arlington's Residential Density and Roof Diversity</h2>
      </div>
      <div class="editorial-prose" style="color: #9FB3C8;">
        <p>
          Arlington's housing stock tells the story of six decades of DFW growth. Neighborhoods near the University of Texas at Arlington feature 1960s and 1970s ranch-style homes with simple gable roofs and pier-and-beam foundations. South Arlington and Mansfield-adjacent areas have 1990s and 2000s two-story homes with complex hip-and-valley roof configurations. Newer developments along I-20 include modern production homes with composition shingle and stone-coated steel.
        </p>
        <p>
          This variety means no two surveys in Arlington are identical. A surveyor might document a straightforward single-plane gable roof in the morning and a multi-plane hip roof with dormers in the afternoon. Our survey process standardizes the output so your design team receives consistent, predictable deliverables regardless of the property's construction era or roof complexity.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: Operations Table -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Operations</div>
        <h2>Arlington Survey Specifications</h2>
      </div>
      <div class="table-wrap card-technical">
        <table class="specs-table">
          <tbody>
            <tr>
              <td><strong>Coverage Area</strong></td>
              <td>Arlington, Grand Prairie, Mansfield, Euless, Bedford, Hurst, Haltom City, North Richland Hills</td>
            </tr>
            <tr>
              <td><strong>Housing Eras</strong></td>
              <td>1960s ranch through modern production homes — diverse roof types and foundation systems</td>
            </tr>
            <tr>
              <td><strong>Deliverables</strong></td>
              <td>CAD-ready photo set, digital measurement log, categorized field documentation</td>
            </tr>
            <tr>
              <td><strong>Compliance Reference</strong></td>
              <td>NEC 2020/2023, NFPA 855, City of Arlington building and electrical permit requirements</td>
            </tr>
            <tr>
              <td><strong>Target Audience</strong></td>
              <td>Solar EPCs, installers, design engineering teams, and solar sales organizations</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-warm">
    <div class="container narrow-content">
      <div class="section-header">
        <div class="kicker">Questions</div>
        <h2>Arlington Survey FAQ</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTASection
    title="Need a Site Survey in Arlington?"
    subtitle="Contact our operations desk to confirm surveyor availability across Arlington and the Mid-Cities corridor."
    primaryCtaText="Schedule in Arlington"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Hub"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: var(--space-4);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
  }

  .narrow-content { max-width: 860px; }

  .editorial-prose p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .editorial-prose p:last-child { margin-bottom: 0; }

  /* Deliverables Grid (numbered) */
  .del-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .del-item {
    padding: var(--space-6);
    position: relative;
  }

  .del-num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.75rem;
    color: var(--accent-gold);
    line-height: 1;
    display: block;
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
  }

  .del-item h3 {
    font-size: 1rem;
    color: var(--primary);
    margin-bottom: var(--space-2);
  }

  .del-item p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Specs Table */
  .table-wrap {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 990px;
    margin: 0 auto;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] { border-color: var(--accent-gold); }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .faq-item[open] .faq-question::after { content: '−'; }

  .faq-answer { padding: 0 var(--space-6) var(--space-5); }

  .faq-answer p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .del-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .del-grid { grid-template-columns: 1fr; }
  }
</style>
