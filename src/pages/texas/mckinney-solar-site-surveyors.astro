---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in McKinney, TX | Field Surveys';
const pageDescription = 'Solar site surveys in McKinney, TX for solar EPCs and installers. Structural framing inspections, electrical service data, and remote CAD coordination.';
const canonicalPath = '/texas/mckinney-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'McKinney' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in McKinney, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: McKinney, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'McKinney, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Attic Framing Structural Survey',
    'Electrical Service Panel Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do framing types differ between historic and modern McKinney homes?',
    answer: 'McKinney features a wide structural range. Downtown historic residential areas frequently showcase true dimensional 2x4 or 2x6 rafters with board decking, while newer communities like Craig Ranch and Stonebridge Ranch feature engineered truss systems with OSB or plywood decking. Our surveyors document exact framing member dimensions, spans, and decking materials.'
  },
  {
    question: 'Which electric utilities serve McKinney solar projects?',
    answer: 'McKinney is primarily served by Oncor Electric Delivery, with portions of western and northern McKinney falling under CoServ Electric territory. We verify the meter badge, utility tags, and disconnect equipment during the survey so your interconnection submittal is accurate.'
  },
  {
    question: 'What electrical service panel details are captured for McKinney projects?',
    answer: 'We photograph the panel label, busbar rating, main breaker ampacity, circuit directory, and grounding conductors. If the home has a separate exterior disconnect or solar-ready subpanel, we record all specifications and open breaker spaces.'
  },
  {
    question: 'How does City of McKinney building inspection review solar permits?',
    answer: 'The City of McKinney Building Inspections department requires code-compliant single-line electrical diagrams, manufacturer spec sheets, and clear structural mounting details. Our field photos and measurements ensure your engineering team has complete data to produce permit-ready plan sets.'
  },
  {
    question: 'Can you coordinate surveys for contiguous projects across Northern Collin County?',
    answer: 'Yes. Dispatches routinely cover McKinney along with neighboring communities in Prosper, Celina, Princeton, Melissa, and Allen.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in McKinney, TX</h1>
        <p class="lead">
          Detailed site surveys across McKinney and northern Collin County. Inspecting structural framing, main electrical equipment, and battery installation locations for solar contractors and remote engineering desks.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in McKinney</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Section: Structural Diversity -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="kicker">Structural Context</div>
        <h2>Historic Framing to Modern Production: Northern Collin County Diversity</h2>
      </div>
      <div class="mckinney-intro">
        <p>
          As the county seat of Collin County, McKinney presents a broader architectural spectrum than many neighboring suburban cities. A solar surveyor in McKinney might inspect an early twentieth-century craftsman bungalow in the historic district on Monday morning, then survey a sprawling two-story custom build in Stonebridge Ranch that afternoon.
        </p>
        <p>
          This structural diversity makes standardized field surveys essential. Older homes often feature conventional rafter construction, true dimensional lumber, low-pitch shed dormers, and 100-amp split-bus electrical panels. In contrast, modern master-planned communities showcase complex hip roofs, engineered trusses, multiple valley intersections, and 200-amp or 400-amp service equipment.
        </p>
        <p>
          Our field surveyors document the exact structural and electrical realities of the property. We capture member dimensions with tape measure photos, verify truss gusset plates, evaluate roof decking thickness, and record complete electrical data plates so your engineering team can draft accurate permit packages.
        </p>
      </div>
    </div>
  </section>

  <!-- Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Inspection Scope</div>
        <h2>What Your Design Team Receives from the McKinney Visit</h2>
        <p class="lead">
          Field data organized to eliminate plan revisions and support smooth permitting through the City of McKinney.
        </p>
      </div>

      <div class="mckinney-grid">
        <div class="mckinney-card card-technical">
          <div class="card-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Roof Planes & Obstruction Geometry</h3>
          <p>
            We measure pitch on every plane, photograph ridges, eaves, valleys, and rakes, and record coordinates for all plumbing vents, chimney flues, and skylights to define usable array areas.
          </p>
        </div>

        <div class="mckinney-card card-technical">
          <div class="card-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
          </div>
          <h3>Attic Framing & Decking Inspection</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking condition with physical measurement photos.
          </p>
        </div>

        <div class="mckinney-card card-technical">
          <div class="card-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3>Electrical Panel & Service Equipment</h3>
          <p>
            We photograph main service panel labels, busbar ratings, main breaker capacity, existing breaker schedules, grounding electrodes, and utility meter tags for Oncor or CoServ filings.
          </p>
        </div>

        <div class="mckinney-card card-technical">
          <div class="card-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3>Battery Backup & Inverter Clearances</h3>
          <p>
            For ESS projects, we record available wall dimensions in attached garages or exterior walls, verifying working clearances to doors, windows, and gas meters.
          </p>
        </div>

        <div class="mckinney-card card-technical">
          <div class="card-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3>Conduit Routing & Exterior Drops</h3>
          <p>
            We photograph proposed conduit pathways from the roof line down to the inverter and main service equipment, noting masonry transitions and attic junction points.
          </p>
        </div>

        <div class="mckinney-card card-technical">
          <div class="card-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Collin County Coverage</div>
        <h2>Connected Survey Coordination Across Northern DFW</h2>
        <p class="lead">
          Maintain consistent field data quality as your installation crews work across neighboring municipalities.
        </p>
      </div>

      <div class="region-links">
        <a href="/texas/frisco-solar-site-surveyors/" class="region-card">
          <h4>Frisco Solar Site Surveyors</h4>
          <p>Steep roof plane geometry, dual-utility boundaries, and high-velocity residential design coordination.</p>
        </a>
        <a href="/texas/allen-solar-site-surveyors/" class="region-card">
          <h4>Allen Solar Site Surveyors</h4>
          <p>Suburban roof plane documentation and rapid CAD turnaround workflows directly south.</p>
        </a>
        <a href="/texas/plano-solar-site-surveyors/" class="region-card">
          <h4>Plano Solar Site Surveyors</h4>
          <p>High-density North DFW residential survey coordination and engineering plan set handoffs.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="region-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>Comprehensive field survey support across the broader Dallas metroplex and Oncor territory.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>McKinney Solar Survey Operations</h2>
        <p class="lead">Key operational details for solar installers and project managers.</p>
      </div>

      <div class="faq-list-mck">
        {faqs.map(faq => (
          <div class="faq-box-mck card-technical">
            <h3 class="faq-q-mck">{faq.question}</h3>
            <p class="faq-a-mck">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in McKinney, TX?"
    subtitle="Submit your project address to confirm surveyor availability in McKinney and coordinate your upcoming field visit."
    primaryCtaText="Schedule Survey in McKinney"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Hub"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .mckinney-intro {
    max-width: 990px;
    margin: var(--space-6) auto 0;
  }

  .mckinney-intro p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .mckinney-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .mckinney-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .card-icon-box {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
    color: var(--primary-color);
    margin-bottom: var(--space-4);
  }

  .mckinney-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .mckinney-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .region-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .region-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .region-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .region-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .region-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .faq-list-mck {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-box-mck {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .faq-q-mck {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .faq-a-mck {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
