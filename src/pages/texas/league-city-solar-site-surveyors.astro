---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in League City, TX | Coastal Surveys';
const pageDescription = 'Solar site surveys in League City, TX. Documenting coastal windstorm framing, salt-air equipment condition, and TNMP vs CenterPoint utility standards.';
const canonicalPath = '/texas/league-city-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'League City' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in League City, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: League City, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'League City, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Coastal Windstorm Roof Inspection',
    'Electrical Service Panel Verification'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do coastal environmental factors affect League City solar surveys?',
    answer: 'Located near Clear Lake and Galveston Bay, League City properties face high humidity and atmospheric salt exposure. Our surveyors inspect exterior electrical enclosures, conduit disconnects, and meter bases for signs of corrosion or moisture ingress. We photograph equipment data plates and structural framing members to assist engineers in selecting appropriate corrosion-resistant hardware.'
  },
  {
    question: 'Which utility company serves League City solar installations?',
    answer: 'League City is divided primarily between Texas-New Mexico Power (TNMP) and CenterPoint Energy. Each utility has distinct distributed generation interconnection paperwork and meter socket standards. We verify the meter enclosure and utility tags on site so your interconnection team submits to the correct provider.'
  },
  {
    question: 'What roof decking and framing data is recorded for coastal wind considerations?',
    answer: 'Galveston County properties are subject to high wind loads. While we do not provide structural engineering stamps, our surveyors record roof decking thickness, rafter or truss spacing, attachment hardware, and purlin bracing with physical measurement photos, giving your structural engineer verified data for wind calculations.'
  },
  {
    question: 'Can you survey battery backup locations in attached garages?',
    answer: 'Yes. The surveyor records available wall dimensions, notes clearances to garage entry doors, windows, and water heaters, and evaluates conduit routing to the main electrical panel.'
  },
  {
    question: 'Do you provide survey dispatches across the Bay Area and Galveston County?',
    answer: 'Yes. Survey routes frequently connect League City with Clear Lake City, Friendswood, Dickinson, Webster, and Texas City.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in League City, TX</h1>
        <p class="lead">
          Field site documentation tailored for Clear Lake and coastal Galveston County. Capturing salt-air equipment exposure, attic structural framing, and TNMP versus CenterPoint utility data for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in League City</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Coastal Operational Focus -->
  <section class="section">
    <div class="container">
      <div class="lc-split">
        <div class="lc-text">
          <div class="kicker">Operational Focus</div>
          <h2>Clear Lake and Coastal Transition: Protecting Downstream Design</h2>
          <p>
            League City sits at the crossroads of Harris and Galveston counties, positioned between Greater Houston and the Gulf Coast. For solar project managers, coordinating surveys in this coastal transition zone requires attention to environmental and jurisdictional factors that inland markets rarely face.
          </p>
          <p>
            Proximity to Clear Lake and Galveston Bay brings elevated ambient humidity and salt-air exposure. Exterior main electrical panels, meter sockets, and conduit disconnects often show premature surface rust or weathering. If an engineering desk relies on distant photos, they cannot determine whether existing equipment is structurally sound or if an outdoor panel requires replacement before interconnection.
          </p>
          <p>
            Our surveyors record detailed condition photos of all exterior electrical gear. We document roof plane geometry, inspect attic rafters and truss connections for structural engineering review, and verify whether the property connects to TNMP or CenterPoint Energy, giving your team complete clarity before CAD drafting begins.
          </p>
        </div>
        <div class="lc-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>League City Operating Overview</h3>
          <ul class="lc-spec-list">
            <li>
              <strong>Counties:</strong>
              <span>Galveston County, Harris County overlap</span>
            </li>
            <li>
              <strong>Electric Utilities:</strong>
              <span>Texas-New Mexico Power (TNMP) and CenterPoint Energy</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of League City Building Department</span>
            </li>
            <li>
              <strong>Environmental Context:</strong>
              <span>Coastal wind loads, salt-air exposure, high humidity</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>150A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for League City Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="lc-grid">
        <div class="lc-card card-technical">
          <h3>Main Electrical Service Panel</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="lc-card card-technical">
          <h3>TNMP & CenterPoint Meter Tagging</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete utility interconnection filing.
          </p>
        </div>

        <div class="lc-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="lc-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="lc-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="lc-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Bay Area Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Coastal Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="lc-links">
        <a href="/texas/pearland-solar-site-surveyors/" class="lc-link-card">
          <h4>Pearland Solar Site Surveyors</h4>
          <p>Multi-county suburban survey coordination and dual CenterPoint versus TNMP utility data directly northwest.</p>
        </a>
        <a href="/texas/pasadena-solar-site-surveyors/" class="lc-link-card">
          <h4>Pasadena Solar Site Surveyors</h4>
          <p>Southeast Houston residential and industrial corridor survey coordination directly north.</p>
        </a>
        <a href="/texas/baytown-solar-site-surveyors/" class="lc-link-card">
          <h4>Baytown Solar Site Surveyors</h4>
          <p>East Harris and Chambers County coastal bay environment survey coordination directly northeast.</p>
        </a>
        <a href="/texas/houston-solar-site-surveyors/" class="lc-link-card">
          <h4>Houston Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Greater Houston metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>League City Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="lc-faq-list">
        {faqs.map(faq => (
          <div class="lc-faq-item card-technical">
            <h3 class="lc-faq-q">{faq.question}</h3>
            <p class="lc-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in League City, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in League City"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .lc-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .lc-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .lc-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .lc-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .lc-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .lc-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lc-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .lc-spec-list li:last-child {
    border-bottom: none;
  }

  .lc-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .lc-spec-list span {
    color: var(--text-secondary);
  }

  .lc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .lc-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .lc-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .lc-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .lc-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .lc-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .lc-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .lc-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .lc-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .lc-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .lc-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .lc-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .lc-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .lc-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
