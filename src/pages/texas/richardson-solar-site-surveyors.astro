---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Richardson, TX | Field Surveys';
const pageDescription = 'Solar site surveys in Richardson, TX. Documenting telecom corridor housing, tree shading patterns, legacy service panels, and roof penetrations.';
const canonicalPath = '/texas/richardson-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Richardson' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Richardson, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Richardson, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Richardson, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Tree Shading Obstruction Survey',
    'Electrical Panel Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do mature trees affect solar roof surveys in Richardson?',
    answer: 'Richardson is known for established neighborhoods with mature oak and pecan trees. These trees create shading profiles that satellite imagery often underestimates. Our surveyors photograph surrounding tree canopies, measure physical obstruction angles from roof planes, and identify the true solar window to assist designers in module placement.'
  },
  {
    question: 'What electrical service configurations are common in Richardson homes?',
    answer: 'Homes constructed in the 1960s, 1970s, and 1980s throughout Richardson often feature 100-amp, 125-amp, or 150-amp main service panels, sometimes installed on exterior brick walls or inside utility closets. We photograph panel labels, bus ratings, main breakers, and existing conduit runs to verify interconnection feasibility.'
  },
  {
    question: 'Which utility handles solar interconnection in Richardson?',
    answer: 'Richardson is served by Oncor Electric Delivery. We photograph the meter enclosure, digital display, meter number, and main disconnect to provide complete documentation for Oncor distributed generation interconnection filings.'
  },
  {
    question: 'What roof types and framing are typical across Richardson?',
    answer: 'Most homes feature low-to-medium pitch composition shingle roofs supported by conventional 2x4 or 2x6 rafters. We record rafter dimensions, span lengths, collar ties, and decking thickness to support structural engineering calculations.'
  },
  {
    question: 'Can you coordinate surveys between Richardson and neighboring North DFW markets?',
    answer: 'Yes. Survey dispatches regularly connect Richardson with Plano, Garland, Dallas, and Carrollton.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Richardson, TX</h1>
        <p class="lead">
          Accurate field data collection across the Telecom Corridor. Documenting tree shading patterns, legacy electrical service panels, low-slope roof planes, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Richardson</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Telecom Corridor Housing Focus -->
  <section class="section">
    <div class="container">
      <div class="rich-split">
        <div class="rich-text">
          <div class="kicker">Operational Focus</div>
          <h2>Telecom Corridor Housing: Overcoming Mature Tree Shading and Low Slopes</h2>
          <p>
            Richardson features classic mid-to-late twentieth-century North Texas suburban architecture. Characterized by wide brick ranch-style homes, low-slope roof planes, and substantial mature tree canopies, Richardson properties present specific operational challenges for solar design teams.
          </p>
          <p>
            Satellite imagery frequently fails to convey the true impact of overhead oak trees or the exact dimensions of low-pitch roof planes. If an engineering desk relies on aerial estimates alone, panel layouts may be placed directly under dense afternoon shade or fail to respect plumbing vent setbacks.
          </p>
          <p>
            Our survey process captures on-site realities. We measure exact roof plane dimensions and pitch, photograph tree obstruction angles, document electrical busbar capacities, and record attic rafter dimensions so your CAD designers can produce accurate, permit-ready plans.
          </p>
        </div>
        <div class="rich-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Richardson Operating Overview</h3>
          <ul class="rich-spec-list">
            <li>
              <strong>Counties:</strong>
              <span>Dallas County, Collin County overlap</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Richardson Building Inspection</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>1960s to 1980s brick ranch homes, contemporary infill</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>125A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Support</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Richardson Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="rich-grid">
        <div class="rich-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="rich-card card-technical">
          <h3>Oncor Meter & Service Disconnect</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="rich-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="rich-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="rich-card card-technical">
          <h3>Tree Shading & Obstruction Documentation</h3>
          <p>
            We photograph surrounding tree canopies, measure proximity to usable roof planes, and note potential shading obstacles that impact solar energy harvest.
          </p>
        </div>

        <div class="rich-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">North DFW Operations</div>
        <h2>Connected Survey Coverage Across Surrounding DFW Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="rich-links">
        <a href="/texas/plano-solar-site-surveyors/" class="rich-link-card">
          <h4>Plano Solar Site Surveyors</h4>
          <p>High-density North DFW residential survey coordination and engineering handoffs directly north.</p>
        </a>
        <a href="/texas/garland-solar-site-surveyors/" class="rich-link-card">
          <h4>Garland Solar Site Surveyors</h4>
          <p>Municipal utility verification and GP&L distributed generation survey standards directly east.</p>
        </a>
        <a href="/texas/carrollton-solar-site-surveyors/" class="rich-link-card">
          <h4>Carrollton Solar Site Surveyors</h4>
          <p>Tri-county municipal coordination across Dallas, Denton, and Collin county project borders.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="rich-link-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Dallas metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Richardson Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="rich-faq-list">
        {faqs.map(faq => (
          <div class="rich-faq-item card-technical">
            <h3 class="rich-faq-q">{faq.question}</h3>
            <p class="rich-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Richardson, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Richardson"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .rich-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .rich-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .rich-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .rich-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .rich-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .rich-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rich-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .rich-spec-list li:last-child {
    border-bottom: none;
  }

  .rich-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .rich-spec-list span {
    color: var(--text-secondary);
  }

  .rich-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .rich-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .rich-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .rich-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .rich-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .rich-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .rich-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .rich-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .rich-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .rich-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rich-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .rich-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .rich-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .rich-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
