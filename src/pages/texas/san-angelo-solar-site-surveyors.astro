---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in San Angelo, TX | Concho Valley';
const pageDescription = 'Solar site surveys in San Angelo, TX. Aligning with AEP Texas North standards, high-insolation roof geometry, and service equipment across Tom Green County.';
const canonicalPath = '/texas/san-angelo-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'San Angelo' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in San Angelo, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: San Angelo, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'San Angelo, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'AEP Texas Utility Solar Surveys',
    'Residential Solar Site Survey',
    'High-Insolation Roof Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do AEP Texas North standards impact solar surveys in San Angelo?',
    answer: 'San Angelo is served by AEP Texas North. Interconnection requires specific distributed generation application forms, dedicated bi-directional meter sockets, and accessible exterior AC disconnect switches. Our surveyors photograph the digital AEP meter badge, enclosure tags, and service disconnect to verify compliance before plan submittal.'
  },
  {
    question: 'What roof types and framing conditions are typical across San Angelo?',
    answer: 'Homes in San Angelo feature a blend of Spanish tile accents, composition shingles, and low-pitch roofs on conventional rafter framing. The survey measures pitch per plane, records azimuth, maps plumbing vents, and documents rafter spacing with measurement photos.'
  },
  {
    question: 'How does high sun exposure affect electrical equipment in Tom Green County?',
    answer: 'San Angelo experiences high ambient temperatures and intense UV radiation. Our surveyors inspect exterior electrical service panels and disconnect switches for weathered data plates or sun-baked labels, ensuring critical ratings are legible for engineering review.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do you cover projects across the Concho Valley region?',
    answer: 'Yes. Survey dispatches regularly connect San Angelo with Ballinger, Miles, Christoval, Mertzon, and Grape Creek.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in San Angelo, TX</h1>
        <p class="lead">
          Field site documentation across the Concho Valley. Aligning with AEP Texas North utility standards, high-insolation roof geometry, and electrical service equipment across Tom Green County.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate San Angelo Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Concho Valley Focus Section -->
  <section class="section">
    <div class="container">
      <div class="sa-split">
        <div class="sa-text">
          <div class="kicker">Operational Focus</div>
          <h2>Concho Valley Solar Operations: High-Insolation Field Site Verification</h2>
          <p>
            San Angelo anchors the Concho Valley, serving as the commercial and cultural hub of West Central Texas. Characterized by high solar irradiance, a semi-arid climate, and substantial air conditioning loads, San Angelo offers strong potential for residential and light commercial solar installations.
          </p>
          <p>
            Operating in Tom Green County requires adherence to AEP Texas North interconnection standards, which differ from Oncor or CenterPoint practices. Furthermore, local residential architecture includes mid-century ranch homes with low-pitch roof planes, stucco accents, and older 100-amp to 150-amp electrical panels. If remote CAD engineers work from incomplete site photos, they cannot verify busbar ratings or determine whether physical space exists for an interconnection breaker, stalling project timelines.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every San Angelo project. We clean and record legible electrical data plates, verify main breaker capacities, inspect accessible attic framing, and map roof plane geometry so your engineering team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="sa-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>San Angelo Operating Overview</h3>
          <ul class="sa-spec-list">
            <li>
              <strong>County:</strong>
              <span>Tom Green County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>AEP Texas North</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of San Angelo Building Permits</span>
            </li>
            <li>
              <strong>Environmental Context:</strong>
              <span>High solar insolation, semi-arid heat, stucco exterior accents</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>125A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for San Angelo Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="sa-grid">
        <div class="sa-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="sa-card card-technical">
          <h3>AEP Texas North Meter Tagging</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete AEP interconnection filing.
          </p>
        </div>

        <div class="sa-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="sa-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="sa-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="sa-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Concho Valley Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Regional Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="sa-links">
        <a href="/texas/abilene-solar-site-surveyors/" class="sa-link-card">
          <h4>Abilene Solar Site Surveyors</h4>
          <p>Big Country regional hub survey coordination and AEP Texas North documentation directly north.</p>
        </a>
        <a href="/texas/midland-solar-site-surveyors/" class="sa-link-card">
          <h4>Midland Solar Site Surveyors</h4>
          <p>Permian Basin energy hub survey operations and Oncor service data directly northwest.</p>
        </a>
        <a href="/texas/odessa-solar-site-surveyors/" class="sa-link-card">
          <h4>Odessa Solar Site Surveyors</h4>
          <p>Ector County residential survey coordination and low-slope roof plane mapping directly northwest.</p>
        </a>
        <a href="/texas/san-antonio-solar-site-surveyors/" class="sa-link-card">
          <h4>San Antonio Solar Site Surveyors</h4>
          <p>CPS Energy municipal utility standards and broad Bexar County coverage southeast.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>San Angelo Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="sa-faq-list">
        {faqs.map(faq => (
          <div class="sa-faq-item card-technical">
            <h3 class="sa-faq-q">{faq.question}</h3>
            <p class="sa-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in San Angelo, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in San Angelo"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .sa-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .sa-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .sa-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .sa-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .sa-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .sa-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sa-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .sa-spec-list li:last-child {
    border-bottom: none;
  }

  .sa-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .sa-spec-list span {
    color: var(--text-secondary);
  }

  .sa-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .sa-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .sa-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .sa-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .sa-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .sa-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sa-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .sa-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .sa-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .sa-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sa-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .sa-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .sa-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .sa-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
