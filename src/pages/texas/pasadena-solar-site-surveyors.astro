---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Pasadena, TX | Field Surveys';
const pageDescription = 'Solar site surveys in Pasadena, TX. Documenting CenterPoint electrical service equipment, roof plane condition, and attic framing across Southeast Houston.';
const canonicalPath = '/texas/pasadena-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Pasadena' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Pasadena, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Pasadena, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Pasadena, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'CenterPoint Meter Inspection',
    'Main Electrical Service Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do City of Pasadena building permits impact solar plan sets?',
    answer: 'The City of Pasadena Permit Department enforces electrical and structural standards under current municipal codes. Plan reviewers examine single-line electrical drawings, structural roof attachment layouts, and equipment specification sheets. Our field survey packages capture readable data plate photos and physical framing measurements to help your team pass permit review on the initial submittal.'
  },
  {
    question: 'What CenterPoint Energy documentation is required in Pasadena?',
    answer: 'Pasadena is located in CenterPoint Energy service territory. We photograph the digital meter display, meter enclosure, meter badge number, service drop or underground lateral, and main utility disconnect to ensure your interconnection coordinator has complete documentation for CenterPoint distributed generation filing.'
  },
  {
    question: 'What electrical panel issues are common in older Pasadena homes?',
    answer: 'Neighborhoods established in the mid-twentieth century across Pasadena frequently feature 100-amp or 125-amp electrical service panels, split-bus hardware, or interior subpanels with limited open spaces. Our surveyors record bus ratings, breaker capacities, and available slots to help engineers determine if a service upgrade is necessary.'
  },
  {
    question: 'How do you document low-slope roofs in established Pasadena neighborhoods?',
    answer: 'The survey records roof pitch, shingle wear, plumbing pipe vents, chimney flashings, and eave overhangs. In homes with conventional rafter framing, we measure rafter dimensions and span lengths to confirm structural capacity.'
  },
  {
    question: 'Can you coordinate surveys for contiguous projects in Southeast Harris County?',
    answer: 'Yes. Survey dispatches regularly connect Pasadena projects with surrounding communities in Deer Park, La Porte, South Houston, Pearland, and Baytown.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Pasadena, TX</h1>
        <p class="lead">
          Dedicated field site surveys across Southeast Houston and Harris County. Documenting CenterPoint electric service equipment, attic structural framing, and low-slope roof planes for solar engineering desks.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Pasadena</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Southeast Houston Operational Focus -->
  <section class="section">
    <div class="container">
      <div class="pas-split">
        <div class="pas-text">
          <div class="kicker">Operational Focus</div>
          <h2>Southeast Houston Operations: Independent Municipal Standards in Pasadena</h2>
          <p>
            Pasadena is the second-largest city in Harris County, representing a critical residential market directly southeast of Houston. For solar operations managers, coordinating projects in Pasadena requires understanding that municipal building permitting is managed locally through the City of Pasadena, not through the City of Houston.
          </p>
          <p>
            The housing stock across Pasadena consists largely of established post-war single-family homes, mid-century brick ranches, and modern infill construction. Older homes frequently feature 100-amp or 125-amp main service panels with limited breaker capacity. If a field surveyor fails to record the busbar rating or takes blurry photos of the electrical data plate, remote CAD engineers are forced to guess, leading to permit plan rejections or costly installation-day delays.
          </p>
          <p>
            Our survey coordination delivers verified physical data directly to your design department. We document electrical bus ratings, record attic rafter dimensions, map roof plane boundaries, and verify CenterPoint meter equipment, ensuring your team has everything needed to draft permit-ready solar plan sets.
          </p>
        </div>
        <div class="pas-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Pasadena Operating Overview</h3>
          <ul class="pas-spec-list">
            <li>
              <strong>County:</strong>
              <span>Harris County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>CenterPoint Energy</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Pasadena Permit Department</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Mid-century brick ranches, post-war bungalows</span>
            </li>
            <li>
              <strong>Common Electrical:</strong>
              <span>100A to 150A main panels, split-bus hardware</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Inspection Deliverables</div>
        <h2>Field Data That Keeps Pasadena Solar Projects Moving</h2>
        <p class="lead">
          Comprehensive field measurements designed for remote CAD engineers and CenterPoint interconnection filing.
        </p>
      </div>

      <div class="pas-grid">
        <div class="pas-card card-technical">
          <h3>Main Electrical Service Panel</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="pas-card card-technical">
          <h3>CenterPoint Meter & Disconnects</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete CenterPoint interconnection filing.
          </p>
        </div>

        <div class="pas-card card-technical">
          <h3>Roof Plane Geometry & Condition</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="pas-card card-technical">
          <h3>Attic Rafter & Framing Health</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="pas-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="pas-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Greater Houston Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Municipalities</h2>
        <p class="lead">
          Coordinate field surveys across neighboring Greater Houston markets with consistent documentation standards.
        </p>
      </div>

      <div class="pas-links">
        <a href="/texas/pearland-solar-site-surveyors/" class="pas-link-card">
          <h4>Pearland Solar Site Surveyors</h4>
          <p>Multi-county suburban survey coordination and dual CenterPoint versus TNMP utility data directly southwest.</p>
        </a>
        <a href="/texas/baytown-solar-site-surveyors/" class="pas-link-card">
          <h4>Baytown Solar Site Surveyors</h4>
          <p>East Harris and Chambers County coastal bay environment survey coordination directly east.</p>
        </a>
        <a href="/texas/league-city-solar-site-surveyors/" class="pas-link-card">
          <h4>League City Solar Site Surveyors</h4>
          <p>Clear Lake and Galveston County coastal transition survey operations directly south.</p>
        </a>
        <a href="/texas/houston-solar-site-surveyors/" class="pas-link-card">
          <h4>Houston Solar Site Surveyors</h4>
          <p>Comprehensive field survey support across the broader Greater Houston metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Pasadena Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="pas-faq-list">
        {faqs.map(faq => (
          <div class="pas-faq-item card-technical">
            <h3 class="pas-faq-q">{faq.question}</h3>
            <p class="pas-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Pasadena, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Pasadena"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .pas-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .pas-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .pas-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .pas-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .pas-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .pas-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pas-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .pas-spec-list li:last-child {
    border-bottom: none;
  }

  .pas-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .pas-spec-list span {
    color: var(--text-secondary);
  }

  .pas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .pas-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .pas-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .pas-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .pas-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .pas-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pas-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .pas-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .pas-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pas-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pas-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .pas-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .pas-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .pas-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
