---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Beaumont, TX | Entergy Territory';
const pageDescription = 'Solar site surveys in Beaumont, TX. Operating under Entergy Texas MISO standards, coastal hurricane wind zones, and service panels across Jefferson County.';
const canonicalPath = '/texas/beaumont-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Beaumont' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Beaumont, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Beaumont, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Beaumont, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Entergy Non-ERCOT Utility Solar Surveys',
    'Residential Solar Site Survey',
    'Hurricane Windstorm Roof Survey'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How does Entergy Texas operate outside the ERCOT grid in Beaumont?',
    answer: 'Beaumont does not operate in the ERCOT electric grid. Electric service across Jefferson County is provided by Entergy Texas, connected to the Midcontinent Independent System Operator (MISO) regional grid. Entergy enforces distinct distributed generation interconnection manuals, dedicated net metering applications, and specific exterior AC disconnect rules. Our surveyors photograph the digital Entergy meter badge, enclosure tags, and service disconnect to verify compliance before plan submittal.'
  },
  {
    question: 'How do coastal hurricane winds and humidity affect solar surveys in Jefferson County?',
    answer: 'Located in a Tier 1 coastal windstorm area near the Gulf Coast, Beaumont requires robust structural attachment design. Survey packages record roof decking thickness, rafter or truss spacing, hurricane clips, and existing purlin bracing with physical measurement photos. We also inspect exterior electrical enclosures for salt-air and humidity corrosion.'
  },
  {
    question: 'What electrical panel configurations are common in Beaumont homes?',
    answer: 'Established homes across central Beaumont frequently feature 100-amp or 125-amp service equipment with limited open spaces, while newer suburban residences feature 200-amp panels. Our surveyors photograph panel data labels, bus ratings, and main breakers so engineers can determine if a panel upgrade or line-side tap is required.'
  },
  {
    question: 'What roof types and framing conditions are typical across Beaumont?',
    answer: 'Properties feature composition shingle roofs on low-to-medium pitch hip and gable planes. The survey measures pitch per plane, records azimuth, maps plumbing vents, and documents truss or rafter spacing with measurement photos.'
  },
  {
    question: 'Do your surveyors cover the greater Golden Triangle region?',
    answer: 'Yes. Survey dispatches regularly connect Beaumont with Port Arthur, Nederland, Groves, Port Neches, Lumberton, and Vidor.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Beaumont, TX</h1>
        <p class="lead">
          Field site documentation across Jefferson County and the Golden Triangle. Operating under Entergy Texas MISO standards, coastal hurricane wind zones, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Coordinate Beaumont Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Entergy Non-ERCOT Alert -->
  <section class="section">
    <div class="container">
      <div class="entergy-banner card-technical">
        <div class="entergy-header">
          <div class="entergy-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <div class="kicker">Critical Utility Distinction</div>
            <h2>Non-ERCOT Territory: Operating Under Entergy Texas (MISO Grid) Rules</h2>
          </div>
        </div>
        <p>
          Beaumont does not operate in the ERCOT electric grid. Electric service across Jefferson County is provided by Entergy Texas, connected to the Midcontinent Independent System Operator (MISO) regional grid.
        </p>
        <p>
          Contractors submitting solar plan sets based on CenterPoint or Oncor procedures encounter immediate interconnection holds. Entergy Texas enforces its own distributed generation interconnection manual, specific bi-directional meter base requirements, and external manual disconnect rules. Our survey packages focus heavily on collecting clear photographs of the Entergy meter base, service entrance mast, utility tags, and existing disconnect equipment. This verification ensures your interconnection team files the appropriate paperwork without back-and-forth utility inquiries.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Scope Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Inspection Scope</div>
        <h2>Beaumont Site Survey Package Deliverables</h2>
        <p class="lead">
          Comprehensive physical data prepared to support engineering review and City of Beaumont building permits.
        </p>
      </div>

      <div class="entergy-grid">
        <div class="entergy-card card-technical">
          <h3>Entergy Texas Electric Meter Equipment</h3>
          <p>
            We photograph the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Entergy interconnection filing.
          </p>
        </div>

        <div class="entergy-card card-technical">
          <h3>Main Electrical Service Panels</h3>
          <p>
            The survey records busbar ratings, main breaker capacity, manufacturer data plates, and circuit breaker directories, confirming whether the electrical panel can accept a solar backfeed breaker.
          </p>
        </div>

        <div class="entergy-card card-technical">
          <h3>Coastal Hurricane Windstorm Framing</h3>
          <p>
            We document rafter dimensions, truss member sizes, center-to-center spacing, hurricane clips, and roof decking thickness with physical tape measure photographs to support structural engineering review.
          </p>
        </div>

        <div class="entergy-card card-technical">
          <h3>Roof Planes & Penetrations</h3>
          <p>
            We measure pitch angles, record roof plane azimuth, and map plumbing vents, attic fans, exhaust flues, and skylights to verify usable array boundaries within local fire code setbacks.
          </p>
        </div>

        <div class="entergy-card card-technical">
          <h3>Battery Backup & Inverter Clearances</h3>
          <p>
            For ESS projects, we record available wall space in attached garages or exterior side yards, verifying clearances from windows, doors, and gas meters to support code-compliant battery placement.
          </p>
        </div>

        <div class="entergy-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Full elevation photos document site access, fence gates, air conditioning equipment, and ladder setup areas to assist installation managers with build-day staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Golden Triangle Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Southeast Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="entergy-links">
        <a href="/texas/baytown-solar-site-surveyors/" class="entergy-link-card">
          <h4>Baytown Solar Site Surveyors</h4>
          <p>Eastern Harris County petrochemical corridor survey coordination and CenterPoint utility data directly southwest.</p>
        </a>
        <a href="/texas/conroe-solar-site-surveyors/" class="entergy-link-card">
          <h4>Conroe Solar Site Surveyors</h4>
          <p>Entergy Texas territory and Montgomery County residential survey coordination west.</p>
        </a>
        <a href="/texas/houston-solar-site-surveyors/" class="entergy-link-card">
          <h4>Houston Solar Site Surveyors</h4>
          <p>CenterPoint Houston metropolitan survey operations and residential framing documentation west.</p>
        </a>
        <a href="/texas/tyler-solar-site-surveyors/" class="entergy-link-card">
          <h4>Tyler Solar Site Surveyors</h4>
          <p>Smith County commercial hub survey coordination and Oncor East utility documentation directly northwest.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Beaumont Solar Survey Operations</h2>
        <p class="lead">Essential details for solar contractors and project coordinators.</p>
      </div>

      <div class="entergy-faq-list">
        {faqs.map(faq => (
          <div class="entergy-faq-item card-technical">
            <h3 class="entergy-faq-q">{faq.question}</h3>
            <p class="entergy-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in Beaumont, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and ensure your field package meets Entergy Texas requirements."
    primaryCtaText="Schedule Survey in Beaumont"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .entergy-banner {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 6px solid var(--accent-gold);
    max-width: 1000px;
    margin: 0 auto;
  }

  .entergy-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .entergy-icon {
    color: var(--accent-gold);
    margin-top: 0.25rem;
  }

  .entergy-banner h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .entergy-banner p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .entergy-banner p:last-child {
    margin-bottom: 0;
  }

  .entergy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .entergy-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .entergy-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .entergy-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .entergy-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .entergy-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .entergy-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .entergy-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .entergy-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .entergy-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .entergy-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .entergy-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .entergy-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
