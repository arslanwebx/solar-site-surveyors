---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Laredo, TX | South Texas Surveys';
const pageDescription = 'Solar site surveys in Laredo, TX. Documenting AEP Texas Central service equipment, flat parapet and tile roofs, and attic framing across Webb County.';
const canonicalPath = '/texas/laredo-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Laredo' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Laredo, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Laredo, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Laredo, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'AEP Texas Utility Solar Surveys',
    'Residential Solar Site Survey',
    'Flat Parapet & Tile Roof Surveys'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do AEP Texas Central requirements affect solar surveys in Laredo?',
    answer: 'Laredo is served by AEP Texas Central. Distributed generation interconnection requires specific application forms, dedicated bi-directional meter base standards, and manual exterior AC disconnect switches. Our surveyors photograph the digital AEP meter badge, enclosure tags, and service disconnect to verify compliance before plan submittal.'
  },
  {
    question: 'What roof types and framing conditions are typical in Laredo?',
    answer: 'Laredo features a combination of Spanish clay tile, concrete tile, flat parapet roofs with modified bitumen membranes, and composition shingles. We measure pitch per plane, record membrane condition, map parapet wall heights, and document framing member sizes with physical measurement photos.'
  },
  {
    question: 'How does intense summer heat affect electrical equipment in Webb County?',
    answer: 'Laredo experiences extreme ambient summer temperatures exceeding 105 degrees. Our surveyors inspect exterior electrical service panels and disconnect switches for weathered data plates or heat damage, recording critical ratings and conduit clearances to assist electrical engineers with temperature derating calculations.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do you cover projects across the Webb County border corridor?',
    answer: 'Yes. Survey dispatches regularly connect central Laredo with Rio Bravo, El Cenizo, Lake Hills, and surrounding industrial logistics parks.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Laredo, TX</h1>
        <p class="lead">
          Field site documentation across Webb County and the South Texas border. Aligning with AEP Texas Central utility standards, flat parapet and tile roof geometry, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Laredo</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Border Logistics Hub Focus -->
  <section class="section">
    <div class="container">
      <div class="lar-split">
        <div class="lar-text">
          <div class="kicker">Operational Focus</div>
          <h2>Border Logistics Hub: High-Insolation Field Site Verification in Laredo</h2>
          <p>
            Laredo serves as the largest inland port on the United States-Mexico border, anchoring international trade and transportation across South Texas. Combining dense residential neighborhoods near downtown with expansive suburban master plans along Loop 20 and McPherson Road, Laredo is an active solar market with exceptional solar irradiance and substantial cooling loads.
          </p>
          <p>
            Residential architecture in Webb County features distinctive construction materials, including stucco-clad concrete block, flat parapet roofs with modified bitumen membranes, and heavy Spanish clay tile planes. In addition, electric distribution is managed by AEP Texas Central, which maintains strict distributed generation rules. If remote CAD engineers receive incomplete field photos, they cannot verify busbar ratings or determine usable membrane boundaries within fire code setbacks, stalling permit reviews.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Laredo project. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your design team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="lar-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Laredo Operating Overview</h3>
          <ul class="lar-spec-list">
            <li>
              <strong>County:</strong>
              <span>Webb County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>AEP Texas Central</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Laredo Building Development Services</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Spanish tile, flat parapet roofs, stucco and masonry</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>125A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Laredo Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="lar-grid">
        <div class="lar-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="lar-card card-technical">
          <h3>AEP Texas Central Meter Tagging</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete AEP interconnection filing.
          </p>
        </div>

        <div class="lar-card card-technical">
          <h3>Flat Parapet & Tile Roof Geometry</h3>
          <p>
            We measure pitch angles, record parapet wall heights, map membrane conditions, and identify roof penetrations to define usable array boundaries within local fire code setbacks.
          </p>
        </div>

        <div class="lar-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="lar-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="lar-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">South Texas Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Regional Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="lar-links">
        <a href="/texas/san-antonio-solar-site-surveyors/" class="lar-link-card">
          <h4>San Antonio Solar Site Surveyors</h4>
          <p>CPS Energy municipal utility standards and broad Bexar County coverage directly northeast.</p>
        </a>
        <a href="/texas/mcallen-solar-site-surveyors/" class="lar-link-card">
          <h4>McAllen Solar Site Surveyors</h4>
          <p>Rio Grande Valley commercial hub survey coordination and AEP Texas Central documentation southeast.</p>
        </a>
        <a href="/texas/corpus-christi-solar-site-surveyors/" class="lar-link-card">
          <h4>Corpus Christi Solar Site Surveyors</h4>
          <p>Coastal Bend windstorm documentation and AEP Texas utility coordination directly east.</p>
        </a>
        <a href="/texas/brownsville-solar-site-surveyors/" class="lar-link-card">
          <h4>Brownsville Solar Site Surveyors</h4>
          <p>BPUB municipal electric standards and coastal border survey operations southeast.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Laredo Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="lar-faq-list">
        {faqs.map(faq => (
          <div class="lar-faq-item card-technical">
            <h3 class="lar-faq-q">{faq.question}</h3>
            <p class="lar-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Laredo, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Laredo"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .lar-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .lar-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .lar-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .lar-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .lar-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .lar-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lar-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .lar-spec-list li:last-child {
    border-bottom: none;
  }

  .lar-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .lar-spec-list span {
    color: var(--text-secondary);
  }

  .lar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .lar-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .lar-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .lar-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .lar-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .lar-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .lar-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .lar-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .lar-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .lar-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .lar-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .lar-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .lar-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .lar-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
