---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Waco, TX | Central Texas Surveys';
const pageDescription = 'Solar site surveys in Waco, TX. Documenting historic framing, modern suburban roof planes, and Oncor service equipment across McLennan County.';
const canonicalPath = '/texas/waco-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Waco' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Waco, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Waco, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Waco, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Historic Framing Inspection',
    'Electrical Panel Verification'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do framing types differ across Waco residential neighborhoods?',
    answer: 'Waco features an architectural mix ranging from historic homes near Baylor University and Castle Heights to newer suburban developments along HWY 6 and Lake Waco. Older properties often feature true dimensional lumber rafters and board decking, while newer homes feature engineered roof trusses. Our surveyors record member sizes, spans, and decking materials with physical measurement photos.'
  },
  {
    question: 'Which electric utility company handles solar interconnection in Waco?',
    answer: 'Waco is primarily served by Oncor Electric Delivery. We photograph the meter enclosure, digital display, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for Oncor distributed generation filings.'
  },
  {
    question: 'How does the City of Waco review residential solar building permits?',
    answer: 'The City of Waco Inspection Services department requires code-compliant single-line electrical diagrams, manufacturer equipment cut sheets, and clear structural mounting attachments. Our survey photo logs and physical measurements provide remote CAD teams with verified data to pass plan review on the initial submission.'
  },
  {
    question: 'What electrical service panel details are captured during the survey?',
    answer: 'We photograph the main service panel, manufacturer label, busbar rating, main breaker capacity, existing breaker schedules, grounding conductors, and utility meter enclosure. This data confirms whether a standard breaker backfeed is compliant or if an alternative interconnection method is needed.'
  },
  {
    question: 'Do your surveyors cover surrounding McLennan County communities?',
    answer: 'Yes. Survey dispatches regularly connect Waco with Hewitt, Woodway, Robinson, Bellmead, McGregor, and China Spring.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Waco, TX</h1>
        <p class="lead">
          Field site documentation across McLennan County and Central Texas. Documenting historic lumber framing, modern suburban roof geometry, and Oncor electric service equipment for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Waco</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Central Texas I-35 Corridor Focus -->
  <section class="section">
    <div class="container">
      <div class="waco-split">
        <div class="waco-text">
          <div class="kicker">Operational Focus</div>
          <h2>I-35 Corridor Central Hub: Historic Craftsman to Lakefront Estates</h2>
          <p>
            Waco holds a strategic position midway between the Dallas-Fort Worth metroplex and Austin along the I-35 corridor. As the commercial center of McLennan County, Waco presents a distinctive structural landscape that ranges from early twentieth-century craftsman homes near downtown to expansive contemporary builds near Lake Waco.
          </p>
          <p>
            Older residential structures often present unique framing conditions, including true dimensional 2x4 or 2x6 rafters, shiplap roof decking, and legacy 100-amp electrical panels. In contrast, modern subdivisions in Woodway and Hewitt feature engineered truss systems and 200-amp service gear. When remote CAD engineers receive vague field notes, they are forced to make assumptions that can lead to structural plan comments or installation-day rework.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Waco project. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your design team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="waco-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Waco Operating Overview</h3>
          <ul class="waco-spec-list">
            <li>
              <strong>County:</strong>
              <span>McLennan County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Waco Inspection Services</span>
            </li>
            <li>
              <strong>Housing Diversity:</strong>
              <span>Historic craftsman homes, mid-century ranches, modern estates</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>100A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Waco Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="waco-grid">
        <div class="waco-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="waco-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="waco-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="waco-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="waco-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="waco-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">McLennan County Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Central Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="waco-links">
        <a href="/texas/temple-solar-site-surveyors/" class="waco-link-card">
          <h4>Temple Solar Site Surveyors</h4>
          <p>Bell County medical corridor survey coordination and framing documentation directly south.</p>
        </a>
        <a href="/texas/killeen-solar-site-surveyors/" class="waco-link-card">
          <h4>Killeen Solar Site Surveyors</h4>
          <p>Fort Cavazos corridor high-density residential survey coordination directly southwest.</p>
        </a>
        <a href="/texas/round-rock-solar-site-surveyors/" class="waco-link-card">
          <h4>Round Rock Solar Site Surveyors</h4>
          <p>High-density Williamson County tech corridor survey coordination further south along I-35.</p>
        </a>
        <a href="/texas/dallas-solar-site-surveyors/" class="waco-link-card">
          <h4>Dallas Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Dallas metropolitan area.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Waco Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="waco-faq-list">
        {faqs.map(faq => (
          <div class="waco-faq-item card-technical">
            <h3 class="waco-faq-q">{faq.question}</h3>
            <p class="waco-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Waco, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Waco"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .waco-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .waco-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .waco-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .waco-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .waco-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .waco-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .waco-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .waco-spec-list li:last-child {
    border-bottom: none;
  }

  .waco-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .waco-spec-list span {
    color: var(--text-secondary);
  }

  .waco-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .waco-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .waco-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .waco-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .waco-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .waco-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .waco-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .waco-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .waco-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .waco-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .waco-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .waco-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .waco-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .waco-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
