---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Conroe, TX | Entergy Territory';
const pageDescription = 'Solar site surveys in Conroe, TX. Operating under Entergy Texas standards, tree canopy shading analysis, and attic framing across Montgomery County.';
const canonicalPath = '/texas/conroe-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas/' },
  { label: 'Conroe' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to coordinate a solar site survey in Conroe, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Conroe, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Conroe, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Non-ERCOT Entergy Utility Surveys',
    'Residential Solar Site Survey',
    'Tree Shading Obstruction Inspection'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How does Entergy Texas affect solar interconnection requirements in Conroe?',
    answer: 'Unlike most of the Greater Houston metro which operates in the ERCOT market under CenterPoint Energy, Conroe is primarily served by Entergy Texas, operating within the MISO electric reliability grid. Entergy Texas maintains distinct distributed generation interconnection procedures, disconnect switch requirements, and technical review timelines. Our surveyors record the exact meter model, enclosure ratings, and exterior disconnect locations to support your Entergy submittal.'
  },
  {
    question: 'Are any Conroe properties served by electric cooperatives?',
    answer: 'Yes. Certain outlying rural and master-planned sections in Montgomery County are served by Mid-South Synergy electric cooperative. We inspect the electric meter badge and enclosure labels during the survey to confirm the serving utility for your project team.'
  },
  {
    question: 'How do tall pine trees in Montgomery County affect roof surveys?',
    answer: 'Conroe sits in the Piney Woods region, where tall loblolly pines often surround residential properties. Our surveyors photograph tree canopies from multiple roof planes, record shading angles, and document the effective solar window to help CAD designers locate arrays where solar harvest is maximized.'
  },
  {
    question: 'What roof and framing data is captured across Conroe homes?',
    answer: 'We measure pitch on all roof planes, record shingle condition, map plumbing vents and flashings, and record attic rafter or truss spacing with measurement photos to support structural review.'
  },
  {
    question: 'Do your surveyors cover surrounding North Houston and Montgomery County markets?',
    answer: 'Yes. Survey dispatches regularly connect Conroe with The Woodlands, Montgomery, Willis, Spring, and Huntsville.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Conroe, TX</h1>
        <p class="lead">
          Field site documentation tailored for Montgomery County and Entergy Texas territory. Capturing non-ERCOT utility service parameters, pine tree shading profiles, and attic structural framing for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Conroe</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Entergy Non-ERCOT Alert & Operational Focus -->
  <section class="section">
    <div class="container">
      <div class="entergy-alert card-technical">
        <div class="alert-head">
          <div class="alert-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div>
            <div class="kicker">Critical Utility Distinction</div>
            <h2>Non-ERCOT Territory: Operating Under Entergy Texas Interconnection Standards</h2>
          </div>
        </div>
        <p>
          Conroe is fundamentally distinct from the rest of the Greater Houston solar market. While Houston, Katy, and Pearland operate within the ERCOT grid under CenterPoint Energy, Conroe is primarily served by Entergy Texas, which belongs to the Midcontinent Independent System Operator (MISO) regional grid.
        </p>
        <p>
          Entergy Texas enforces its own distributed generation interconnection rules, specific meter socket standards, and manual disconnect requirements. Submitting an interconnection package based on CenterPoint assumptions results in immediate rejection. Our survey coordination records the exact Entergy meter tags, service entrance mast specifications, and exterior disconnect hardware so your team files with complete accuracy.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Inspection Scope</div>
        <h2>Conroe Site Survey Package Deliverables</h2>
        <p class="lead">
          Comprehensive physical data prepared to support engineering review and City of Conroe building permits.
        </p>
      </div>

      <div class="conroe-grid">
        <div class="conroe-card card-technical">
          <h3>Entergy Texas Meter Equipment</h3>
          <p>
            We photograph the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Entergy Texas or Mid-South Synergy interconnection filing.
          </p>
        </div>

        <div class="conroe-card card-technical">
          <h3>Main Electrical Service Panels</h3>
          <p>
            The survey records busbar ratings, main breaker capacity, manufacturer data plates, and circuit breaker directories, confirming whether the electrical panel can accept a solar backfeed breaker.
          </p>
        </div>

        <div class="conroe-card card-technical">
          <h3>Pine Tree Shading & Obstruction Mapping</h3>
          <p>
            We document surrounding pine tree canopies, measure proximity to usable roof planes, and photograph obstruction angles that impact solar production across Montgomery County properties.
          </p>
        </div>

        <div class="conroe-card card-technical">
          <h3>Roof Plane Geometry & Decking</h3>
          <p>
            We measure pitch angles on all roof planes, record azimuth, map plumbing vents, and photograph shingle condition to define usable array boundaries within local fire code setbacks.
          </p>
        </div>

        <div class="conroe-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="conroe-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">North Houston Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Montgomery County Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="conroe-links">
        <a href="/texas/houston-solar-site-surveyors/" class="conroe-link-card">
          <h4>Houston Solar Site Surveyors</h4>
          <p>Comprehensive solar site survey operations across the broader Greater Houston metropolitan area.</p>
        </a>
        <a href="/texas/sugar-land-solar-site-surveyors/" class="conroe-link-card">
          <h4>Sugar Land Solar Site Surveyors</h4>
          <p>Fort Bend County master-planned community survey coordination and 400A service data.</p>
        </a>
        <a href="/texas/pasadena-solar-site-surveyors/" class="conroe-link-card">
          <h4>Pasadena Solar Site Surveyors</h4>
          <p>Southeast Houston residential and industrial corridor survey coordination.</p>
        </a>
        <a href="/texas/pearland-solar-site-surveyors/" class="conroe-link-card">
          <h4>Pearland Solar Site Surveyors</h4>
          <p>Multi-county suburban survey coordination and dual CenterPoint versus TNMP utility data.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Conroe Solar Survey Operations</h2>
        <p class="lead">Essential details for solar contractors and project coordinators.</p>
      </div>

      <div class="conroe-faq-list">
        {faqs.map(faq => (
          <div class="conroe-faq-item card-technical">
            <h3 class="conroe-faq-q">{faq.question}</h3>
            <p class="conroe-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Coordinate a Solar Site Survey in Conroe, TX"
    subtitle="Submit your project address to confirm surveyor scheduling and ensure your field package meets Entergy Texas requirements."
    primaryCtaText="Schedule Survey in Conroe"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .entergy-alert {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 6px solid var(--accent-gold);
    max-width: 1000px;
    margin: 0 auto;
  }

  .alert-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .alert-icon {
    color: var(--accent-gold);
    margin-top: 0.25rem;
  }

  .entergy-alert h2 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .entergy-alert p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .entergy-alert p:last-child {
    margin-bottom: 0;
  }

  .conroe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .conroe-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .conroe-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .conroe-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .conroe-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .conroe-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .conroe-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .conroe-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .conroe-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .conroe-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .conroe-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .conroe-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .conroe-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
