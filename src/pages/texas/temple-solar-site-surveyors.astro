---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar Site Surveyors in Temple, TX | Central Texas';
const pageDescription = 'Solar site surveys in Temple, TX. Documenting Oncor service panels, attic framing, and roof plane geometry across Bell County and the I-35 corridor.';
const canonicalPath = '/texas/temple-solar-site-surveyors/';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Texas', href: '/texas-solar-site-surveyors/' },
  { label: 'Temple' }
];

const dispatchWhatsApp = getWhatsAppLink('Hi, I need to schedule a solar site survey in Temple, Texas.');

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Solar Site Surveyors: Temple, TX',
  'description': pageDescription,
  'url': `https://solarsitesurveyors.com${canonicalPath}`,
  'telephone': '+1-682-396-0543',
  'areaServed': {
    '@type': 'City',
    'name': 'Temple, Texas',
    'containedInPlace': { '@type': 'State', 'name': 'Texas' }
  },
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Attic Framing Inspection',
    'Electrical Panel Verification'
  ],
  'priceRange': '$$'
};

const faqs = [
  {
    question: 'How do City of Temple building permits impact solar plan sets?',
    answer: 'The City of Temple Permits and Inspections Department enforces current residential building and electrical codes. Plan reviewers require complete single-line electrical diagrams, structural rafter attachment details, and manufacturer specification sheets. Our survey packages provide high-resolution data plate photos and verified framing measurements to ensure smooth plan approval.'
  },
  {
    question: 'Which utility company handles solar interconnection in Temple?',
    answer: 'Temple is served by Oncor Electric Delivery. We photograph the digital meter display, meter enclosure, meter badge number, service drop or underground lateral, and main utility disconnect to ensure complete documentation for Oncor distributed generation filings.'
  },
  {
    question: 'What electrical panel configurations are common in Temple homes?',
    answer: 'Temple residential properties built between the 1970s and 2000s feature 150-amp or 200-amp main service panels, while older central homes may retain 100-amp or 125-amp equipment. Our surveyors photograph panel labels, bus ratings, main breaker capacities, and available breaker slots to verify solar backfeed feasibility.'
  },
  {
    question: 'What roof types and framing conditions are typical across Temple?',
    answer: 'Single-family homes feature composition shingle roofs across low-to-medium pitch gable and hip planes. We document rafter or truss dimensions, center-to-center spacing, purlin bracing, and roof decking thickness with physical measurement photos to support structural review.'
  },
  {
    question: 'Do you cover projects across the Bell County medical corridor?',
    answer: 'Yes. Survey dispatches regularly connect Temple with Belton, Salado, Troy, Morgans Point Resort, and Killeen.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="service-areas"
  canonical={canonicalPath}
  schemaData={citySchema}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Centered Hero Section -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <h1 class="page-title">Solar Site Surveyors in Temple, TX</h1>
        <p class="lead">
          Field site documentation across eastern Bell County and Central Texas. Documenting Oncor electric service equipment, attic structural framing, and roof plane geometry for solar design teams.
        </p>
        <div class="hero-actions">
          <a href={dispatchWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Schedule Survey in Temple</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/texas-solar-site-surveyors/" class="btn btn-outline-white btn-lg">
            <span>← All Texas Cities</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bell County Medical Hub Focus -->
  <section class="section">
    <div class="container">
      <div class="temple-split">
        <div class="temple-text">
          <div class="kicker">Operational Focus</div>
          <h2>Central Texas Medical Hub: Residential and Infill Solar Infrastructure</h2>
          <p>
            Temple serves as the primary medical, commercial, and logistics anchor of eastern Bell County along the I-35 corridor. Anchored by major healthcare institutions and manufacturing hubs, the city has experienced sustained residential expansion alongside mature established neighborhoods.
          </p>
          <p>
            The housing inventory presents a balanced cross-section of Central Texas architecture. Established neighborhoods feature classic mid-century brick ranch homes with conventional rafter framing and 125-amp panels, while modern master-planned communities along HWY 317 showcase engineered roof trusses and 200-amp service equipment. When remote CAD engineers receive incomplete field photos, they are forced to make assumptions that can lead to structural plan comments or installation-day delays.
          </p>
          <p>
            Our survey coordination standardizes field data collection across every Temple project. We record verified electrical service parameters, inspect accessible attic framing, measure roof plane geometry, and photograph all service equipment to ensure your design team can draft accurate, permit-ready plans.
          </p>
        </div>
        <div class="temple-profile card-technical">
          <div class="profile-tag">Market Profile</div>
          <h3>Temple Operating Overview</h3>
          <ul class="temple-spec-list">
            <li>
              <strong>County:</strong>
              <span>Bell County</span>
            </li>
            <li>
              <strong>Electric Utility:</strong>
              <span>Oncor Electric Delivery</span>
            </li>
            <li>
              <strong>Permit Authority:</strong>
              <span>City of Temple Permits and Inspections</span>
            </li>
            <li>
              <strong>Housing Architecture:</strong>
              <span>Established brick ranches, contemporary suburban subdivisions</span>
            </li>
            <li>
              <strong>Electrical Norms:</strong>
              <span>125A to 200A residential service equipment</span>
            </li>
            <li>
              <strong>Core Services:</strong>
              <span><a href="/services/solar-site-surveys/">Site Surveys</a> and <a href="/services/solar-cad-designs/">Solar CAD Plan Sets</a></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Deliverables Grid -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Field Scope</div>
        <h2>Field Deliverables for Temple Solar Installations</h2>
        <p class="lead">
          Structured documentation designed to eliminate design revisions and support smooth permitting.
        </p>
      </div>

      <div class="temple-grid">
        <div class="temple-card card-technical">
          <h3>Main Electrical Panel Verification</h3>
          <p>
            We photograph the panel interior, busbar rating, main breaker capacity, manufacturer catalog number, and circuit directory, verifying open spaces for solar backfeed breakers.
          </p>
        </div>

        <div class="temple-card card-technical">
          <h3>Oncor Meter & Disconnect Hardware</h3>
          <p>
            The survey documents the electric meter enclosure, meter badge number, digital display, service entrance conduit, and existing grounding to support complete Oncor interconnection filing.
          </p>
        </div>

        <div class="temple-card card-technical">
          <h3>Roof Plane Geometry & Usable Area</h3>
          <p>
            We measure pitch angles, record azimuth, and map roof planes across the structure. The survey identifies vent pipes, attic fans, chimney flashing, and dormers to define usable array boundaries.
          </p>
        </div>

        <div class="temple-card card-technical">
          <h3>Attic Rafter & Truss Framing</h3>
          <p>
            When accessible, the surveyor records rafter dimensions, truss member sizes, center-to-center spacing, purlin bracing, and roof decking thickness with physical tape measure photographs.
          </p>
        </div>

        <div class="temple-card card-technical">
          <h3>Battery Backup Wall Setbacks</h3>
          <p>
            When projects incorporate energy storage systems, we record available wall dimensions in attached garages or exterior walls, verifying clearances from windows, doors, and gas meters.
          </p>
        </div>

        <div class="temple-card card-technical">
          <h3>Property Elevation Context</h3>
          <p>
            Four-corner property elevation photos capture site access, fence gates, air conditioning compressors, and overhead service drops to support installation crew safety and staging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Coverage Links -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Bell County Operations</div>
        <h2>Connected Survey Coverage Across Surrounding Central Texas Markets</h2>
        <p class="lead">
          Coordinate field surveys across neighboring municipalities with consistent documentation standards.
        </p>
      </div>

      <div class="temple-links">
        <a href="/texas/killeen-solar-site-surveyors/" class="temple-link-card">
          <h4>Killeen Solar Site Surveyors</h4>
          <p>Western Bell County Fort Cavazos corridor high-density residential survey coordination directly west.</p>
        </a>
        <a href="/texas/waco-solar-site-surveyors/" class="temple-link-card">
          <h4>Waco Solar Site Surveyors</h4>
          <p>Historic university-area housing and suburban roof plane documentation directly north.</p>
        </a>
        <a href="/texas/georgetown-solar-site-surveyors/" class="temple-link-card">
          <h4>Georgetown Solar Site Surveyors</h4>
          <p>Georgetown Utility Systems municipal standards and Sun City roof plane documentation directly south.</p>
        </a>
        <a href="/texas/round-rock-solar-site-surveyors/" class="temple-link-card">
          <h4>Round Rock Solar Site Surveyors</h4>
          <p>High-density Williamson County tech corridor survey coordination further south along I-35.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="kicker">Frequently Asked Questions</div>
        <h2>Temple Solar Survey Operations</h2>
        <p class="lead">Common questions from solar operations managers and project coordinators.</p>
      </div>

      <div class="temple-faq-list">
        {faqs.map(faq => (
          <div class="temple-faq-item card-technical">
            <h3 class="temple-faq-q">{faq.question}</h3>
            <p class="temple-faq-a">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    title="Need a Solar Site Survey in Temple, TX?"
    subtitle="Submit your project address to confirm surveyor scheduling and receive CAD-ready field documentation for your design team."
    primaryCtaText="Schedule Survey in Temple"
    primaryCtaLink={dispatchWhatsApp}
    secondaryCtaText="Explore Texas Directory"
    secondaryCtaLink="/texas-solar-site-surveyors/"
  />
</BaseLayout>

<style>
  .page-hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .page-hero .lead {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: #9FB3C8;
    max-width: 900px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .temple-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .temple-text h2 {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .temple-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .temple-profile {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .profile-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-color);
    background: var(--surface-subtle);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .temple-profile h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
  }

  .temple-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .temple-spec-list li {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }

  .temple-spec-list li:last-child {
    border-bottom: none;
  }

  .temple-spec-list strong {
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .temple-spec-list span {
    color: var(--text-secondary);
  }

  .temple-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .temple-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .temple-card h3 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .temple-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .temple-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .temple-link-card {
    display: block;
    padding: var(--space-6);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .temple-link-card:hover {
    border-color: var(--primary-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .temple-link-card h4 {
    font-size: 1.0625rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .temple-link-card p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .temple-faq-list {
    max-width: 900px;
    margin: var(--space-8) auto 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .temple-faq-item {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
  }

  .temple-faq-q {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .temple-faq-a {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 900px) {
    .temple-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
