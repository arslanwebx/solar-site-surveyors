---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import SurveyCalculator from '../components/SurveyCalculator.astro';
import CTASection from '../components/CTASection.astro';
import { resourcesData } from '../data/resources';
import { serviceAreasData } from '../data/serviceAreas';

const recentArticles = resourcesData.slice(0, 3);
---

<BaseLayout 
  title="SolarSite Co. | Solar Site Surveys Coordinated for EPCs & Installers"
  description="Nationwide solar site survey coordination for Solar EPCs, installers, dealers, and engineering operations teams. Roof, electrical MSP, and battery surveys delivered in 48–72 hours."
  activeNav="home"
>
  <!-- HERO SECTION -->
  <section class="hero-section section-dark">
    <div class="container-wide">
      <div class="hero-grid">
        <!-- Hero Content -->
        <div class="hero-content">
          <div class="hero-badge-row">
            <span class="badge-tech badge-dark"><span class="status-dot"></span> NATIONWIDE OPERATIONAL DISPATCH</span>
            <span class="hero-sla-label font-mono">48–72HR SLA</span>
          </div>

          <h1 class="hero-title">
            Solar Site Surveys, <br/>
            <span class="text-amber">Scheduled Without</span> the Headache.
          </h1>

          <p class="hero-subtitle lead">
            We help Solar EPCs, installers, and contractors coordinate professional residential and commercial site surveys across 14+ states—providing the accurate field dimensions, electrical nameplates, and 36-photo packages your engineering team needs for one-touch CAD design and immediate permit approval.
          </p>

          <div class="hero-actions">
            <a href="/schedule" class="btn btn-primary btn-lg" id="hero-primary-cta">
              <span>Schedule a Site Survey</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/for-epcs" class="btn btn-outline-white btn-lg" id="hero-partner-cta">
              <span>Partner With Us (For EPCs)</span>
            </a>
          </div>

          <!-- Hero Metrics / Trust Points -->
          <div class="hero-metrics-grid">
            <div class="metric-item">
              <span class="metric-val font-mono">48–72h</span>
              <span class="metric-lbl">Standard Survey Turnaround</span>
            </div>
            <div class="metric-item">
              <span class="metric-val font-mono">99.4%</span>
              <span class="metric-lbl">First-Pass QA Approval</span>
            </div>
            <div class="metric-item">
              <span class="metric-val font-mono">14+</span>
              <span class="metric-lbl">States with Active Network</span>
            </div>
            <div class="metric-item">
              <span class="metric-val font-mono">&lt; 3%</span>
              <span class="metric-lbl">CAD Revision Rate</span>
            </div>
          </div>
        </div>

        <!-- Hero Visual: Documentary Commercial Photography with Technical Overlay -->
        <div class="hero-visual-col">
          <div class="hero-image-wrapper card-dark tech-grid-border">
            <img 
              src="/images/hero_surveyor_field.jpg" 
              alt="Professional solar site surveyor inspecting residential roof pitch and structural condition with digital gauge and tablet" 
              width="1200" 
              height="675" 
              class="hero-img"
              loading="eager"
            />
            
            <!-- Technical Overlay Callouts -->
            <div class="tech-annotation top-left">
              <span class="ann-icon">📐</span>
              <div class="ann-data">
                <span class="ann-label font-mono">ROOF PLANE AZIMUTH / PITCH</span>
                <span class="ann-val font-mono">185° SSW • 34.8° SLOPE</span>
              </div>
            </div>

            <div class="tech-annotation bottom-right">
              <span class="ann-icon">⚡</span>
              <div class="ann-data">
                <span class="ann-label font-mono">MSP AUDIT STATUS</span>
                <span class="ann-val font-mono">225A BUS • 200A MAIN (120% OK)</span>
              </div>
            </div>

            <div class="tech-badge-overlay">
              <span class="font-mono">GEO-REF: 30.2672° N, 97.7431° W • 36-PHOTO STANDARD</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST & VALUE SECTION: BUILT FOR SOLAR OPERATIONS TEAMS -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <span class="badge-tech badge-amber">OPERATIONAL FIT</span>
        <h2>Built for Solar Operations Teams</h2>
        <p class="lead">
          Designed specifically to solve the logistical headaches of field surveying for growing solar companies, high-volume EPCs, and distributed sales dealers.
        </p>
      </div>

      <!-- Categories Served -->
      <div class="audience-grid">
        <div class="audience-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M2 20h20M5 20V8l7-5 7 5v12M9 20v-6h6v6"/></svg>
          </div>
          <h4>Solar EPCs</h4>
          <p>Eliminate regional surveyor payroll and expand territory overnight with zero fixed overhead.</p>
        </div>

        <div class="audience-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h4>Solar Installers</h4>
          <p>Prevent expensive installation-day surprises like undersized busbars or dry-rotted rafters.</p>
        </div>

        <div class="audience-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7.5" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          </div>
          <h4>Solar Dealers</h4>
          <p>Move closed sales into engineering in 48 hours to lock in customer momentum and slash cancellations.</p>
        </div>

        <div class="audience-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h4>Roof + Solar Contractors</h4>
          <p>Receive comprehensive roof layer analysis, condition reports, and remaining lifespan assessments.</p>
        </div>

        <div class="audience-card card-technical">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <h4>Design & CAD Teams</h4>
          <p>Receive standardized single-line parameters, 36-photo packages, and clear obstruction offsets.</p>
        </div>
      </div>

      <!-- Major Operational Benefits -->
      <div class="benefits-panel card-technical tech-grid-border" style="margin-top: var(--space-10);">
        <div class="benefits-header">
          <span class="badge-tech badge-amber">OPERATIONAL ADVANTAGE</span>
          <h3>Why Solar Operations Leaders Choose SolarSite Co.</h3>
        </div>
        <div class="benefits-grid">
          <div class="benefit-item">
            <div class="benefit-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div>
              <strong>Reliable Survey Scheduling</strong>
              <p>Direct customer coordination with zero scheduling back-and-forth for your project managers.</p>
            </div>
          </div>
          <div class="benefit-item">
            <div class="benefit-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div>
              <strong>Standardized 36-Photo Packages</strong>
              <p>Every surveyor follows an identical photo checklist so draftspersons never guess.</p>
            </div>
          </div>
          <div class="benefit-item">
            <div class="benefit-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div>
              <strong>Faster CAD Turnaround</strong>
              <p>Clear, dimensioned data reduces drafting cycle times from days to hours.</p>
            </div>
          </div>
          <div class="benefit-item">
            <div class="benefit-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div>
              <strong>Fewer Missing Photos & Revisits</strong>
              <p>Our internal QA team verifies every photo before deliverable release, eliminating 2nd truck rolls.</p>
            </div>
          </div>
          <div class="benefit-item">
            <div class="benefit-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div>
              <strong>Reduced Redesigns & Change Orders</strong>
              <p>Accurate busbar and rafter data prevents costly plan revisions after municipal submission.</p>
            </div>
          </div>
          <div class="benefit-item">
            <div class="benefit-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div>
              <strong>Multi-Market Scalability</strong>
              <p>Enter new states and utility territories instantly without recruiting or managing local staff.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: THE 4-STEP OPERATIONAL PIPELINE -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <span class="badge-tech badge-amber">OPERATIONAL WORKFLOW</span>
        <h2>How Project Coordination Works</h2>
        <p class="lead">
          A friction-free four-stage pipeline connecting your sales intake directly to CAD drafting.
        </p>
      </div>

      <ProcessTimeline />
    </div>
  </section>

  <!-- SITE SURVEY SERVICES (DETAILED TECHNICAL SCOPE) -->
  <section class="section section-subtle" id="services-overview">
    <div class="container">
      <div class="section-header">
        <span class="badge-tech badge-amber">FIELD AUDIT SCOPE</span>
        <h2>Comprehensive Site Survey Disciplines</h2>
        <p class="lead">
          Our coordinated field surveyors execute exhaustive inspections across all physical, structural, and electrical parameters required for solar permitting and installation.
        </p>
      </div>

      <div class="services-detail-grid">
        <!-- Service 1: Roof Survey -->
        <div class="service-block card-technical tech-grid-border">
          <div class="service-block-header">
            <span class="badge-tech badge-amber">ROOF & STRUCTURAL</span>
            <h3>Roof Geometry & Condition Audit</h3>
          </div>
          <p class="service-block-desc">
            Physical validation of aerial models. We document every roof plane, pitch angle, material layer, and obstruction coordinate to give CAD designers total spatial confidence.
          </p>
          <div class="service-features-list">
            <span class="feat-tag">Roof Dimensions & Pitch Gauges</span>
            <span class="feat-tag">Shingle / Tile Layer Count</span>
            <span class="feat-tag">Attic Rafter & Truss Spacing</span>
            <span class="feat-tag">Obstruction X/Y Offsets</span>
            <span class="feat-tag">Chimney & Skylight Clearances</span>
            <span class="feat-tag">Shading & Horizon Factors</span>
          </div>
        </div>

        <!-- Service 2: Electrical Survey -->
        <div class="service-block card-technical tech-grid-border">
          <div class="service-block-header">
            <span class="badge-tech badge-amber">ELECTRICAL & MSP</span>
            <h3>Electrical Service & Interconnection</h3>
          </div>
          <p class="service-block-desc">
            Complete electrical nameplate documentation. We remove panel dead-fronts to verify busbar ratings, main breaker capacity, and NEC 705.12 interconnection viability.
          </p>
          <div class="service-features-list">
            <span class="feat-tag">Main Service Panel (MSP) Model</span>
            <span class="feat-tag">Busbar Amp Rating Verification</span>
            <span class="feat-tag">Main Disconnect Amperage</span>
            <span class="feat-tag">120% Rule Calculation Data</span>
            <span class="feat-tag">Utility Meter Serial & Socket Type</span>
            <span class="feat-tag">Grounding Electrode Verification</span>
          </div>
        </div>

        <!-- Service 3: Battery & Storage Survey -->
        <div class="service-block card-technical tech-grid-border">
          <div class="service-block-header">
            <span class="badge-tech badge-amber">STORAGE & BESS</span>
            <h3>Battery & Gateway Spatial Clearances</h3>
          </div>
          <p class="service-block-desc">
            Specialized storage site checks. We verify NFPA 855 wall clearances, gateway locations, and conduit pathways for Tesla Powerwall, Enphase, and SolarEdge systems.
          </p>
          <div class="service-features-list">
            <span class="feat-tag">NFPA 855 Window/Door Offsets</span>
            <span class="feat-tag">Microgrid Gateway Placement</span>
            <span class="feat-tag">Critical Loads Subpanel Audit</span>
            <span class="feat-tag">Conduit Routing Path & Distance</span>
            <span class="feat-tag">Wall Framing & Stud Capacity</span>
            <span class="feat-tag">Garage Vehicle Impact Checks</span>
          </div>
        </div>

        <!-- Service 4: Site Documentation -->
        <div class="service-block card-technical tech-grid-border">
          <div class="service-block-header">
            <span class="badge-tech badge-amber">SITE DOCUMENTATION</span>
            <h3>Complete Geotagged Visual Package</h3>
          </div>
          <p class="service-block-desc">
            High-resolution documentary photography. Every property angle, street elevation, meter context, and attic framing connection delivered in a structured digital package.
          </p>
          <div class="service-features-list">
            <span class="feat-tag">4 Exterior Building Elevations</span>
            <span class="feat-tag">High-Resolution Macro Labels</span>
            <span class="feat-tag">Geotagged & Timestamped</span>
            <span class="feat-tag">Drone Thermal / RGB (Optional)</span>
            <span class="feat-tag">Cloud Portal Download ZIP</span>
            <span class="feat-tag">One-Touch CAD Compatibility</span>
          </div>
        </div>
      </div>

      <div class="services-cta-row" style="margin-top: var(--space-8); text-align: center;">
        <a href="/services" class="btn btn-dark btn-md">
          <span>Explore Complete Technical Service Scopes & Deliverables →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE ESTIMATOR SECTION -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <span class="badge-tech badge-amber">INSTANT ESTIMATE</span>
        <h2>Calculate Turnaround & Deliverable Scope</h2>
        <p class="lead">
          Select your project parameters to preview target SLA turnarounds and standard deliverable inclusions.
        </p>
      </div>

      <SurveyCalculator />
    </div>
  </section>

  <!-- EPC SPOTLIGHT: "YOU SELL AND INSTALL SOLAR. WE HANDLE THE FIELD VERIFICATION." -->
  <section class="section section-dark">
    <div class="container">
      <div class="epc-spotlight-grid">
        <div class="epc-text-col">
          <span class="badge-tech badge-dark">ENGINEERED FOR SCALE</span>
          <h2 class="epc-title">You Sell & Install Solar.<br/><span class="text-amber">We Handle the Field Verification.</span></h2>
          <p class="lead" style="color: #CBD5E1; margin-bottom: 1.5rem;">
            Managing an in-house fleet of site surveyors means dealing with vehicle maintenance, ladder liability, regional dead zones, scheduling call-outs, and unpredictable payroll overhead.
          </p>
          <p style="color: #94A3B8; margin-bottom: 2rem;">
            SolarSite Co. acts as your dedicated regional field operations department. You dispatch projects on demand through our portal, and we deliver QA-verified survey packages directly into your engineering pipeline within 48–72 hours.
          </p>

          <div class="epc-checklist">
            <div class="epc-check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Zero surveyor payroll during seasonal market fluctuations</span>
            </div>
            <div class="epc-check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Consistent 36-photo deliverables across all geographic regions</span>
            </div>
            <div class="epc-check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Direct webhook / API delivery into your CRM or CAD software</span>
            </div>
          </div>

          <div class="epc-actions" style="margin-top: 2rem;">
            <a href="/for-epcs" class="btn btn-primary btn-lg">Become an EPC Partner</a>
          </div>
        </div>

        <div class="epc-visual-col">
          <div class="epc-image-card card-dark tech-grid-border">
            <img 
              src="/images/electrical_panel_survey.jpg" 
              alt="Licensed solar technician inspecting electrical main service panel with multimeter" 
              width="900" 
              height="506" 
              class="epc-img"
              loading="lazy"
            />
            <div class="epc-image-caption">
              <div class="caption-title font-mono">FIELD VERIFICATION STANDARD</div>
              <div class="caption-desc">MSP interior inspection, busbar rating verification, and backfeed compliance audit.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESOURCE HUB PREVIEW (EDITORIAL AUTHORITY) -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-top-row">
        <div class="section-header" style="margin-bottom: 0;">
          <span class="badge-tech badge-amber">SOLAR OPERATIONS RESOURCES</span>
          <h2>Field & Engineering Knowledge Hub</h2>
          <p class="lead">
            Authoritative technical guides on site survey checklists, electrical busbars, AHJ permitting rules, and NTP-to-PTO operational workflows.
          </p>
        </div>
        <a href="/resources" class="btn btn-outline btn-sm">View All Resources →</a>
      </div>

      <div class="resources-grid" style="margin-top: var(--space-8);">
        {recentArticles.map(article => (
          <article class="resource-card card-technical tech-grid-border">
            <div class="card-top-meta">
              <span class="badge-tech badge-amber">{article.category}</span>
              <span class="read-time font-mono">{article.readTime}</span>
            </div>
            <h3 class="resource-title">
              <a href={`/resources/${article.slug}`}>{article.title}</a>
            </h3>
            <p class="resource-summary">{article.summary}</p>
            <div class="card-footer-meta">
              <span class="author-byline">By {article.author} • {article.authorRole}</span>
              <a href={`/resources/${article.slug}`} class="read-more-link">
                <span>Read Guide</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COVERAGE QUICK SELECTOR & GLOSSARY CALLOUT -->
  <section class="section">
    <div class="container">
      <div class="grid-2">
        <!-- Service Areas Quick Box -->
        <div class="coverage-callout card-technical tech-grid-border">
          <span class="badge-tech badge-amber">GEOGRAPHIC COVERAGE</span>
          <h3>Active State Service Network</h3>
          <p>
            We maintain certified surveyor coverage across major solar markets with established turnaround SLAs.
          </p>
          <div class="state-pills-row">
            {serviceAreasData.map(st => (
              <a href={`/service-areas/${st.slug}`} class="state-pill">
                <strong>{st.code}</strong> {st.name}
              </a>
            ))}
          </div>
          <a href="/service-areas" class="btn btn-outline btn-sm" style="margin-top: 1.5rem;">
            Explore All State Turnarounds & Utility Profiles →
          </a>
        </div>

        <!-- Glossary Quick Box -->
        <div class="glossary-callout card-technical tech-grid-border">
          <span class="badge-tech badge-amber">INDUSTRY TERMINOLOGY</span>
          <h3>Solar Operations Glossary</h3>
          <p>
            Searchable definitions and operational context for 25+ essential solar terms including AHJ, PTO, NTP, MSP, 120% Rule, and Backfeed Breakers.
          </p>
          <div class="glossary-sample-tags">
            <a href="/glossary" class="gloss-tag">120% Rule (NEC 705.12)</a>
            <a href="/glossary" class="gloss-tag">Main Service Panel (MSP)</a>
            <a href="/glossary" class="gloss-tag">AHJ Compliance</a>
            <a href="/glossary" class="gloss-tag">PTO & NTP Milestones</a>
            <a href="/glossary" class="gloss-tag">PE Engineering Stamps</a>
          </div>
          <a href="/glossary" class="btn btn-outline btn-sm" style="margin-top: 1.5rem;">
            Access Searchable Glossary (25+ Terms) →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA SECTION -->
  <CTASection 
    title="Need a Site Survey for Your Next Project?"
    subtitle="Submit the project address and requirements. Our operations desk coordinates the surveyor and delivers an organized, CAD-ready survey package in 48–72 hours."
    primaryCtaText="Schedule a Site Survey"
    primaryCtaLink="/schedule"
    secondaryCtaText="Become an EPC Partner"
    secondaryCtaLink="/for-epcs"
  />
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
    position: relative;
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-sla-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-amber-light);
    background-color: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .hero-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.12;
    margin-bottom: var(--space-6);
  }

  .text-amber {
    color: #F59E0B;
  }

  .hero-subtitle {
    color: #94A3B8;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .hero-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-6);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-size: 1.5rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .metric-lbl {
    font-size: 0.75rem;
    color: #94A3B8;
    line-height: 1.3;
    margin-top: 0.2rem;
  }

  /* Hero Visual */
  .hero-image-wrapper {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
