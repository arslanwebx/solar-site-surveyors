---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import { top20TexasCities } from '../data/texasCities';
import { getWhatsAppLink } from '../data/whatsapp';

const featuredTexasCities = top20TexasCities.slice(0, 10);
const whatsappScheduleLink = getWhatsAppLink('Hi, I would like to schedule a solar site survey in Texas.');
---

<BaseLayout 
  title="Solar Site Surveyors & CAD Designers for Texas"
  description="Professional solar site surveyors & CAD designers across Texas for solar installers and EPCs. Fast, accurate roof, electrical, structural, and site survey reports."
  activeNav="home"
>
  <!-- SECTION 1: HERO SECTION (Left-Aligned, Asymmetrical Luxury Horizontal Gradient) -->
  <section class="hero-section">
    <div class="container-wide">
      <div class="hero-content-left">
        <h1 class="hero-title">
          Solar Site Surveys, <br class="hero-br" />
          Done Right.
        </h1>

        <p class="hero-subtitle">
          Reliable Texas-wide site survey coordination connecting solar EPCs and installers with verified local surveyors. Standardized field data, comprehensive photo packages, and CAD-ready deliverables.
        </p>

        <!-- Two Left-Aligned CTAs -->
        <div class="hero-actions">
          <a href={whatsappScheduleLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg" id="hero-schedule-btn">
            <span>Schedule a Site Survey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/join-us" class="btn btn-outline btn-lg" id="hero-partner-btn">
            <span>Partner With Us</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: BUILT FOR TEXAS SOLAR OPERATIONS -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <h2>Built Specifically for Texas Solar Operations</h2>
        <p class="lead">
          We eliminate the friction of scheduling, managing in-house field fleets, and navigating regional Texas utility nuances.
        </p>
      </div>

      <div class="grid-3" style="margin-top: var(--space-8);">
        <div class="advantage-card card-technical">
          <div class="adv-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h4>Full ERCOT & Texas Utility Proficiency</h4>
          <p>
            Our surveyors understand the exact meter socket, disconnect, and labeling requirements for Oncor, CenterPoint Energy, AEP Texas, CPS Energy, Austin Energy, and TNMP.
          </p>
        </div>

        <div class="advantage-card card-technical">
          <div class="adv-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h4>One-Touch CAD Deliverables</h4>
          <p>
            Every survey delivers standardized photo packages, verified digital pitch readings, rafter spans, and single-line parameters ready for immediate AutoCAD, HelioScope, or Aurora import.
          </p>
        </div>

        <div class="advantage-card card-technical">
          <div class="adv-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h4>Zero Payroll Overhead & No Travel Fees</h4>
          <p>
            Pay on-demand per completed, QA-verified survey. Expand your sales into Dallas, Houston, Austin, San Antonio, or West Texas overnight without hiring regional staff.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: OUR CORE FIELD SURVEY DISCIPLINES -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2>Standardized Texas Survey Disciplines</h2>
        <p class="lead">
          Our surveyors capture every critical physical, electrical, and structural parameter required for solar engineering stamps and municipal AHJ permits.
        </p>
      </div>

      <div class="grid-2" style="margin-top: var(--space-8);">
        <!-- Roof Discipline -->
        <div class="discipline-block card-technical">
          <div class="discipline-icon-row">
            <div class="discipline-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Roof Geometry & Condition Audit</h3>
          </div>
          <p>
            Physical verification of all roof planes, digital pitch gauge readings, shingle/tile layer counts, granular condition, and millimeter-accurate obstruction coordinates (vents, pipes, skylights).
          </p>
        </div>

        <!-- Electrical Discipline -->
        <div class="discipline-block card-technical">
          <div class="discipline-icon-row">
            <div class="discipline-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="9" y1="9" x2="9" y2="15"/><line x1="15" y1="9" x2="15" y2="15"/><line x1="9" y1="12" x2="15" y2="12"/></svg>
            </div>
            <h3>Electrical MSP & 120% Busbar Rule</h3>
          </div>
          <p>
            Full interior dead-front removal to photograph manufacturer labels, busbar ampacity ratings, main breaker sizes, grounding electrode conductors, and spare breaker slots.
          </p>
        </div>

        <!-- Battery Storage Discipline -->
        <div class="discipline-block card-technical">
          <div class="discipline-icon-row">
            <div class="discipline-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><line x1="6" y1="11" x2="6" y2="11"/><line x1="10" y1="11" x2="10" y2="11"/><line x1="14" y1="11" x2="14" y2="11"/><line x1="18" y1="11" x2="18" y2="11"/></svg>
            </div>
            <h3>Battery Storage & Gateway Clearances</h3>
          </div>
          <p>
            Specialized energy storage checks verifying NFPA 855 boundaries (3ft from doors/windows), system controller/gateway placement, and continuous conduit routing to the main electrical service.
          </p>
        </div>

        <!-- Site Documentation Discipline -->
        <div class="discipline-block card-technical">
          <div class="discipline-icon-row">
            <div class="discipline-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </div>
            <h3>Photo Documentation Package</h3>
          </div>
          <p>
            High-resolution HD photographs covering 4 exterior building elevations, street access, utility meter context, attic structural ties, and optional FAA Part 107 drone photogrammetry.
          </p>
        </div>
      </div>

      <div style="text-align: center; margin-top: var(--space-10);">
        <a href="/services" class="btn btn-outline btn-md">
          <span>View Complete Service Specifications →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 4: THE 4-STEP TEXAS DISPATCH WORKFLOW -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <h2>How Texas Survey Coordination Works</h2>
        <p class="lead">
          A friction-free four-stage pipeline connecting your sales intake directly to CAD drafting.
        </p>
      </div>

      <ProcessTimeline />
    </div>
  </section>

  <!-- SECTION 5: TEXAS COVERAGE SUMMARY & FINAL DUAL-CTA -->
  <section class="section section-dark">
    <div class="container">
      <div class="texas-coverage-banner">
        <h2 style="color: #FFFFFF; font-size: clamp(2rem, 3.5vw, 2.75rem); margin-top: 0.5rem; margin-bottom: 1rem;">
          Active Dispatch Across Every Major Texas Market
        </h2>
        <p class="lead" style="color: #9FB3C8; max-width: 780px; margin: 0 auto 2rem;">
          Houston, San Antonio, Dallas, Austin, Fort Worth, El Paso, Arlington, Corpus Christi, Plano, Lubbock, and 90+ additional Texas cities.
        </p>

        <div class="texas-city-pills-row">
          {featuredTexasCities.map(c => (
            <a href={`/service-areas#${c.slug}`} class="texas-city-pill">
              <strong>{c.name}</strong>
            </a>
          ))}
          <a href="/service-areas" class="texas-city-pill explore-more">
            Explore All Cities →
          </a>
        </div>
      </div>

      <!-- Final Dual CTA Box -->
      <div class="final-dual-cta-box" style="margin-top: var(--space-12);">
        <div class="final-cta-content">
          <h2 style="color: #FFFFFF; font-size: clamp(1.875rem, 3vw, 2.5rem); margin-top: 0.5rem; margin-bottom: 1rem;">
            Ready to Dispatch Your Next Texas Solar Site Survey?
          </h2>
          <p style="color: #CBD2D9; font-size: 1.0625rem; max-width: 680px; margin: 0 auto 2rem;">
            Contact us via WhatsApp to check surveyor availability and see open time slots, or join our network as an EPC partner.
          </p>

          <div class="final-cta-buttons">
            <a href={whatsappScheduleLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
              <span>Schedule a Site Survey</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/join-us" class="btn btn-outline-white btn-lg">
              <span>Partner With Us</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section - Left Aligned with Modern Translucent Veil */
  .hero-section {
    position: relative;
    background-color: #F8F8F5;
    background-image: 
      /* Top & Bottom subtle edge blend */
      linear-gradient(180deg, rgba(250, 250, 247, 0.25) 0%, transparent 12%, transparent 88%, rgba(250, 250, 247, 0.9) 100%),
      /* Translucent directional veil: semi-transparent warm white letting background show softly */
      linear-gradient(90deg, rgba(250, 250, 247, 0.85) 0%, rgba(250, 250, 247, 0.80) 28%, rgba(250, 250, 247, 0.50) 52%, rgba(250, 250, 247, 0.10) 74%, transparent 100%),
      url('/images/hero_surveyor_field.webp');
    background-size: cover;
    background-position: right 30%;
    background-repeat: no-repeat;
    padding-top: clamp(6.5rem, 10vw, 9.5rem);
    padding-bottom: clamp(6.5rem, 10vw, 9.5rem);
    border-bottom: 1px solid var(--border-light);
    display: flex;
    align-items: center;
  }

  .hero-content-left {
    text-align: left;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title {
    font-family: var(--font-heading) !important;
    color: var(--h1-color, #102A43);
    font-size: clamp(2.75rem, 5.2vw, 4.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    color: #334E68;
    font-size: clamp(1.0625rem, 1.4vw, 1.2rem);
    font-weight: 450;
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .hero-actions .btn-primary {
    background-color: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
    box-shadow: 0 4px 14px rgba(16, 42, 67, 0.18);
    padding: 1rem 2rem;
    font-size: 1.0625rem;
  }

  .hero-actions .btn-primary:hover {
    background-color: var(--primary-dark);
    border-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(16, 42, 67, 0.26);
  }

  .hero-actions .btn-outline {
    background-color: #FFFFFF;
    border: 1px solid rgba(16, 42, 67, 0.25);
    color: var(--primary);
    padding: 1rem 2rem;
    font-size: 1.0625rem;
    box-shadow: 0 2px 8px rgba(16, 42, 67, 0.04);
  }

  .hero-actions .btn-outline:hover {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(16, 42, 67, 0.18);
  }

  /* Advantage Cards */
  .advantage-card {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .advantage-card:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .adv-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .advantage-card h4 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .advantage-card p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Discipline Blocks */
  .discipline-block {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .discipline-block:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .discipline-icon-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .discipline-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .discipline-icon-row h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--primary);
    margin: 0;
  }

  .discipline-block p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Texas Coverage Banner */
  .texas-coverage-banner {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .texas-city-pills-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .texas-city-pill {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: #FAFAF7;
    transition: all var(--transition-fast);
  }

  .texas-city-pill strong {
    color: #FAFAF7;
  }

  .texas-city-pill:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .texas-city-pill.explore-more {
    background-color: rgba(244, 185, 66, 0.2);
    color: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  .final-dual-cta-box {
    background-color: var(--primary-dark);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    box-shadow: var(--shadow-xl);
  }

  .final-cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero-section {
      background-image: 
        linear-gradient(180deg, rgba(250, 250, 247, 0.92) 0%, rgba(250, 250, 247, 0.78) 45%, rgba(250, 250, 247, 0.96) 100%),
        url('/images/hero_surveyor_field.webp');
      background-position: center center;
    }
    .hero-content-left {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .hero-br {
      display: none;
    }
    .hero-actions,
    .final-cta-buttons {
      flex-direction: column;
      width: 100%;
    }
    .hero-actions .btn,
    .final-cta-buttons .btn {
      width: 100%;
    }
  }
</style>
