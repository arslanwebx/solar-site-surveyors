---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import { top20TexasCities } from '../data/texasCities';

const featuredTexasCities = top20TexasCities.slice(0, 10);
---

<BaseLayout 
  title="SolarSite Texas | Statewide Solar Site Survey Coordination for EPCs"
  description="Coordinating professional solar site surveys across all Texas cities. 24–48hr turnaround, standardized 36-photo CAD packages, and complete ERCOT utility alignment for Solar EPCs and installers."
  activeNav="home"
>
  <!-- SECTION 1: HERO SECTION -->
  <section class="section section-dark hero-section">
    <div class="container-wide">
      <div class="hero-grid">
        <!-- Hero Content -->
        <div class="hero-content">
          <div class="hero-badge-row">
            <span class="badge-tech badge-dark"><span class="status-dot"></span> 100% TEXAS STATEWIDE FIELD NETWORK</span>
            <span class="hero-sla-label font-mono">24–48HR SLA</span>
          </div>

          <h1 class="hero-title">
            Precision Solar Site Surveys <br/>
            Across Texas, <span class="text-amber">Scheduled in Seconds.</span>
          </h1>

          <p class="hero-subtitle lead">
            We coordinate verified local site surveyors across every city and county in Texas. From Houston to El Paso, our network delivers standardized 36-photo CAD-ready survey packages to Solar EPCs and installers within 24–48 hours.
          </p>

          <!-- TWO PRIMARY BUTTONS AS REQUESTED -->
          <div class="hero-actions">
            <a href="/schedule" class="btn btn-primary btn-lg" id="hero-schedule-btn">
              <span>Schedule a Survey</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/join-us" class="btn btn-outline-white btn-lg" id="hero-join-btn">
              <span>Join Us</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </a>
          </div>

          <!-- Operational Trust Metrics -->
          <div class="hero-metrics-grid">
            <div class="metric-item">
              <span class="metric-val font-mono">24–48h</span>
              <span class="metric-lbl">Texas Average SLA</span>
            </div>
            <div class="metric-item">
              <span class="metric-val font-mono">254</span>
              <span class="metric-lbl">Texas Counties Covered</span>
            </div>
            <div class="metric-item">
              <span class="metric-val font-mono">99.4%</span>
              <span class="metric-lbl">First-Pass QA Rate</span>
            </div>
            <div class="metric-item">
              <span class="metric-val font-mono">$0</span>
              <span class="metric-lbl">Travel Surcharges</span>
            </div>
          </div>
        </div>

        <!-- Hero Visual: Authentic Documentary Photography with Technical Annotation -->
        <div class="hero-visual-col">
          <div class="hero-image-wrapper card-dark tech-grid-border">
            <img 
              src="/images/hero_surveyor_field.jpg" 
              alt="Professional solar site surveyor inspecting residential roof pitch and structural condition in Texas" 
              width="1200" 
              height="675" 
              class="hero-img"
              loading="eager"
            />
            
            <div class="tech-annotation top-left">
              <span class="ann-icon">📐</span>
              <div class="ann-data">
                <span class="ann-label font-mono">ROOF PITCH & AZIMUTH</span>
                <span class="ann-val font-mono">185° SSW • 34.8° SLOPE</span>
              </div>
            </div>

            <div class="tech-annotation bottom-right">
              <span class="ann-icon">⚡</span>
              <div class="ann-data">
                <span class="ann-label font-mono">TEXAS MSP AUDIT</span>
                <span class="ann-val font-mono">225A BUS • 200A MAIN (ONCOR OK)</span>
              </div>
            </div>

            <div class="tech-badge-overlay font-mono">
              TEXAS FIELD DISPATCH • 36-PHOTO CAD STANDARD • ALL 254 COUNTIES
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: BUILT FOR TEXAS SOLAR OPERATIONS -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <span class="badge-tech badge-amber">OPERATIONAL ADVANTAGE</span>
        <h2>Built Specifically for Texas Solar Operations</h2>
        <p class="lead">
          We eliminate the friction of scheduling, managing in-house field fleets, and navigating regional Texas utility nuances.
        </p>
      </div>

      <div class="grid-3" style="margin-top: var(--space-8);">
        <div class="advantage-card card-technical tech-grid-border">
          <div class="adv-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h4>Full ERCOT & Texas Utility Proficiency</h4>
          <p>
            Our surveyors understand the exact meter socket, disconnect, and labeling requirements for Oncor, CenterPoint Energy, AEP Texas, CPS Energy, Austin Energy, and TNMP.
          </p>
        </div>

        <div class="advantage-card card-technical tech-grid-border">
          <div class="adv-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h4>One-Touch CAD Deliverables</h4>
          <p>
            Every survey delivers standardized 36-photo packages, verified digital pitch readings, rafter spans, and single-line parameters ready for immediate AutoCAD, HelioScope, or Aurora import.
          </p>
        </div>

        <div class="advantage-card card-technical tech-grid-border">
          <div class="adv-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h4>Zero Payroll Overhead & No Travel Fees</h4>
          <p>
            Pay on-demand per completed, QA-verified survey. Expand your sales into Dallas, Houston, Austin, San Antonio, or West Texas overnight without hiring regional staff.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: OUR CORE FIELD SURVEY DISCIPLINES -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge-tech badge-amber">COMPREHENSIVE FIELD AUDIT</span>
        <h2>Standardized Texas Survey Disciplines</h2>
        <p class="lead">
          Our surveyors capture every critical physical, electrical, and structural parameter required for solar engineering stamps and municipal AHJ permits.
        </p>
      </div>

      <div class="grid-2" style="margin-top: var(--space-8);">
        <!-- Roof Discipline -->
        <div class="discipline-block card-technical tech-grid-border">
          <div class="discipline-header">
            <span class="badge-tech badge-amber">DISCIPLINE 01</span>
            <h3>Roof Geometry & Condition Audit</h3>
          </div>
          <p>
            Physical verification of all roof planes, digital pitch gauge readings, shingle/tile layer counts, granular condition, and millimeter-accurate obstruction coordinates (vents, pipes, skylights).
          </p>
          <div class="discipline-tags">
            <span>Digital Pitch Verification</span>
            <span>Attic Rafter & Truss Spacing</span>
            <span>IFC 36" Fire Setbacks</span>
            <span>Obstruction X/Y Offsets</span>
          </div>
        </div>

        <!-- Electrical Discipline -->
        <div class="discipline-block card-technical tech-grid-border">
          <div class="discipline-header">
            <span class="badge-tech badge-amber">DISCIPLINE 02</span>
            <h3>Electrical MSP & 120% Busbar Rule</h3>
          </div>
          <p>
            Full interior dead-front removal to photograph manufacturer labels, busbar ampacity ratings, main breaker sizes, grounding electrode conductors, and spare breaker slots.
          </p>
          <div class="discipline-tags">
            <span>Busbar Nameplate Audit</span>
            <span>NEC 705.12 Calculations</span>
            <span>Utility Meter & Socket Spec</span>
            <span>Subpanel Load Verification</span>
          </div>
        </div>

        <!-- Battery Storage Discipline -->
        <div class="discipline-block card-technical tech-grid-border">
          <div class="discipline-header">
            <span class="badge-tech badge-amber">DISCIPLINE 03</span>
            <h3>Battery Storage & Gateway Clearances</h3>
          </div>
          <p>
            Specialized energy storage checks verifying NFPA 855 boundaries (3ft from doors/windows), system controller/gateway placement, and continuous conduit routing to the main electrical service.
          </p>
          <div class="discipline-tags">
            <span>NFPA 855 Clearances</span>
            <span>Gateway & Transfer Switch</span>
            <span>Conduit Pathway Distance</span>
            <span>Critical Loads Audit</span>
          </div>
        </div>

        <!-- Site Documentation Discipline -->
        <div class="discipline-block card-technical tech-grid-border">
          <div class="discipline-header">
            <span class="badge-tech badge-amber">DISCIPLINE 04</span>
            <h3>36-Photo Georeferenced Package</h3>
          </div>
          <p>
            High-resolution 4K photographs covering 4 exterior building elevations, street access, utility meter context, attic structural ties, and optional FAA Part 107 drone photogrammetry.
          </p>
          <div class="discipline-tags">
            <span>4 Building Elevations</span>
            <span>Attic Rafter Macro Shots</span>
            <span>Geotagged & Timestamped</span>
            <span>Cloud Portal Download</span>
          </div>
        </div>
      </div>

      <div style="text-align: center; margin-top: var(--space-8);">
        <a href="/services" class="btn btn-dark btn-md">
          <span>View Complete Service Specifications & SLAs →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 4: THE 4-STEP TEXAS DISPATCH WORKFLOW -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <span class="badge-tech badge-amber">SEAMLESS COORDINATION</span>
        <h2>How Texas Survey Coordination Works</h2>
        <p class="lead">
          A friction-free four-stage pipeline connecting your sales intake directly to CAD drafting.
        </p>
      </div>

      <ProcessTimeline />
    </div>
  </section>

  <!-- SECTION 5: TEXAS COVERAGE SUMMARY & FINAL DUAL-CTA -->
  <section class="section section-dark">
    <div class="container">
      <div class="texas-coverage-banner">
        <span class="badge-tech badge-dark"><span class="status-dot"></span> TOP 20 TEXAS CITIES COVERED</span>
        <h2 style="color: #FFFFFF; font-size: clamp(2rem, 3.5vw, 2.75rem); margin-top: 0.5rem; margin-bottom: 1rem;">
          Active Dispatch Across Every Major Texas Market
        </h2>
        <p class="lead" style="color: #94A3B8; max-width: 780px; margin: 0 auto 2rem;">
          Houston, San Antonio, Dallas, Austin, Fort Worth, El Paso, Arlington, Corpus Christi, Plano, Lubbock, and all surrounding submarkets.
        </p>

        <div class="texas-city-pills-row">
          {featuredTexasCities.map(c => (
            <a href="/service-areas" class="texas-city-pill">
              <strong>{c.name}</strong> • {c.majorUtility.split(' ')[0]}
            </a>
          ))}
          <a href="/service-areas" class="texas-city-pill explore-more">
            View All 20 Cities →
          </a>
        </div>
      </div>

      <!-- Final Dual CTA Box -->
      <div class="final-dual-cta-box tech-grid-border" style="margin-top: var(--space-12);">
        <div class="final-cta-content">
          <span class="badge-tech badge-amber">GET STARTED IN TEXAS</span>
          <h2 style="color: #FFFFFF; font-size: clamp(1.875rem, 3vw, 2.5rem); margin-top: 0.5rem; margin-bottom: 1rem;">
            Ready to Dispatch Your Next Texas Solar Site Survey?
          </h2>
          <p style="color: #CBD5E1; font-size: 1.0625rem; max-width: 680px; margin: 0 auto 2rem;">
            Submit your project address or join our statewide network as an EPC partner or local site surveyor.
          </p>

          <div class="final-cta-buttons">
            <a href="/schedule" class="btn btn-primary btn-lg">
              <span>Schedule a Survey</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/join-us" class="btn btn-outline-white btn-lg">
              <span>Join Us (EPCs & Surveyors)</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
    position: relative;
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-sla-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-amber-light);
    background-color: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .hero-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.12;
    margin-bottom: var(--space-6);
  }

  .text-amber {
    color: #F59E0B;
  }

  .hero-subtitle {
    color: #94A3B8;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .hero-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-6);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-size: 1.5rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .metric-lbl {
    font-size: 0.75rem;
    color: #94A3B8;
    line-height: 1.3;
    margin-top: 0.2rem;
  }

  /* Hero Visual */
  .hero-image-wrapper {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .hero-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .tech-annotation {
    position: absolute;
    background-color: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: var(--shadow-md);
  }

  .tech-annotation.top-left {
    top: 1rem;
    left: 1rem;
  }

  .tech-annotation.bottom-right {
    bottom: 2.75rem;
    right: 1rem;
  }

  .ann-icon {
    font-size: 1.1rem;
  }

  .ann-data {
    display: flex;
    flex-direction: column;
  }

  .ann-label {
    font-size: 0.625rem;
    color: #94A3B8;
    letter-spacing: 0.05em;
  }

  .ann-val {
    font-size: 0.75rem;
    font-weight: 600;
    color: #F8FAFC;
  }

  .tech-badge-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(11, 17, 32, 0.9);
    padding: 0.35rem 0.75rem;
    font-size: 0.6875rem;
    color: #94A3B8;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Advantage Cards */
  .advantage-card {
    background-color: #FFFFFF;
    padding: var(--space-8);
  }

  .adv-icon {
    margin-bottom: var(--space-4);
  }

  .advantage-card h4 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .advantage-card p {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* Discipline Blocks */
  .discipline-block {
    background-color: #FFFFFF;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .discipline-header {
    margin-bottom: var(--space-3);
  }

  .discipline-header h3 {
    margin-top: var(--space-2);
    font-size: 1.3125rem;
  }

  .discipline-block p {
    font-size: 0.9375rem;
    line-height: 1.55;
    margin-bottom: var(--space-5);
    flex-grow: 1;
  }

  .discipline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .discipline-tags span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-light);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
  }

  /* Texas Coverage Banner */
  .texas-coverage-banner {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .texas-city-pills-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .texas-city-pill {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: #E2E8F0;
    transition: all var(--transition-fast);
  }

  .texas-city-pill strong {
    color: #F59E0B;
  }

  .texas-city-pill:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: #F59E0B;
  }

  .texas-city-pill.explore-more {
    background-color: var(--accent-amber);
    color: #FFFFFF;
    border-color: var(--accent-amber-dark);
  }

  .final-dual-cta-box {
    background-color: #111827;
    border: 1px solid #1F2937;
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    box-shadow: var(--shadow-xl);
  }

  .final-cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 768px) {
    .hero-metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .final-cta-buttons {
      flex-direction: column;
    }
    .tech-annotation {
      position: static;
      margin: 0.5rem;
    }
  }
</style>
