---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas' }
];
---

<BaseLayout 
  title="Service Areas | Solar Site Surveys"
  description="Professional solar site surveys throughout Texas for installers, EPCs, solar companies, and contractors."
  activeNav="service-areas"
>
  <!-- Page Hero with Dark Aesthetic -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <Breadcrumbs items={breadcrumbs} isDark={true} />
        <div class="hero-badge">
          <span class="status-dot"></span>
          <span>Field Surveyor Coverage</span>
        </div>
        <h1 class="page-title">Service Areas</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 820px;">
          Explore our regional coverage and active surveyor dispatch networks across Texas.
        </p>
      </div>
    </div>
  </section>

  <!-- Clean Texas Card Section -->
  <section class="section section-texas-area">
    <div class="container">
      <!-- Clean Texas Card -->
      <div class="texas-card card-technical">
        <h2 class="texas-card-title">Texas</h2>
        <p class="texas-card-description">
          Professional solar site surveys throughout Texas for installers, EPCs, solar companies, and contractors.
        </p>
        <div class="texas-card-action">
          <a href="/texas-solar-site-surveyors/" class="btn btn-primary btn-lg texas-cta-btn" id="view-texas-service-areas-btn">
            <span>View Texas Service Areas</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection 
    title="Need a Solar Site Survey Anywhere in Texas?"
    subtitle="Contact our dispatch desk via WhatsApp to check real-time surveyor availability and coordinate your next survey."
    primaryCtaText="View Texas Hub"
    primaryCtaLink="/texas-solar-site-surveyors/"
    secondaryCtaText="Partner With Us"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #FAFAF7;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-family: var(--font-heading) !important;
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
  }

  /* Clean Texas Card Section */
  .section-texas-area {
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
  }

  .texas-card {
    padding: var(--space-10) var(--space-12);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-light);
    background-color: #FFFFFF;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
    max-width: 820px;
  }

  .texas-card:hover {
    border-color: var(--border-medium);
    box-shadow: var(--shadow-md);
  }

  .texas-card-title {
    font-family: var(--font-heading) !important;
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: var(--primary);
    margin-bottom: var(--space-3);
  }

  .texas-card-description {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .texas-cta-btn {
    display: inline-flex;
    font-size: 1rem;
    padding: 0.875rem 1.75rem;
  }

  @media (max-width: 768px) {
    .texas-card {
      padding: var(--space-8) var(--space-6);
    }
  }
</style>
