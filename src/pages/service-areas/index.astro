---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { top20TexasCities, texasUtilityCoverage } from '../../data/texasCities';
---

<BaseLayout 
  title="Texas Solar Site Survey Coverage | Top 20 Cities & Statewide Network | SolarSite Texas"
  description="Statewide solar site survey coordination across Texas. Active surveyor coverage in Houston, Dallas, San Antonio, Austin, Fort Worth, and all top 20 Texas cities with 24–48hr turnaround SLAs."
  activeNav="service-areas"
>
  <!-- Page Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <span class="badge-tech badge-dark"><span class="status-dot"></span> 100% TEXAS STATEWIDE COVERAGE</span>
        <h1 class="page-title">Texas Service Areas & City Coverage</h1>
        <p class="lead" style="color: #94A3B8; max-width: 820px;">
          From the Rio Grande Valley to the Panhandle, SolarSite Texas coordinates vetted local site surveyors across all 254 Texas counties—delivering CAD-ready photo packages in 24–48 hours.
        </p>

        <!-- Texas Operational Stats -->
        <div class="texas-hero-stats">
          <div class="stat-pill">
            <span class="pill-num font-mono">20+</span>
            <span class="pill-text">Primary Texas Metro Hubs</span>
          </div>
          <div class="stat-pill">
            <span class="pill-num font-mono">254</span>
            <span class="pill-text">Texas Counties Covered</span>
          </div>
          <div class="stat-pill">
            <span class="pill-num font-mono">24–48h</span>
            <span class="pill-text">Standard Turnaround SLA</span>
          </div>
          <div class="stat-pill">
            <span class="pill-num font-mono">ERCOT</span>
            <span class="pill-text">100% TDU & Muni Alignment</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top 20 Texas Cities Directory -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge-tech badge-amber">TOP 20 TEXAS METROS & CITIES</span>
        <h2>Active City Dispatch Directory</h2>
        <p class="lead">
          Our distributed field surveyor list covers every major municipality and surrounding suburban submarkets across Texas.
        </p>
      </div>

      <div class="cities-grid">
        {top20TexasCities.map((city, index) => (
          <div class="city-card card-technical tech-grid-border">
            <div class="city-card-header">
              <div class="city-rank font-mono">{String(index + 1).padStart(2, '0')}</div>
              <span class="badge-tech badge-amber font-mono">{city.turnaroundSla}</span>
            </div>

            <h3 class="city-name">{city.name}</h3>
            <div class="city-sub font-mono">{city.county} • {city.metro}</div>

            <div class="city-meta-block">
              <span class="city-meta-label font-mono">PRIMARY ELECTRIC UTILITY:</span>
              <span class="utility-badge">{city.majorUtility}</span>
            </div>

            <p class="city-notes">{city.keyCoverageNotes}</p>

            <div class="city-capabilities">
              {city.surveyTypes.map(type => (
                <span class="cap-tag">{type}</span>
              ))}
            </div>

            <div class="city-card-cta">
              <a href="/schedule" class="btn btn-outline btn-sm" style="width: 100%;">
                <span>Dispatch {city.name} Survey →</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Texas Electric Grid & Utility Coverage Breakdown -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header">
        <span class="badge-tech badge-amber">REGULATORY & GRID PROFICIENCY</span>
        <h2>Full Texas Utility & TDU Integration</h2>
        <p class="lead">
          Our surveyors are trained on the exact meter socket, disconnect, and labeling standards required across Texas electric territories.
        </p>
      </div>

      <div class="grid-2" style="margin-top: var(--space-8);">
        {texasUtilityCoverage.map(util => (
          <div class="utility-card card-technical tech-grid-border">
            <div class="util-top">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              <h4>{util.name}</h4>
            </div>
            <div class="util-meta">
              <div><strong class="font-mono">Territory:</strong> {util.territory}</div>
              <div><strong class="font-mono">Grid Structure:</strong> {util.share}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection 
    title="Need a Solar Site Survey Anywhere in Texas?"
    subtitle="Submit your project address today. We assign the closest certified Texas surveyor and deliver an organized CAD-ready package within 24–48 hours."
    primaryCtaText="Schedule a Texas Survey"
    primaryCtaLink="/schedule"
    secondaryCtaText="Join Our Texas Network"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .texas-hero-stats {
    display: flex;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .stat-pill {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    padding: 0.6rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pill-num {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-amber-light);
  }

  .pill-text {
    font-size: 0.8125rem;
    color: #CBD5E1;
  }

  /* Top 20 Cities Grid */
  .cities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .city-card {
    background-color: #FFFFFF;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  .city-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .city-rank {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-amber-dark);
  }

  .city-name {
    font-size: 1.375rem;
    margin-bottom: 0.15rem;
    color: var(--text-primary);
  }

  .city-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .city-meta-block {
    background-color: var(--bg-subtle);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .city-meta-label {
    display: block;
    font-size: 0.625rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .utility-badge {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .city-notes {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .city-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: var(--space-5);
  }

  .cap-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-light);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    color: var(--text-secondary);
  }

  .city-card-cta {
    margin-top: auto;
    border-top: 1px solid var(--border-light);
    padding-top: var(--space-4);
  }

  /* Utility Grid */
  .utility-card {
    background-color: #FFFFFF;
    padding: var(--space-6);
  }

  .util-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .util-top h4 {
    font-size: 1.1875rem;
  }

  .util-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .util-meta strong {
    color: var(--text-primary);
  }

  @media (max-width: 1100px) {
    .cities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .cities-grid, .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
