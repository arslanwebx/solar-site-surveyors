---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { allTexasCities, texasUtilityCoverage } from '../../data/texasCities';
---

<BaseLayout 
  title="Texas Solar Site Survey Coverage | 100 Cities & Statewide Network | Solar Site Surveys"
  description="Statewide solar site survey coordination across Texas. Active surveyor coverage across 100 Texas cities including Houston, Dallas, San Antonio, Austin, Fort Worth, and all 254 counties."
  activeNav="service-areas"
>
  <!-- Page Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <h1 class="page-title">Texas Service Areas & City Coverage</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 820px;">
          From the Rio Grande Valley to the Panhandle, Solar Site Surveys coordinates vetted local site surveyors across all 254 Texas counties—delivering CAD-ready photo packages for your engineering and permitting teams.
        </p>
      </div>
    </div>
  </section>

  <!-- 100 Texas Cities Directory -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2>Active City Dispatch Directory</h2>
        <p class="lead">
          Our distributed field surveyor network covers 100 major municipalities and surrounding suburban submarkets across Texas.
        </p>

        <!-- Live Instant Search Bar -->
        <div class="search-bar-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#66717D" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input 
            type="text" 
            id="city-search" 
            placeholder="Search all 100 Texas cities (e.g. Plano, Frisco, Lubbock, Houston)..." 
            aria-label="Filter Texas cities"
          />
        </div>
      </div>

      <!-- 100 Clean, Centered City Cards -->
      <div class="cities-grid" id="cities-grid">
        {allTexasCities.map((city) => (
          <div class="city-card card-technical" id={city.slug} data-name={city.name.toLowerCase()}>
            <h3 class="city-name">{city.name}</h3>
            <p class="city-notes">{city.keyCoverageNotes}</p>

            <div class="city-card-cta">
              <a href={`/schedule?city=${city.slug}`} class="btn btn-city-explore">
                <span>Explore</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
      
      <div id="no-cities-msg" class="no-results-box" style="display: none;">
        <p>No Texas cities matching your search. We cover all 254 counties statewide—<a href="/schedule" style="color: var(--primary); font-weight: 600; text-decoration: underline;">Schedule a Custom Survey</a>.</p>
      </div>
    </div>
  </section>

  <!-- Texas Electric Grid & Utility Coverage Breakdown -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <h2>Texas Utility & Grid Integration</h2>
        <p class="lead">
          Our surveyors are trained on the exact meter socket, disconnect, and labeling standards required across Texas electric territories.
        </p>
      </div>

      <div class="grid-2" style="margin-top: var(--space-8);">
        {texasUtilityCoverage.map(util => (
          <div class="utility-card card-technical">
            <div class="util-top">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              <h4>{util.name}</h4>
            </div>
            <div class="util-meta">
              <div><strong>Territory:</strong> {util.territory}</div>
              <div><strong>Grid Structure:</strong> {util.share}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection 
    title="Need a Solar Site Survey Anywhere in Texas?"
    subtitle="Submit your project address today to check real-time surveyor availability and see open time slots in your market."
    primaryCtaText="Schedule a Texas Survey"
    primaryCtaLink="/schedule"
    secondaryCtaText="Join Our Texas Network"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<script>
  // Live Instant City Search
  const searchInput = document.getElementById('city-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.city-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-cities-msg');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let matchedCount = 0;

      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        if (!q || name.includes(q)) {
          card.style.display = 'flex';
          matchedCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = matchedCount === 0 ? 'block' : 'none';
      }
    });
  }
</script>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-bottom: var(--space-4);
  }

  .texas-hero-stats {
    display: flex;
    gap: 1rem;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .stat-pill {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    padding: 0.6rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pill-num {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .pill-text {
    font-size: 0.8125rem;
    color: #CBD2D9;
  }

  /* Search Bar */
  .search-bar-wrap {
    position: relative;
    max-width: 520px;
    margin: var(--space-6) auto 0;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search-bar-wrap input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    background-color: #FFFFFF;
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .search-bar-wrap input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(16, 42, 67, 0.1);
  }

  /* 100 Cities Grid */
  .cities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .city-card {
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .city-card:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .city-name {
    font-family: var(--font-heading);
    font-size: 1.3125rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .city-notes {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex-grow: 1;
    text-align: center;
  }

  .city-card-cta {
    width: 100%;
    border-top: 1px solid var(--border-light);
    padding-top: 1rem;
    margin-top: auto;
  }

  .btn-city-explore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.65rem 1rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--primary);
    background-color: #FAFAF7;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .btn-city-explore:hover {
    background-color: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
    box-shadow: 0 4px 12px rgba(16, 42, 67, 0.15);
    transform: translateY(-1px);
  }

  .no-results-box {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-medium);
    border-radius: var(--radius-lg);
    margin-top: var(--space-6);
  }

  /* Utility Grid */
  .utility-card {
    background-color: #FFFFFF;
    padding: var(--space-6);
  }

  .util-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .util-top h4 {
    font-size: 1.1875rem;
  }

  .util-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .util-meta strong {
    color: var(--text-main);
  }

  @media (max-width: 1200px) {
    .cities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .cities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cities-grid, .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
