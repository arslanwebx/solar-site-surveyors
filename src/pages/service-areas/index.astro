---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { allTexasCities } from '../../data/texasCities';
import { getWhatsAppLink } from '../../data/whatsapp';

// First 100 cities are pre-rendered statically for ultra-fast initial load & SEO
const initialCities = allTexasCities.slice(0, 100);
const remainingCities = allTexasCities.slice(100);
const defaultCustomSurveyWhatsApp = getWhatsAppLink('Hi, I would like to schedule a custom solar site survey in Texas.');
---

<BaseLayout 
  title="Texas Solar Site Survey Coverage | Statewide City Directory | Solar Site Surveys"
  description="Statewide solar site survey coordination across Texas. Active surveyor coverage across all major Texas cities and regional municipalities delivering CAD-ready photo packages."
  activeNav="service-areas"
>
  <!-- Page Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <h1 class="page-title">Texas Service Areas & City Coverage</h1>
        <p class="lead" style="color: #9FB3C8; max-width: 820px;">
          From the Rio Grande Valley to the Panhandle, Solar Site Surveys coordinates vetted local site surveyors across all 254 Texas counties—delivering CAD-ready photo packages for your engineering and permitting teams.
        </p>
      </div>
    </div>
  </section>

  <!-- Texas Cities Directory -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2>Active City Dispatch Directory</h2>
        <p class="lead">
          Our distributed field surveyor network covers major municipalities and regional submarkets across Texas.
        </p>

        <!-- Live Instant Search Bar -->
        <div class="search-bar-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#66717D" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input 
            type="text" 
            id="city-search" 
            placeholder="Search Texas cities & towns (e.g. Plano, Frisco, Lubbock, Bandera)..." 
            aria-label="Filter Texas cities"
          />
        </div>
      </div>

      <!-- Cities Grid (Initial 100 Pre-rendered) -->
      <div class="cities-grid" id="cities-grid">
        {initialCities.map((city) => (
          <div class="city-card card-technical" id={city.slug} data-name={city.name.toLowerCase()}>
            <h3 class="city-name">{city.name}</h3>
            <p class="city-notes">{city.keyCoverageNotes}</p>

            <div class="city-card-cta">
              <a 
                href={getWhatsAppLink(`Hi, I would like to schedule a solar site survey in ${city.name}, Texas.`)} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn-city-explore"
              >
                <span>Explore</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Clean Load More Button -->
      <div class="load-more-wrap" id="load-more-wrap">
        <button type="button" class="btn btn-outline btn-lg" id="load-more-btn">
          <span>Load More Locations</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>
      
      <div id="no-cities-msg" class="no-results-box" style="display: none;">
        <p>No Texas cities matching your search. We coordinate surveys across all 254 counties statewide—<a href={defaultCustomSurveyWhatsApp} target="_blank" rel="noopener noreferrer" style="color: var(--primary); font-weight: 600; text-decoration: underline;">Schedule a Custom Survey via WhatsApp</a>.</p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection 
    title="Need a Solar Site Survey Anywhere in Texas?"
    subtitle="Contact our dispatch desk via WhatsApp to check real-time surveyor availability and coordinate your next survey."
    primaryCtaText="Schedule a Texas Survey"
    secondaryCtaText="Join Our Texas Network"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<!-- Client Script for Fast Batch Loading and Full-Dataset Search -->
<script define:vars={{ remainingCities, initialCities }}>
  let currentLoadedCount = initialCities.length;
  const BATCH_SIZE = 100;
  const grid = document.getElementById('cities-grid');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreWrap = document.getElementById('load-more-wrap');
  const searchInput = document.getElementById('city-search');
  const noResults = document.getElementById('no-cities-msg');

  // Helper to create a city card DOM element with WhatsApp link
  function createCardElement(city) {
    const card = document.createElement('div');
    card.className = 'city-card card-technical';
    card.id = city.slug;
    card.setAttribute('data-name', city.name.toLowerCase());
    const waText = encodeURIComponent('Hi, I would like to schedule a solar site survey in ' + city.name + ', Texas.');
    const waUrl = 'https://wa.me/16823960543?text=' + waText;
    card.innerHTML = `
      <h3 class="city-name">${city.name}</h3>
      <p class="city-notes">${city.keyCoverageNotes}</p>
      <div class="city-card-cta">
        <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-city-explore">
          <span>Explore</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    `;
    return card;
  }

  // Load More Handler (loads next batch)
  function loadNextBatch() {
    if (!grid || !remainingCities) return;
    const startIndex = currentLoadedCount - initialCities.length;
    const nextCities = remainingCities.slice(startIndex, startIndex + BATCH_SIZE);

    if (nextCities.length > 0) {
      const fragment = document.createDocumentFragment();
      nextCities.forEach(city => {
        fragment.appendChild(createCardElement(city));
      });
      grid.appendChild(fragment);
      currentLoadedCount += nextCities.length;
    }

    if (startIndex + BATCH_SIZE >= remainingCities.length && loadMoreWrap) {
      loadMoreWrap.style.display = 'none';
    }
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', loadNextBatch);
  }

  // Live Instant Search across whole dataset
  const allDataset = [...initialCities, ...remainingCities];

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();

      if (!q) {
        // Reset to currently loaded view
        if (grid) {
          const domCards = grid.querySelectorAll('.city-card');
          domCards.forEach((c) => {
            c.style.display = 'flex';
          });
        }
        if (loadMoreWrap) {
          const startIndex = currentLoadedCount - initialCities.length;
          loadMoreWrap.style.display = (startIndex < remainingCities.length) ? 'flex' : 'none';
        }
        if (noResults) noResults.style.display = 'none';
        return;
      }

      // If search query is active, hide load more button
      if (loadMoreWrap) loadMoreWrap.style.display = 'none';

      // Find matching cities from full dataset
      const matches = allDataset.filter(c => c.name.toLowerCase().includes(q));

      if (grid) {
        grid.innerHTML = '';
        if (matches.length > 0) {
          const fragment = document.createDocumentFragment();
          // Show up to 100 search results for instantaneous speed
          matches.slice(0, 100).forEach(city => {
            fragment.appendChild(createCardElement(city));
          });
          grid.appendChild(fragment);
          if (noResults) noResults.style.display = 'none';
        } else {
          if (noResults) noResults.style.display = 'block';
        }
      }
    });
  }
</script>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-bottom: var(--space-4);
  }

  /* Search Bar */
  .search-bar-wrap {
    position: relative;
    max-width: 520px;
    margin: var(--space-6) auto 0;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search-bar-wrap input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    background-color: #FFFFFF;
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .search-bar-wrap input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(16, 42, 67, 0.1);
  }

  /* Cities Grid */
  .cities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .city-card {
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .city-card:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .city-name {
    font-family: var(--font-heading);
    font-size: 1.3125rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .city-notes {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex-grow: 1;
    text-align: center;
  }

  .city-card-cta {
    width: 100%;
    border-top: 1px solid var(--border-light);
    padding-top: 1rem;
    margin-top: auto;
  }

  .btn-city-explore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.65rem 1rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--primary);
    background-color: #FAFAF7;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .btn-city-explore:hover {
    background-color: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
    box-shadow: 0 4px 12px rgba(16, 42, 67, 0.15);
    transform: translateY(-1px);
  }

  /* Load More Wrap */
  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  .load-more-wrap .btn-outline {
    background-color: #FFFFFF;
    border: 1px solid rgba(16, 42, 67, 0.25);
    color: var(--primary);
    padding: 0.85rem 2.25rem;
    font-size: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .load-more-wrap .btn-outline:hover {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .no-results-box {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-medium);
    border-radius: var(--radius-lg);
    margin-top: var(--space-6);
  }

  @media (max-width: 1200px) {
    .cities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .cities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cities-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
