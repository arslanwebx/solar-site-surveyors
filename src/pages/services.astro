---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWhatsAppLink } from '../data/whatsapp';

const cadWhatsAppLink = getWhatsAppLink('Hi, I would like to inquire about solar CAD designs and permit plan sets.');
---

<BaseLayout 
  title="Solar Site Survey & CAD Design Services"
  description="Comprehensive solar engineering services for EPCs & installers: Precision on-site solar site surveys and permit-ready solar CAD plan sets."
  activeNav="services"
>
  <!-- SECTION 1: SERVICES HERO (TOP SECTION) -->
  <section class="section section-dark services-hero">
    <div class="container">
      <div class="hero-inner">
        <div class="sub-badge badge-gold">PRECISION ENGINEERING SERVICES</div>
        <h1 class="services-hero-title">Precision Field Surveys & CAD Designs</h1>
        <p class="services-hero-lead">
          From on-site roof geometry and electrical panel audits to permit-ready plan sets. Standardized field data and technical drawings for Solar EPCs and installers.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: DUAL SERVICE OVERVIEW (2 CARDS) -->
  <section class="section section-warm services-overview-section">
    <div class="container">
      <div class="section-header center">
        <div class="sub-badge">CORE CAPABILITIES</div>
        <h2>Two Dedicated Engineering Disciplines</h2>
        <p class="lead">
          Choose standalone field surveys, custom CAD drafting, or our integrated survey-to-permit turnkey pipeline.
        </p>
      </div>

      <div class="dual-service-grid">
        <!-- Service 1 Card -->
        <div class="service-spotlight-card card-technical">
          <div class="spotlight-header">
            <div class="spotlight-badge">SERVICE 01</div>
            <span class="spotlight-tag field-tag">FIELD VERIFICATION</span>
          </div>
          <h3 class="spotlight-title">Precision Solar Site Surveys</h3>
          <p class="spotlight-desc">
            Standardized on-site data collection to eliminate drafting discrepancies. Roof pitch mapping, attic structural analysis, MSP dead-front audits, and NFPA 855 battery clearances.
          </p>
          <ul class="spotlight-features">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Digital pitch gauge & obstruction offset mapping</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Main electrical panel (MSP) interior dead-front audit</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Attic rafter/truss structural dimensions & spans</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>50+ HD categorized photo directory & cloud package</span>
            </li>
          </ul>
          <div class="spotlight-footer">
            <a href="/services/solar-site-surveys/" class="btn btn-primary btn-md w-100">
              <span>Explore Site Surveys</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Service 2 Card -->
        <div class="service-spotlight-card card-technical">
          <div class="spotlight-header">
            <div class="spotlight-badge">SERVICE 02</div>
            <span class="spotlight-tag cad-tag">ENGINEERING & PERMITTING</span>
          </div>
          <h3 class="spotlight-title">Permit-Ready CAD Designs</h3>
          <p class="spotlight-desc">
            Complete architectural and electrical drawing packages tailored to your AHJ requirements. Single-line diagrams, string sizing, structural load notes, and utility submittals.
          </p>
          <ul class="spotlight-features">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Full solar PV & ESS permit plan sets (.DWG & .PDF)</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Single-line (SLD) & three-line electrical diagrams</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>NEC 705.12, NEC 690, & NFPA 855 code compliance</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>PE structural & electrical stamp-ready packages</span>
            </li>
          </ul>
          <div class="spotlight-footer">
            <a href="/services/solar-cad-designs/" class="btn btn-primary btn-md w-100">
              <span>Explore CAD Designs</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     SERVICES PAGE - MINIMALIST LUXURY ARCHITECTURAL STYLING
     ========================================================================== */

  /* Minimalist Page Hero */
  .services-hero {
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5rem);
    background-color: var(--primary);
    border-bottom: 1px solid var(--border-dark-subtle);
    text-align: center;
  }

  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .services-hero-title {
    color: #FFFFFF !important;
    font-family: var(--font-heading) !important;
    font-size: clamp(2.15rem, 4vw, 3.15rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin-top: 0.5rem;
    margin-bottom: var(--space-4);
    font-weight: 800;
  }

  .services-hero-lead {
    color: #9FB3C8 !important;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    font-weight: 400;
    line-height: 1.65;
    max-width: 680px;
    margin-bottom: 0;
  }

  /* Section Sub-Badges */
  .sub-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
    background-color: rgba(16, 42, 67, 0.08);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .sub-badge.badge-gold {
    color: var(--accent-gold);
    background-color: rgba(244, 185, 66, 0.15);
  }

  /* ==========================================================================
     DUAL SERVICE OVERVIEW CARDS
     ========================================================================== */

  .services-overview-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-20);
  }

  .dual-service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  .service-spotlight-card {
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .service-spotlight-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .spotlight-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .spotlight-badge {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--primary);
  }

  .spotlight-tag {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.05em;
  }

  .spotlight-tag.field-tag {
    background-color: #ECFDF5;
    color: #059669;
  }

  .spotlight-tag.cad-tag {
    background-color: #F0F9FF;
    color: #0284C7;
  }

  .spotlight-title {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2vw, 1.625rem);
    font-weight: 700;
    color: var(--primary);
    margin-bottom: var(--space-3);
  }

  .spotlight-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .spotlight-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: var(--space-8);
    flex-grow: 1;
  }

  .spotlight-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-main);
    line-height: 1.45;
  }

  .spotlight-features li svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .w-100 {
    width: 100%;
  }

  @media (max-width: 768px) {
    .services-hero {
      padding-top: var(--space-10);
      padding-bottom: var(--space-10);
    }

    .services-overview-section {
      padding-top: var(--space-10);
      padding-bottom: var(--space-12);
    }

    .dual-service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
