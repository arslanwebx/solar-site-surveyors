---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import { getWhatsAppLink } from '../data/whatsapp';

const surveyWhatsAppLink = getWhatsAppLink('Hi, I would like to schedule a solar site survey in Texas.');
const cadWhatsAppLink = getWhatsAppLink('Hi, I would like to inquire about solar CAD designs and permit plan sets.');
---

<BaseLayout 
  title="Solar Site Survey & CAD Design Services | Solar Site Surveys"
  description="Comprehensive solar engineering services for EPCs & installers: Precision on-site solar site surveys and permit-ready solar CAD plan sets."
  activeNav="services"
>
  <!-- SECTION 1: MINIMALIST SERVICES HERO -->
  <section class="section section-dark services-hero">
    <div class="container">
      <div class="hero-inner">
        <div class="sub-badge badge-gold">PRECISION ENGINEERING SERVICES</div>
        <h1 class="services-hero-title">Precision Field Surveys & CAD Designs</h1>
        <p class="services-hero-lead">
          From on-site roof geometry and electrical panel audits to permit-ready plan sets. Standardized field data and technical drawings for Solar EPCs and installers.
        </p>

        <!-- Minimalist Anchor Jump Bar -->
        <div class="hero-quick-nav">
          <a href="#site-surveys" class="quick-nav-btn">
            <span class="quick-nav-num">01</span>
            <span>Site Surveys</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 13l5 5 5-5M12 4v14"/></svg>
          </a>
          <a href="#cad-designs" class="quick-nav-btn">
            <span class="quick-nav-num">02</span>
            <span>CAD Designs</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 13l5 5 5-5M12 4v14"/></svg>
          </a>
          <a href="#matrix" class="quick-nav-link-subtle">
            <span>Deliverables Matrix ↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: DUAL SERVICE OVERVIEW -->
  <section class="section section-warm services-overview-section">
    <div class="container">
      <div class="section-header center">
        <div class="sub-badge">CORE CAPABILITIES</div>
        <h2>Two Dedicated Engineering Disciplines</h2>
        <p class="lead">
          Choose standalone field surveys, custom CAD drafting, or our integrated survey-to-permit turnkey pipeline.
        </p>
      </div>

      <div class="dual-service-grid">
        <!-- Service 1 Card -->
        <div class="service-spotlight-card card-technical">
          <div class="spotlight-header">
            <div class="spotlight-badge">SERVICE 01</div>
            <span class="spotlight-tag field-tag">FIELD VERIFICATION</span>
          </div>
          <h3 class="spotlight-title">Precision Solar Site Surveys</h3>
          <p class="spotlight-desc">
            Standardized on-site data collection to eliminate drafting discrepancies. Roof pitch mapping, attic structural analysis, MSP dead-front audits, and NFPA 855 battery clearances.
          </p>
          <ul class="spotlight-features">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Digital pitch gauge & obstruction offset mapping</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Main electrical panel (MSP) interior dead-front audit</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Attic rafter/truss structural dimensions & spans</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>50+ HD categorized photo directory & cloud package</span>
            </li>
          </ul>
          <div class="spotlight-footer">
            <a href="#site-surveys" class="btn btn-primary btn-md w-100">
              <span>Explore Site Surveys</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Service 2 Card -->
        <div class="service-spotlight-card card-technical">
          <div class="spotlight-header">
            <div class="spotlight-badge">SERVICE 02</div>
            <span class="spotlight-tag cad-tag">ENGINEERING & PERMITTING</span>
          </div>
          <h3 class="spotlight-title">Permit-Ready CAD Designs</h3>
          <p class="spotlight-desc">
            Complete architectural and electrical drawing packages tailored to your AHJ requirements. Single-line diagrams, string sizing, structural load notes, and utility submittals.
          </p>
          <ul class="spotlight-features">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Full solar PV & ESS permit plan sets (.DWG & .PDF)</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Single-line (SLD) & three-line electrical diagrams</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>NEC 705.12, NEC 690, & NFPA 855 code compliance</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>PE structural & electrical stamp-ready packages</span>
            </li>
          </ul>
          <div class="spotlight-footer">
            <a href="#cad-designs" class="btn btn-primary btn-md w-100">
              <span>Explore CAD Designs</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SERVICE 01 DEEP DIVE: PRECISION SOLAR SITE SURVEYS
       ========================================================================= -->
  <section class="section service-deep-dive" id="site-surveys">
    <div class="container">
      <!-- Section Tag Header -->
      <div class="discipline-banner">
        <div class="discipline-tag-wrap">
          <span class="discipline-num">01</span>
          <span class="discipline-pill">FIELD DISCIPLINE</span>
        </div>
        <div class="discipline-heading-group">
          <h2>Precision Solar Site Surveys</h2>
          <p class="lead">
            Thorough on-site physical auditing engineered to enable streamlined drafting and eliminate costly field measurement surprises.
          </p>
        </div>
      </div>

      <!-- Main Visual & Summary Row -->
      <div class="deep-dive-grid">
        <div class="deep-dive-media">
          <div class="media-frame">
            <img 
              src="/images/roof_pitch_survey.webp" 
              alt="Certified solar surveyor measuring roof pitch and rafter dimensions with digital pitch gauge" 
              width="1200" 
              height="675" 
              class="frame-img"
              loading="lazy"
            />
            <div class="media-floating-badge badge-top-left">
              <span class="badge-dot-green"></span>
              <span>50+ HD Photo Directory</span>
            </div>
            <div class="media-floating-badge badge-bottom-right">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <span>CAD-Ready Field Data</span>
            </div>
          </div>

          <!-- Secondary Image Grid for Site Survey Context -->
          <div class="sub-media-grid">
            <div class="sub-media-card">
              <img 
                src="/images/electrical_panel_survey.webp" 
                alt="Electrical main service panel interior audit with dead-front removed" 
                width="600" 
                height="338" 
                loading="lazy"
              />
              <span class="sub-media-label">MSP Dead-Front Audit</span>
            </div>
            <div class="sub-media-card">
              <img 
                src="/images/battery_storage_survey.webp" 
                alt="Battery storage gateway clearances and NFPA 855 setback verification" 
                width="600" 
                height="338" 
                loading="lazy"
              />
              <span class="sub-media-label">Battery & ESS Clearances</span>
            </div>
            <div class="sub-media-card">
              <img 
                src="/images/drone_site_inspection.webp" 
                alt="Drone aerial inspection for rooftop solar survey" 
                width="600" 
                height="338" 
                loading="lazy"
              />
              <span class="sub-media-label">Aerial Documentation</span>
            </div>
          </div>
        </div>

        <div class="deep-dive-content">
          <div class="technical-summary-box">
            <h3 class="box-title">What Every Field Survey Covers</h3>
            <p>
              Our trained field surveyors follow standardized verification protocols: digital pitch measurements, electrical panel interior documentation, attic structural checks, and precise obstacle mapping.
            </p>
          </div>

          <!-- 4 Core Checkpoint Cards -->
          <div class="checkpoints-stack">
            <!-- Checkpoint 1 -->
            <div class="checkpoint-item card-technical">
              <div class="checkpoint-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
              <div class="checkpoint-body">
                <h4>Roof Geometry & Structural Integrity</h4>
                <p>
                  Digital pitch readings on roof planes, azimuth degrees, rafter/truss dimensions (2x4, 2x6), on-center spacing (16" vs 24" O.C.), roofing material layer audit, and visual shingle condition check.
                </p>
              </div>
            </div>

            <!-- Checkpoint 2 -->
            <div class="checkpoint-item card-technical">
              <div class="checkpoint-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
              </div>
              <div class="checkpoint-body">
                <h4>Electrical Main Service Panel (MSP) Audit</h4>
                <p>
                  Interior dead-front removal to photograph busbar rating, main breaker ampacity (NEC 705.12 120% rule), spare breaker slots, utility meter rating, lever bypass, and Grounding Electrode Conductor (GEC) paths.
                </p>
              </div>
            </div>

            <!-- Checkpoint 3 -->
            <div class="checkpoint-item card-technical">
              <div class="checkpoint-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><line x1="6" y1="11" x2="6" y2="11"/><line x1="10" y1="11" x2="10" y2="11"/><line x1="14" y1="11" x2="14" y2="11"/><line x1="18" y1="11" x2="18" y2="11"/></svg>
              </div>
              <div class="checkpoint-body">
                <h4>Battery & Energy Storage (NFPA 855)</h4>
                <p>
                  3-foot setback verification from operable doors and windows, system controller/gateway wall mounting elevations, conduit run measurements, and backup subpanel load mapping.
                </p>
              </div>
            </div>

            <!-- Checkpoint 4 -->
            <div class="checkpoint-item card-technical">
              <div class="checkpoint-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#102A43" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              </div>
              <div class="checkpoint-body">
                <h4>Obstruction Mapping & Aerial Documentation</h4>
                <p>
                  Offset measurements for plumbing vents, attic turbines, skylights, chimneys, and tree overhangs. Optional FAA Part 107 drone aerial photos for complex roof geometries.
                </p>
              </div>
            </div>
          </div>

          <!-- Deliverables Pill Row -->
          <div class="deliverables-badge-wrap">
            <span class="deliverable-label">DELIVERABLES INCLUDED:</span>
            <div class="deliverable-tags">
              <span class="tag-item">50+ Categorized HD Photos</span>
              <span class="tag-item">One-Sheet Dimensional PDF</span>
              <span class="tag-item">SLD Electrical Parameter Sheet</span>
              <span class="tag-item">Secure Cloud Drive Delivery</span>
            </div>
          </div>

          <div class="action-row">
            <a href={surveyWhatsAppLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-md">
              <span>Schedule a Texas Site Survey</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/join-us" class="btn btn-outline btn-md">
              <span>Partner Your Field Team</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SERVICE 02 DEEP DIVE: PERMIT-READY CAD DESIGNS
       ========================================================================= -->
  <section class="section section-warm service-deep-dive" id="cad-designs">
    <div class="container">
      <!-- Section Tag Header -->
      <div class="discipline-banner">
        <div class="discipline-tag-wrap">
          <span class="discipline-num">02</span>
          <span class="discipline-pill cad-pill">ENGINEERING DISCIPLINE</span>
        </div>
        <div class="discipline-heading-group">
          <h2>Permit-Ready CAD Designs & Plan Sets</h2>
          <p class="lead">
            Full-scope solar PV and energy storage drafting built to local AHJ standards, utility interconnection guidelines, and National Electrical Code (NEC).
          </p>
        </div>
      </div>

      <!-- Main Visual & Summary Row (Reversed Layout) -->
      <div class="deep-dive-grid reverse">
        <div class="deep-dive-content">
          <div class="technical-summary-box">
            <h3 class="box-title">Complete Permit Submittal Engineering</h3>
            <p>
              Our drafting team converts verified survey dimensions, site photos, and equipment specifications into clean, code-compliant permit packages ready for direct submission to building departments and utilities.
            </p>
          </div>

          <!-- 4 Core Engineering Checkpoint Cards -->
          <div class="checkpoints-stack">
            <!-- CAD Checkpoint 1 -->
            <div class="checkpoint-item card-technical">
              <div class="checkpoint-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></polygon></svg>
              </div>
              <div class="checkpoint-body">
                <h4>Architectural & Structural Roof Plan Sets</h4>
                <p>
                  Optimized module array placement, fire code setbacks (ridge & valley pathways), attachment details, rafter span structural analysis, and ASCE structural load notes.
                </p>
              </div>
            </div>

            <!-- CAD Checkpoint 2 -->
            <div class="checkpoint-item card-technical">
              <div class="checkpoint-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              </div>
              <div class="checkpoint-body">
                <h4>Single-Line (SLD) & 3-Line Electrical Schematics</h4>
                <p>
                  String sizing calculations, conductor wire gauge & conduit schedules, OCPD sizing, voltage drop calculations (&lt;2%), NEC 690 Rapid Shutdown (RSD), and NEC 705.12 120% rule calculations.
                </p>
              </div>
            </div>

            <!-- CAD Checkpoint 3 -->
            <div class="checkpoint-item card-technical">
              <div class="checkpoint-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
              </div>
              <div class="checkpoint-body">
                <h4>Battery & Microgrid Storage Engineering</h4>
                <p>
                  Whole-home and partial-home backup transfer switches (ATS/Gateway), smart load centers, emergency disconnects, and NFPA 855 ventilation & spatial compliance details.
                </p>
              </div>
            </div>

            <!-- CAD Checkpoint 4 -->
            <div class="checkpoint-item card-technical">
              <div class="checkpoint-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              </div>
              <div class="checkpoint-body">
                <h4>AHJ Submittal & Placard Warning Schedules</h4>
                <p>
                  Contractor title blocks, jurisdiction-specific code notes, equipment spec cut sheets, NEC warning placard directories, and Professional Engineer (PE) stamp readiness.
                </p>
              </div>
            </div>
          </div>

          <div class="action-row">
            <a href={cadWhatsAppLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-md">
              <span>Request CAD Plan Sets</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact" class="btn btn-outline btn-md">
              <span>Submit Project Requirements</span>
            </a>
          </div>
        </div>

        <div class="deep-dive-media">
          <div class="media-frame">
            <img 
              src="/images/solar_cad_designs.webp" 
              alt="High-precision solar CAD permit drawing set, single-line electrical schematic, and structural roof plan" 
              width="1200" 
              height="675" 
              class="frame-img"
              loading="lazy"
            />
            <div class="media-floating-badge badge-top-left">
              <span class="badge-dot-sky"></span>
              <span>Permit-Ready Engineering Plan Sets</span>
            </div>
            <div class="media-floating-badge badge-bottom-right">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span>Full AHJ Revision Support</span>
            </div>
          </div>

          <!-- CAD Highlights Mini Grid -->
          <div class="cad-highlights-grid">
            <div class="cad-mini-card">
              <span class="cad-mini-num">01</span>
              <h5>Rapid CAD Drafting</h5>
              <p>Streamlined drafting workflows to keep your permitting pipeline moving efficiently.</p>
            </div>
            <div class="cad-mini-card">
              <span class="cad-mini-num">02</span>
              <h5>PE Stamp Ready</h5>
              <p>Structured for immediate Professional Engineer (PE) structural & electrical endorsement.</p>
            </div>
            <div class="cad-mini-card">
              <span class="cad-mini-num">03</span>
              <h5>Revisions Covered</h5>
              <p>Responsive AHJ revision support to address city plan reviewer comments.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION: DELIVERABLES MATRIX & COMPARISON
       ========================================================================= -->
  <section class="section" id="matrix">
    <div class="container">
      <div class="section-header center">
        <div class="sub-badge">TECHNICAL SPECIFICATIONS</div>
        <h2>Deliverables & Scope Comparison</h2>
        <p class="lead">
          Compare outputs, supported systems, formats, and quality assurance protocols between our two core services.
        </p>
      </div>

      <div class="matrix-table-container card-technical">
        <table class="specs-table comparison-table">
          <thead>
            <tr>
              <th style="width: 26%;">SPECIFICATION</th>
              <th style="width: 37%;">SERVICE 01: SITE SURVEYS</th>
              <th style="width: 37%;">SERVICE 02: CAD DESIGNS</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="spec-name">Primary Focus</td>
              <td>On-site physical inspection, roof pitch measurements, attic framing, and MSP interior audit.</td>
              <td>Full architectural & electrical permit drawing sets, string sizing, and AHJ submittals.</td>
            </tr>
            <tr>
              <td class="spec-name">Core Deliverables</td>
              <td>
                <ul class="matrix-list">
                  <li>50+ Categorized HD photos</li>
                  <li>One-sheet dimensional PDF audit</li>
                  <li>SLD parameter & obstruction sheet</li>
                </ul>
              </td>
              <td>
                <ul class="matrix-list">
                  <li>Full permit-ready drawing set (.PDF)</li>
                  <li>Editable source CAD files (.DWG)</li>
                  <li>Cut sheets & placard warning schedules</li>
                </ul>
              </td>
            </tr>
            <tr>
              <td class="spec-name">Delivery Schedule</td>
              <td>Prompt desk QA release upon field inspection completion</td>
              <td>Expedited drafting upon project intake and survey data verification</td>
            </tr>
            <tr>
              <td class="spec-name">Code Compliance</td>
              <td>NEC 110.26 (Clearances), NFPA 855 (Storage), IFC fire setbacks verification.</td>
              <td>NEC 690 / 705.12, ASCE structural loads, AHJ & utility interconnection standards.</td>
            </tr>
            <tr>
              <td class="spec-name">Supported Systems</td>
              <td>Residential Rooftop, Ground Mounts, Commercial C&I, Battery Storage (ESS), Carports.</td>
              <td>Enphase, SolarEdge, Tesla Powerwall, FranklinWH, Sol-Ark, SMA, Canadian Solar, and more.</td>
            </tr>
            <tr>
              <td class="spec-name">Quality Assurance</td>
              <td>Multi-point internal desk QA before dispatch delivery.</td>
              <td>Dual-tier drafting QA with responsive AHJ revision support.</td>
            </tr>
            <tr>
              <td class="spec-name">Delivery Format</td>
              <td>Secure cloud storage folder (Dropbox / Google Drive / API).</td>
              <td>Printable vector PDF, layered AutoCAD .DWG, and calculation reports.</td>
