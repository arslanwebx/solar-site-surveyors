---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout 
  title="Site Survey Services & Scope Specifications | SolarSite Co."
  description="Comprehensive field survey scopes for Solar EPCs: Roof geometry, electrical main service panels (MSP), battery storage clearances (NFPA 855), attic structural framing, and 36-photo CAD deliverable packages."
  activeNav="services"
>
  <!-- Page Header -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <span class="badge-tech badge-dark">OPERATIONAL SPECIFICATIONS</span>
        <h1 class="page-title">Site Survey Services & Technical Scope</h1>
        <p class="lead" style="color: #94A3B8; max-width: 820px;">
          Standardized field verification protocols designed for zero-touch CAD drafting, PE structural stamps, and rapid AHJ permit approval. Every survey includes our certified 36-photo standard.
        </p>
      </div>
    </div>
  </section>

  <!-- Service 1: Roof Survey -->
  <section class="section" id="roof">
    <div class="container">
      <div class="service-detail-row">
        <div class="service-text-side">
          <span class="badge-tech badge-amber">DISCIPLINE 01</span>
          <h2>Roof & Structural Survey</h2>
          <p class="lead">
            Physical geometry verification that calibrates satellite models with millimeter accuracy.
          </p>
          <p>
            While aerial imagery tools provide preliminary layouts, physical on-site verification confirms actual pitch, structural deflection, layer thickness, and obstruction coordinates required for solar module attachment engineering.
          </p>

          <div class="specs-box card-technical" style="margin-top: 1.5rem;">
            <h4 class="specs-title font-mono">FIELD VERIFICATION CHECKPOINTS:</h4>
            <ul class="specs-list-check">
              <li><strong>Roof Dimensions & Angles:</strong> Eave-to-ridge, rake-to-rake, valleys, and hips measured and cross-referenced with digital pitch gauges.</li>
              <li><strong>Roof Material & Layers:</strong> Asphalt shingle (3-tab vs architectural), clay/concrete tile (S-tile, flat tile), standing seam metal, or flat membrane (TPO/EPDM). Layer count verified.</li>
              <li><strong>Roof Condition Assessment:</strong> Granular loss, tile cracking, soft spots, ponding evidence, and estimated remaining lifespan (&lt;5 years flagged).</li>
              <li><strong>Obstruction Mapping:</strong> Exact X/Y offsets from nearest ridge and eave for plumbing vents, attic turbines, skylights, chimneys, and satellite dishes.</li>
              <li><strong>Shading & Clearances:</strong> Tree overhangs, horizon obstructions, and IFC fire code setbacks (36" ridge / 36" valley).</li>
            </ul>
          </div>
        </div>

        <div class="service-image-side">
          <div class="service-img-wrapper card-technical tech-grid-border">
            <img 
              src="/images/hero_surveyor_field.jpg" 
              alt="Roof inspection and pitch measurement by solar site surveyor" 
              width="900" 
              height="506" 
              class="service-img"
              loading="lazy"
            />
            <div class="img-caption font-mono">
              <span>PHOTO CODE: RF-01-AZIMUTH • DIGITAL PITCH GAUGE VERIFIED</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service 2: Electrical Survey -->
  <section class="section section-warm" id="electrical">
    <div class="container">
      <div class="service-detail-row reverse">
        <div class="service-text-side">
          <span class="badge-tech badge-amber">DISCIPLINE 02</span>
          <h2>Electrical Service & Interconnection Survey</h2>
          <p class="lead">
            Eliminating 45% of change orders through rigorous main service panel (MSP) interior audits.
          </p>
          <p>
            Our surveyors remove panel dead-fronts (where safe) to document internal busbar ratings, main breaker ampacity, spare breaker slots, and conduit pathways—providing electrical drafters with the exact data needed for NEC 705.12 calculations.
          </p>

          <div class="specs-box card-technical" style="margin-top: 1.5rem;">
            <h4 class="specs-title font-mono">ELECTRICAL AUDIT PARAMETERS:</h4>
            <ul class="specs-list-check">
              <li><strong>Main Service Panel (MSP):</strong> Manufacturer nameplate, model/catalog number, enclosure NEMA rating, and interior dead-front photograph.</li>
              <li><strong>Busbar & Main Breaker:</strong> Busbar amp rating (e.g. 125A, 200A, 225A) and main breaker ampacity for 120% rule compliance.</li>
              <li><strong>Interconnection Location:</strong> Assessment of opposite-end backfeed breaker slot availability, supply-side tap viability, or feeder tap box necessity.</li>
              <li><strong>Utility Meter & Socket:</strong> Meter number, digital display, meter socket rating, lever bypass presence, and clearance from gas meters (&gt;36").</li>
              <li><strong>Grounding & Subpanels:</strong> Grounding electrode conductor (GEC) path to ground rod or water pipe, plus existing subpanel loads.</li>
            </ul>
          </div>
        </div>

        <div class="service-image-side">
          <div class="service-img-wrapper card-technical tech-grid-border">
            <img 
              src="/images/electrical_panel_survey.jpg" 
              alt="Technician measuring and documenting electrical main service panel with multimeter" 
              width="900" 
              height="506" 
              class="service-img"
              loading="lazy"
            />
            <div class="img-caption font-mono">
              <span>PHOTO CODE: EL-04-DEADFRONT • 120% RULE DATA CAPTURE</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service 3: Battery & Storage Survey -->
  <section class="section" id="battery">
    <div class="container">
      <div class="service-detail-row">
        <div class="service-text-side">
          <span class="badge-tech badge-amber">DISCIPLINE 03</span>
          <h2>Battery & Energy Storage (ESS) Clearances</h2>
          <p class="lead">
            Ensuring NFPA 855 compliance and seamless microgrid gateway integration.
          </p>
          <p>
            With solar-plus-storage surging, site surveys must account for strict separation distances from windows and doors, structural wall anchor capacity, and continuous conduit routing between the battery bank, system controller, and main panel.
          </p>

          <div class="specs-box card-technical" style="margin-top: 1.5rem;">
            <h4 class="specs-title font-mono">STORAGE SURVEY CHECKPOINTS:</h4>
            <ul class="specs-list-check">
              <li><strong>NFPA 855 Spatial Boundaries:</strong> 3-foot minimum clearance verified from all operable windows, doors, and ventilation air intakes.</li>
              <li><strong>System Controller / Gateway Location:</strong> Proposed mounting wall with floor-to-ceiling elevation measurements and working space clearances (NEC 110.26).</li>
              <li><strong>Conduit Pathway & Run Length:</strong> Measured linear path and elevation changes between battery location and main service equipment.</li>
              <li><strong>Wall Structure & Anchoring:</strong> Stud framing inspection (16" vs 24" O.C.), concrete foundation wall, or masonry support check.</li>
              <li><strong>Critical Loads Subpanel:</strong> Inventory and photo directory of branch circuits targeted for backup islanding.</li>
            </ul>
          </div>
        </div>

        <div class="service-image-side">
          <div class="service-img-wrapper card-technical tech-grid-border">
            <img 
              src="/images/battery_storage_survey.jpg" 
              alt="Site surveyor inspecting battery storage gateway wall clearances" 
              width="900" 
              height="506" 
              class="service-img"
              loading="lazy"
            />
            <div class="img-caption font-mono">
              <span>PHOTO CODE: ESS-02-CLEARANCE • NFPA 855 BOUNDARY CHECK</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service 4: Drone & Commercial C&I Survey -->
  <section class="section section-warm" id="commercial">
    <div class="container">
      <div class="service-detail-row reverse">
        <div class="service-text-side">
          <span class="badge-tech badge-amber">DISCIPLINE 04</span>
          <h2>Commercial (C&I) & Drone Aerial Surveys</h2>
          <p class="lead">
            High-resolution aerial photogrammetry and 3-phase industrial electrical audits.
          </p>
          <p>
            For commercial rooftops, carports, and complex residential estates, our FAA Part 107 certified remote pilots capture 4K photogrammetric point clouds and orthomosaic maps, while commercial electricians audit 208V/480V switchgear.
          </p>

          <div class="specs-box card-technical" style="margin-top: 1.5rem;">
            <h4 class="specs-title font-mono">COMMERCIAL AUDIT CAPABILITIES:</h4>
            <ul class="specs-list-check">
              <li><strong>FAA Part 107 Drone Surveys:</strong> High-resolution 4K RGB orthomosaic maps, 3D point clouds, and thermal anomaly scans.</li>
              <li><strong>3-Phase Electrical Switchboards:</strong> 120/208V and 277/480V main switchboard bus ratings, CT cabinets, and transformer nameplates.</li>
              <li><strong>Flat Commercial Roofs:</strong> TPO, EPDM, Built-Up, and standing seam roof deck assessments for ballasted or penetrating racking.</li>
              <li><strong>Structural Trusses & Decking:</strong> Open-web steel joist (OWSJ) and timber glulam truss measurements for PE structural calculations.</li>
            </ul>
          </div>
        </div>

        <div class="service-image-side">
          <div class="service-img-wrapper card-technical tech-grid-border">
            <img 
              src="/images/drone_site_inspection.jpg" 
              alt="Solar surveyor operating commercial drone on large rooftop array" 
              width="900" 
              height="506" 
              class="service-img"
              loading="lazy"
            />
            <div class="img-caption font-mono">
              <span>PHOTO CODE: DR-01-AERIAL • FAA PART 107 PHOTOGRAMMETRY</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DELIVERABLE SPECIFICATION & QA PROTOCOL -->
  <section class="section" id="package">
    <div class="container">
      <div class="section-header center">
        <span class="badge-tech badge-amber">OPERATIONAL OUTPUT</span>
        <h2>The CAD-Ready Survey Deliverable Package</h2>
        <p class="lead">
          What your engineering and drafting team receives upon deliverable release.
        </p>
      </div>

      <div class="grid-3" style="margin-top: var(--space-8);">
        <div class="package-item card-technical">
          <div class="package-num font-mono">01</div>
          <h4>36+ Geotagged 4K Photos</h4>
          <p>Organized into standardized folders (Property, Roof, Electrical, Structural, ESS) with high-resolution macro labels.</p>
        </div>

        <div class="package-item card-technical">
          <div class="package-num font-mono">02</div>
          <h4>One-Touch CAD Dimension Sheet</h4>
          <p>Full roof geometry, plane azimuths, verified pitch angles, and obstruction offsets ready for AutoCAD or HelioScope import.</p>
        </div>

        <div class="package-item card-technical">
          <div class="package-num font-mono">03</div>
          <h4>Single-Line Electrical Parameter Sheet</h4>
          <p>Bus rating, main breaker, wire sizes, grounding, and NEC 705.12 120% rule calculations documented by a certified auditor.</p>
        </div>

        <div class="package-item card-technical">
          <div class="package-num font-mono">04</div>
          <h4>Structural Framing Report</h4>
          <p>Rafter dimensions, span lengths, on-center spacing, and decking condition for structural PE calculation stamps.</p>
        </div>

        <div class="package-item card-technical">
          <div class="package-num font-mono">05</div>
          <h4>Battery & Gateway Clearance Report</h4>
          <p>NFPA 855 setback diagrams, stud wall anchor checks, and measured conduit run paths with elevation notes.</p>
        </div>

        <div class="package-item card-technical">
          <div class="package-num font-mono">06</div>
          <h4>Triple-Check QA Verification Signoff</h4>
          <p>Pre-screened by our internal engineering desk to guarantee zero missing photos or ambiguous data points.</p>
        </div>
      </div>

      <!-- Turnaround SLA Comparison Table -->
      <div class="sla-table-container card-technical tech-grid-border" style="margin-top: var(--space-12);">
        <div class="sla-table-header">
          <span class="badge-tech badge-amber">SLA PERFORMANCE</span>
          <h3>Service Turnaround Standards</h3>
        </div>

        <table class="specs-table">
          <thead>
            <tr>
              <th>Service Tier</th>
              <th>Survey Dispatch Time</th>
              <th>Field Survey Duration</th>
              <th>Deliverable QA Release</th>
              <th>Ideal Project Fit</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Standard Residential</strong></td>
              <td>&lt; 24 Hours</td>
              <td>60–90 Minutes</td>
              <td><strong>48–72 Hours</strong></td>
              <td>Standard pipeline residential sales</td>
            </tr>
            <tr>
              <td><strong>Expedited / Rush Residential</strong></td>
              <td>&lt; 4 Hours</td>
              <td>60–90 Minutes</td>
              <td><strong>24–36 Hours</strong></td>
              <td>Month-end deadlines, fast-closing deals</td>
            </tr>
            <tr>
              <td><strong>Commercial & Industrial (C&I)</strong></td>
              <td>&lt; 48 Hours</td>
              <td>2–4 Hours</td>
              <td><strong>48–96 Hours</strong></td>
              <td>3-phase commercial rooftops & carports</td>
            </tr>
            <tr>
              <td><strong>Drone Aerial Photogrammetry</strong></td>
              <td>&lt; 48 Hours</td>
              <td>60–120 Minutes</td>
              <td><strong>48–72 Hours</strong></td>
              <td>Steep-pitch roofs, large multi-plane estates</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection 
    title="Ready to Request a Texas Solar Site Survey?"
    subtitle="Submit your project details and receive an organized, CAD-ready survey package in 24–48 hours."
    primaryCtaText="Schedule a Texas Survey"
    primaryCtaLink="/schedule"
    secondaryCtaText="Join Our Texas Network"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .service-detail-row {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .service-detail-row.reverse {
    grid-template-columns: 1fr 1.15fr;
  }

  .service-detail-row.reverse .service-text-side {
    order: 2;
  }

  .service-detail-row.reverse .service-image-side {
    order: 1;
  }

  .service-text-side h2 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
  }

  .specs-box {
    background-color: #FFFFFF;
    padding: var(--space-6);
  }

  .specs-title {
    font-size: 0.75rem;
    color: var(--accent-amber-dark);
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
  }

  .specs-list-check {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .specs-list-check li {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    position: relative;
    padding-left: 1.25rem;
  }

  .specs-list-check li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #059669;
    font-weight: 700;
  }

  .specs-list-check li strong {
    color: var(--text-primary);
  }

  .service-img-wrapper {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--bg-surface);
  }

  .service-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .img-caption {
    background-color: #0F172A;
    color: #94A3B8;
    font-size: 0.6875rem;
    padding: 0.5rem 0.75rem;
    text-align: center;
  }

  .package-item {
    padding: var(--space-6);
    background-color: #FFFFFF;
  }

  .package-num {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--accent-amber);
    margin-bottom: var(--space-2);
  }

  .package-item h4 {
    margin-bottom: var(--space-2);
    font-size: 1.125rem;
  }

  .package-item p {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .sla-table-container {
    background-color: #FFFFFF;
    padding: var(--space-8);
  }

  .sla-table-header {
    margin-bottom: var(--space-6);
  }

  .sla-table-header h3 {
    margin-top: var(--space-2);
    font-size: 1.5rem;
  }

  @media (max-width: 1024px) {
    .service-detail-row,
    .service-detail-row.reverse {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .service-detail-row.reverse .service-text-side {
      order: 1;
    }
    .service-detail-row.reverse .service-image-side {
      order: 2;
    }
  }
</style>
