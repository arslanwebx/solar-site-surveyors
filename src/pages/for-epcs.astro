---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout 
  title="Built for Solar EPCs & Installers | Scale Field Operations | SolarSite Co."
  description="Scale your solar EPC operations without the fixed overhead of in-house surveyors. Standardized 36-photo packages, 48-hour turnarounds, and nationwide field coordination."
  activeNav="for-epcs"
>
  <!-- Page Hero -->
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <span class="badge-tech badge-dark">ENTERPRISE SOLAR OPERATIONS</span>
        <h1 class="page-title">You Sell & Install Solar.<br/><span class="text-amber">We Handle the Field Verification.</span></h1>
        <p class="lead" style="color: #94A3B8; max-width: 820px;">
          Eliminate surveyor payroll, fleet headaches, and scheduling bottlenecks. SolarSite Co. provides dedicated regional site survey coordination for growing Solar EPCs and contractors across 14+ states.
        </p>
        <div class="page-hero-actions" style="margin-top: var(--space-6);">
          <a href="#partner-form" class="btn btn-primary btn-lg">Become an EPC Partner</a>
          <a href="/schedule" class="btn btn-outline-white btn-lg">Schedule a Test Survey</a>
        </div>
      </div>
    </div>
  </section>

  <!-- The In-House vs Coordinated Comparison -->
  <section class="section" id="comparison">
    <div class="container">
      <div class="section-header center">
        <span class="badge-tech badge-amber">OPERATIONAL COMPARISON</span>
        <h2>In-House Field Surveyors vs. SolarSite Co.</h2>
        <p class="lead">
          Why leading solar operations directors are transitioning from internal field fleets to on-demand coordinated survey dispatch.
        </p>
      </div>

      <div class="comparison-table-wrapper card-technical tech-grid-border" style="margin-top: var(--space-8);">
        <table class="specs-table comparison-table">
          <thead>
            <tr>
              <th>Operational Dimension</th>
              <th>Managing In-House Surveyors</th>
              <th>Coordinated via SolarSite Co.</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Cost Structure</strong></td>
              <td>Fixed monthly payroll, benefits, overtime, and idle labor during rain or market slowdowns.</td>
              <td><span class="text-green font-bold">100% Variable On-Demand:</span> Pay only per completed, QA-verified survey package.</td>
            </tr>
            <tr>
              <td><strong>Vehicle & Tool Liability</strong></td>
              <td>Fleet leases, commercial auto insurance, ladders, drone registration, gas cards, and repairs.</td>
              <td><span class="text-green font-bold">Zero Equipment Overhead:</span> All network surveyors provide certified safety equipment.</td>
            </tr>
            <tr>
              <td><strong>Geographic Expansion</strong></td>
              <td>Months spent recruiting, vetting, and training local surveyors in new counties or states.</td>
              <td><span class="text-green font-bold">Instant Multi-Market Scale:</span> Active coverage ready across 14+ major solar states.</td>
            </tr>
            <tr>
              <td><strong>Deliverable Consistency</strong></td>
              <td>Varying photo quality, forgotten panel dead-fronts, and inconsistent hand-drawn sketches.</td>
              <td><span class="text-green font-bold">Strict 36-Photo Standard:</span> Standardized CAD dimensioning and electrical parameter reports.</td>
            </tr>
            <tr>
              <td><strong>CAD Revision Rate</strong></td>
              <td>Industry average 22%–28% drafting revisions due to incomplete field data.</td>
              <td><span class="text-green font-bold">&lt; 3% Revisions:</span> Triple-checked by internal engineering desk prior to release.</td>
            </tr>
            <tr>
              <td><strong>Average Turnaround Time</strong></td>
              <td>7–14 days depending on internal surveyor schedule backlogs.</td>
              <td><span class="text-green font-bold">48–72 Hours:</span> Guaranteed dispatch SLA with 24hr rush tier available.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Core EPC Operational Pillars -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header">
        <span class="badge-tech badge-amber">DESIGNED FOR VOLUME</span>
        <h2>How We Streamline Your Operational Pipeline</h2>
        <p class="lead">
          Built to integrate directly with your project management, CAD drafting, and permit submittal workflows.
        </p>
      </div>

      <div class="grid-3" style="margin-top: var(--space-8);">
        <div class="epc-pillar-card card-technical tech-grid-border">
          <div class="pillar-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h4>Zero Coordination Overhead</h4>
          <p>Your team submits the project address and utility bill. Our dispatch desk handles appointment scheduling, homeowner communication, and site access coordination.</p>
        </div>

        <div class="epc-pillar-card card-technical tech-grid-border">
          <div class="pillar-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h4>CAD & Drafting Integration</h4>
          <p>Deliverables format directly into AutoCAD DWG overlays, HelioScope design layouts, Aurora Solar models, and ETX permit plan sets with zero format conversion.</p>
        </div>

        <div class="epc-pillar-card card-technical tech-grid-border">
          <div class="pillar-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h4>Dedicated Account Operations Manager</h4>
          <p>High-volume EPC partners receive a dedicated operations manager and direct hotline to handle rush dispatches, custom checklist requests, and escalation support.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EPC Partner Onboarding Form -->
  <section class="section" id="partner-form">
    <div class="container">
      <div class="partner-form-wrapper card-technical tech-grid-border">
        <div class="form-header">
          <span class="badge-tech badge-amber">EPC PARTNER ONBOARDING</span>
          <h2>Become an EPC Partner</h2>
          <p class="lead">
            Set up an enterprise account to access volume pricing, dedicated SLA scheduling, and direct portal/API dispatch integration.
          </p>
        </div>

        <form id="epc-partner-intake-form" class="project-form">
          <div class="grid-2">
            <div class="form-group">
              <label class="form-label" for="epc-company">Company / EPC Name <span class="required">*</span></label>
              <input type="text" id="epc-company" name="company" class="form-input" placeholder="e.g. Horizon Solar EPC LLC" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="epc-contact">Primary Operations Contact <span class="required">*</span></label>
              <input type="text" id="epc-contact" name="contact" class="form-input" placeholder="e.g. Tyler Brooks (VP of Ops)" required />
            </div>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label class="form-label" for="epc-email">Work Email <span class="required">*</span></label>
              <input type="email" id="epc-email" name="email" class="form-input" placeholder="e.g. tyler@horizonsolar.com" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="epc-phone">Direct Phone <span class="required">*</span></label>
              <input type="tel" id="epc-phone" name="phone" class="form-input" placeholder="e.g. (555) 890-1234" required />
            </div>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label class="form-label" for="epc-volume">Estimated Monthly Survey Volume <span class="required">*</span></label>
              <select id="epc-volume" name="volume" class="form-select" required>
                <option value="5-15">5–15 Surveys / Month</option>
                <option value="16-50" selected>16–50 Surveys / Month (Standard Partner)</option>
                <option value="51-150">51–150 Surveys / Month (High Volume)</option>
                <option value="150+">150+ Surveys / Month (Enterprise)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="epc-states">Primary Active States <span class="required">*</span></label>
              <input type="text" id="epc-states" name="states" class="form-input" placeholder="e.g. CA, TX, FL, AZ" required />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="epc-notes">Current Operational Pain Points or Requirements</label>
            <textarea id="epc-notes" name="notes" class="form-textarea" placeholder="Tell us about your current site survey turnaround times, CAD software used, or specific market expansion plans..."></textarea>
          </div>

          <div class="form-submit-footer">
            <button type="submit" class="btn btn-primary btn-lg" id="submit-epc-btn">
              <span>Submit EPC Partnership Application</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </div>
        </form>

        <div class="partner-confirmation" id="partner-confirmation" style="display: none;">
          <div class="conf-icon-box">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <span class="badge-tech badge-amber">APPLICATION RECEIVED</span>
          <h3 class="conf-title">EPC Partnership Request Confirmed</h3>
          <p class="conf-desc">
            Our Director of EPC Partnerships will contact you within 4 business hours to set up your dispatch account, review volume pricing, and configure your CAD deliverable templates.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection 
    title="Have an Active Project That Needs Surveying Today?"
    subtitle="You don't have to wait for an enterprise onboarding call. Submit your first project and test our 48-hour deliverable quality."
    primaryCtaText="Schedule a Site Survey Now"
    primaryCtaLink="/schedule"
    secondaryCtaText="Call Operations Dispatch"
    secondaryCtaLink="tel:+18005557878"
  />
</BaseLayout>

<script>
  const epcForm = document.getElementById('epc-partner-intake-form') as HTMLFormElement;
  const epcConf = document.getElementById('partner-confirmation');

  if (epcForm && epcConf) {
    epcForm.addEventListener('submit', (e) => {
      e.preventDefault();
      epcForm.style.display = 'none';
      epcConf.style.display = 'block';
      epcConf.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .page-hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .comparison-table-wrapper {
    background-color: #FFFFFF;
    padding: var(--space-8);
  }

  .text-green {
    color: #059669;
  }

  .font-bold {
    font-weight: 700;
  }

  .epc-pillar-card {
    background-color: #FFFFFF;
    padding: var(--space-8);
  }

  .pillar-icon {
    margin-bottom: var(--space-4);
  }

  .epc-pillar-card h4 {
    margin-bottom: var(--space-2);
    font-size: 1.1875rem;
  }

  .epc-pillar-card p {
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .partner-form-wrapper {
    background-color: #FFFFFF;
    padding: var(--space-10) var(--space-8);
  }

  .partner-confirmation {
    text-align: center;
    padding: var(--space-12) var(--space-6);
  }

  .conf-icon-box {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--status-green-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
  }

  .conf-title {
    font-size: 1.875rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .conf-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .partner-form-wrapper {
      padding: var(--space-6) var(--space-4);
    }
    .comparison-table th, .comparison-table td {
      font-size: 0.8125rem;
      padding: 0.5rem;
    }
  }
</style>
