---
import BaseLayout from '../layouts/BaseLayout.astro';
import SurveyorApplyForm from '../components/SurveyorApplyForm.astro';
---

<BaseLayout 
  title="Become a Solar Site Surveyor | Join Our Field Network | SolarSite Co."
  description="Apply to join our vetted nationwide network of solar site surveyors, roof inspectors, and FAA Part 107 drone pilots. Reliable 1099 dispatches across active markets."
  activeNav="surveyors"
>
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <span class="badge-tech badge-dark">FIELD NETWORK RECRUITMENT</span>
        <h1 class="page-title">Become a Solar Site Surveyor</h1>
        <p class="lead" style="color: #94A3B8; max-width: 820px;">
          Join a professional nationwide network of certified solar site surveyors, roof inspectors, and licensed drone pilots. We provide consistent local project dispatches with prompt bi-weekly payouts.
        </p>
      </div>
    </div>
  </section>

  <!-- Network Value Pillars for Surveyors -->
  <section class="section section-warm">
    <div class="container">
      <div class="grid-3">
        <div class="network-card card-technical tech-grid-border">
          <div class="card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h4>Consistent Local Dispatches</h4>
          <p>We match you with survey requests within your designated service radius. No cold sales or customer prospecting required.</p>
        </div>

        <div class="network-card card-technical tech-grid-border">
          <div class="card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h4>Guaranteed Bi-Weekly Payouts</h4>
          <p>Get paid reliably via direct deposit for every completed, QA-verified survey package with zero billing follow-up hassle.</p>
        </div>

        <div class="network-card card-technical tech-grid-border">
          <div class="card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4>Standardized Mobile Workflow</h4>
          <p>Use our streamlined field app to capture our 36-photo checklist and submit measurements directly from the job site.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Application Section -->
  <section class="section">
    <div class="container-narrow">
      <SurveyorApplyForm />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .network-card {
    background-color: #FFFFFF;
    padding: var(--space-8);
  }

  .network-card h4 {
    font-size: 1.1875rem;
    margin-bottom: var(--space-2);
  }

  .network-card p {
    font-size: 0.875rem;
    line-height: 1.55;
  }
</style>
