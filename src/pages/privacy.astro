---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Privacy Policy | SolarSite Co."
  description="Privacy policy and data protection terms for SolarSite Co. survey coordination platform."
>
  <section class="section section-dark page-hero">
    <div class="container-narrow">
      <h1 class="page-title">Privacy Policy</h1>
      <p class="lead" style="color: #94A3B8;">Last updated: August 2026</p>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <div class="legal-content card-technical" style="padding: var(--space-8); line-height: 1.7;">
        <h3>1. Information We Collect</h3>
        <p>SolarSite Co. collects property addresses, homeowner contact information (for scheduling purposes), utility bill account numbers, CAD layouts, and on-site photographic documentation submitted by Solar EPCs, contractors, and field surveyors.</p>

        <h3 style="margin-top: 1.5rem;">2. How We Use Project Information</h3>
        <p>All project data collected is used solely for the operational dispatch of certified field site surveyors, internal engineering quality assurance, and generating CAD-ready deliverable packages for the submitting contractor.</p>

        <h3 style="margin-top: 1.5rem;">3. Data Security & Confidentiality</h3>
        <p>We implement enterprise-grade encryption for all stored project files, utility bills, and single-line diagrams. We never sell, rent, or distribute project leads, homeowner data, or contractor client lists to third-party marketing companies.</p>

        <h3 style="margin-top: 1.5rem;">4. Contact Us</h3>
        <p>For questions regarding data retention or privacy practices, email <a href="mailto:privacy@solarsitesurveyors.com" style="color: var(--accent-amber-dark); text-decoration: underline;">privacy@solarsitesurveyors.com</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
