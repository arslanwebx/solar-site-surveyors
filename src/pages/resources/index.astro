---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { resourcesData } from '../../data/resources';

const categories = ['All', 'Site Surveys', 'Solar Design', 'Permitting', 'Interconnection', 'Solar Operations'];
---

<BaseLayout 
  title="Solar Operations Resource Hub | Field Survey & Engineering Guides"
  description="Technical resources for Solar EPCs, contractors, and operations managers: Site survey checklists, 36-photo standards, electrical panel busbar calculations, and AHJ permitting rules."
  activeNav="resources"
>
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <span class="badge-tech badge-dark">OPERATIONAL KNOWLEDGE BASE</span>
        <h1 class="page-title">Solar Operations Resource Hub</h1>
        <p class="lead" style="color: #94A3B8; max-width: 820px;">
          Practical, technical guides written by field engineers for solar EPCs, project managers, and CAD draftspersons. Real checklists, electrical formulas, and AHJ permit strategies.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Article Directory Grid -->
      <div class="articles-directory-grid">
        {resourcesData.map(article => (
          <article class="resource-entry-card card-technical tech-grid-border">
            <div class="entry-meta-top">
              <span class="badge-tech badge-amber">{article.category}</span>
              <span class="entry-read-time font-mono">{article.readTime}</span>
            </div>
            
            <h2 class="entry-title">
              <a href={`/resources/${article.slug}`}>{article.title}</a>
            </h2>
            
            <p class="entry-summary">{article.summary}</p>
            
            <div class="entry-takeaways">
              <span class="takeaways-label font-mono">KEY TAKEAWAYS:</span>
              <ul class="takeaways-mini-list">
                {article.keyTakeaways.slice(0, 2).map(takeaway => (
                  <li>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{takeaway}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="entry-footer">
              <span class="entry-author font-mono">By {article.author} • {article.publishedDate}</span>
              <a href={`/resources/${article.slug}`} class="btn btn-outline btn-sm">
                <span>Read Guide</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection 
    title="Need a Professional Site Survey for Your Pipeline?"
    subtitle="Put our standardized 36-photo field methodology to work on your next residential or commercial project."
    primaryCtaText="Schedule a Site Survey"
    primaryCtaLink="/schedule"
    secondaryCtaText="Explore Glossary Terms"
    secondaryCtaLink="/glossary"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .articles-directory-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  .resource-entry-card {
    background-color: #FFFFFF;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .entry-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .entry-read-time {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .entry-title {
    font-size: 1.375rem;
    line-height: 1.3;
    margin-bottom: var(--space-3);
  }

  .entry-title a:hover {
    color: var(--accent-amber);
  }

  .entry-summary {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .entry-takeaways {
    background-color: var(--bg-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-6);
  }

  .takeaways-label {
    display: block;
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .takeaways-mini-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .takeaways-mini-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .entry-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-light);
    padding-top: var(--space-4);
    margin-top: auto;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .entry-author {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .articles-directory-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
