---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout 
  title="Solar Operations Blog | SolarSite Texas"
  description="Field operations insights, Texas utility interconnection guidelines, and solar site-surveying standards for Solar EPCs and contractors."
  activeNav="blog"
>
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <h1 class="page-title">Solar Operations Blog</h1>
        <p class="lead" style="color: #94A3B8; max-width: 780px;">
          Practical, engineering-grade insights on solar site surveys, Texas utility interconnection practices, and streamlining the installation pipeline.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-coming-soon-card card-technical tech-grid-border">
        <div class="coming-soon-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            <line x1="9" y1="7" x2="15" y2="7"/>
            <line x1="9" y1="11" x2="13" y2="11"/>
          </svg>
        </div>
        <h2>Articles & Field Guides Coming Soon</h2>
        <p class="lead" style="max-width: 620px; margin: 0.75rem auto 1.75rem;">
          We are preparing in-depth technical breakdowns on Texas utility meter specifications, 120% busbar compliance, and field quality assurance standards. Check back soon for new publications.
        </p>
        
        <div class="blog-actions">
          <a href="/schedule" class="btn btn-primary btn-md">
            <span>Schedule a Site Survey</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/contact" class="btn btn-outline btn-md">
            <span>Contact Operations Team</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection 
    title="Need Reliable Site Surveys Across Texas?"
    subtitle="Submit your project details to request surveyor availability and see open time slots in your market."
    primaryCtaText="Schedule a Texas Survey"
    primaryCtaLink="/schedule"
    secondaryCtaText="Join Our Texas Network"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-bottom: var(--space-4);
  }

  .blog-coming-soon-card {
    background-color: #FFFFFF;
    padding: var(--space-16) var(--space-8);
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
  }

  .coming-soon-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: var(--accent-amber-subtle);
    margin-bottom: var(--space-6);
  }

  .blog-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .blog-coming-soon-card {
      padding: var(--space-10) var(--space-4);
    }
  }
</style>
