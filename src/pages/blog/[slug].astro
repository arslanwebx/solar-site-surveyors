---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { resourcesData, type ResourceArticle } from '../../data/resources';

export async function getStaticPaths() {
  return resourcesData.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: ResourceArticle;
}

const { article } = Astro.props;
const relatedArticles = resourcesData.filter(a => a.slug !== article.slug).slice(0, 2);
---

<BaseLayout 
  title={`${article.title} | Solar Operations Blog | SolarSite Texas`}
  description={article.summary}
  activeNav="blog"
  schemaType="TechArticle"
  schemaData={{
    headline: article.title,
    author: {
      '@type': 'Person',
      name: article.author,
      jobTitle: article.authorRole
    },
    datePublished: article.publishedDate
  }}
>
  <article class="article-wrapper">
    <header class="section section-dark article-hero">
      <div class="container-narrow">
        <div class="article-hero-content">
          <div class="article-top-meta">
            <a href="/blog" class="back-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span>Back to Operations Blog</span>
            </a>
            <span class="badge-tech badge-amber">{article.category}</span>
          </div>

          <h1 class="article-h1">{article.title}</h1>

          <div class="article-author-box">
            <div class="author-avatar-badge font-mono">{article.author.split(' ').map(n => n[0]).join('')}</div>
            <div class="author-info">
              <span class="author-name">{article.author}</span>
              <span class="author-title">{article.authorRole} • {article.publishedDate} • {article.readTime}</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="section">
      <div class="container-narrow">
        <div class="takeaways-banner card-technical tech-grid-border">
          <div class="takeaways-title font-mono">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>EXECUTIVE OPERATIONAL TAKEAWAYS</span>
          </div>
          <ul class="takeaways-full-list">
            {article.keyTakeaways.map(item => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="article-body-content" set:html={article.contentHtml} />

        <div class="article-author-bio card-technical" style="margin-top: var(--space-12);">
          <div class="bio-inner">
            <div class="bio-avatar font-mono">{article.author.split(' ').map(n => n[0]).join('')}</div>
            <div class="bio-text">
              <h4>Written by {article.author}</h4>
              <p class="bio-role font-mono">{article.authorRole} at SolarSite Texas</p>
              <p class="bio-desc">
                Specializing in Texas statewide field surveying protocols, CAD drafting standards, and bridge engineering between field conditions and Texas AHJ building permit approvals.
              </p>
            </div>
          </div>
        </div>

        <div class="related-guides-section" style="margin-top: var(--space-12);">
          <h3 style="margin-bottom: var(--space-6); font-size: 1.375rem;">Related Solar Operations Guides</h3>
          <div class="grid-2">
            {relatedArticles.map(rel => (
              <div class="related-card card-technical">
                <span class="badge-tech badge-amber">{rel.category}</span>
                <h4 style="margin: 0.5rem 0;"><a href={`/blog/${rel.slug}`}>{rel.title}</a></h4>
                <p style="font-size: 0.875rem; line-height: 1.45;">{rel.summary}</p>
                <a href={`/blog/${rel.slug}`} class="read-more-link" style="margin-top: 0.75rem; font-size: 0.8125rem;">Read Guide →</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </article>

  <CTASection 
    title="Put These Texas Operational Standards to Work"
    subtitle="Submit your project address to experience our standardized 36-photo survey delivery in 24–48 hours."
    primaryCtaText="Schedule a Texas Survey"
    primaryCtaLink="/schedule"
    secondaryCtaText="Join Our Texas Network"
    secondaryCtaLink="/join-us"
  />
</BaseLayout>

<style>
  .article-hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .article-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-amber-light);
  }

  .back-link:hover {
    color: #FFFFFF;
  }

  .article-h1 {
    color: #FFFFFF;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: var(--space-6);
  }

  .article-author-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-4);
  }

  .author-avatar-badge {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--accent-amber);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .author-title {
    color: #94A3B8;
    font-size: 0.75rem;
  }

  .takeaways-banner {
    background-color: #FFFFFF;
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .takeaways-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-amber-dark);
    margin-bottom: var(--space-4);
    letter-spacing: 0.05em;
  }

  .takeaways-full-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .takeaways-full-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .article-body-content :global(h2) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    font-size: 1.75rem;
    color: var(--text-primary);
  }

  .article-body-content :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    font-size: 1.3125rem;
    color: var(--text-primary);
  }

  .article-body-content :global(p) {
    margin-bottom: var(--space-5);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .article-body-content :global(ul), 
  .article-body-content :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-body-content :global(li) {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .article-body-content :global(li strong) {
    color: var(--text-primary);
  }

  .article-author-bio {
    background-color: #FFFFFF;
    padding: var(--space-6);
  }

  .bio-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .bio-avatar {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background-color: var(--text-primary);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .bio-text h4 {
    font-size: 1.125rem;
    margin-bottom: 0.2rem;
  }

  .bio-role {
    font-size: 0.75rem;
    color: var(--accent-amber-dark);
    margin-bottom: 0.5rem;
  }

  .bio-desc {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .related-card {
    background-color: #FFFFFF;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  .read-more-link {
    font-weight: 600;
    color: var(--accent-amber-dark);
  }
</style>
