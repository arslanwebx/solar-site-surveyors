---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getWhatsAppLink } from '../../data/whatsapp';

// SEO Metadata
const pageTitle = 'Solar CAD Design & Permit Plan Sets | PV & Battery Engineering';
const pageDescription = 'Solar CAD design and permit plan sets for PV and battery projects. Architectural, structural and electrical drawings prepared around AHJ and utility requirements.';
const canonicalUrl = 'https://solarsitesurveyors.com/services/solar-cad-designs/';

// Breadcrumbs
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Solar CAD Designs' }
];

const cadWhatsApp = getWhatsAppLink('Hi, I would like to request a solar CAD plan set or discuss project requirements.');

// FAQ Data for on-page accordion and Schema.org
const faqs = [
  {
    question: 'What do you need to start a solar CAD plan set?',
    answer: 'At minimum, send the project address, verified site information or survey package, equipment selection, electrical-service information, system size / layout requirements and the project AHJ and utility when known. Additional inputs may be required depending on the system type.'
  },
  {
    question: 'Can you create plans from a site survey completed by another company?',
    answer: 'Yes, provided the field information is complete enough for the requested drawing scope. If important dimensions, panel details or equipment information are missing, we will identify the gap before the package is finalized.'
  },
  {
    question: 'Do you design battery and ESS projects?',
    answer: 'Yes. CAD packages can include battery, gateway, backup-load and associated electrical documentation based on the selected equipment and project configuration.'
  },
  {
    question: 'Do your plan sets include PE stamps?',
    answer: 'Plan sets can be prepared for licensed professional review, and stamp coordination can be included when required by the project scope and jurisdiction. The specific engineering discipline and licensure must match the project location and requirement.'
  },
  {
    question: 'Are AHJ revisions included?',
    answer: 'Revision support can be provided for plan-review comments. The exact number or type of included revisions should follow the commercial agreement for the account or project.'
  },
  {
    question: 'Do you guarantee permit approval?',
    answer: 'No responsible drafting provider can guarantee an AHJ or utility approval. We prepare coordinated drawings around the project requirements and respond to review comments, but final approval remains with the reviewing authority.'
  },
  {
    question: 'Can I order CAD without a site survey from you?',
    answer: 'Yes. CAD drafting can be ordered as a standalone service using verified field data supplied by your team or another survey provider.'
  }
];

// Schema.org Service Schema & FAQPage Schema
const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      'name': 'Solar CAD Design & Permit Plan Sets',
      'url': canonicalUrl,
      'description': pageDescription,
      'provider': {
        '@type': 'Organization',
        'name': 'Solar Site Surveys',
        'url': 'https://solarsitesurveyors.com/'
      },
      'serviceType': 'Solar CAD design, electrical drafting and permit plan sets'
    },
    {
      '@type': 'FAQPage',
      'mainEntity': faqs.map(faq => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}
  activeNav="services"
  canonical={canonicalUrl}
  ogImage="/images/solar_cad_designs.webp"
  schemaData={serviceSchema}
>
  <!-- Section 1: Hero (Two-Column Layout) -->
  <section class="section section-dark service-hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <Breadcrumbs items={breadcrumbs} isDark={true} />
          
          <div class="discipline-tag-wrap">
            <span class="discipline-badge badge-blue">ENGINEERING & PERMITTING</span>
          </div>

          <h1 class="service-h1">Solar CAD Design & Permit Plan Sets for PV & Battery Projects</h1>
          
          <p class="service-lead">
            Turn verified project information into clean solar drawings your permitting team can actually use. We prepare architectural, structural and electrical plan sets for residential and commercial PV, battery storage and related solar projects, organized around the requirements of the project AHJ, utility and engineering scope.
          </p>

          <div class="hero-cta-group">
            <a href={cadWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
              <span>Request a CAD Plan Set</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact" class="btn btn-outline-white btn-lg">
              <span>Send Project Requirements</span>
            </a>
          </div>
        </div>

        <div class="hero-media-wrap">
          <div class="media-frame card-technical">
            <img 
              src="/images/solar_cad_designs.webp" 
              alt="Permit-ready solar CAD design plan set with single-line diagram and roof layout" 
              width="600" 
              height="400" 
              class="hero-img"
              loading="eager"
            />
            <div class="floating-media-badge">
              <span class="badge-dot-blue"></span>
              <span>Permit-Ready Plan Sets</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: From Field Data to Permit Package -->
  <section class="section section-warm">
    <div class="container narrow-container">
      <div class="section-header text-left">
        <div class="sub-badge">REVIEWER-READY DRAFTING</div>
        <h2>Solar drafting that starts with the information reviewers need</h2>
      </div>
      <div class="editorial-body">
        <p>
          Permit delays often begin long before a plan reviewer opens the drawing set. Incomplete site data, inconsistent equipment schedules, missing electrical details and generic notes can create revision cycles that slow down operations. Our CAD workflow is built to convert verified site information and equipment specifications into a coordinated plan set with a clear architectural and electrical story.
        </p>
        <p>
          We can work from our own site survey package or from field data supplied by your team. Before drafting, the project inputs are checked for obvious gaps so missing information can be addressed before it turns into a plan-review comment.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 3: What the CAD Plan Set Can Include -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header center">
        <div class="sub-badge">DRAWING SET ARCHITECTURE</div>
        <h2>What the CAD Plan Set Can Include</h2>
        <p class="lead">Complete sheet sets prepared for AHJ permit submission and utility interconnection.</p>
      </div>

      <div class="grid-2 gap-6">
        <!-- Sheet 1 -->
        <div class="scope-card card-technical">
          <div class="scope-header">
            <div class="scope-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3>Cover & project information</h3>
          </div>
          <p>Project address, scope, equipment summary, applicable notes and jurisdiction-specific information provided for the project.</p>
        </div>

        <!-- Sheet 2 -->
        <div class="scope-card card-technical">
          <div class="scope-header">
            <div class="scope-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Site / roof plan</h3>
          </div>
          <p>Property context, roof geometry, module layout, setbacks, pathways, equipment locations and relevant site notes.</p>
        </div>

        <!-- Sheet 3 -->
        <div class="scope-card card-technical">
          <div class="scope-header">
            <div class="scope-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></svg>
            </div>
            <h3>Array & attachment details</h3>
          </div>
          <p>Module layout, attachment pattern, mounting notes and structural information required by the project scope.</p>
        </div>

        <!-- Sheet 4 -->
        <div class="scope-card card-technical">
          <div class="scope-header">
            <div class="scope-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="9" y1="9" x2="9" y2="15"/><line x1="15" y1="9" x2="15" y2="15"/><line x1="9" y1="12" x2="15" y2="12"/></svg>
            </div>
            <h3>Single-line / three-line diagrams</h3>
          </div>
          <p>Electrical topology, service connection, conductor and OCPD information, disconnects, inverter / ESS equipment and related electrical notes.</p>
        </div>

        <!-- Sheet 5 -->
        <div class="scope-card card-technical">
          <div class="scope-header">
            <div class="scope-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            </div>
            <h3>Equipment schedules</h3>
          </div>
          <p>Modules, inverters, optimizers / microinverters, batteries, gateways, disconnects and other specified equipment.</p>
        </div>

        <!-- Sheet 6 -->
        <div class="scope-card card-technical">
          <div class="scope-header">
            <div class="scope-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <h3>Placards & labels</h3>
          </div>
          <p>Project-specific warning labels and placard schedules based on the applicable design and jurisdiction requirements.</p>
        </div>

        <!-- Sheet 7 -->
        <div class="scope-card card-technical">
          <div class="scope-header">
            <div class="scope-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <h3>Cut sheets & supporting documents</h3>
          </div>
          <p>Manufacturer documentation and supporting material organized with the permit package when requested.</p>
        </div>

        <!-- Sheet 8 -->
        <div class="scope-card card-technical">
          <div class="scope-header">
            <div class="scope-icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <h3>PE stamp coordination</h3>
          </div>
          <p>Packages can be prepared for review by the appropriate licensed professional when structural or electrical engineering stamps are required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Supported Project Types -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="sub-badge">SYSTEM CONFIGURATIONS</div>
        <h2>Supported Project Types</h2>
        <p class="lead">Drafting support tailored for residential portfolios, storage retrofits, and commercial facilities.</p>
      </div>

      <div class="grid-3 gap-6">
        <div class="type-card card-technical">
          <h4>Residential rooftop PV</h4>
          <p>Permit drawing sets for common residential rooftop systems using project-specific module, inverter and interconnection details.</p>
        </div>
        <div class="type-card card-technical">
          <h4>PV + battery / ESS</h4>
          <p>Layouts and electrical drawings for projects that include battery storage, gateways, transfer equipment, backup loads and associated disconnects.</p>
        </div>
        <div class="type-card card-technical">
          <h4>Ground-mount solar</h4>
          <p>Site and electrical drawing packages for ground-mount projects where the available field data and engineering scope support the design.</p>
        </div>
        <div class="type-card card-technical">
          <h4>Commercial / C&I</h4>
          <p>Custom plan-set support for larger facilities and more complex electrical or structural coordination.</p>
        </div>
        <div class="type-card card-technical full-row-span">
          <h4>Standalone drafting from your field data</h4>
          <p>Already have a complete survey? Send the verified measurements, photos, equipment schedule and jurisdiction information for CAD intake.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5 & 6: Technical Deep Dives (Electrical & Structural) -->
  <section class="section section-light">
    <div class="container">
      <div class="grid-2 gap-8">
        <!-- Section 5: Electrical Design Documentation -->
        <div class="technical-detail-card card-technical">
          <div class="sub-badge">ELECTRICAL DRAFTING</div>
          <h3>Clear electrical drawings for review and installation planning</h3>
          <p>
            The electrical portion of the plan set should communicate the proposed system without forcing a reviewer or installer to reconstruct the design from scattered notes. Depending on the project, drawings may include conductor and conduit information, overcurrent protection, disconnects, rapid-shutdown components, service interconnection details, inverter or microinverter architecture, battery / gateway connections and equipment ratings.
          </p>
          <div class="compliance-note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Applicable NEC provisions, utility requirements and local amendments are selected for the actual project jurisdiction and code cycle. The service is prepared around project-specific requirements rather than promising one fixed code edition nationwide.</span>
          </div>
        </div>

        <!-- Section 6: Structural & Roof-Plan Documentation -->
        <div class="technical-detail-card card-technical">
          <div class="sub-badge">STRUCTURAL DRAFTING</div>
          <h3>Structural & roof-plan documentation</h3>
          <p>
            For rooftop projects, the plan set can coordinate module layout with roof geometry, setbacks, access pathways, attachment locations and the structural information available for the project.
          </p>
          <p>
            When engineering analysis or stamped calculations are required, drawings should be prepared for review by the appropriate licensed professional rather than represented as a substitute for that engineering review.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-Service Bridge -->
  <section class="section section-warm bridge-section">
    <div class="container">
      <div class="bridge-card card-technical">
        <div class="bridge-text">
          <span class="bridge-tag">UPSTREAM VERIFICATION</span>
          <h3>Need verified field data before drafting?</h3>
          <p>Eliminate drafting assumptions with our standardized on-site solar site surveys across Texas.</p>
        </div>
        <div class="bridge-action">
          <a href="/services/solar-site-surveys/" class="btn btn-outline btn-md">
            <span>Explore Precision Site Surveys</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7 & 8: AHJ Workflow & Revision Support -->
  <section class="section section-light">
    <div class="container">
      <div class="grid-2 gap-8">
        <!-- Section 7: AHJ and Utility Workflow -->
        <div class="policy-card card-technical">
          <div class="sub-badge">LOCALIZED ALIGNMENT</div>
          <h3>Prepared around the project jurisdiction - not a one-size-fits-all template</h3>
          <p>
            Solar permitting varies by building department, utility and project type. Our drafting workflow should capture the project AHJ, utility, equipment list, interconnection method and any supplied submission standards before the drawing set is finalized. This allows notes, title blocks, placards and supporting documents to be aligned more closely with the actual permit package.
          </p>
          <p>
            Where a jurisdiction or utility publishes a specific checklist or required form, that information should be attached to the project intake whenever possible.
          </p>
        </div>

        <!-- Section 8: Revision Support -->
        <div class="policy-card card-technical">
          <div class="sub-badge">PERMITTING LIFECYCLE</div>
          <h3>Dedicated Revision support</h3>
          <p>
            Plan-review comments are part of permitting. When an AHJ or utility requests a drawing change, provide the reviewer comments and any updated project information. The CAD team can revise the affected sheets and return an updated package according to the agreed revision scope.
          </p>
          <div class="compliance-note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#66717D" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>We do not market this as "guaranteed permit approval." Approval depends on the authority having jurisdiction, utility review, engineering requirements, property conditions and the accuracy of the project information supplied.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 9: CAD Workflow -->
  <section class="section section-warm">
    <div class="container">
      <div class="section-header center">
        <div class="sub-badge">PRODUCTION PIPELINE</div>
        <h2>CAD Production Workflow</h2>
        <p class="lead">A disciplined 6-stage drafting sequence from intake review to final delivery.</p>
      </div>

      <div class="workflow-grid-6">
        <div class="workflow-step card-technical">
          <span class="step-number">01</span>
          <h4>Submit project inputs</h4>
          <p>Send the address, site survey or verified field data, equipment schedule, AHJ / utility information and company standards.</p>
        </div>
        <div class="workflow-step card-technical">
          <span class="step-number">02</span>
          <h4>Intake review</h4>
          <p>The project is checked for missing information that could affect the drawing set before drafting begins.</p>
        </div>
        <div class="workflow-step card-technical">
          <span class="step-number">03</span>
          <h4>Draft the plan set</h4>
          <p>Architectural, structural and electrical sheets are prepared around the submitted project scope.</p>
        </div>
        <div class="workflow-step card-technical">
          <span class="step-number">04</span>
          <h4>Internal QA</h4>
          <p>The drawing package is reviewed for consistency, equipment coordination and obvious drafting errors.</p>
        </div>
        <div class="workflow-step card-technical">
          <span class="step-number">05</span>
          <h4>Delivery / stamp review</h4>
          <p>Receive the permit package in the agreed format, with professional-engineer review or stamp coordination added when required.</p>
        </div>
        <div class="workflow-step card-technical">
          <span class="step-number">06</span>
          <h4>Revision handling</h4>
          <p>Send reviewer comments or project changes for plan-set updates under the agreed revision policy.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 10 & 11: File Formats & Nationwide Scope -->
  <section class="section section-light">
    <div class="container">
      <div class="grid-2 gap-8">
        <!-- Section 10: File Formats & Handoff -->
        <div class="info-card card-technical">
          <div class="sub-badge">DELIVERABLE STANDARDS</div>
          <h3>File Formats & Digital Handoff</h3>
          <p>
            Typical deliverables may include permit-ready PDF plan sets, editable DWG source files when included in the project scope, supporting calculation or engineering documents, equipment cut sheets and placard / label schedules.
          </p>
          <p>
            File naming and folder organization can be matched to the client workflow for repeat-volume accounts.
          </p>
        </div>

        <!-- Section 11: Nationwide CAD Support -->
        <div class="info-card card-technical">
          <div class="sub-badge">JURISDICTION COVERAGE</div>
          <h3>Nationwide CAD Support</h3>
          <p>
            Solar CAD design services are available for projects beyond the Texas field-survey footprint.
          </p>
          <p>
            Because permitting and code cycles differ by location, every project should be drafted from the project address, AHJ, utility and current submission requirements rather than from a generic state template.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 12: FAQ -->
  <section class="section section-warm">
    <div class="container narrow-container">
      <div class="section-header center">
        <div class="sub-badge">QUESTIONS & ANSWERS</div>
        <h2>Frequently Asked Questions</h2>
        <p class="lead">Common questions about solar CAD drafting, software deliverables, and permit revisions.</p>
      </div>

      <div class="faq-accordion">
        {faqs.map((faq) => (
          <details class="faq-item card-technical">
            <summary class="faq-question">
              <span>{faq.question}</span>
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 13: Final CTA -->
  <section class="section section-dark cta-banner-section">
    <div class="container">
      <div class="cta-banner-inner">
        <h2>Ready to send your next solar project to CAD?</h2>
        <p class="cta-lead">
          Send the site survey, equipment list, project address and permitting requirements. We will review the inputs and confirm the drafting scope before the plan set begins.
        </p>
        <div class="cta-actions">
          <a href={cadWhatsApp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            <span>Request a CAD Plan Set</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/contact" class="btn btn-outline-white btn-lg">
            <span>Send Project Requirements</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     SOLAR CAD DESIGNS - TECHNICAL ARCHITECTURAL STYLING
     ========================================================================== */

  .service-hero {
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: center;
  }

  .discipline-tag-wrap {
    margin-bottom: var(--space-4);
  }

  .discipline-badge {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .discipline-badge.badge-blue {
    background-color: #F0F9FF;
    color: #0284C7;
  }

  .service-h1 {
    color: #FFFFFF !important;
    font-family: var(--font-heading) !important;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-5);
  }

  .service-lead {
    color: #9FB3C8 !important;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    font-weight: 400;
    line-height: 1.65;
    margin-bottom: var(--space-8);
  }

  .hero-cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0;
  }

  .hero-cta-group .btn-primary,
