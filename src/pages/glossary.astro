---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlossarySearch from '../components/GlossarySearch.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout 
  title="Solar Operations Glossary | Definitions & Code Standards | SolarSite Co."
  description="Comprehensive solar operations glossary for EPCs, installers, and engineers: AHJ, PTO, NTP, MSP, MPU, 120% Rule, Busbar Rating, Rapid Shutdown, and Interconnection rules."
  activeNav="glossary"
>
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <span class="badge-tech badge-dark">OPERATIONAL ENCYCLOPEDIA</span>
        <h1 class="page-title">Solar Operations Glossary</h1>
        <p class="lead" style="color: #94A3B8; max-width: 820px;">
          An authoritative reference guide to critical electrical, engineering, permitting, and financial terms used across US residential and commercial solar operations.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <GlossarySearch />
    </div>
  </section>

  <CTASection 
    title="Need a Field Verification Partner Who Speaks Your Language?"
    subtitle="Our field surveyors and QA desk live and breathe 120% busbar rules, AHJ setbacks, and utility interconnection standards."
    primaryCtaText="Schedule a Site Survey"
    primaryCtaLink="/schedule"
    secondaryCtaText="Become an EPC Partner"
    secondaryCtaLink="/for-epcs"
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }
</style>
