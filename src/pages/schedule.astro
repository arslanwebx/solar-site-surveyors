---
import BaseLayout from '../layouts/BaseLayout.astro';
import DispatchForm from '../components/DispatchForm.astro';
---

<BaseLayout 
  title="Schedule a Solar Site Survey | 48-Hour Dispatch | SolarSite Co."
  description="Submit your solar project address, utility bills, and survey scope. Our operations desk coordinates the certified local surveyor and delivers a CAD-ready survey package in 48–72 hours."
  activeNav="schedule"
>
  <section class="section section-dark page-hero">
    <div class="container">
      <div class="page-hero-content">
        <span class="badge-tech badge-dark">OPERATIONAL INTAKE DESK</span>
        <h1 class="page-title">Schedule a Solar Site Survey</h1>
        <p class="lead" style="color: #94A3B8; max-width: 780px;">
          Submit your project details below. We match the appropriate certified field surveyor, coordinate access, and deliver an organized 36-photo CAD-ready package within 48–72 hours.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <DispatchForm />

      <!-- Operational Dispatch FAQ -->
      <div class="dispatch-faq-box card-technical tech-grid-border" style="margin-top: var(--space-12);">
        <h3 style="margin-bottom: var(--space-4); font-size: 1.25rem;">Frequently Asked Dispatch Questions</h3>
        
        <div class="faq-list">
          <div class="faq-item">
            <strong>How quickly is the site survey scheduled?</strong>
            <p>Our regional dispatch desk contacts the homeowner/customer within 4 business hours to confirm site access and schedule the appointment within 48 hours.</p>
          </div>

          <div class="faq-item">
            <strong>What happens if the customer is not home?</strong>
            <p>For exterior-only surveys (outdoor MSP and walkable roof), homeowner presence is not required. For attic framing inspections or indoor battery gateways, our team schedules an arrival window directly with the property contact.</p>
          </div>

          <div class="faq-item">
            <strong>How do we receive the completed survey package?</strong>
            <p>Your engineering team receives an encrypted cloud link and webhook containing 36+ categorized 4K geotagged photos, CAD dimension reports, and single-line electrical sheets.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-dark-subtle);
  }

  .page-title {
    color: #FFFFFF;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .dispatch-faq-box {
    background-color: #FFFFFF;
    padding: var(--space-8);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .faq-item p {
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
