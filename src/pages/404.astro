---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 - Page Not Found | SolarSite Texas"
  description="The requested solar site survey page or document was not found."
>
  <section class="section section-dark page-hero">
    <div class="container-narrow" style="text-align: center; padding: var(--space-16) var(--space-4);">
      <h1 class="page-title" style="margin-bottom: 1rem;">Page Not Found (404)</h1>
      <p class="lead" style="color: #94A3B8; max-width: 600px; margin: 0 auto 2rem;">
        The requested page or project link could not be located. Use the links below to return to the active dispatch network.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary btn-md">Return to Home</a>
        <a href="/schedule" class="btn btn-outline-white btn-md">Schedule a Survey</a>
        <a href="/service-areas" class="btn btn-outline-white btn-md">Service Areas</a>
      </div>
    </div>
  </section>
</BaseLayout>
