---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
  canonical?: string;
  ogImage?: string;
  schemaType?: string;
  schemaData?: Record<string, any>;
}

const {
  title = 'Solar Site Surveys | Precision Solar Site Survey Coordination',
  description = 'Statewide solar site survey coordination platform for Solar EPCs, installers, dealers, and engineering teams across Texas. Standardized roof, electrical, and battery site surveys delivered with prompt QA release.',
  activeNav = '',
  canonical = Astro.url.href,
  ogImage = '/images/hero_surveyor_field.jpg',
  schemaType = 'ProfessionalService',
  schemaData = {}
} = Astro.props;

const siteUrl = 'https://solarsitesurveyors.com';
const fullCanonicalUrl = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  'name': 'Solar Site Surveys',
  'legalName': 'SolarSite Operations LLC',
  'url': siteUrl,
  'logo': `${siteUrl}/images/logo.png`,
  'image': fullOgImageUrl,
  'description': description,
  'telephone': '+1-800-555-7878',
  'email': 'dispatch@solarsitesurveyors.com',
  'areaServed': 'Texas, United States',
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Commercial Solar Site Survey',
    'Electrical Main Service Panel Survey',
    'Battery Energy Storage Clearance Survey',
    'Drone Photogrammetry Roof Inspection'
  ],
  'priceRange': '$$',
  ...schemaData
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#102A43" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:site_name" content="Solar Site Surveys" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- Typography Fonts: Satoshi + Instrument Sans -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;600&display=swap" />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
  </head>
  <body>
    <Header activeNav={activeNav} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
