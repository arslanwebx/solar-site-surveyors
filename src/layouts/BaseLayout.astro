---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloatingButton from '../components/WhatsAppFloatingButton.astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
  canonical?: string;
  ogImage?: string;
  schemaType?: string;
  schemaData?: Record<string, any>;
  preloadImage?: string;
  preloadImageMobile?: string;
}

const {
  title = 'Solar Site Surveys | Precision Solar Site Survey Coordination',
  description = 'Statewide solar site survey coordination platform for Solar EPCs, installers, dealers, and engineering teams across Texas. Standardized roof, electrical, and battery site surveys delivered with prompt QA release.',
  activeNav = '',
  canonical = Astro.url.href,
  ogImage = '/images/hero_surveyor_field.webp',
  schemaType = 'ProfessionalService',
  schemaData = {},
  preloadImage = '',
  preloadImageMobile = ''
} = Astro.props;

const siteUrl = 'https://solarsitesurveyors.com';
const fullCanonicalUrl = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  'name': 'Solar Site Surveys',
  'legalName': 'SolarSite Operations LLC',
  'url': siteUrl,
  'logo': `${siteUrl}/images/logo.png`,
  'image': fullOgImageUrl,
  'description': description,
  'telephone': '+1-682-396-0543',
  'areaServed': 'Texas, United States',
  'serviceType': [
    'Solar Site Surveys',
    'Residential Solar Site Survey',
    'Commercial Solar Site Survey',
    'Electrical Main Service Panel Survey',
    'Battery Energy Storage Clearance Survey',
    'Drone Photogrammetry Roof Inspection'
  ],
  'priceRange': '$$',
  ...schemaData
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Google tag (gtag.js) - Non-blocking Deferred Initialization -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GXSFB3FHHS');

      function initGtag() {
        if (window._gtagLoaded) return;
        window._gtagLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-GXSFB3FHHS';
        document.head.appendChild(s);
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() { setTimeout(initGtag, 1500); });
      } else {
        window.addEventListener('load', function() { setTimeout(initGtag, 1500); });
      }
      ['scroll', 'touchstart', 'pointerdown', 'keydown'].forEach(function(e) {
        window.addEventListener(e, initGtag, { once: true, passive: true });
      });
    </script>

    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#102A43" />

    {preloadImageMobile && (
      <link rel="preload" as="image" href={preloadImageMobile} type="image/webp" media="(max-width: 900px)" fetchpriority="high" />
    )}
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} type="image/webp" media={preloadImageMobile ? "(min-width: 901px)" : undefined} fetchpriority="high" />
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:site_name" content="Solar Site Surveys" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- Typography Fonts: Preconnect & Asynchronous Non-blocking Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Instrument+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Instrument+Sans:wght@400;500;600&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Instrument+Sans:wght@400;500;600&display=swap" />
    </noscript>

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
  </head>
  <body>
    <Header activeNav={activeNav} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloatingButton />
  </body>
</html>
